                        </rectangle>

                        <label name="popCls_lblAviso" align="bottom" height="18" text="" fontFamily="EB Garamond" fontColor="#8B2332" fontSize="11" margins="{top=4}"/>

                        <rectangle align="bottom" height="40" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=6}">
                            <layout align="client" margins="{left=6,right=6,top=4,bottom=4}">
                                <rectangle align="left" width="138" color="#16202A" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Grava esta subclasse no primeiro slot, no nível 1 (gasta 1 ponto de classe)">
                                    <event name="onClick"><![CDATA[definirSubclasseNoSlot(1);]]></event>
                                    <label name="popCls_lblSlot1" align="client" text="DEFINIR COMO 1ª" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle align="left" width="138" color="#16202A" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{right=12}" cursor="handPoint" hint="Grava esta subclasse no segundo slot (exige nível 11 e a primeira subclasse no nível 4)">
                                    <event name="onClick"><![CDATA[definirSubclasseNoSlot(2);]]></event>
                                    <label name="popCls_lblSlot2" align="client" text="DEFINIR COMO 2ª" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>

                                <rectangle align="left" width="42" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Descer um nível. No nível 1, remove a subclasse da ficha e devolve o ponto.">
                                    <event name="onClick"><![CDATA[alterarNivelSubclasseAtual(-1);]]></event>
                                    <label align="client" text="&#8722;" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="15" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle align="left" width="146" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" hitTest="false">
                                    <label name="popCls_lblNivelBotoes" align="client" text="—" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center"/>
                                </rectangle>
                                <rectangle align="left" width="42" color="#111A1E" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Gastar 1 ponto de classe e subir um nível nesta árvore">
                                    <event name="onClick"><![CDATA[alterarNivelSubclasseAtual(1);]]></event>
                                    <label align="client" text="+" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>

                                <rectangle align="right" width="96" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fechar esta janela">
                                    <event name="onClick"><![CDATA[self.popClasses:close();]]></event>
                                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                            </layout>
                        </rectangle>

