                    <!-- SANGUE BEBIDO (v0.48.0), so para vampiros, ao lado do
                         Vitae e na cor dele.

                         LIVRO, Racas/Vampiros [1.6], "[Sede de sangue]":
                         "voce apenas recupera esta barra de energia se
                         alimentando do sangue de outros seres vivos. Cada
                         50ml recupera 1 ponto de Vitae."

                         O card CONVERTE e REGISTRA; nao soma em lugar nenhum.
                         A ficha nao rastreia recurso ATUAL para o personagem -
                         so maximos - entao somar aqui inventaria um rastreio
                         que nao existe e sumiria com a metade dele. -->
                    <layout name="cmb_wrapSangue" align="left" width="0">
                        <rectangle name="cmb_secSangue" align="client" color="#0D1317" strokeColor="#8B2332" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8B2332" hitTest="false"/>
                            <label align="top" height="26" text="SANGUE BEBIDO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Cada 50 ml de sangue bebido recupera 1 ponto de Vitae (Raças/Vampiros, [Sede de sangue])."/>
                            <label name="cmb_lblSangue" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#8B2332" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaSangue" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=2,left=10,right=10,bottom=4}">
                                <rectangle name="cmb_btnBeber" align="client" color="#080B0E" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Converte o sangue anotado em pontos de Vitae e zera o contador. O resto abaixo de 50 ml continua anotado.">
                                    <label align="client" text="BEBER" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[beberSangue();]]></event>
                                </rectangle>
                            </layout>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=2}">
                                <label align="left" width="40" text="ML" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3">
                                    <edit name="cmb_edSangueMl" align="client" field="sangueBebidoMl" type="number" text="0" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="12" horzTextAlign="center" transparent="true" hint="Quantos ml o vampiro bebeu. É campo de JOGO: continua livre com a ficha finalizada.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>


                    <!-- DESCANSO (v0.48.0). Os dois botoes APLICAM: somam no
                         atual das barras e, no caso do longo, saram o Ferido.
                         As duas linhas mostram o que cada um rende ANTES de
                         clicar, porque botao que muda numero sem avisar o
                         quanto e botao que ninguem aperta duas vezes. -->
                    <layout name="cmb_wrapDescanso" align="left" width="196">
                        <rectangle name="cmb_secDescanso" align="client" color="#0D1317" strokeColor="#4E8C74" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#4E8C74" hitTest="false"/>
                            <label align="top" height="24" text="DESCANSO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="[2.3]: Longo (24h) devolve 30% da vida e 50% da aura/mana; Curto (12h), 25% e 25%. O longo TAMBÉM sara o Ferido, e enquanto ferido o ganho de vida sai pelo percentual do nível (30/20/10%)."/>
                            <label name="cmb_lblDescanso" align="top" height="30" text="0" fontFamily="Cinzel" fontColor="#4E8C74" fontSize="24" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaDescanso" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <label name="cmb_curtoDescanso" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=2,left=10,right=10,bottom=6}">
                                <rectangle name="cmb_btnDescCurto" align="left" width="76" color="#080B0E" strokeColor="#4E8C74" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Aplicar descanso curto (12h)">
                                    <label align="client" text="CURTO" fontFamily="Marcellus SC" fontColor="#4E8C74" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[aplicarDescanso("curto");]]></event>
                                </rectangle>
                                <rectangle name="cmb_btnDescLongo" align="right" width="76" color="#080B0E" strokeColor="#4E8C74" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Aplicar descanso longo (24h) — também sara o Ferido">
                                    <label align="client" text="LONGO" fontFamily="Marcellus SC" fontColor="#4E8C74" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[aplicarDescanso("longo");]]></event>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>

                    <!-- FASE DA LUA (v0.38.0). Card so para lobisomens, com
                         setas, clonado da estrutura do card de TAMANHO - que
                         e a unica outra da ficha com valor em palavra e setas,
                         e ja provada na tela.
                         O valor e uma PALAVRA: entra em CARDS_DE_TEXTO para
                         a escala de fonte nao estourar a caixa com
                         "Eclipse Carmesim". -->
                    <layout name="cmb_wrapLua" align="left" width="0">
                        <rectangle name="cmb_secLua" align="client" color="#0D1317" strokeColor="#3A2E52" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8A63C9" hitTest="false"/>
                            <label align="top" height="26" text="FASE DA LUA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="A fase da lua do mundo agora. O bônus lunar entra nos cálculos quando a forma bestial está ligada."/>
                            <label name="cmb_lblLua" align="top" height="34" text="Nova" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaLua" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <rectangle name="cmb_btnLuaAnterior" align="left" width="30" color="#080B0E" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fase anterior">
                                    <label align="client" text="&#9664;" fontFamily="EB Garamond" fontColor="#8A63C9" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[mudarFaseLua(-1);]]></event>
                                </rectangle>
                                <rectangle name="cmb_btnLuaProxima" align="right" width="30" color="#080B0E" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Próxima fase">
                                    <label align="client" text="&#9654;" fontFamily="EB Garamond" fontColor="#8A63C9" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[mudarFaseLua(1);]]></event>
                                </rectangle>
                                <label name="cmb_lblLuaEscala" align="client" text="" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            </layout>
                        </rectangle>
                    </layout>
                    </layout>
                    <label name="cmb_lblNotaRecursos" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="11" wordWrap="false" margins="{top=2}" hitTest="false"/>

                    <rectangle align="top" height="72" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{top=6}">
                        <layout align="client" margins="{left=14,right=14,top=8,bottom=8}">
                            <label align="top" height="16" text="COMPOSIÇÃO — o que entra nas barras acima" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <layout align="client" margins="{top=2}">
                        <layout name="cmb_compDadoVida" align="left" width="220" margins="{right=12}">
                            <label align="top" height="15" text="Dado de vida (raça)" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" hitTest="false"/>
