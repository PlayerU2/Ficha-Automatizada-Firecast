    <popup name="popEncantamentos" width="800" height="640" backOpacity="0.8" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="ENCANTAMENTOS" fontFamily="Cinzel Decorative" fontColor="#8A63C9" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#8A63C9" margins="{top=4,bottom=6}" hitTest="false"/>
                <label align="top" height="30" text="Só é possível encantar um item que tenha slot para isso, e ter slot depende da qualidade e do material com que ele foi forjado. Clique para aplicar ou remover." fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{bottom=6}" hitTest="false"/>
                <rectangle align="bottom" height="30" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{top=10}" cursor="handPoint" hint="Voltar ao editor">
                    <label align="client" text="VOLTAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[fecharPopupEncantamentos();]]></event>
                </rectangle>
                <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                    <scrollBox align="client" margins="{left=10,right=10,top=4,bottom=8}">
                            <label align="top" height="24" text="CLASSE I — 5 AUREUS" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{top=10,bottom=3}" hitTest="false"/>
                            <rectangle name="rectEnc_Afinidadedefogo" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Afinidade de fogo");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Afinidadedefogo" align="top" height="16" text="Afinidade de fogo" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="o portador do objeto com este encantamento recebe afinidade com o elemento [Fogo]." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Afinidadedegelo" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Afinidade de gelo");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Afinidadedegelo" align="top" height="16" text="Afinidade de gelo" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="o portador do objeto com este encantamento recebe afinidade com o elemento [Gelo]." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Afinidadedeagua" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
