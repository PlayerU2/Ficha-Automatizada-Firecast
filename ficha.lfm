                </scrollBox>
            </layout>
        </rectangle>
    </popup>

    <popup name="popFavores" width="720" height="620" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label name="popFav_lblTitulo" align="top" height="26" text="REGISTRAR FAVOR" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=6}" hitTest="false"/>
                <label name="popFav_lblAjuda" align="top" height="30" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{bottom=6}" hitTest="false"/>
                <!-- A recusa aparece AQUI tambem (v0.42.1): ate a v0.41.1 ela era
                     escrita so na aba, atras do popup ainda aberto — o mestre
                     clicava na macula, nada acontecia, e o motivo ficava
                     escondido pelo proprio popup. -->
                <label name="popFav_lblAviso" align="top" height="0" text="" fontFamily="EB Garamond" fontColor="#E2AEB6" fontSize="12" wordWrap="true" vertTextAlign="center" margins="{bottom=6}" hitTest="false"/>

                <rectangle align="bottom" height="30" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{top=10}" cursor="handPoint" hint="Fechar">
                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[fecharPopupFavores();]]></event>
                </rectangle>

                <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                    <scrollBox align="client" margins="{left=10,right=10,top=8,bottom=8}">
                            <!-- O PAI E A MAE (v0.35.4): topo do panteao, acima
                                 dos primordiais. Deuses, "Panteão": "~> Pai, pai
                                 dos seres primordiais / ~> Mãe, mãe dos seres
                                 primordiais / ~~> Asta, deus primordial...".
                                 Ficam FORA de CatalogoDeuses.itens de proposito
                                 (nao tem kit de poder, nao podem ser Aspecto
                                 Divino - o livro diz que nao ha semideus do
                                 Supremo). Entram aqui porque a ficha tambem
                                 serve para NPC: os paladinos tem favor com o
                                 Pai. Categoria "Suprema" os mantem fora da
                                 lista de escolha de primordial. -->
                            <rectangle name="rectFav_OPai" align="top" height="26" color="#0D1317" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Clique para meio favor; use o botão + 1 INTEIRO para um favor cheio">
                                <label name="lblFav_OPai" align="client" text="O Pai" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                <label align="right" width="66" text="Suprema" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherDeusFavor("O Pai");]]></event>
                            </rectangle>
                            <rectangle name="rectFavInt_OPai" align="top" height="0" color="#0D1317" strokeSize="0" hitTest="false"/>
                            <rectangle name="rectFav_AMae" align="top" height="26" color="#0D1317" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Clique para meio favor; use o botão + 1 INTEIRO para um favor cheio">
                                <label name="lblFav_AMae" align="client" text="A Mãe" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                <label align="right" width="66" text="Suprema" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherDeusFavor("A Mãe");]]></event>
                            </rectangle>
                            <rectangle name="rectFavInt_AMae" align="top" height="0" color="#0D1317" strokeSize="0" hitTest="false"/>
                            <rectangle name="rectFav_Ammis" align="top" height="26" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Clique para meio favor; use o botão + 1 INTEIRO para um favor cheio">
                                <label name="lblFav_Ammis" align="client" text="Ammis" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                <label align="right" width="66" text="Grande" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherDeusFavor("Ammis");]]></event>
