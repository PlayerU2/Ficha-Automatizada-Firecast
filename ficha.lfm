                                    <label name="popCatalogoDefeitos_lblAutomacao" align="client" text="" fontFamily="EB Garamond" fontColor="#B9D3DD" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                        </scrollBox>

                        <rectangle align="bottom" height="106" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                            <layout align="client" margins="{left=10,right=10,top=8,bottom=8}">
                                <label name="popCatalogoDefeitos_lblJaPossui" align="top" height="16" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{bottom=4}"/>

                                <layout align="top" height="24" margins="{bottom=6}">
                                    <checkBox name="popCatalogoDefeitos_chkGratis" align="left" width="22" cursor="handPoint" hint="Se marcado, o tier escolhido abaixo é concedido de graça (não gasta PD)"/>
                                    <label align="client" text="Concedido pelo mestre (não gasta PD - ex.: recompensa de narrativa/dungeon)" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11" vertTextAlign="center" margins="{left=6}"/>
                                </layout>

                                <layout align="top" height="34" margins="{bottom=6}">
                                    <label align="left" width="118" text="TIER DESEJADO:" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                                <rectangle name="popCatalogoDefeitos_btnTier1" align="left" width="66" color="#16202A" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoDefeitos", 1);]]></event>
                                    <label name="popCatalogoDefeitos_lblTier1" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popCatalogoDefeitos_btnTier2" align="left" width="66" color="#16202A" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoDefeitos", 2);]]></event>
                                    <label name="popCatalogoDefeitos_lblTier2" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popCatalogoDefeitos_btnTier3" align="left" width="66" color="#16202A" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoDefeitos", 3);]]></event>
                                    <label name="popCatalogoDefeitos_lblTier3" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popCatalogoDefeitos_btnTier4" align="left" width="66" color="#16202A" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoDefeitos", 4);]]></event>
                                    <label name="popCatalogoDefeitos_lblTier4" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                    <rectangle name="popCatalogoDefeitos_rectFaixa" align="left" width="150" color="#0A0C10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" visible="false">
                                        <layout align="client" margins="{left=6,right=6}">
                                            <label align="left" width="46" text="PONTOS" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                                            <edit name="popCatalogoDefeitos_editFaixa" align="client" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" vertTextAlign="center"/>
                                        </layout>
                                    </rectangle>
                                    <rectangle name="popCatalogoDefeitos_btnFaixaConfirmar" align="left" width="90" color="#16202A" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" visible="false" margins="{left=6}" cursor="handPoint" hint="Adicionar/atualizar a ficha com a pontuação digitada">
                                        <event name="onClick"><![CDATA[confirmarAdicaoQDFaixa("popCatalogoDefeitos");]]></event>
                                        <label align="client" text="Confirmar" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    </rectangle>
                                </layout>
                                <layout align="client">
                                    <rectangle align="right" width="90" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fechar esta janela">
                                        <event name="onClick"><![CDATA[self.popCatalogoDefeitos:close();]]></event>
                                        <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    </rectangle>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>
                </layout>
            </layout>
        </rectangle>
    </popup>

    <popup name="popLimiteQD" width="520" height="280" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8B2332" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=20,right=20,top=18,bottom=18}">
                <label align="top" height="26" text="PONTOS INSUFICIENTES" fontFamily="Cinzel Decorative" fontColor="#8B2332" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
                <rectangle align="top" height="1" color="#8B2332" margins="{top=4,bottom=10}" hitTest="false"/>
                <label name="lblLimiteQDTexto" align="client" text="" fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                <layout align="bottom" height="36" margins="{top=10}">
                    <rectangle align="left" width="140" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{right=6}" cursor="handPoint" hint="Cancelar e não adicionar">
                        <event name="onClick"><![CDATA[cancelarQDAlemDoLimite();]]></event>
                        <label align="client" text="CANCELAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                    <rectangle align="client" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="4" yradius="4" margins="{left=6}" cursor="handPoint" hint="Adicionar mesmo sem saldo (autorização do mestre)">
                        <event name="onClick"><![CDATA[confirmarQDAlemDoLimite();]]></event>
                        <label align="client" text="MESTRE AUTORIZA - ADICIONAR MESMO ASSIM" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                </layout>
            </layout>
        </rectangle>
    </popup>

