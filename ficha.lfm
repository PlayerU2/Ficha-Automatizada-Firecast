    <!-- =================================================================
         POPUP - ASPECTO DIVINO (mestre-detalhe)

         Mesmo padrao de Racas, Qualidades e Classes: lista estatica a
         esquerda, detalhe completo a direita. Os PRIMORDIAIS aparecem na
         lista como referencia de lore, mas com o botao de escolher desligado.

         As VAGAS do livro nao aparecem de proposito: a ficha nao consegue
         saber o que as outras fichas da mesa escolheram, e um numero
         desatualizado seria pior que numero nenhum.
         ================================================================= -->
    <popup name="popHabilidade" width="1020" height="700" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label name="popHab_lblTitulo" align="top" height="26" text="CONSTRUTOR DE HABILIDADE" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>

                <!-- rodape -->
                <layout align="bottom" height="36" margins="{top=8}">
