    <popup name="popDeuses" width="1080" height="680" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="ASPECTO DIVINO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>
                <label align="top" height="18" text="A divindade define o kit de poderes do semideus. Somente os deuses grandes podem ser escolhidos como Aspecto Divino." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" margins="{bottom=8}" hitTest="false"/>

                <layout align="client">
                    <rectangle align="left" width="270" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" margins="{right=14}" hitTest="false">
