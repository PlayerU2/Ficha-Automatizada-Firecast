    <!-- =================================================================
         POPUP - ESCOLHER TRACO DE PERSONALIDADE
         Padrao reaproveitavel para os demais catalogos (Racas, Classes,
         Poderes, Qualidades...): cabecalho + texto de regra + lista rolavel
         de cards clicaveis + rodape com acoes.
         ================================================================= -->
    <popup name="popTracos" width="820" height="560" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=20,right=20,top=16,bottom=16}">

                <label align="top" height="30" text="TRAÇOS DE PERSONALIDADE" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" horzTextAlign="center"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>

                <label align="top" height="30" text="Recusa: gaste 1 ponto de inspiração para recusar ganhar ou perder um traço. Ações opostas ao traço podem exigir teste puro de Sabedoria (meta 20) ou custar 1 ponto de inspiração." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" wordWrap="true" margins="{bottom=4}" hitTest="false"/>
                <label align="top" height="18" text="Clique para conceder; clique de novo para remover. Só o mestre altera — o personagem pode acumular mais de um traço ao longo da campanha." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" margins="{bottom=2}" hitTest="false"/>
                <label name="popTraco_lblAviso" align="top" height="20" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>

                <rectangle align="bottom" height="40" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=8}" hitTest="false">
                    <layout align="client" margins="{left=10,right=10,top=5,bottom=5}">
                        <rectangle align="left" width="200" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Remover o traço atual do personagem">
                            <event name="onClick"><![CDATA[limparTracoPersonalidade();]]></event>
                            <label align="client" text="REMOVER TRAÇO ATUAL" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        </rectangle>
                        <rectangle align="right" width="140" color="#111A1E" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fechar esta janela">
                            <event name="onClick"><![CDATA[fecharPopupTracos();]]></event>
                            <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        </rectangle>
                    </layout>
                </rectangle>

                <scrollBox align="client" margins="{top=4}">
                    <rectangle name="rectTraco_Lascivo" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Lascivo' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Lascivo");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="22">
                                <label align="left" width="220" text="Lascivo" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <label align="client" text="oposto: Casto" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Sua chance de gerar um descendente é aumentada, bem como a chance de cair em truques e/ou habilidades de sedução em -2, porém sua chance de seduzir alguém é aumentada em +2, você terá desvantagem em testes sociais contra personagens Castos." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Casto" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Casto' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Casto");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="22">
                                <label align="left" width="220" text="Casto" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <label align="client" text="oposto: Lascivo" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Sua chance de gerar um descendente é drasticamente reduzida, aumente sua resistência a truques e/ou habilidades de sedução em +2, você terá desvantagem em testes sociais contra personagens Lascivos." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Glutao" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Glutão' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Glutão");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="22">
                                <label align="left" width="220" text="Glutão" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <label align="client" text="oposto: Moderado" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Você deve obrigatoriamente gastar 20% de todo o dinheiro que recebe por estação com comida, você deve se alimentar com o dobro da comida que um indivíduo comum da sua raça comeria para se sentir satisfeito e possui desvantagem em testes sociais contra personagens Moderados. Enquanto você estiver perfeitamente saciado, rolagens que causam alteração de humor são roladas com desvantagem contra você." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Moderado" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Moderado' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Moderado");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="22">
                                <label align="left" width="220" text="Moderado" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <label align="client" text="oposto: Glutão" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Expectativa de vida 10% maior, personagens moderados possuem uma chance maior de serem bem sucedidos em ações que envolvam administração e possui desvantagem em testes sociais contra personagens Glutões." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Ganancioso" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Ganancioso' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Ganancioso");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="22">
                                <label align="left" width="220" text="Ganancioso" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <label align="client" text="oposto: Generoso" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Sempre que houver a oportunidade de você obter algum lucro numa missão, pacto ou acordo você irá lutar para obtê-lo, por vezes se colocando em risco por isso, aumente em 10% todo lucro monetário obtido, entretanto reduza em 20% todo lucro relacionado a contratos estabelecidos. Você terá desvantagem em testes sociais contra Seguidores do Supremo." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Generoso" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Generoso' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Generoso");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="22">
                                <label align="left" width="220" text="Generoso" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <label align="client" text="oposto: Ganancioso" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Você obrigatoriamente doa 10% de todo o ouro que recebe por estação para aqueles que precisam, personagens generosos possuem uma chance maior em serem bem sucedidos em ações que envolvam diplomacia e discursos, além de serem bem vistos por aqueles que vivem no local que recebe suas doações." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Preguicoso" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Preguiçoso' para o personagem">
