                    </layout>
                    <layout name="edIt_grupoabsorcao" align="top" height="76">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" margins="{bottom=8}">
                            <layout align="client" margins="{left=14,right=14,top=4,bottom=6}">
                                <label align="top" height="18" text="PROTEÇÃO, CARGA E MOVIMENTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="46">
                                    <layout align="left" width="140" margins="{right=10}">
                                        <label align="top" height="14" text="ABSORÇÃO (%)" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Percentual de dano absorvido"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_absorcao" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Percentual de dano absorvido"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="160" margins="{right=10}">
