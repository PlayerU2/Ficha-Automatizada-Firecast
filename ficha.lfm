    <popup name="popCriatura" width="1000" height="760" backOpacity="0.8" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=20,right=20,top=16,bottom=16}">
                <label align="top" height="26" text="FICHA DA CRIATURA" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=10}" hitTest="false"/>

                <layout align="bottom" height="34" margins="{top=12}">
                    <rectangle align="left" width="190" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{right=12}" cursor="handPoint" hint="Fechar sem salvar. As classificações já trocadas ficam; os números não.">
                        <label align="client" text="CANCELAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        <event name="onClick"><![CDATA[fecharEditorCriatura();]]></event>
                    </rectangle>
                    <label name="edCri_lblAviso" align="client" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" wordWrap="true" margins="{left=6,right=6}" hitTest="false"/>
                    <rectangle align="right" width="230" color="#12181C" strokeColor="#C9A24B" strokeSize="2" xradius="3" yradius="3" cursor="handPoint" hint="Gravar esta criatura na ficha">
                        <label align="client" text="SALVAR E FECHAR" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        <event name="onClick"><![CDATA[salvarEditorCriatura();]]></event>
                    </rectangle>
                </layout>

                <!-- O QUE FICOU PARA VOCE, numa COLUNA AO LADO dos campos
                     (v0.42.1, T-03). Ate a v0.41.1 a caixa abria DENTRO do
                     scrollBox, acima dos campos: em 1366×768 ela empurrava
                     para fora da tela justamente os atributos que mandava
                     preencher. Agora abre a direita, com rolagem propria, e
                     os campos continuam visiveis. Largura 0 esconde. -->
                <layout name="edCri_colInstrucoes" align="right" width="0">
                    <rectangle align="client" color="#12181C" strokeColor="#8A63C9" strokeSize="1" xradius="5" yradius="5" margins="{left=14}" hitTest="false">
                        <scrollBox align="client" margins="{left=10,right=6,top=8,bottom=8}">
                            <label name="edCri_lblInstrucoes" align="top" height="400" text="" fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true" vertTextAlign="leading" hitTest="false"/>
                        </scrollBox>
                    </rectangle>
                </layout>
                <scrollBox align="client">

                    <label align="top" height="16" text="NOME" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" margins="{bottom=2}" hitTest="false"/>
                    <rectangle align="top" height="30" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{bottom=10}">
                        <edit name="edCri_nome" align="client" text="" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="14" transparent="true" margins="{left=10,right=10}" hint="Como a mesa chama esta criatura"/>
                    </rectangle>

                    <label align="top" height="16" text="CLASSIFICA&#199;&#213;ES DO BESTI&#193;RIO" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" margins="{bottom=4}" hitTest="false"/>
                    <layout align="top" height="52">
                            <layout align="left" width="196" margins="{right=8,bottom=8}">
                                <label align="top" height="14" text="PAPEL NA MESA" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <rectangle align="top" height="30" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <rectangle align="left" width="26" color="#12181C" strokeSize="0" xradius="3" yradius="3" cursor="handPoint" hint="Anterior">
                                        <label align="client" text="&#9664;" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[ciclarPapelCriatura(-1);]]></event>
                                    </rectangle>
                                    <rectangle align="right" width="26" color="#12181C" strokeSize="0" xradius="3" yradius="3" cursor="handPoint" hint="Próximo">
                                        <label align="client" text="&#9654;" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[ciclarPapelCriatura(1);]]></event>
                                    </rectangle>
                                    <label name="edCri_lblPapel" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                </rectangle>
                            </layout>
                            <layout align="left" width="196" margins="{right=8,bottom=8}">
                                <label align="top" height="14" text="TAMANHO" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <rectangle align="top" height="30" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
