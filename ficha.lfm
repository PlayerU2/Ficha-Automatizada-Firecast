                            <rectangle name="popCatalogoQualidades_secEfeito" align="top" height="300" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                    <label align="top" height="20" text="EFEITO" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="12" margins="{bottom=4}"/>
                                    <label name="popCatalogoQualidades_lblEfeito" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                            <rectangle name="popCatalogoQualidades_secRestricao" align="top" height="140" color="#0B1014" strokeColor="#5A2028" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                    <label align="top" height="20" text="RESTRIÇÃO" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="12" margins="{bottom=4}"/>
                                    <label name="popCatalogoQualidades_lblRestricao" align="client" text="" fontFamily="EB Garamond" fontColor="#E2AEB6" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                            <rectangle name="popCatalogoQualidades_secAutomacao" align="top" height="110" color="#0B1014" strokeColor="#2A4652" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                    <label align="top" height="20" text="AUTOMAÇÃO NA FICHA" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="12" margins="{bottom=4}"/>
                                    <label name="popCatalogoQualidades_lblAutomacao" align="client" text="" fontFamily="EB Garamond" fontColor="#B9D3DD" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                        </scrollBox>

                        <rectangle align="bottom" height="106" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                            <layout align="client" margins="{left=10,right=10,top=8,bottom=8}">
                                <label name="popCatalogoQualidades_lblJaPossui" align="top" height="16" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{bottom=4}"/>

                                <layout align="top" height="24" margins="{bottom=6}">
                                    <checkBox name="popCatalogoQualidades_chkGratis" align="left" width="22" cursor="handPoint" hint="Se marcado, o tier escolhido abaixo é concedido de graça (não gasta PQ)"/>
                                    <label align="client" text="Concedido pelo mestre (não gasta PQ - ex.: recompensa de narrativa/dungeon)" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11" vertTextAlign="center" margins="{left=6}"/>
                                </layout>

                                <layout align="top" height="34" margins="{bottom=6}">
                                    <label align="left" width="118" text="TIER DESEJADO:" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                                <rectangle name="popCatalogoQualidades_btnTier1" align="left" width="66" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoQualidades", 1);]]></event>
                                    <label name="popCatalogoQualidades_lblTier1" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popCatalogoQualidades_btnTier2" align="left" width="66" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoQualidades", 2);]]></event>
                                    <label name="popCatalogoQualidades_lblTier2" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popCatalogoQualidades_btnTier3" align="left" width="66" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoQualidades", 3);]]></event>
                                    <label name="popCatalogoQualidades_lblTier3" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popCatalogoQualidades_btnTier4" align="left" width="66" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" visible="false" cursor="handPoint" hint="Adicionar/atualizar a ficha com esta pontuação">
                                    <event name="onClick"><![CDATA[confirmarAdicaoQD("popCatalogoQualidades", 4);]]></event>
                                    <label name="popCatalogoQualidades_lblTier4" align="client" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                    <rectangle name="popCatalogoQualidades_rectFaixa" align="left" width="150" color="#0A0C10" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" visible="false">
                                        <layout align="client" margins="{left=6,right=6}">
                                            <label align="left" width="46" text="PONTOS" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                                            <edit name="popCatalogoQualidades_editFaixa" align="client" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" vertTextAlign="center"/>
                                        </layout>
                                    </rectangle>
                                    <rectangle name="popCatalogoQualidades_btnFaixaConfirmar" align="left" width="90" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" visible="false" margins="{left=6}" cursor="handPoint" hint="Adicionar/atualizar a ficha com a pontuação digitada">
                                        <event name="onClick"><![CDATA[confirmarAdicaoQDFaixa("popCatalogoQualidades");]]></event>
                                        <label align="client" text="Confirmar" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    </rectangle>
                                </layout>
                                <layout align="client">
                                    <rectangle align="right" width="90" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fechar esta janela">
                                        <event name="onClick"><![CDATA[self.popCatalogoQualidades:close();]]></event>
                                        <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    </rectangle>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>
                </layout>
            </layout>
        </rectangle>
    </popup>

    <popup name="popCatalogoDefeitos" width="920" height="600" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8B2332" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="DEFEITOS • CATÁLOGO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
