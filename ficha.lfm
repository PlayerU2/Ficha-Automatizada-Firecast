                    <rectangle name="popSlot_btnsaque" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblsaque" align="client" text="SAQUE RÁPIDO" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        <event name="onClick"><![CDATA[confirmarSlot("saque");]]></event>
                    </rectangle>
                    <rectangle name="popSlot_btnbolso1" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblbolso1" align="client" text="BOLSO 1" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
