                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapPv" align="left" width="196">
                        <rectangle name="cmb_secPv" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#9E3B4A" hitTest="false"/>
                            <label align="top" height="26" text="PONTOS DE VITAE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="10 + (Constituição × 1,5) + (Rank × 30). Apenas vampiros."/>
