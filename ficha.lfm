<?xml version="1.0" encoding="UTF-8"?>
<!--
  FICHA DE PERSONAGEM - PETRICHOR
  Versao: 0.2.0

  IDENTIDADE VISUAL
    Paleta inspirada no proprio nome da mesa: petrichor, o cheiro de chuva
    na terra seca. Ardosia molhada quase preta no fundo, verdete de musgo,
    azul-chuva, ouro velho para o divino, violeta para a Aura e vinho para
    vida/sangue.
      fundo      #070A0C      painel     #0D1317
      painelAlt  #111A1E      borda      #22323A
      bordaSuave #1A262C      ouro       #C9A24B
      aura       #8A63C9      vinho      #8B2332
      musgo      #4E8C74      chuva      #7FA8B8
      texto      #E6E9E4      rotulo     #8C9AA0

  NAVEGACAO
    O <tabControl> padrao foi substituido por uma barra de abas propria
    (retangulos clicaveis + troca de visibilidade dos paineis), para permitir
    numeracao, marcador inferior e cores de estado personalizadas.

  PADRAO DE CODIGO (ver Main_lfm.lua de referencia):
    - Eventos sao elementos filhos <event name="onClick">...</event>.
    - "self" (form) e "sheet" (no de dados) ja existem no escopo; nunca
      declarar como parametro de funcao.
    - Popups: :show() / :close().
    - recordList: field= + templateForm= + itemHeight=; criar item com
      self.lista:append(); remover com NDB.deleteNode(sheet).
    - <layout g="row"> solto dentro de scrollBox precisa de align="top" e
      height explicitos, senao colapsa e sobrepoe o conteudo.
-->
<form name="frmFichaPetrichor" formType="sheetTemplate" dataType="com.petrichor.fichapersonagem.Ficha" title="Petrichor" theme="dark">
    <script><![CDATA[
        -- Bibliotecas do SDK. "rrpg.lua" e necessaria para descobrir a mesa /
        -- o jogador atual (usado em usuarioEhMestre).
        require("ndb.lua")
        require("rrpg.lua")
        require("firecast.lua")

        local DadosSistema = require("dadosSistema.lua")
        local Calculos = require("calculos.lua")
        local CatalogoPericias = require("catalogoPericias.lua")
        local CatalogoQD = require("catalogoQualidadesDefeitos.lua")
        local CatalogoRacas = require("catalogoRacas.lua")
        local CatalogoBestiario = require("catalogoBestiario.lua")
        local CatalogoClasses = require("catalogoClasses.lua")
        local CatalogoDeuses = require("catalogoDeuses.lua")
        local CatalogoPoderes = require("catalogoPoderes.lua")
        local CatalogoHabilidades = require("catalogoHabilidades.lua")
        local CatalogoItens = require("catalogoItens.lua")
        local CatalogoEncantamentos = require("catalogoEncantamentos.lua")
        local CatalogoProgressiva = require("catalogoProgressiva.lua")

        -- Paleta usada por todo o script. Precisa ser declarada ANTES de
        -- qualquer funcao que a use: "local" em Lua so existe a partir da
        -- linha da declaracao.
        local COR = {
            bg = "#070A0C", panel = "#0D1317", panelAlt = "#111A1E",
            line = "#22323A", lineSoft = "#1A262C", gold = "#C9A24B",
            aura = "#8A63C9", wine = "#8B2332", moss = "#4E8C74",
            rain = "#7FA8B8", text = "#E6E9E4", muted = "#8C9AA0",
            faint = "#5F7078",
        }

        local CatalogoTracos = require("catalogoTracos.lua")

        local function n(v)
            return tonumber(v) or 0
        end

        -- Numero para a tela, em portugues: 6 vira "6", 6.5 vira "6,5".
        -- Sem isto o Lua escreve "6.5" e "115.0" nas contas dos cards.
        local function fmtNumero(v)
            v = n(v)
            if v == math.floor(v) then return tostring(math.floor(v)) end
            return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", ""):gsub("%.", ","))
        end

        -- Utilitario de uso geral: parte um texto pelos separadores.
        -- DECLARADO AQUI NO TOPO de proposito: em Lua uma "local" so existe
        -- a partir da linha em que aparece, e secoes bem acima no arquivo
        -- dependem dela. Estando no meio, quem vinha antes enxergava nil.
        local function partirTexto(texto, sep)
            local r = {}
            for parte in string.gmatch(tostring(texto or ""), "([^" .. sep .. "]+)") do
                table.insert(r, parte)
            end
            return r
        end

        -- =================================================================
        -- PERMISSAO: O USUARIO ATUAL E MESTRE DA MESA?
        --
        -- Padrao oficial do SDK (ver "Fazer uma ficha enviar rolagens"):
        --   rrpg.getPersonagemDe(sheet) -> personagem.mesa.meuJogador.isMestre
        -- Envolvido em pcall porque a ficha pode estar sendo aberta fora de
        -- uma mesa (ex.: editor da biblioteca), quando nao existe "mesa".
        -- Nesse caso devolvemos "true" para nao travar quem esta montando a
        -- ficha sozinho; o bloqueio real vale quando ha mesa de verdade.
        -- =================================================================
        -- =================================================================
        -- TRAVA DE CRIACAO
        --
        -- Depois que o jogador marca a ficha como FINALIZADA, as areas de
        -- criacao (Qualidades & Defeitos, Raca e Favores Divinos) ficam
        -- somente-leitura para ele. O MESTRE continua podendo alterar tudo,
        -- e so o mestre consegue destravar a ficha de volta.
        -- =================================================================
        function fichaEstaFinalizada()
            return sheet ~= nil and sheet.fichaFinalizada == true
        end

        function podeEditarCriacao()
            if not fichaEstaFinalizada() then return true end
            return usuarioEhMestre()
        end


        -- ---------------------------------------------------------------
        -- O QUE A TRAVA ALCANCA
        --
        -- Finalizar a ficha fecha a CRIACAO do personagem: atributos, racial,
        -- pericias, poderes, favores, e a identidade dos itens.
        --
        -- Nao fecha o que muda DURANTE o jogo: equipar e desequipar, gastar
        -- municao, mover coisas para a mochila ou o bau, consumir pocao.
        -- Travar isso obrigaria a chamar o mestre a cada troca de arma.
        -- ---------------------------------------------------------------
        function podeEditarItemNaCriacao()
            return podeEditarCriacao()
        end

        -- Mensagem padrao mostrada quando a edicao e barrada.
        function motivoTravaCriacao()
            return "Ficha finalizada: esta área só pode ser alterada pelo MESTRE. Peça ao narrador, ou peça para destravar a ficha."
        end

        function alternarFichaFinalizada()
            if sheet == nil then return end
            -- Finalizar: qualquer um pode. Destravar: so o mestre.
            if fichaEstaFinalizada() and not usuarioEhMestre() then
                atualizarSeloFinalizada("Somente o MESTRE pode destravar a ficha.")
                return
            end
            sheet.fichaFinalizada = not fichaEstaFinalizada()
            atualizarSeloFinalizada()
            atualizarBlocoRaca()
            atualizarPainelPontosQD()
            -- a trava dos campos ligados ao NDB acompanha o selo na hora,
            -- sem esperar o proximo recalculo
            pcall(function() aplicarTravaDeCriacao() end)
        end

        -- ---------------------------------------------------------------
        -- A TRAVA DOS CAMPOS LIGADOS DIRETO AO NDB (v0.42.1)
        --
        -- A ficha grava dado por dois caminhos. Botao, popup e catalogo
        -- passam por uma funcao Lua, e la podeEditarCriacao() barra o
        -- jogador (30 chamadas). Um <edit field="x"> NAO passa por Lua:
        -- o widget escreve direto no no. Para esses, a unica trava possivel
        -- e desabilitar o widget - e ate a v0.41.1 so os sete atributos base
        -- recebiam isso. NIVEL, IDADE, ANIVERSARIO, RACA, CLASSE e os dois
        -- campos rotulados "AJUSTE DO MESTRE" continuavam livres com a
        -- ficha finalizada. Seis deles nem tinham name=, entao o Lua nao
        -- os alcancava nem para desabilitar.
        --
        -- LISTA UNICA. A checagem 42 do verifica.py le esta tabela e o XML
        -- e falha o build se um <edit field="..."> de campo de criacao
        -- estiver fora dela ou sem o name= que ela cita. Campo novo de
        -- criacao entra AQUI, ou o build cai - comentario nao e guarda-corpo.
        --
        -- O que NAO esta aqui, e por que:
        --   * experiencia - DECISAO DA MESA (05/09/2026): o mestre concede
        --     XP em narrativa e o JOGADOR anota; o nivel sobe sozinho. Se
        --     o XP travasse, o mestre teria de abrir cada ficha para lancar.
        --   * os campos de BONUS e os ajustes MANUAIS de pericia e dos
        --     cards de combate - mudam em jogo (item, feitico, bencao).
        --   * ajusteHp/ajusteAp e afins - valvula do mestre em jogo.
        --
        -- sempre = true: trava para TODO MUNDO, inclusive o mestre, porque o
        -- dono do campo e o catalogo (aba 04) e nao a digitacao. RACA e a
        -- CHAVE que o codigo usa para achar a raca no catalogo: "orcs" com
        -- minuscula perdia todas as concessoes raciais em silencio (B-10).
        CAMPOS_TRAVA_CRIACAO = {
            {widget = "edNivel",                 campo = "nivel", cor = "gold"},
            {widget = "edIdade",                 campo = "idade"},
            {widget = "edAniversario",           campo = "aniversario"},
            {widget = "edRaca",                  campo = "raca",   sempre = true},
            {widget = "edClasse",                campo = "classe", sempre = true},
            {widget = "abaAtr_edAjustePontos",   campo = "pontosAtributoAjuste"},
            {widget = "abaAtr_edAjustePericias", campo = "periciasAjuste"},
            {widget = "edBaseforca",             campo = "forcaBase"},
            {widget = "edBasedestreza",          campo = "destrezaBase"},
            {widget = "edBaseconstituicao",      campo = "constituicaoBase"},
            {widget = "edBaseinteligencia",      campo = "inteligenciaBase"},
            {widget = "edBasesabedoria",         campo = "sabedoriaBase"},
            {widget = "edBasecarisma",           campo = "carismaBase"},
            {widget = "edBasemanipulacao",       campo = "manipulacaoBase"},
        }

        -- A IRMA DECLARADA DA TABELA ACIMA.
        --
        -- Um <edit field=...> grava direto no NDB, sem passar por Lua, entao
        -- a unica trava possivel e setEnabled(false) - e para isso o widget
        -- precisa de name=. Dai o sinal que a checagem 53 usa: um campo do
        -- NDB que ganhou name= e um campo que alguem quis que o Lua
        -- alcancasse, e o unico motivo para alcancar um <edit field=> e
        -- habilitar ou desabilitar. Os 39 campos SEM name= sao ajustes
        -- comuns e ninguem pretende trava-los.
        --
        -- Entao todo campo do NDB COM name= tem de estar em uma das duas
        -- tabelas. Nao e para o caso do Ferido: e para a CLASSE "campo de
        -- jogo que alguem trancou por simetria" e para a irma dela, "campo
        -- de criacao que ninguem lembrou de trancar" - que foi o bug B-09,
        -- o jogador digitando NIVEL e IDADE com a ficha finalizada.
        --
        -- O motivo de cada entrada mora aqui, ao lado dela. Excecao sem
        -- motivo escrito e como uma checagem comeca a mentir.
        CAMPOS_LIVRES_EM_JOGO = {
            -- Decisao da mesa, 05/09/2026: o mestre concede XP em narrativa,
            -- o jogador anota, e o nivel sobe sozinho - inclusive com a ficha
            -- finalizada. O campo NIVEL, esse sim, e criacao e esta na trava.
            {widget = "edExperiencia",      campo = "experiencia"},
            -- Equipar, desequipar e mover na mochila sao jogo; o teto da
            -- mochila tem ajuste porque a mesa concede espaco por narrativa.
            {widget = "cmb_edMochilaBonus", campo = "mochilaBonus"},
            -- Pontos de poder concedidos por favor divino ou por narrativa:
            -- e campo do MESTRE, e ele os concede com a ficha ja fechada.
            {widget = "abaPod_edConcedidos", campo = "poderPontosConcedidos"},
            -- Link do background: anotacao, nunca regra.
            {widget = "abaBg_edLink",       campo = "bgLink"},
            -- Sangue bebido (v0.48.0): quantos ml o vampiro bebeu. Beber e
            -- jogo, como gastar municao ou marcar dano.
            {widget = "cmb_edSangueMl",     campo = "sangueBebidoMl"},
            -- Ajuste do Ferido (v0.48.0): marcar ferimento e JOGO, e o
            -- mestre precisa poder sobrepor a penalidade no meio da sessao.
            -- Travar este campo entregaria metade da regra.
            {widget = "cmb_edAjusteFerido", campo = "ajusteFerido"},
            -- As cinco barras ganharam ATUAL em 06/09/2026. Marcar dano,
            -- gastar aura e beber sangue sao jogo — a mesma familia de
            -- "equipar, gastar municao, marcar dano" que o metodo ja
            -- classificava como livre. Travar qualquer um destes deixaria
            -- a mesa sem como registrar o que acontece na sessao.
            {widget = "cmb_edAtualHp",      campo = "hpAtual"},
            {widget = "cmb_edAtualAp",      campo = "apAtual"},
            {widget = "cmb_edAtualMp",      campo = "mpAtual"},
            {widget = "cmb_edAtualPrana",   campo = "pranaAtual"},
            {widget = "cmb_edAtualPv",      campo = "pvAtual"},
        }

        function aplicarTravaDeCriacao()
            local pode = podeEditarCriacao()
            for _, e in ipairs(CAMPOS_TRAVA_CRIACAO) do
                local w = self[e.widget]
                if w ~= nil then
                    local livre = pode and not e.sempre
                    pcall(function() w:setEnabled(livre) end)
                    -- Os campos do catalogo continuam legiveis com a cor
                    -- normal: sao informacao, nao campo apagado.
                    if not e.sempre then
                        pcall(function() w:setFontColor(livre and (COR[e.cor or "text"] or COR.text) or COR.faint) end)
                    end
                end
            end
        end

        -- Nome antigo, mantido para quem ainda chama.
        function aplicarTravaAtributos()
            aplicarTravaDeCriacao()
        end

        function atualizarSeloFinalizada(avisoTemporario)
            if self.lblSeloFinalizada == nil then return end
            if avisoTemporario ~= nil then
                self.lblSeloFinalizada:setText(avisoTemporario)
                self.lblSeloFinalizada:setFontColor(COR.wine)
                return
            end
            if fichaEstaFinalizada() then
                self.lblSeloFinalizada:setText("FICHA FINALIZADA")
                self.lblSeloFinalizada:setFontColor(COR.gold)
                if self.rectSeloFinalizada ~= nil then self.rectSeloFinalizada:setStrokeColor(COR.gold) end
            else
                self.lblSeloFinalizada:setText("EM CRIAÇÃO")
                self.lblSeloFinalizada:setFontColor(COR.moss)
                if self.rectSeloFinalizada ~= nil then self.rectSeloFinalizada:setStrokeColor(COR.moss) end
            end
        end

        function usuarioEhMestre()
            local ok, resultado = pcall(function()
                local personagem = rrpg.getPersonagemDe(sheet)
                if personagem == nil then return true end
                local mesa = personagem.mesa
                if mesa == nil or mesa.meuJogador == nil then return true end
                return mesa.meuJogador.isMestre == true
            end)
            if not ok then return true end
            return resultado
        end

        -- Extrai o numero do INICIO de um texto livre, ex.: "18 anos" -> 18,
        -- "cerca de 300" -> nil (nao comeca com digito, cai no 0). Usado para
        -- campos como "idade" que agora aceitam texto livre.
        local function numeroInicial(v)
            if v == nil then return 0 end
            local texto = tostring(v)
            local digitos = texto:match("^%s*(%d+)")
            return tonumber(digitos) or 0
        end

        -- =================================================================
        -- NAVEGACAO POR ABAS CUSTOMIZADAS
        -- =================================================================
        local abaAtual = 1
        local abasDef = {
            {painel="pnlAba1", botao="btnAba1", num="lblNumAba1", tit="lblTitAba1", marc="marcAba1", ico="icoAba1", icoOff="imagens/aba_01_inativa.png", icoOn="imagens/aba_01_ativa.png", nome="DADOS PESSOAIS"},
            {painel="pnlAba2", botao="btnAba2", num="lblNumAba2", tit="lblTitAba2", marc="marcAba2", ico="icoAba2", icoOff="imagens/aba_02_inativa.png", icoOn="imagens/aba_02_ativa.png", nome="ATRIBUTOS & PERÍCIAS"},
            {painel="pnlAba4", botao="btnAba3", num="lblNumAba3", tit="lblTitAba3", marc="marcAba3", ico="icoAba3", icoOff="imagens/aba_03_inativa.png", icoOn="imagens/aba_03_ativa.png", nome="QUALIDADES & DEFEITOS"},
            {painel="pnlAba5", botao="btnAba4", num="lblNumAba4", tit="lblTitAba4", marc="marcAba4", ico="icoAba4", icoOff="imagens/aba_04_inativa.png", icoOn="imagens/aba_04_ativa.png", nome="RAÇA & CLASSE"},
            {painel="pnlAba6", botao="btnAba5", num="lblNumAba5", tit="lblTitAba5", marc="marcAba5", ico="icoAba5", icoOff="imagens/aba_05_inativa.png", icoOn="imagens/aba_05_ativa.png", nome="PODERES & HABILIDADES"},
            {painel="pnlAba3", botao="btnAba6", num="lblNumAba6", tit="lblTitAba6", marc="marcAba6", ico="icoAba6", icoOff="imagens/aba_06_inativa.png", icoOn="imagens/aba_06_ativa.png", nome="CÁLCULOS & COMBATE"},
            {painel="pnlAba8", botao="btnAba7", num="lblNumAba7", tit="lblTitAba7", marc="marcAba7", ico="icoAba7", icoOff="imagens/aba_07_inativa.png", icoOn="imagens/aba_07_ativa.png", nome="INVENTÁRIO"},
            -- ORDEM DAS ABAS (v0.38.3, pedido da mesa): Criaturas passou para
            -- a 08, logo depois do Inventario, e Favores/Background desceram.
            -- Repare que "painel" NAO segue a numeracao: pnlAba10 e a aba de
            -- Criaturas, e agora ela mora na posicao 8. A posicao e o indice
            -- desta tabela; o nome do painel e so historico de quando ele foi
            -- criado. Mexer aqui e mexer no rotulo do XML e suficiente - nao
            -- ha nada mais no arquivo que dependa da ordem.
            {painel="pnlAba10", botao="btnAba8", num="lblNumAba8", tit="lblTitAba8", marc="marcAba8", ico="icoAba8", icoOff="imagens/aba_08_inativa.png", icoOn="imagens/aba_08_ativa.png", nome="CRIATURAS"},
            {painel="pnlAba7", botao="btnAba9", num="lblNumAba9", tit="lblTitAba9", marc="marcAba9", ico="icoAba9", icoOff="imagens/aba_09_inativa.png", icoOn="imagens/aba_09_ativa.png", nome="FAVORES DIVINOS"},
            {painel="pnlAba9", botao="btnAba10", num="lblNumAba10", tit="lblTitAba10", marc="marcAba10", ico="icoAba10", icoOff="imagens/aba_10_inativa.png", icoOn="imagens/aba_10_ativa.png", nome="BACKGROUND"}
        }

        local function atualizarNavegacao()
            for indice, def in ipairs(abasDef) do
                local ativo = (indice == abaAtual)
                local painel = self[def.painel]
                local botao  = self[def.botao]
                local num    = self[def.num]
                local tit    = self[def.tit]
                local marc   = self[def.marc]
                if painel ~= nil then
                    painel:setVisible(ativo)
                    painel:setEnabled(ativo)
                end
                if botao ~= nil then
                    botao:setColor(ativo and COR.panelAlt or COR.panel)
                    botao:setStrokeColor(ativo and COR.gold or COR.lineSoft)
                    botao:setStrokeSize(ativo and 2 or 1)
                end
                if num ~= nil then num:setFontColor(ativo and COR.gold or COR.faint) end
                if tit ~= nil then tit:setFontColor(ativo and COR.text or COR.muted) end
                if marc ~= nil then marc:setVisible(ativo) end
                -- Icone da aba: dois PNGs, um por estado, recoloridos no
                -- gerador com o hex exato da ficha (inativa #8C9AA0, ativa
                -- #C9A24B). A sonda v1.1 provou o caminho relativo a raiz
                -- do plugin e que originalSize e nitido a 22px.
                local ico = self[def.ico]
                if ico ~= nil and def.icoOn ~= nil then
                    pcall(function() ico.src = ativo and def.icoOn or def.icoOff end)
                end
            end
            if self.lblSecaoAtual ~= nil then
                self.lblSecaoAtual:setText(string.format("SEÇÃO %02d  •  %s", abaAtual, abasDef[abaAtual].nome))
            end
            if self.lblSecaoContador ~= nil then
                self.lblSecaoContador:setText(tostring(abaAtual) .. " / " .. tostring(#abasDef))
            end
        end

        function ativarAba(indice)
            indice = math.max(1, math.min(#abasDef, math.floor(tonumber(indice) or 1)))
            abaAtual = indice
            atualizarNavegacao()
            repararNosAntigos()
            atualizarContadoresPericias()
            -- A aba de Combate so ganha largura real quando fica visivel;
            -- e o momento certo de redistribuir os cards.
            pcall(function() ajustarGradeCombate() end)
            atualizarBlocoRaca()
            atualizarBlocoClasse()
        end

        -- =================================================================
        -- RECALCULO GERAL
        -- =================================================================
        local recalculando = false

        -- AS CONTAS SAO MONTADAS AQUI, JUNTO DO VALOR (v0.42.1).
        --
        -- Ate a v0.41.1 a linha "de onde veio o numero" era REMONTADA em
        -- atualizarAbaCombate() a partir das parcelas que ela lembrava - e
        -- ela esquecia: a penalidade da armadura sumia da conta do
        -- deslocamento (16 na conta, 6 no card), a conta da mana imprimia a
        -- IDADE no lugar da mana acumulada por idade (77 na conta, 132 no
        -- card), e nenhuma conta mostrava o ajuste manual nem a forma
        -- bestial. Conta que nao fecha e pior do que conta nenhuma: o
        -- jogador conclui que a FICHA esta errada.
        --
        -- Agora cada conta e escrita no mesmo lugar em que o valor e
        -- calculado, com as mesmas variaveis. atualizarAbaCombate() so
        -- copia o texto para o rotulo. A bateria de testes le estas contas,
        -- avalia a aritmetica delas e exige que feche com o valor - por
        -- isso a gramatica e fixa: numeros, "+", "−", "×", "÷", parenteses
        -- de conta, e palavras soltas (que sao rotulo e nao contam).
        -- Texto entre colchetes [assim] e anotacao: a bateria ignora.
        CONTAS = {}

        -- " + rotulo 3" ou " − rotulo 3": parcela com sinal, so quando existe.
        local function parcela(v, rotulo)
            v = n(v)
            if v == 0 then return "" end
            if v < 0 then return " − " .. rotulo .. " " .. fmtNumero(-v) end
            return " + " .. rotulo .. " " .. fmtNumero(v)
        end

        -- ===============================================================
        -- FERIDO (v0.48.0)
        -- ===============================================================
        -- LIVRO, [2.3] "Ferimentos", verbatim:
        --
        --   "Quando um personagem sofre um golpe que lhe aplica pelo menos
        --    30% de sua vida maxima como dano, este recebera a condicao
        --    'Ferido', que lhe trara consequencias significantes a depender
        --    da situacao e da narracao, conforme abaixo:
        --    -> 30% da vida maxima em um golpe - Ferido I: a area do golpe
        --       fica quebrada ou danificada; Recupera 30% da vida maxima por
        --       dia, ao inves do valor padrao; -2 em todos os testes.
        --    -> 60% da vida maxima em um golpe - Ferido II: a area do golpe
        --       fica esmagada ou triturada; Recupera 20% da vida maxima por
        --       dia, ao inves do valor padrao; -4 em todos os testes.
        --    -> 90% da vida maxima em um golpe - Ferido III: sofre amputacao
        --       da area impactada; Recupera 10% da vida maxima por dia, ao
        --       inves do valor padrao; -7 em todos os testes."
        --
        -- O gatilho e FRACAO DA VIDA MAXIMA e EM UM GOLPE - nao fracao da
        -- vida atual, e nao dano acumulado.
        --
        -- SUBSTITUI, NAO ACUMULA (mestre, 06/09/2026). O livro nao diz na
        -- tabela, mas sustenta: escreve "A condicao 'Ferido'" no singular, e
        -- o Ungento medicinal "Elimina UM NIVEL de ferimento" ([2.9]) - cura
        -- que remove nivel so faz sentido numa escada unica. Dois golpes, um
        -- de 30% e outro de 60%, deixam Ferido II; nao I e II somados.
        --
        -- "EM TODOS OS TESTES" INCLUI AS QUATRO DEFESAS (mestre, 06/09/2026).
        -- Isto CONTRARIA o vocabulario do proprio livro, e a divergencia fica
        -- registrada: na Lista de Condicoes de Estado o livro escreve
        -- "defesas" toda vez que quer inclui-las - Exausto: "todas as
        -- rolagens de qualquer natureza E DEFESAS"; Desnutrido: "todos os
        -- bonus E DEFESAS de natureza fisica" - e no Ferido nao escreve. O
        -- mestre manda sobre o livro, e mandou.
        --
        -- O GATILHO NAO E INFERIDO, DE PROPOSITO. A ficha nao ve golpes: ela
        -- ve um campo que alguem edita. Deduzir "caiu 41 pontos, logo foi um
        -- golpe de 41" quebra assim que o jogador digita 45 e corrige para 4.
        -- O nivel e MARCADO a mao; o que a ficha calcula sao os LIMIARES em
        -- pontos, que e a conta que ninguem quer fazer na mesa. Ha ainda duas
        -- rotas de gatilho que a ficha nunca vera: golpe em Orgaos-vitais com
        -- 60% aplica Ferido III direto ([2.3], Areas de acerto) e venenos
        -- podem "adicionar niveis de ferimento" ([2.8]).
        FERIDO = {
            [1] = {fracao = 0.30, penalidade = 2, recupera = 30, romano = "I"},
            [2] = {fracao = 0.60, penalidade = 4, recupera = 20, romano = "II"},
            [3] = {fracao = 0.90, penalidade = 7, recupera = 10, romano = "III"},
        }

        -- A barra que o Ferido mede.
        --
        -- DECISAO DA MESA, 06/09/2026: o vampiro nao tem Vida - o Vitae E a
        -- vida dele -, entao os 30/60/90% saem do Vitae. Mora numa funcao so
        -- para que corrigir esta leitura, se ela mudar, seja UMA linha e nao
        -- uma varredura pela ficha inteira.
        function vidaMaximaParaFerimento()
            if sheet == nil then return 0 end
            if sheet.ehVampiro then return n(sheet.pv) end
            return n(sheet.hp)
        end

        -- O nivel, saturado em 0..3. Saturar aqui (e nao no campo) e o que
        -- impede um valor velho ou digitado fora da faixa de indexar FERIDO
        -- com nil e derrubar o recalculo inteiro.
        function nivelFerido()
            if sheet == nil then return 0 end
            local v = math.floor(n(sheet.feridoNivel))
            if v < 0 then return 0 end
            if v > 3 then return 3 end
            return v
        end

        -- MARCAR FERIDO E JOGO, NAO CRIACAO. Nao passa por <edit field=>:
        -- e escrito por esta funcao, entao a trava de finalizar nao tem o
        -- que desabilitar. A checagem 53 cobra que o campo de AJUSTE, esse
        -- sim ligado ao NDB, esteja declarado como livre.
        function mudarNivelFerido(delta)
            if sheet == nil then return end
            local novo = nivelFerido() + n(delta)
            if novo < 0 then novo = 0 end
            if novo > 3 then novo = 3 end
            sheet.feridoNivel = novo
            recalcularTudo()
        end

        function penalidadeFerido()
            if sheet == nil then return 0 end
            local nv = nivelFerido()
            local base = (nv > 0) and FERIDO[nv].penalidade or 0
            -- O ajuste do mestre vale MESMO sem nivel: e a valvula de escape
            -- do metodo, e a mesa sempre tem um caso que o livro nao previu.
            -- Para ele nunca ser silencioso, a linha do card o mostra
            -- separado da penalidade da tabela.
            return base + n(sheet.ajusteFerido)
        end

        -- O dano que dispara cada nivel, em PONTOS. math.ceil porque o livro
        -- diz "pelo menos 30%": 23 num maximo de 77 sao 29,8% e nao bastam.
        function limiarFerido(nivel)
            local d = FERIDO[nivel]
            if d == nil then return 0 end
            return math.ceil(vidaMaximaParaFerimento() * d.fracao)
        end

        -- ===============================================================
        -- ATUAL x MAXIMO das cinco barras (v0.48.0)
        -- ===============================================================
        -- DECISAO DA MESA, 06/09/2026: "os mestres disseram que seria melhor
        -- ter um atual/maximo nesses campos (vida, aura, mana, prana, vitae)".
        --
        -- Ate aqui a ficha so tinha MAXIMOS - foi por isso que o card de
        -- sangue bebido e o de descanso nasceram apenas mostrando numeros:
        -- nao havia onde somar. Agora ha.
        --
        -- TRES REGRAS, e as tres sao decisao de mesa, nao do livro:
        --
        -- 1. FICHA ANTIGA NASCE CHEIA. Campo que nunca existiu vira o
        --    maximo. Sem isso toda ficha da mesa abriria com 0 de vida,
        --    aura e mana, e ninguem morto nao e ninguem jogando.
        --
        --    E um REPARO, nao um bloco de migracao de versao. Reparo escrito
        --    como elseif de migracao nunca roda para quem esta na versao
        --    antiga, que e a maioria - a regra ja custou caro neste projeto.
        --    Ele roda em TODA abertura e so faz alguma coisa uma vez.
        --
        --    A marca e uma STRING, e nao um booleano: o NDB ja devolveu
        --    booleano de mais de uma forma neste projeto, e um "true" que
        --    volta como 1 faria o reparo rodar de novo e encher a barra de
        --    quem estava ferido. E ela e necessaria porque campo vazio e
        --    indistinguivel de campo zerado: sem a marca, o personagem a 0
        --    de vida seria "curado" toda vez que abrisse a ficha.
        --
        -- 2. MAXIMO QUE MUDA LEVA O ATUAL JUNTO, PELA DIFERENCA. Subiu de
        --    nivel e ganhou 8 de vida maxima, ganha 8 de vida atual. Por
        --    isso o maximo anterior fica guardado: sem ele a unica opcao
        --    seria encher a barra, que apagaria o dano registrado toda vez
        --    que o mestre mexesse num ajuste no meio da sessao.
        --
        -- 3. PODE FICAR NEGATIVO. O livro NAO define regra de vida negativa
        --    - isto e decisao de mesa. O mestre ve o quanto o golpe passou
        --    de zero, que e informacao para os "testes de morte" que o
        --    [2.3] cita e nunca define. O card marca em vermelho.
        --
        -- O teto, esse sim, e duro: atual nunca passa do maximo.
        RECURSOS_COM_ATUAL = {
            {chave = "hp",    rotulo = "Vida"},
            {chave = "ap",    rotulo = "Aura"},
            {chave = "mp",    rotulo = "Mana"},
            {chave = "prana", rotulo = "Prana"},
            {chave = "pv",    rotulo = "Vitae"},
        }

        -- Roda no fim de cada recalculo, depois de os cinco maximos estarem
        -- prontos. RECONCILIA: nao cria-e-esquece.
        function reconciliarRecursosAtuais()
            if sheet == nil then return end
            local primeiraVez = (tostring(sheet.recursosAtuaisIniciados or "") ~= "1")
            -- Qual barra o detector de golpe observa: a mesma que o Ferido
            -- mede. No vampiro e o Vitae.
            local barraDoFerido = sheet.ehVampiro and "pv" or "hp"

            -- Move a base do detector junto com o atual. MUDANCA DE MAXIMO
            -- NAO E GOLPE: sem isto, perder uma qualidade que baixa o maximo
            -- derrubaria o atual junto e a ficha marcaria um Ferido que
            -- ninguem causou.
            local function moverBase(delta)
                local b = sheet.feridoVidaAnterior
                if b ~= nil and tostring(b) ~= "" then
                    sheet.feridoVidaAnterior = n(b) + delta
                end
            end

            for _, r in ipairs(RECURSOS_COM_ATUAL) do
                local maximo = n(sheet[r.chave])
                local cAtual = r.chave .. "Atual"
                local cAnt   = r.chave .. "MaxAnterior"
                if primeiraVez then
                    sheet[cAtual] = maximo
                else
                    local ant = sheet[cAnt]
                    if ant ~= nil and tostring(ant) ~= "" and n(ant) ~= maximo then
                        local delta = maximo - n(ant)
                        sheet[cAtual] = n(sheet[cAtual]) + delta
                        if r.chave == barraDoFerido then moverBase(delta) end
                    end
                end
                -- teto duro; piso nenhum, de proposito (regra 3 acima)
                if n(sheet[cAtual]) > maximo then
                    if r.chave == barraDoFerido then
                        moverBase(maximo - n(sheet[cAtual]))
                    end
                    sheet[cAtual] = maximo
                end
                sheet[cAnt] = maximo
            end
            if primeiraVez then
                sheet.recursosAtuaisIniciados = "1"
                -- A base nasce junto com as barras: sem isto o primeiro
                -- recalculo leria a ficha inteira como um golpe.
                --
                -- E ela le o ATUAL, nao o maximo. No instante do reparo os
                -- dois valem o mesmo, entao o erro nao aparecia aqui - mas
                -- apareceria na primeira ficha que ja tivesse dano gravado.
                sheet.feridoVidaAnterior = n(sheet[barraDoFerido .. "Atual"])
            end
            detectarGolpeFerido()
        end

        -- O GOLPE, agora que existe vida ATUAL (mesa, 06/09/2026).
        --
        -- Ate aqui o nivel era so marcado a mao, porque a ficha nao via
        -- golpes - so maximos. Com o atual gravado, a QUEDA entre dois
        -- recalculos E o golpe, e o gatilho do livro ([2.3]: "um golpe que
        -- lhe aplica pelo menos 30% de sua vida maxima") fica automatico.
        --
        -- SO SOBE, NUNCA DESCE SOZINHO. Palavra do mestre, 06/09/2026:
        -- "mesmo se ele voltar a recuperar a vida por cura e etc, o ferido
        -- ainda continua, so com os descansos, pocao de unguento ou outra
        -- coisa especifica retira os estados de ferido". Entao curar nao
        -- mexe no nivel, e um golpe menor que o ferimento atual tambem nao:
        -- e a regra "substitui" andando so para cima.
        --
        -- O RISCO E REAL E FOI ACEITO: digitar 45 e corrigir para 4 registra
        -- uma queda de 41 e pode marcar um Ferido que nao aconteceu. E por
        -- isso que as setas continuam ali - o mestre desfaz em um clique.
        -- Preferir o falso positivo corrigivel ao falso negativo silencioso
        -- e a decisao, e ela esta escrita aqui para nao ser "corrigida"
        -- depois por quem so ver o sintoma.
        function detectarGolpeFerido()
            if sheet == nil then return end
            local barra = sheet.ehVampiro and "pvAtual" or "hpAtual"
            local atual = n(sheet[barra])
            local ant = sheet.feridoVidaAnterior
            if ant ~= nil and tostring(ant) ~= "" then
                local queda = n(ant) - atual
                if queda > 0 then
                    -- do maior para o menor: o golpe dispara o MAIOR nivel
                    -- que ele alcanca, e nao o primeiro
                    for nv = 3, 1, -1 do
                        local limiar = limiarFerido(nv)
                        if limiar > 0 and queda >= limiar then
                            if nv > nivelFerido() then sheet.feridoNivel = nv end
                            break
                        end
                    end
                end
            end
            sheet.feridoVidaAnterior = atual
        end

        -- ===============================================================
        -- DESCANSO (v0.48.0)
        -- ===============================================================
        -- LIVRO [2.3]: "Toda criatura recupera 30% de sua vida maxima quando
        -- realiza um 'Descanso Longo', ou seja, passa pelo menos vinte e
        -- quatro horas repousando focado em se recuperar. Tambem e possivel
        -- recuperar vida atraves do 'Descanso Curto', ficando 12 horas
        -- repousando e em troca recuperando 25% da vida maxima."
        --
        -- LIVRO [2.3]: "Um personagem recupera 50% de sua aura ou mana maxima
        -- quando realiza um 'Descanso Longo', e 25% em 'Descanso Curto'."
        --
        -- TRES QUALIDADES MEXEM AQUI, e ate a v0.48.0 nenhuma estava modelada
        -- porque o catalogo so guardava o percentual de TOTAL. O segundo
        -- efeito esta na MESMA FRASE do livro: "Vigor expandido" e "Vigor
        -- reprimido" mudam o ganho de VIDA por descanso, e "Aura expandida"
        -- muda o da AURA ("desta energia" - nao vale para a mana).
        --
        -- DECISOES DA MESA, 06/09/2026:
        --
        -- * O DESCANSO LONGO ZERA O FERIDO. O livro nao da numero para isso -
        --   as linhas de Ferimentos falam de recuperar VIDA, nao de remover
        --   nivel - entao e regra de mesa.
        --
        -- * A RECUPERACAO PROPRIA DO FERIDO SUBSTITUI o ganho do descanso
        --   longo: 30%, 20% ou 10% conforme o nivel, no lugar dos 30%
        --   padrao. Isso explica a frase do livro que parecia inofensiva -
        --   o Ferido I recuperar "30% por dia" e igual ao padrao por
        --   coincidencia; quem perde sao o II e o III.
        --
        -- * ORDEM: descansa FERIDO e depois sara. O ganho sai pelo percentual
        --   do nivel que a personagem tinha ao deitar; so entao o nivel vai a
        --   zero. Descansar ja curado inverteria a narrativa.
        --
        -- * O VAMPIRO NAO RECUPERA VITAE DESCANSANDO. [1.6], "[Sede de
        --   sangue]": "voce apenas recupera esta barra de energia se
        --   alimentando do sangue de outros seres vivos". Ele descansa (e
        --   sara o ferimento), mas a barra nao sobe.
        DESCANSO = {
            curto = {rotulo = "CURTO", horas = 12, vida = 25, energia = 25, saraFerido = false},
            longo = {rotulo = "LONGO", horas = 24, vida = 30, energia = 50, saraFerido = true},
        }

        -- Quanto um descanso rende, em PONTOS. O percentual da qualidade
        -- multiplica o GANHO, e nao o maximo: o livro diz "recupere 25% MAIS
        -- de vida por descanso", nao "tenha 25% mais de vida".
        function ganhoDescanso(maximo, percentBase, percentQualidade)
            local bruto = n(maximo) * (n(percentBase) / 100)
            bruto = bruto * (1 + n(percentQualidade) / 100)
            return math.floor(bruto + 0.5)
        end

        -- O percentual de VIDA de um descanso, ja com a substituicao do
        -- Ferido. Uma funcao so, porque a tela e o botao precisam do MESMO
        -- numero - card mostrando um valor e botao aplicando outro e a
        -- classe de bug que este projeto ja pagou com a conta do deslocamento.
        function percentVidaDescanso(tipo)
            local d = DESCANSO[tipo] or DESCANSO.longo
            local nv = nivelFerido()
            if d.saraFerido and nv > 0 then return FERIDO[nv].recupera end
            return d.vida
        end

        -- BEBER: converte o ml anotado em pontos de Vitae e ZERA o contador.
        -- [1.6], "[Sede de sangue]": "Cada 50ml recupera 1 ponto de Vitae".
        --
        -- Zerar o contador e o que impede o erro de somar duas vezes: sem
        -- isso, cada recalculo tentaria aplicar o mesmo copo de sangue de
        -- novo, e o jogador nao teria como saber quantos ja entraram. O
        -- resto que nao completa 50ml FICA no contador, porque ele e o
        -- registro de quanto sangue ja foi bebido sem virar ponto.
        function beberSangue()
            if sheet == nil or not sheet.ehVampiro then return end
            local ml = n(sheet.sangueBebidoMl)
            local pontos = math.floor(ml / 50)
            if pontos <= 0 then return end
            sheet.pvAtual = n(sheet.pvAtual) + pontos
            sheet.sangueBebidoMl = ml - (pontos * 50)
            recalcularTudo()
        end

        function aplicarDescanso(tipo)
            if sheet == nil then return end
            local d = DESCANSO[tipo] or DESCANSO.longo
            local ef = CatalogoQD.somarEfeitos(escolhidosQD())
            -- Vampiro nao recupera a barra dele descansando, mas descansa.
            if not sheet.ehVampiro then
                local ganho = ganhoDescanso(sheet.hp, percentVidaDescanso(tipo),
                                            ef.descansoHpPercent or 0)
                sheet.hpAtual = n(sheet.hpAtual) + ganho
                sheet.apAtual = n(sheet.apAtual) +
                    ganhoDescanso(sheet.ap, d.energia, ef.descansoApPercent or 0)
                if sheet.temCoracaoDeMana then
                    sheet.mpAtual = n(sheet.mpAtual) +
                        ganhoDescanso(sheet.mp, d.energia, 0)
                end
                if personagemEhBruxa() then
                    sheet.pranaAtual = n(sheet.pranaAtual) +
                        ganhoDescanso(sheet.prana, d.energia, ef.descansoApPercent or 0)
                end
            end
            -- e SO ENTAO o ferimento sara: o ganho acima ja saiu pelo
            -- percentual do nivel que a personagem tinha ao deitar
            if d.saraFerido then sheet.feridoNivel = 0 end
            recalcularTudo()
        end

        function recalcularTudo()
            if sheet == nil then return end
            if recalculando then return end
            recalculando = true

            -- Subida automatica de nivel por XP acumulada (nunca desce sozinho:
            -- o mestre pode reduzir o nivel na mao se precisar).
            local xpAtual = n(sheet.experiencia)
            local nivelPorXp = DadosSistema.nivelPorXP(xpAtual)
            if nivelPorXp > n(sheet.nivel) then
                sheet.nivel = nivelPorXp
            end

            -- NIVEL SATURADO DE VOLTA NO CAMPO (v0.42.1). O calculo sempre
            -- limitou o nivel a 1..20, mas o campo continuava com o que foi
            -- digitado: com "201" o Hp saia 65 (certo, nivel 20) e a conta
            -- embaixo dizia "(Con 4÷2 × 201)" - o numero certo com a
            -- explicacao errada, que e a pior combinacao. Agora o valor
            -- digitado e corrigido no proprio campo e a ficha AVISA, em vez
            -- de corrigir em silencio. Todos os que leem sheet.nivel passam
            -- a ver o valor limitado sem precisar saber do limite.
            local nivel = n(sheet.nivel)
            local nivelDigitado = nivel
            if nivel < 1 then nivel = 1 end
            if nivel > 20 then nivel = 20 end
            if nivel ~= nivelDigitado then
                sheet.nivel = nivel
                avisoNivelCorrigido = "Nível " .. fmtNumero(nivelDigitado) ..
                    " não existe: a ficha usa " .. nivel .. " (o sistema vai do 1 ao 20)."
            elseif nivelDigitado ~= math.floor(nivelDigitado) then
                nivel = math.floor(nivelDigitado)
                sheet.nivel = nivel
                avisoNivelCorrigido = "Nível " .. fmtNumero(nivelDigitado) ..
                    " não existe: a ficha usa " .. nivel .. "."
            else
                avisoNivelCorrigido = ""
            end
            if self.lblAvisoNivel ~= nil then
                self.lblAvisoNivel:setText(avisoNivelCorrigido)
            end

            -- Quem tem Mana, Prana e Vitae sai da propria ficha: qualidade
            -- "Coração de mana", "Linhagem de Unaris" e raça/característica
            -- de vampiro. Nao ha caixa de marcar para isso.
            pcall(function() sincronizarMarcadoresDeEnergia() end)

            -- Reavalia as concessoes a cada recalculo: trocar de raca troca as
            -- caracteristicas, e os bonus precisam entrar e sair junto.
            pcall(function() separarAutomacoesDoBonus() end)
            pcall(function() aplicarConcessoes() end)

            -- Hemocinese fica FORA da tabela CONCESSOES porque o nivel
            -- concedido cresce com o nivel do personagem (Orcs: marcos 5, 10,
            -- 15 e 20). Roda depois das concessoes, quando raca e
            -- caracteristicas ja estao estabilizadas.
            pcall(function() sincronizarHemocinese() end)

            -- Teto do valor BASE dos atributos (nivel + limite da raca).
            -- Roda antes dos calculos para os totais ja saírem corrigidos.
            local avisoLimite = ""
            pcall(function() avisoLimite = aplicarLimitesDeAtributo() end)
            if self.abaAtr_lblAvisoLimite ~= nil then
                self.abaAtr_lblAvisoLimite:setText(avisoLimite)
            end

            local dadosNivel = DadosSistema.dadosDoNivel(nivel)
            sheet.rank = dadosNivel.rank
            sheet.bonusProficiencia = dadosNivel.prof

            if self.lblRankValor ~= nil then self.lblRankValor:setText(dadosNivel.rank) end
            if self.lblProfValor ~= nil then self.lblProfValor:setText("+" .. tostring(dadosNivel.prof)) end
            if self.lblLimiteAtributoValor ~= nil then self.lblLimiteAtributoValor:setText(tostring(dadosNivel.limiteAtributo)) end

            -- XP do proximo nivel
            local xpProximo = DadosSistema.xpDoProximoNivel(nivel)
            if self.lblXpProximoValor ~= nil then
                if xpProximo == nil then
                    self.lblXpProximoValor:setText("MÁXIMO")
                else
                    self.lblXpProximoValor:setText(tostring(xpProximo))
                end
            end
            if self.lblXpFaltaValor ~= nil then
                if xpProximo == nil then
                    self.lblXpFaltaValor:setText("nível máximo atingido")
                else
                    local falta = xpProximo - xpAtual
                    if falta > 0 then
                        self.lblXpFaltaValor:setText("faltam " .. tostring(falta) .. " XP")
                    else
                        self.lblXpFaltaValor:setText("pronto para subir")
                    end
                end
            end

            -- TOTAIS DE ATRIBUTO: base + bonus + automacoes.
            --
            -- Sao DOIS numeros, e a diferenca entre eles e o Ferido:
            --
            --   valores[chave]  -- SEM o Ferido. E o que alimenta as formulas
            --                      derivadas: vida, aura, mana, deslocamento,
            --                      iniciativa e a base das defesas.
            --   <chave>Total    -- COM o Ferido. E o numero que aparece na
            --                      ficha e com o qual o jogador ROLA.
            --
            -- DECISAO DA MESA, 06/09/2026: "como o proprio ferido diz, ele
            -- influencia ROLAGENS, entao esses derivados nao sao
            -- influenciados". Sem essa separacao, Ferido II encolheria a vida
            -- maxima, a aura e o deslocamento junto -- e a vida maxima caindo
            -- puxaria a atual pela regra da diferenca, que e uma segunda
            -- punicao que ninguem pediu.
            --
            -- O Ferido continua descendo direto nas quatro defesas, mais
            -- abaixo. Ele NAO chega la por aqui: a base da defesa usa
            -- valores[], que e o valor limpo. Se um dia alguem trocar
            -- valores[] pelo Total, a penalidade passa a contar duas vezes.
            local atributos = {"carisma", "constituicao", "destreza", "forca", "inteligencia", "manipulacao", "sabedoria"}
            local valores = {}
            local penAtributo = penalidadeFerido()
            for _, chave in ipairs(atributos) do
                local concedido = n(sheet[chave .. "Concedido"])
                local limpo = n(sheet[chave .. "Base"]) + n(sheet[chave .. "Bonus"]) + concedido
                valores[chave] = limpo
                -- a coluna que a ficha mostra: o que ela automatizou, ja com
                -- o ferimento dentro
                sheet[chave .. "Auto"] = concedido - penAtributo
                -- <chave>Total continua sendo o valor LIMPO, e essa escolha
                -- e o coracao disto. Sete lugares o leem e NENHUM deles e
                -- rolagem: quantas pericias cabem no atributo, a conta das
                -- quatro defesas, o texto do deslocamento. Se a penalidade
                -- entrasse aqui, os sete passariam a mentir de uma vez -- e
                -- a defesa contaria o Ferido DUAS vezes, porque ele ja desce
                -- nela direto mais abaixo.
                sheet[chave .. "Total"] = limpo
                -- e este e o numero da TELA, com o qual o jogador rola. E o
                -- unico que a penalidade toca, e e ele que faz a linha do
                -- atributo fechar: base + bonus + automacoes.
                sheet[chave .. "TotalRolagem"] = limpo - penAtributo
            end

            -- Efeitos numericos vindos de Qualidades/Defeitos escolhidos
            -- (ex.: "Aura expandida" +15%/+30% de Ap, "Vigor reprimido"
            -- -15%/-30% de Hp). Ver catalogoQualidadesDefeitos.lua.
            local efeitosQD = CatalogoQD.somarEfeitos(escolhidosQD())

            local hpBase = Calculos.hp({
                nivel = nivel, constituicao = valores.constituicao,
                dadoVida = sheet.dadoVida, progressaoVidaExtra = sheet.progressaoVidaExtra,
                ajusteManual = sheet.ajusteHp,
            })
            -- Vigor expandido/reprimido incide na VIDA, sempre - inclusive
            -- em vampiro. Aura expandida/reprimida incide na AURA, sempre -
            -- inclusive em bruxa. Cada qualidade age na barra que ela nomeia,
            -- e nao na barra derivada (Prana e Vitae ficam de fora).
            sheet.hp = math.floor(hpBase * (1 + (efeitosQD.hpPercent or 0) / 100) + 0.5)

            -- A conta do Hp, com as MESMAS parcelas de Calculos.hp e das
            -- linhas acima. "dado" e o dado de vida da raca; "progressão" e
            -- o acumulado dos níveis; o percentual e das qualidades.
            local contaHp = "15 + dado " .. n(sheet.dadoVida) .. " + (Con " ..
                valores.constituicao .. "÷2 × " .. nivel .. ")" ..
                parcela(sheet.progressaoVidaExtra, "progressão") ..
                parcela(sheet.ajusteHp, "ajuste")
            if (efeitosQD.hpPercent or 0) ~= 0 then
                contaHp = "(" .. contaHp .. ") × " .. fmtNumero(1 + (efeitosQD.hpPercent or 0) / 100) ..
                    " [qualidades " .. (efeitosQD.hpPercent > 0 and "+" or "") .. efeitosQD.hpPercent .. "%]"
            end

            -- FORMA BESTIAL (v0.38.0): o bloco do rank atual da habilidade
            -- racial progressiva entra aqui, e sai quando a forma desliga.
            -- Somado DEPOIS do percentual das qualidades de proposito: o
            -- "+40 pontos de vida" da habilidade e um numero fixo do texto,
            -- e nao uma base para Vigor expandido multiplicar.
            local bonusBesta = bonusFormaBestial()
            sheet.bonusBestaVida = bonusBesta.vida
            sheet.bonusBestaAbsorcao = bonusBesta.absorcao
            sheet.bonusBestaDefesas = bonusBesta.defesas
            sheet.bonusBestaDados = bonusBesta.dadosDano
            sheet.bonusBestaRegen = bonusBesta.regen
            sheet.bonusBestaTetoAbs = bonusBesta.tetoAbsorcao
            sheet.bonusBestaFonte = bonusBesta.fonte
            sheet.bonusBestaRank = bonusBesta.rank
            sheet.hp = n(sheet.hp) + bonusBesta.vida
            CONTAS.Hp = contaHp .. parcela(bonusBesta.vida, "forma bestial")

            if sheet.temCoracaoDeMana then
                sheet.mp = Calculos.mp({
                    nivel = nivel, idade = numeroInicial(sheet.idade),
                    temCoracaoDeMana = true, ajusteManual = sheet.ajusteMp,
                })
                -- A parcela da idade e a MANA ACUMULADA por aniversario
                -- (faixas do Tutorial de Ficha: 2,0/ano ate 50; 1,5 ate 99;
                -- 0,5 ate 300; 0,25 dali em diante), e nao a idade em anos.
                -- Ate a v0.41.1 a conta imprimia "idade 60" onde somava 115.
                local baseIdade = Calculos.baseManaPorIdade(numeroInicial(sheet.idade))
                CONTAS.Mp = "15 + idade " .. fmtNumero(baseIdade) .. " [" ..
                    numeroInicial(sheet.idade) .. " anos] + (" .. nivel .. " × 2)" ..
                    parcela(sheet.ajusteMp, "ajuste")
            else
                sheet.mp = 0
                CONTAS.Mp = "requer Coração de Mana"
            end

            local apBase = Calculos.ap({
                sabedoria = valores.sabedoria, nivel = nivel, rank = dadosNivel.rank,
                dadoPorNivelAcumulado = sheet.dadoPorNivelAcumulado, ajusteManual = sheet.ajusteAp,
            })
            sheet.ap = math.floor(apBase * (1 + (efeitosQD.apPercent or 0) / 100) + 0.5)
            do
                local rankNum = DadosSistema.ordemRank[dadosNivel.rank] or 1
                local contaAp = "(20 + Sab " .. valores.sabedoria .. " + " .. nivel .. ") × " .. rankNum ..
                    parcela(sheet.dadoPorNivelAcumulado, "dados") ..
                    parcela(sheet.ajusteAp, "ajuste")
                if (efeitosQD.apPercent or 0) ~= 0 then
                    contaAp = "(" .. contaAp .. ") × " .. fmtNumero(1 + (efeitosQD.apPercent or 0) / 100) ..
                        " [qualidades " .. (efeitosQD.apPercent > 0 and "+" or "") .. efeitosQD.apPercent .. "%]"
                end
                CONTAS.Ap = contaAp
            end

            -- PRANA: a barra da BRUXA (Linhagem de Unaris), soma de Mana e
            -- Aura. Mana e Aura seguem calculadas normalmente - o Prana e uma
            -- TERCEIRA barra, e nao uma fusao que apaga as outras. Mago com
            -- Coracao de Mana nao tem Prana: ele tem Mana e Aura separadas.
            -- O Prana e a soma das duas barras JA calculadas. Como Aura
            -- expandida ja entrou na Aura, o efeito chega aqui por
            -- consequencia - nao se aplica de novo.
            sheet.prana = Calculos.prana({
                ehBruxa = personagemEhBruxa(),
                mp = sheet.mp, ap = sheet.ap,
                ajusteManual = sheet.ajustePrana,
            })

            -- VITAE. O Prana entra aqui dentro quando a personagem e vampira
            -- E da Linhagem de Unaris (decisao do mestre, 22/08/2026): na
            -- bruxa Mana e Aura ja viraram UMA reserva so, e no vampiro o
            -- Vitae fica "no lugar da Aura e da Mana" - no lugar dessa
            -- reserva unica, portanto. Vira parcela do Vitae, nao barra
            -- separada. Ver o comentario longo em Calculos.pv.
            --
            -- ORDEM IMPORTA: sheet.prana precisa estar calculado acima desta
            -- linha. Se alguem mover o bloco do Prana para depois daqui, o
            -- Vitae da vampibruxa sai sem a parcela e ninguem percebe - o
            -- numero continua "plausivel". A bateria de teste
            -- "Vitae da vampibruxa" existe para pegar exatamente isso.
            -- A RESERVA do vampiro e mana + aura, SEMPRE - nao so na
            -- vampibruxa, como era ate a v0.48.0. O ajuste do Prana entra
            -- junto quando a personagem e bruxa, porque nesse caso o card
            -- do Prana esta escondido e o campo de ajuste dele ficaria sem
            -- destino nenhum. Ver o comentario longo em Calculos.pv.
            local reservaVitae = 0
            local ganhoVitae, baseVitae = 0, 0
            if sheet.ehVampiro then
                reservaVitae = n(sheet.mp) + n(sheet.ap)
                if personagemEhBruxa() then
                    reservaVitae = reservaVitae + n(sheet.ajustePrana)
                end
                sheet.pv, baseVitae, ganhoVitae = Calculos.pv({
                    ehVampiro = true, constituicao = valores.constituicao,
                    rank = dadosNivel.rank, ajusteManual = sheet.ajustePv,
                    hpPercent = efeitosQD.hpPercent or 0,
                    reserva = reservaVitae,
                })
                -- O "+N pontos de vida" da forma bestial paga no Vitae, que
                -- passou a ser a vida do vampiro. Hoje inalcancavel (so
                -- Lobisomens e Ursari tem forma alternativa, e o livro
                -- exclui as duas de Mesticagem e de Sangue das racas
                -- antigas), mas mandar o bonus para sheet.hp deixaria um
                -- numero morto numa barra que o vampiro nem ve.
                sheet.pv = n(sheet.pv) + bonusBesta.vida
            else
                sheet.pv = 0
            end

            do
                local rankNum = DadosSistema.ordemRank[dadosNivel.rank] or 1
                CONTAS.Prana = "mana " .. n(sheet.mp) .. " + aura " .. n(sheet.ap) ..
                    parcela(sheet.ajustePrana, "ajuste")
                if sheet.ehVampiro then
                    -- Aura e Mana aparecem como PARCELAS porque os dois cards
                    -- estao escondidos para o vampiro: sem isto o Vitae
                    -- saltaria dezenas de pontos sem nada na tela explicando.
                    --
                    -- Sem parenteses em lugar nenhum, de proposito. A meia
                    -- unidade do "Con × 1,5" so e arredondada no TOTAL, como
                    -- Calculos.pv faz, e parentese aqui significa "arredonda
                    -- o grupo" para a bateria. Pelo mesmo motivo o ganho das
                    -- qualidades entra como numero somado, e nao como "× 1,3".
                    local contaPv = "10 + Con " .. valores.constituicao .. " × 1,5 + rank " ..
                        rankNum .. " × 30"
                    if ganhoVitae ~= 0 then
                        contaPv = contaPv .. " + " .. fmtNumero(ganhoVitae) ..
                            " [Vigor expandido " .. ((efeitosQD.hpPercent or 0) > 0 and "+" or "") ..
                            (efeitosQD.hpPercent or 0) .. "%]"
                    end
                    contaPv = contaPv .. parcela(n(sheet.ap), "aura") ..
                        parcela(n(sheet.mp), "mana")
                    if personagemEhBruxa() then
                        contaPv = contaPv .. parcela(sheet.ajustePrana, "ajuste do prana")
                    end
                    CONTAS.Pv = contaPv .. parcela(sheet.ajustePv, "ajuste") ..
                        parcela(bonusBesta.vida, "forma bestial")
                else
                    CONTAS.Pv = "apenas vampiros"
                end
            end

            -- Os cinco maximos estao prontos: o atual de cada barra e
            -- reconciliado aqui, e nao la embaixo na pintura. Pintura que
            -- decide valor e a origem da classe de bug em que a tela
            -- mostra uma coisa e o dado guardado e outra.
            reconciliarRecursosAtuais()

            -- Base terrestre. Racas com FORMA ALTERNATIVA (Lobisomens
            -- "12m (forma mortal) / 24m (forma bestial)", Ursaris "8m (em pé)
            -- / 18m (postura Ursari)") trocam a base quando a forma esta
            -- ligada. Nao e voo nem nado: e o mesmo deslocamento terrestre
            -- em outro estado do corpo.
            local baseTerrestre = n(sheet.deslocamentoBaseRaca)
            if formaAlternativaAtiva() then
                baseTerrestre = n(sheet.deslocamentoBaseFormaAlt)
            end
            sheet.deslocamento = Calculos.deslocamentoModo({
                baseModo = baseTerrestre, destreza = valores.destreza,
                rank = dadosNivel.rank, ajusteManual = sheet.ajusteDeslocamento,
            })
            sheet.deslocamento = n(sheet.deslocamento) + n(bonusBesta.deslocamento)
            sheet.iniciativa = Calculos.iniciativa({
                destreza = valores.destreza, rank = dadosNivel.rank, ajusteManual = sheet.ajusteIniciativa,
            }) + n(bonusBesta.iniciativa)

            -- As contas de deslocamento e iniciativa comecam aqui e vao
            -- ganhando parcela conforme o valor ganha (armadura, dobro).
            local rankNumDesloc = DadosSistema.ordemRank[dadosNivel.rank] or 1
            local rotuloBaseDesloc = "raça"
            if formaAlternativaAtiva() then
                rotuloBaseDesloc = tostring(sheet.formaAlternativaNome or "forma")
            end
            local contaDesloc = rotuloBaseDesloc .. " " .. baseTerrestre ..
                " + Des " .. valores.destreza .. " + rank " .. rankNumDesloc ..
                parcela(sheet.ajusteDeslocamento, "ajuste") ..
                parcela(bonusBesta.deslocamento, "forma bestial")
            CONTAS.Iniciativa = "Des " .. valores.destreza .. " + rank " .. rankNumDesloc ..
                parcela(sheet.ajusteIniciativa, "ajuste") ..
                parcela(bonusBesta.iniciativa, "forma bestial")

            local ctxDef = {
                forca = valores.forca, destreza = valores.destreza,
                manipulacao = valores.manipulacao, sabedoria = valores.sabedoria,
                bonusProficiencia = dadosNivel.prof, bonusItensArmaduras = sheet.bonusItensArmaduras,
            }
            ctxDef.ajusteManual = sheet.ajusteDefesaAparar
            sheet.defesaAparar = Calculos.defesaAparar(ctxDef) + bonusTotalDefesa("aparar") + bonusItemDefesa("aparar")
            ctxDef.ajusteManual = sheet.ajusteDefesaEsquiva
            sheet.defesaEsquiva = Calculos.defesaEsquiva(ctxDef) + bonusTotalDefesa("esquiva") + bonusItemDefesa("esquiva")
            ctxDef.ajusteManual = sheet.ajusteDefesaEmpatica
            sheet.defesaEmpatica = Calculos.defesaEmpatica(ctxDef) + bonusTotalDefesa("empatica") + bonusItemDefesa("empatica")
            ctxDef.ajusteManual = sheet.ajusteDefesaTelepatica
            sheet.defesaTelepatica = Calculos.defesaTelepatica(ctxDef) + bonusTotalDefesa("telepatica") + bonusItemDefesa("telepatica")

            -- Contas das quatro defesas, com TODAS as parcelas de cima:
            -- base + atributo + prof + armaduras + bônus (poder, escudo,
            -- raça, subclasse) + item equipado + ajuste + forma bestial.
            -- O "+N em todas as defesas" da forma bestial entra logo abaixo,
            -- e ja e escrito aqui para a conta nascer completa.
            for _, d in ipairs({
                {n = "DefAparar",     base = 9,  atr = "Força", val = valores.forca,       chave = "aparar",     ajuste = sheet.ajusteDefesaAparar},
                {n = "DefEsquiva",    base = 9,  atr = "Des",   val = valores.destreza,    chave = "esquiva",    ajuste = sheet.ajusteDefesaEsquiva},
                {n = "DefEmpatica",   base = 10, atr = "Man",   val = valores.manipulacao, chave = "empatica",   ajuste = sheet.ajusteDefesaEmpatica},
                {n = "DefTelepatica", base = 10, atr = "Sab",   val = valores.sabedoria,   chave = "telepatica", ajuste = sheet.ajusteDefesaTelepatica},
            }) do
                CONTAS[d.n] = d.base .. " + " .. d.atr .. " " .. d.val .. " + prof " .. n(dadosNivel.prof) ..
                    parcela(sheet.bonusItensArmaduras, "armaduras") ..
                    parcela(bonusTotalDefesa(d.chave), "bônus") ..
                    parcela(bonusItemDefesa(d.chave), "item") ..
                    parcela(d.ajuste, "ajuste") ..
                    parcela(bonusBesta.defesas, "forma bestial")
            end

            -- "+N em todas as Defesas" da forma bestial: as QUATRO, sem
            -- excecao. O texto diz "todas", entao nao ha escolha a fazer.
            if bonusBesta.defesas ~= 0 then
                sheet.defesaAparar = n(sheet.defesaAparar) + bonusBesta.defesas
                sheet.defesaEsquiva = n(sheet.defesaEsquiva) + bonusBesta.defesas
                sheet.defesaEmpatica = n(sheet.defesaEmpatica) + bonusBesta.defesas
                sheet.defesaTelepatica = n(sheet.defesaTelepatica) + bonusBesta.defesas
            end

            -- FERIDO: "-2/-4/-7 em todos os testes" [2.3], e a mesa incluiu
            -- as QUATRO defesas (06/09/2026). Subtracao pura sobre o total,
            -- depois de todos os bonus - e ela entra na conta de cada card,
            -- porque um numero que desce sem explicacao vira mensagem para o
            -- desenvolvedor.
            do
                local penFerido = penalidadeFerido()
                if penFerido ~= 0 then
                    local nv = nivelFerido()
                    local rot = (nv > 0) and ("Ferido " .. FERIDO[nv].romano)
                                          or "ajuste do mestre"
                    for _, d in ipairs({
                        {campo = "defesaAparar",     conta = "DefAparar"},
                        {campo = "defesaEsquiva",    conta = "DefEsquiva"},
                        {campo = "defesaEmpatica",   conta = "DefEmpatica"},
                        {campo = "defesaTelepatica", conta = "DefTelepatica"},
                    }) do
                        sheet[d.campo] = n(sheet[d.campo]) - penFerido
                        CONTAS[d.conta] = CONTAS[d.conta] .. parcela(-penFerido, rot)
                    end
                end
            end

            -- Armadura pesada tira metros do deslocamento; so conta o que
            -- esta equipado. REGRA DA MESA (21/08/2026): o desconto vale para
            -- os TRES modos - voar de armadura pesada tambem custa metros.
            local penalidadeArmadura = 0
            do
                local ok, ef = pcall(efeitosEquipados)
                if ok and ef ~= nil then penalidadeArmadura = n(ef.deslocamento) end
            end
            if penalidadeArmadura ~= 0 then
                local antes = n(sheet.deslocamento)
                sheet.deslocamento = math.max(0, antes + penalidadeArmadura)
                -- Ate a v0.41.1 esta parcela NAO aparecia na conta: o card
                -- dizia 6m e a linha embaixo "raça 10 + Des 5 + rank 1".
                contaDesloc = contaDesloc .. parcela(penalidadeArmadura, "armadura")
                if antes + penalidadeArmadura < 0 then
                    contaDesloc = contaDesloc .. " [mínimo 0]"
                end
            end

            -- Guardado AQUI, entre a armadura e Passos de vento, para servir
            -- de base a nado e escalada sem base racial (metade do
            -- deslocamento). A ordem nao e detalhe: a penalidade de armadura
            -- DEVE entrar na metade (decisao de 21/08: o desconto vale para
            -- todos os modos) e Passos de vento NAO (mesma decisao: o dobro
            -- so vale para o terrestre). Mover esta linha para depois do if
            -- abaixo dobraria o nado de um Duelista em silencio.
            -- Vai para o sheet porque a conta que aparece embaixo do card
            -- ("metade de 13") e escrita em atualizarAbaCombate(), que e
            -- outra funcao: uma local daqui nao chega la.
            local deslocParaMetade = n(sheet.deslocamento)
            sheet.deslocamentoMetadeBase = deslocParaMetade

            -- Passos de vento (Duelista nivel 2): "seu deslocamento PADRAO e
            -- de corrida passivamente dobram". So o terrestre - o texto diz
            -- "padrao", e a mesa confirmou que nao alcanca voo e nado.
            if deslocamentoDobrado() then
                sheet.deslocamento = n(sheet.deslocamento) * 2
                contaDesloc = "(" .. contaDesloc .. ") × 2 [Passos de vento]"
            end
            CONTAS.Deslocamento = contaDesloc

            -- Corrida: o dobro do deslocamento, ou o TRIPLO para Satiros
            -- ("Maratonista"). Duelista/Passos de vento dobra o deslocamento
            -- padrao, e a corrida acompanha por consequencia.
            sheet.corrida = Calculos.corrida({
                deslocamento = sheet.deslocamento,
                ehSatiro = temCaracRacial("Maratonista"),
            })

            -- ---------- VOO E NADO ----------
            -- Mesma conta do terrestre, trocando so o valor base da raca.
            -- Card com base 0 nao aparece (ver cardVisivelCombate).
            -- "Maratonista" e "Passos de vento" nao entram aqui de proposito.
            -- O modo EXISTE se a raça o dá (base > 0) ou se alguém lançou um
            -- ajuste manual. Sem essa segunda condição, um Anão com voo
            -- concedido pelo mestre digitaria no campo de ajuste e não
            -- aconteceria nada — automação sem escape.
            -- padraoMetade: modos que, SEM base racial, valem metade do
            -- deslocamento (nado e escalada, decisao dos mestres 30/08/2026).
            -- O VOO nao tem padrao: quem nao voa continua sem voar, e o card
            -- segue mostrando "—" com o campo de ajuste ao lado.
            local function modoDerivado(campoBase, campoAjuste, padraoMetade)
                local base = n(sheet[campoBase])
                local ajuste = n(sheet[campoAjuste])

                if base <= 0 and padraoMetade then
                    -- a base da raca SUBSTITUI o padrao; sem base, metade.
                    local v = Calculos.metadeDeslocamento({
                        deslocamento = deslocParaMetade, ajusteManual = ajuste,
                    })
                    return v, Calculos.corrida({deslocamento = v})
                end

                if base <= 0 and ajuste == 0 then return 0, 0 end
                local v = Calculos.deslocamentoModo({
                    baseModo = base, destreza = valores.destreza,
                    rank = dadosNivel.rank, ajusteManual = ajuste,
                })
                if penalidadeArmadura ~= 0 then
                    v = math.max(0, v + penalidadeArmadura)
                end
                if v < 0 then v = 0 end
                return v, Calculos.corrida({deslocamento = v})
            end

            sheet.deslocamentoVoo, sheet.corridaVoo =
                modoDerivado("deslocamentoBaseVoo", "ajusteDeslocamentoVoo", false)
            sheet.deslocamentoNado, sheet.corridaNado =
                modoDerivado("deslocamentoBaseNado", "ajusteDeslocamentoNado", true)
            sheet.deslocamentoEscalada, sheet.corridaEscalada =
                modoDerivado("deslocamentoBaseEscalada", "ajusteDeslocamentoEscalada", true)

            -- Deslocamento montado: depende do deslocamento a pé já
            -- calculado (Montador selvagem ○○ soma o seu ao da montaria),
            -- então roda DEPOIS dele.
            pcall(function() calcularDeslocamentoMontado() end)

            -- Tres progressoes distintas, cada uma com seu nivel de ganho.
            -- ACOES: base + evolucao por nivel (calculos.lua) + o que vem de
            -- poder e de classe (ACOES_EXTRAS). As RESTRITAS ficam num campo
            -- separado: elas existem, mas nao entram no numero que o jogador
            -- gasta livremente no turno.
            local exPadraoLivre, exPadraoRestrita = 0, 0
            local exBonusLivre, exBonusRestrita = 0, 0
            local exReacaoLivre, exReacaoRestrita = 0, 0
            pcall(function()
                exPadraoLivre, exPadraoRestrita = extrasDeAcao("padrao")
                exBonusLivre, exBonusRestrita = extrasDeAcao("bonus")
                exReacaoLivre, exReacaoRestrita = extrasDeAcao("reacao")
            end)

            sheet.acoesPadrao = Calculos.acoesPadrao({nivel = nivel,
                extras = exPadraoLivre, ajusteManual = sheet.ajusteAcoesPadrao})
            sheet.acoesBonus  = Calculos.acoesBonus({nivel = nivel,
                extras = exBonusLivre, ajusteManual = sheet.ajusteAcoesBonus})
            sheet.acoesReacao = Calculos.acoesReacao({nivel = nivel,
                extras = exReacaoLivre, ajusteManual = sheet.ajusteAcoesReacao})

            -- Os contadores de acoes RESTRITAS (acoesPadraoRestritas etc.)
            -- eram gravados no sheet a cada recalculo e ninguem os lia: a
            -- tela usa as listas de rotulos que extrasDeAcao devolve. Tres
            -- campos mortos a menos na ficha salva (v0.42.1).

            sheet.capacidadeMochila = Calculos.capacidadeMochila({
                forca = valores.forca, rank = dadosNivel.rank,
            })
            -- A conta da mochila inclui o AJUSTE do mestre (mochilaBonus) e
            -- os espacos extras de itens ("Contrabando" e afins), que ate a
            -- v0.41.1 entravam no total sem aparecer na linha - e o ajuste
            -- nem tinha campo na tela.
            do
                local rankNum = DadosSistema.ordemRank[dadosNivel.rank] or 1
                local extrasItens = 0
                pcall(function() extrasItens = n(espacosExtrasDeItens()) end)
                CONTAS.Mochila = "2 + For " .. valores.forca .. " + rank " .. rankNum ..
                    parcela(extrasItens, "itens") ..
                    parcela(sheet.mochilaBonus, "ajuste")
            end

            -- CLASSE da aba 01 (v0.42.1): vem da escolha feita na aba 04.
            -- Ate a v0.41.1 era um texto livre paralelo que ninguem
            -- sincronizava - o jogador escolhia a classe no catalogo e via a
            -- aba 01 vazia. Uma propriedade, um dono: o catalogo.
            do
                local partes = {}
                for slot = 1, 2 do
                    local c = tostring(sheet["classe" .. slot .. "Nome"] or "")
                    local sub = tostring(sheet["classe" .. slot .. "Sub"] or "")
                    local nv = n(sheet["classe" .. slot .. "Nivel"])
                    if c ~= "" then
                        local txt = c
                        if sub ~= "" then txt = txt .. " · " .. sub end
                        if nv > 0 then txt = txt .. " " .. nv end
                        table.insert(partes, txt)
                    end
                end
                local texto = table.concat(partes, "  +  ")
                -- Ficha antiga com classe digitada e nenhuma escolhida na
                -- aba 04: o texto fica ate a primeira escolha, para nao
                -- apagar dado de quem ja usava.
                if #partes > 0 and tostring(sheet.classe or "") ~= texto then
                    sheet.classe = texto
                end
            end

            atualizarContadoresPericias()
            atualizarPainelPontosQD()
            pcall(function() atualizarAbaCombate() end)
            pcall(function() atualizarAbaFavores() end)
            pcall(function() atualizarAbaInventario() end)
            pcall(function() atualizarAbaBackground() end)
            pcall(function() aplicarTravaDeCriacao() end)
            -- o selo do cabecalho e RECURSO DERIVADO: reconcilia a cada
            -- recalculo, e nao so na hora em que se escolhe. Sem isto, o
            -- selo de uma bencao removida ficaria na ficha para sempre.
            pcall(function() atualizarSeloCabecalho() end)
            -- os atuais dependem dos maximos ja calculados
            recalculando = false
        end

        -- =================================================================
        -- POPUP DE CATALOGO: TRACOS DE PERSONALIDADE
         --
        -- Padrao reaproveitavel para os proximos catalogos (Racas, Classes,
         -- Poderes...). A recordList do popup e alimentada por um no
        -- TEMPORARIO da ficha (sheet.catalogoTracos), reconstruido a cada
        -- abertura a partir do arquivo de catalogo. Assim o texto das
        -- descricoes nunca fica duplicado dentro da ficha salva.
        -- =================================================================

        -- Reflete no campo clicavel o traco atualmente escolhido.
        function atualizarRotuloTraco()
            if self.lblTracoAtual == nil then return end
            do
                local lista = lerTracos()
                if #lista == 0 then
                    if jogadorPodeMexerEmTraco() then
                        self.lblTracoAtual:setText("Clique para escolher")
                    else
                        self.lblTracoAtual:setText("Nenhum traço — o mestre concede")
                    end
                    self.lblTracoAtual:setFontColor(COR.faint)
                else
                    local partes = {}
                    for _, nome in ipairs(lista) do
                        local d = CatalogoTracos.buscarPorNome(nome)
                        if d ~= nil and d.oposto ~= nil and temTraco(d.oposto) then
                            table.insert(partes, nome .. " (!)")
                        else
                            table.insert(partes, nome)
                        end
                    end
                    self.lblTracoAtual:setText(table.concat(partes, "   ·   "))
                    self.lblTracoAtual:setFontColor(COR.text)
                end
                return
            end
            local atual = ""
            if sheet ~= nil then atual = tostring(sheet.tracoPersonalidade or "") end
            if atual == "" then
                self.lblTracoAtual:setText("Clique para escolher")
                self.lblTracoAtual:setFontColor(COR.faint)
            else
                local dados = CatalogoTracos.buscarPorNome(atual)
                if dados ~= nil and dados.oposto ~= nil then
                    self.lblTracoAtual:setText(atual .. "   •   oposto: " .. dados.oposto)
                else
                    self.lblTracoAtual:setText(atual)
                end
                self.lblTracoAtual:setFontColor(COR.text)
            end
        end

        function abrirPopupTracos()
            if self.popTracos == nil then return end
            destacarTracoSelecionado()
            -- O popup abre sempre. O aviso diz de saída o que este usuário pode
            -- fazer, para o jogador não descobrir a trava clicando.
            if usuarioEhMestre() then
                avisarTracos("Você é o mestre: pode conceder e remover traços à vontade.", COR.muted)
            elseif fichaEstaFinalizada() then
                avisarTracos("Consulta apenas: a ficha está finalizada. Só o MESTRE altera traços.", COR.muted)
            elseif #lerTracos() == 0 then
                avisarTracos("Escolha o seu traço. Enquanto a ficha estiver em criação, dá para trocar quando quiser.", COR.gold)
            elseif #lerTracos() == 1 then
                avisarTracos("Clique em outro traço para trocar. Remover ou acumular um segundo é com o MESTRE.", COR.gold)
            else
                avisarTracos("Seus traços vieram do MESTRE. Só ele pode trocá-los ou remover.", COR.muted)
            end
            abrirPopupAjustado(self.popTracos, 820, 560)
        end

        function fecharPopupTracos()
            if self.popTracos ~= nil then self.popTracos:close() end
            atualizarRotuloTraco()
        end

        -- ---------------------------------------------------------------
        -- TRACOS DE PERSONALIDADE (lista)
        --
        -- O personagem comeca com um traco, mas a narrativa pode conceder
        -- outros ou tirar os que tem - ja aconteceu na mesa. Por isso a ficha
        -- guarda uma LISTA, e nao um valor unico.
        --
        -- Quem concede e remove e o MESTRE: e ganho de narrativa oficial.
        --
        -- Opostos (Lascivo x Casto) nao sao bloqueados: em regra nao se tem os
        -- dois, mas quem maneja isso e o mestre, entao a ficha apenas AVISA.
        --
        -- Guardado em "tracoPersonalidade", separado por ";". O campo e o
        -- mesmo de antes, entao fichas antigas com um traco so continuam
        -- valendo - viram uma lista de um item.
        -- ---------------------------------------------------------------
        function lerTracos()
            local lista = {}
            if sheet == nil then return lista end
            for _, nome in ipairs(partirTexto(sheet.tracoPersonalidade, ";")) do
                if nome ~= "" then table.insert(lista, nome) end
            end
            return lista
        end

        function gravarTracos(lista)
            if sheet == nil then return end
            sheet.tracoPersonalidade = table.concat(lista, ";")
        end

        function temTraco(nome)
            for _, t in ipairs(lerTracos()) do
                if t == nome then return true end
            end
            return false
        end

        -- Clicar num card: adiciona se nao tem, remove se ja tem.
        -- REGRA DA MESA: com a ficha EM CRIAÇÃO, o jogador troca o próprio
        -- traço à vontade — escolhe outro no lugar do que tem.
        --
        -- O que ele NÃO faz é mudar a QUANTIDADE: acrescentar um segundo traço
        -- ou ficar sem nenhum é do mestre, porque traço vem de narrativa.
        -- Finalizada a ficha, nada disso: só o mestre.
        function jogadorPodeMexerEmTraco()
            if usuarioEhMestre() then return true end
            return not fichaEstaFinalizada()
        end

        function selecionarTraco(nome)
            if sheet == nil then return end

            local lista = lerTracos()
            local achou = nil
            for i, t in ipairs(lista) do
                if t == nome then achou = i end
            end

            if not usuarioEhMestre() then
                -- Toda recusa diz por que e quem libera.
                if fichaEstaFinalizada() then
                    avisarTracos("Ficha finalizada: só o MESTRE altera traços de personalidade.", COR.wine)
                    return
                end
                -- Clicou no traço que já tem: isso REMOVERIA, e remover muda a
                -- quantidade. Fora do alcance do jogador.
                if achou ~= nil then
                    avisarTracos("Remover um traço é do MESTRE. Para TROCAR, clique direto no traço que você quer.", COR.gold)
                    return
                end
                -- Com mais de um traço não dá para saber qual seria trocado —
                -- os extras vieram do mestre, então é com ele.
                if #lista > 1 then
                    avisarTracos("Você tem mais de um traço, todos concedidos pelo MESTRE. Só ele pode trocá-los.", COR.gold)
                    return
                end
                -- TROCA: sai o traço atual, entra o escolhido. A quantidade
                -- não muda, que é justamente o limite do jogador.
                if #lista == 1 then
                    local anterior = lista[1]
                    lista[1] = nome
                    gravarTracos(lista)
                    avisarTracos("Traço trocado: " .. anterior .. " › " .. nome .. ".", COR.moss)
                    publicarNoChat(mensagemTraco("trocou", nome, anterior), COR.aura)
                    destacarTracoSelecionado()
                    atualizarRotuloTraco()
                    return
                end
            end

            if achou ~= nil then
                table.remove(lista, achou)
                gravarTracos(lista)
                publicarNoChat(mensagemTraco("removeu", nome), COR.aura)
                avisarTracos(nome .. " removido.", COR.muted)
            else
                table.insert(lista, nome)
                gravarTracos(lista)
                -- Aviso, nao bloqueio: a decisao final e do mestre.
                local dados = CatalogoTracos.buscarPorNome(nome)
                if dados ~= nil and dados.oposto ~= nil and temTraco(dados.oposto) then
                    avisarTracos("Atenção: " .. nome .. " e " .. dados.oposto ..
                        " são opostos. Em regra não se tem os dois — a ficha aceita, mas confira.", COR.gold)
                else
                    avisarTracos(nome .. " concedido.", COR.moss)
                end
                publicarNoChat(mensagemTraco("concedeu", nome), COR.aura)
            end

            destacarTracoSelecionado()
            atualizarRotuloTraco()
        end

        function avisarTracos(texto, cor)
            if self.popTraco_lblAviso == nil then return end
            self.popTraco_lblAviso:setText(tostring(texto or ""))
            self.popTraco_lblAviso:setFontColor(cor or COR.muted)
        end

        -- Realca visualmente (borda dourada) o card do traco atualmente
        -- escolhido, sempre que o popup abre.
        function destacarTracoSelecionado()
            if sheet == nil then return end
            for _, item in ipairs(CatalogoTracos.itens) do
                local card = self["rectTraco_" .. item.chave]
                if card ~= nil then
                    if temTraco(item.nome) then
                        card:setStrokeColor(COR.gold)
                        card:setStrokeSize(2)
                    else
                        card:setStrokeColor(COR.line)
                        card:setStrokeSize(1)
                    end
                end
            end
        end

        -- =================================================================
        -- ASPECTO DIVINO
        --
        -- Mesmo padrao do Traco de Personalidade: campo clicavel + popup com
        -- cards estaticos, cada um carregando o proprio nome no XML. Nada de
        -- recordList reciclada, entao nao ha como a selecao de um card
        -- "vazar" para outro.
        --
        -- A escolha aqui e o que alimenta a aba de Poderes: o kit da
        -- divindade define quais poderes o semideus pode adquirir.
        -- =================================================================
        function atualizarRotuloAspecto()
            if self.lblAspectoAtual == nil then return end
            local atual = ""
            if sheet ~= nil then atual = tostring(sheet.aspectoDivino or "") end
            if atual == "" then
                self.lblAspectoAtual:setText("Clique para escolher a divindade")
                self.lblAspectoAtual:setFontColor(COR.faint)
            else
                local d = CatalogoDeuses.buscarPorNome(atual)
                -- PROCLAMADO: marco raro, aparece junto da divindade no Perfil
                local selo = ""
                if tostring(sheet.proclamadoPor or "") == atual then
                    selo = "   ✦   PROCLAMADO"
                end
                if d ~= nil then
                    self.lblAspectoAtual:setText(atual .. "   •   deus " .. d.categoria:lower() .. selo)
                else
                    -- Valor digitado a mao antes de existir o catalogo:
                    -- preserva em vez de apagar.
                    self.lblAspectoAtual:setText(atual .. "   •   fora do catálogo" .. selo)
                end
                if selo ~= "" then
                    self.lblAspectoAtual:setFontColor(COR.gold)
                else
                    self.lblAspectoAtual:setFontColor(COR.text)
                end
            end
        end

        local deusEmDetalhe = nil

        function abrirPopupDeuses()
            if self.popDeuses == nil then return end
            -- Guarda a largura ANTES de montar o detalhe: as alturas dos
            -- paragrafos dependem dela e o popup ainda nao esta na tela.
            larguraTextoLore = tamanhoPopupDeuses() - LARGURA_CROMO_POPUP_DEUSES
            if larguraTextoLore < 320 then larguraTextoLore = 320 end

            local atual = tostring(sheet and sheet.aspectoDivino or "")
            if CatalogoDeuses.buscarPorNome(atual) ~= nil then
                mostrarDetalheDeus(atual)
            elseif deusEmDetalhe ~= nil then
                mostrarDetalheDeus(deusEmDetalhe)
            end
            destacarDeusSelecionado()
            abrirPopupAjustado(self.popDeuses, 1080, 680)
        end

        function fecharPopupDeuses()
            if self.popDeuses ~= nil then self.popDeuses:close() end
            atualizarRotuloAspecto()
        end

        -- Painel da direita: nome, categoria, kit e o lore completo.
        -- SELO DE CADA DIVINDADE (v0.44.0). Caminhos com LITERAL de
        -- proposito: a checagem 33 varre o script atras de caminho de
        -- imagem entre aspas, e assim cobra os dois lados — arquivo citado que nao existe, e
        -- arquivo no pacote que ninguem usa. Montar o caminho por
        -- concatenacao ("imagens/selo_" .. chave .. ".png") deixaria os 18
        -- invisiveis para ela, e um selo com nome errado falharia em
        -- silencio: no Firecast, src que nao resolve so nao desenha.
        --
        -- TODAS as 30 divindades do catalogo tem selo (v0.44.1), e nao so
        -- as 18 com kit: primordiais e menores nao sao escolhiveis, mas
        -- carregam o peso de lore do cenario e apareciam com o brasao
        -- generico ao lado do nome — o que fazia a metade nao jogavel do
        -- panteao parecer inacabada.
        SELO_DO_DEUS = {
            ["Ammis"]                      = { grande = "imagens/selo_ammis.png", pequeno = "imagens/selo38_ammis.png" },
            ["Aslot"]                      = { grande = "imagens/selo_aslot.png", pequeno = "imagens/selo38_aslot.png" },
            ["Asta"]                       = { grande = "imagens/selo_asta.png", pequeno = "imagens/selo38_asta.png" },
            ["Bran"]                       = { grande = "imagens/selo_bran.png", pequeno = "imagens/selo38_bran.png" },
            ["Din"]                        = { grande = "imagens/selo_din.png", pequeno = "imagens/selo38_din.png" },
            ["Ditrys"]                     = { grande = "imagens/selo_ditrys.png", pequeno = "imagens/selo38_ditrys.png" },
            ["Erinor"]                     = { grande = "imagens/selo_erinor.png", pequeno = "imagens/selo38_erinor.png" },
            ["Grún"]                       = { grande = "imagens/selo_grun.png", pequeno = "imagens/selo38_grun.png" },
            ["Haliana, a Deusa da Pesca"]  = { grande = "imagens/selo_haliana.png", pequeno = "imagens/selo38_haliana.png" },
            ["Isydras"]                    = { grande = "imagens/selo_isydras.png", pequeno = "imagens/selo38_isydras.png" },
            ["Kaern"]                      = { grande = "imagens/selo_kaern.png", pequeno = "imagens/selo38_kaern.png" },
            ["Khelion"]                    = { grande = "imagens/selo_khelion.png", pequeno = "imagens/selo38_khelion.png" },
            ["Merewen"]                    = { grande = "imagens/selo_merewen.png", pequeno = "imagens/selo38_merewen.png" },
            ["Morgara, a Deusa das Aves"]  = { grande = "imagens/selo_morgara.png", pequeno = "imagens/selo38_morgara.png" },
            ["Mungus"]                     = { grande = "imagens/selo_mungus.png", pequeno = "imagens/selo38_mungus.png" },
            ["Nellios"]                    = { grande = "imagens/selo_nellios.png", pequeno = "imagens/selo38_nellios.png" },
            ["Noctefir"]                   = { grande = "imagens/selo_noctefir.png", pequeno = "imagens/selo38_noctefir.png" },
            ["Oduwa"]                      = { grande = "imagens/selo_oduwa.png", pequeno = "imagens/selo38_oduwa.png" },
            ["Oskarion"]                   = { grande = "imagens/selo_oskarion.png", pequeno = "imagens/selo38_oskarion.png" },
            ["Qhyrana"]                    = { grande = "imagens/selo_qhyrana.png", pequeno = "imagens/selo38_qhyrana.png" },
            ["Qosis"]                      = { grande = "imagens/selo_qosis.png", pequeno = "imagens/selo38_qosis.png" },
            ["Ras'buz"]                    = { grande = "imagens/selo_rasbuz.png", pequeno = "imagens/selo38_rasbuz.png" },
            ["Sidharis"]                   = { grande = "imagens/selo_sidharis.png", pequeno = "imagens/selo38_sidharis.png" },
            ["Sýdos"]                      = { grande = "imagens/selo_sydos.png", pequeno = "imagens/selo38_sydos.png" },
            ["Tenebria"]                   = { grande = "imagens/selo_tenebria.png", pequeno = "imagens/selo38_tenebria.png" },
            ["Thaleessa"]                  = { grande = "imagens/selo_thaleessa.png", pequeno = "imagens/selo38_thaleessa.png" },
            ["Uhtris e Unaris"]            = { grande = "imagens/selo_uhtrisunaris.png", pequeno = "imagens/selo38_uhtrisunaris.png" },
            ["Vista, a Deusa da Colheita"] = { grande = "imagens/selo_vista.png", pequeno = "imagens/selo38_vista.png" },
            ["Wenti"]                      = { grande = "imagens/selo_wenti.png", pequeno = "imagens/selo38_wenti.png" },
            ["Zeno"]                       = { grande = "imagens/selo_zeno.png", pequeno = "imagens/selo38_zeno.png" },
        }
        -- DOIS TAMANHOS, e nao um escalado. O cabecalho tem 38px e o painel
        -- de detalhe 64: mandar o de 64 para o cabecalho o desenharia CORTADO,
        -- porque a mesa decidiu style="originalSize" para arte de pacote
        -- (checagem 19) — arte de tamanho conhecido nao escala. Foi a
        -- checagem 19 que denunciou isso antes de chegar na tela.
        SELO_NEUTRO = { grande = "imagens/brasao_petrichor.png",
                        pequeno = "imagens/brasao_petrichor.png" }

        function mostrarDetalheDeus(nome)
            local d = CatalogoDeuses.buscarPorNome(nome)
            if d == nil then return end
            deusEmDetalhe = nome

            if self.popDeus_lblNome ~= nil then self.popDeus_lblNome:setText(d.nome) end
            if self.popDeus_imgSelo ~= nil then
                pcall(function()
                    self.popDeus_imgSelo.src = (SELO_DO_DEUS[d.nome] or SELO_NEUTRO).grande
                end)
            end
            if self.popDeus_lblCategoria ~= nil then
                local txt = "Deus " .. d.categoria:lower()
                if not d.selecionavel then
                    txt = txt .. "   •   " .. CatalogoDeuses.motivoBloqueio(d)
                    self.popDeus_lblCategoria:setFontColor(COR.wine)
                else
                    self.popDeus_lblCategoria:setFontColor(COR.aura)
                end
                self.popDeus_lblCategoria:setText(txt)
            end

            -- Kit: 5 linhas fixas, as sobrando ficam invisíveis.
            for i = 1, 5 do
                local lbl = self["popDeus_lblSlot" .. i]
                local sec = self["popDeus_secSlot" .. i]
                local slot = d.slots[i]
                if sec ~= nil then sec:setVisible(slot ~= nil) end
                if slot ~= nil and lbl ~= nil then
                    local nomes = CatalogoDeuses.textoSlot(slot)
                    local tipos = {}
                    for _, p in ipairs(slot) do
                        local dados = CatalogoPoderes.buscar(p)
                        table.insert(tipos, dados and dados.tipo or "?")
                    end
                    lbl:setText(nomes .. "   (" .. table.concat(tipos, " / ") .. ")")
                end
            end
            if self.popDeus_lblKitVazio ~= nil then
                self.popDeus_lblKitVazio:setVisible(not d.kitConhecido)
            end
            -- Sem kit definido o painel nao precisa dos 188px dos 5 slots.
            if self.popDeus_secKit ~= nil then
                pcall(function() self.popDeus_secKit:setHeight(d.kitConhecido and 188 or 62) end)
            end

            -- Lore: UM label só, com os parágrafos separados por linha em
            -- branco. É exatamente o que o popup de Raças faz, e por isso lá
            -- o espaçamento sempre saiu certo: quem quebra as linhas é o
            -- wordWrap do próprio label, não a nossa conta.
            if self.popDeus_lblLore ~= nil then
                self.popDeus_lblLore:setText(table.concat(d.lore, "\n\n"))
            end
            ajustarAlturaLoreDeus(d)

            if self.popDeus_lblBtnEscolher ~= nil then
                if not d.selecionavel then
                    self.popDeus_lblBtnEscolher:setText("SOMENTE DEUSES GRANDES PODEM SER ESCOLHIDOS")
                    self.popDeus_lblBtnEscolher:setFontColor(COR.faint)
                elseif tostring(sheet and sheet.aspectoDivino or "") == d.nome then
                    self.popDeus_lblBtnEscolher:setText("JÁ É O SEU ASPECTO DIVINO")
                    self.popDeus_lblBtnEscolher:setFontColor(COR.moss)
                else
                    self.popDeus_lblBtnEscolher:setText("ESCOLHER " .. d.nome:upper() .. " COMO ASPECTO DIVINO")
                    self.popDeus_lblBtnEscolher:setFontColor(COR.gold)
                end
            end
        end

        -- Altura do bloco de historia.
        --
        -- POR QUE UM LABEL SO, E NAO UM POR PARAGRAFO:
        --   A versao anterior media cada paragrafo e definia a altura de 8
        --   labels separados. Isso transforma CADA erro de estimativa em um
        --   buraco visivel no meio do texto - e errar e inevitavel, porque a
        --   ficha nao consegue medir texto renderizado.
        --   O popup de Racas nunca teve esse problema porque usa UM label com
        --   o texto inteiro: o wordWrap quebra as linhas sozinho e nao existe
        --   espaco entre paragrafos para errar. Aqui agora e igual.
        --
        --   Sobra apenas UMA estimativa, a altura total do bloco, e um erro
        --   nela so gera espaco em branco no fim da rolagem.
        --
        -- Armadilhas ja pisadas nesta conta, para nao repetir:
        --   1. "#texto" em Lua conta BYTES; acentuacao UTF-8 ocupa 2. usar utf8.len.
        --   2. Ler "controle.width" antes do popup aparecer devolve valor
        --      pequeno - a largura vem de tamanhoPopupDeuses().
        local ALTURA_LINHA_LORE = 18
        LARGURA_CROMO_POPUP_DEUSES = 340
        larguraTextoLore = 740

        function ajustarAlturaLoreDeus(d)
            local sec = self.popDeus_secLore
            if sec == nil then return end
            -- EB Garamond 13: ~5.9px por caractere em media.
            local charsPorLinha = math.max(40, math.floor(larguraTextoLore / 5.9))
            local linhas = 0
            for _, p in ipairs(d.lore) do
                local qtd = #p
                if utf8 ~= nil and utf8.len ~= nil then
                    local ok, n = pcall(utf8.len, p)
                    if ok and n ~= nil then qtd = n end
                end
                linhas = linhas + math.max(1, math.ceil(qtd / charsPorLinha)) + 1 -- +1 = linha em branco
            end
            if linhas < 1 then linhas = 1 end
            pcall(function() sec:setHeight(linhas * ALTURA_LINHA_LORE + 34) end)
        end

        -- Botao do rodape do detalhe.
        function escolherDeusEmDetalhe()
            if deusEmDetalhe == nil then return end
            local d = CatalogoDeuses.buscarPorNome(deusEmDetalhe)
            if d == nil or not d.selecionavel then return end
            selecionarDeus(d.nome)
        end

        function selecionarDeus(nome)
            if sheet == nil then return end
            local anterior = tostring(sheet.aspectoDivino or "")

            -- LACRE DO ASPECTO: depois do primeiro ponto de poder gasto,
            -- trocar de divindade zeraria o kit adquirido. So o mestre
            -- libera, com autorizacao de uso unico.
            if anterior ~= nome and not podeTrocarAspecto() then
                if self.popDeus_lblCategoria ~= nil then
                    self.popDeus_lblCategoria:setText("ASPECTO LACRADO — já há pontos de poder gastos. Peça ao MESTRE para romper o lacre.")
                    self.popDeus_lblCategoria:setFontColor(COR.wine)
                end
                return
            end

            if anterior ~= nome and aspectoLacrado() then
                -- Consome a autorizacao, devolve os pontos e reabre o lacre
                -- para a nova divindade.
                sheet.autorizacaoMestreAspecto = false
                sheet.aspectoLacre = false
                sheet.poderesDados = ""
                publicarNoChat(anuncio("aspecto", "TROCA DE ASPECTO DIVINO",
                    tostring(sheet.nome or "Personagem") .. " deixou " .. anterior ..
                    " e passou a servir **" .. nome ..
                    "**. Os poderes adquiridos foram devolvidos ao saldo."), COR.wine)
            end

            sheet.aspectoDivino = nome
            fecharPopupDeuses()
            atualizarBlocoPoderes()
        end

        function limparAspectoDivino()
            if sheet ~= nil then sheet.aspectoDivino = "" end
            fecharPopupDeuses()
        end

        function destacarDeusSelecionado()
            if sheet == nil then return end
            local atual = tostring(sheet.aspectoDivino or "")
            for _, d in ipairs(CatalogoDeuses.itens) do
                local card = self["rectDeus_" .. d.chave]
                if card ~= nil then
                    if d.nome == atual then
                        card:setStrokeColor(COR.gold)
                        card:setStrokeSize(2)
                    elseif d.nome == deusEmDetalhe then
                        card:setStrokeColor(COR.aura)
                        card:setStrokeSize(1)
                    else
                        card:setStrokeColor(COR.line)
                        card:setStrokeSize(1)
                    end
                end
            end
        end

        function limparTracoPersonalidade()
            if sheet ~= nil then sheet.tracoPersonalidade = "" end
            fecharPopupTracos()
        end

        -- =================================================================
        -- LISTAS (pericias / qualidades / defeitos)
        -- =================================================================
        local function jaTemNome(listaCampo, nome)
            for _, item in ipairs(NDB.getChildNodes(sheet[listaCampo]) or {}) do
                if tostring(item.nome or "") == nome then return true end
            end
            return false
        end

        -- =================================================================
        -- ADICIONAR PERICIA (via popup-catalogo por atributo)
        -- Regra: numero de pericias do atributo <= valor Total do atributo.
        -- Se o limite ja foi atingido, a pericia NAO entra direto: fica
        -- pendente e abre um popup de confirmacao (autorizacao do mestre).
        -- Pericias aprovadas alem do limite ficam marcadas (aprovadoMestre)
        -- e o item.lfm as pinta com uma cor de destaque.
        -- =================================================================

        local POPUPS_PERICIA = {
            "popPericiaCarisma", "popPericiaDestreza", "popPericiaForca",
            "popPericiaInteligencia", "popPericiaManipulacao", "popPericiaSabedoria",
        }

        function fecharTodosPopupsPericia()
            for _, nomePop in ipairs(POPUPS_PERICIA) do
                local pop = self[nomePop]
                if pop ~= nil then pop:close() end
            end
        end

        local function contarItensLista(nomeLista)
            if sheet == nil then return 0 end
            return #(NDB.getChildNodes(sheet[nomeLista]) or {})
        end

        local function adicionarPericiaDireto(atributo, nome, nomeLista, aprovadoMestre)
            local widgetLista = self[nomeLista]
            if widgetLista == nil or sheet == nil then return end
            local dados = CatalogoPericias.buscar(atributo, nome)
            local node = widgetLista:append()
            if node ~= nil then
                node.atributo = atributo
                node.nome = nome
                node.aprovadoMestre = aprovadoMestre
                -- descricao gravada no proprio item: assim ela aparece por
                -- binding (field=) sem depender de script no template
                node.descricao = dados and dados.descricao or ""
            end
            atualizarContadoresPericias()
        end

        -- Chamada por cada card dos popups de pericia (nome vem gravado no XML).
        function tentarAdicionarPericia(atributo, nome, nomeLista, campoTotal, nomePopupOrigem)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                fecharTodosPopupsPericia()
                return
            end
            if jaTemNome(nomeLista, nome) then
                fecharTodosPopupsPericia()
                return
            end
            local limite = limitePericiasDoAtributo(campoTotal)
            local atual = contarItensLista(nomeLista)
            fecharTodosPopupsPericia()
            if atual < limite then
                adicionarPericiaDireto(atributo, nome, nomeLista, false)
            else
                sheet.pendPericiaAtributo = atributo
                sheet.pendPericiaNome = nome
                sheet.pendPericiaLista = nomeLista
                if self.lblLimitePericiaTexto ~= nil then
                    self.lblLimitePericiaTexto:setText(
                        "\"" .. nome .. "\" ultrapassa o limite de " .. tostring(limite) ..
                        " pericias de " .. atributo .. " (voce ja tem " .. tostring(atual) .. ").")
                end
                if self.popLimitePericia ~= nil then self.popLimitePericia:show() end
            end
        end

        function confirmarPericiaAlemDoLimite()
            if sheet == nil then return end
            -- Excecao ao limite = decisao do mestre. Jogadores/espectadores
            -- veem o aviso mas nao conseguem confirmar.
            if not usuarioEhMestre() then
                if self.lblLimitePericiaTexto ~= nil then
                    self.lblLimitePericiaTexto:setText("Somente o MESTRE da mesa pode autorizar exceções ao limite. Peça ao narrador para confirmar por você.")
                end
                return
            end
            adicionarPericiaDireto(
                tostring(sheet.pendPericiaAtributo or ""),
                tostring(sheet.pendPericiaNome or ""),
                tostring(sheet.pendPericiaLista or ""),
                true
            )
            if self.popLimitePericia ~= nil then self.popLimitePericia:close() end
        end

        function cancelarPericiaAlemDoLimite()
            if self.popLimitePericia ~= nil then self.popLimitePericia:close() end
        end

        -- Valvula de escape: apaga TODAS as pericias de um atributo de uma vez.
        -- Util se alguma lista ficar em estado estranho apos uma atualizacao.
        function limparListaPericias(nomeLista)
            if not podeEditarCriacao() then return end
            if sheet == nil then return end
            -- NUNCA apagar o no-container (sheet[nomeLista]): o recordList
            -- fica vinculado a ele, e se ele morrer o widget passa a apontar
            -- para um no morto - o efeito e que adicionar/remover so aparece
            -- depois de fechar e reabrir a ficha. Apagamos filho por filho.
            for _, no in ipairs(NDB.getChildNodes(sheet[nomeLista]) or {}) do
                NDB.deleteNode(no)
            end
            atualizarContadoresPericias()
        end


        -- Limite de pericias de um atributo = valor do atributo + vagas
        -- concedidas pelo sistema (poderes que dao "uma pericia deste
        -- atributo a sua escolha"). Sem somar as vagas, a concessao existiria
        -- no papel mas o jogador continuaria travado no limite.
        function limitePericiasDoAtributo(campoTotal)
            if sheet == nil then return 0 end
            local base = n(sheet[campoTotal])
            local raiz = tostring(campoTotal):gsub("Total$", "")
            return base + n(sheet[raiz .. "PericiasBonus"])
        end

        function vagasExtrasPericia(campoTotal)
            if sheet == nil then return 0 end
            local raiz = tostring(campoTotal):gsub("Total$", "")
            return n(sheet[raiz .. "PericiasBonus"])
        end

        function atualizarContadoresPericias()
            -- O painel de resumo do topo vive pendurado aqui de proposito:
            -- esta funcao e chamada por recalcularTudo, por ativarAba e a cada
            -- pericia adicionada ou removida. Antes o painel so era atualizado
            -- em ativarAba, e por isso so mudava ao reabrir a ficha.
            pcall(function() atualizarPainelAtributosPericias() end)
            local mapa = {
                {lista = "listaPericiasCarisma", campo = "carismaTotal", lbl = "lblContadorCarisma"},
                {lista = "listaPericiasDestreza", campo = "destrezaTotal", lbl = "lblContadorDestreza"},
                {lista = "listaPericiasForca", campo = "forcaTotal", lbl = "lblContadorForca"},
                {lista = "listaPericiasInteligencia", campo = "inteligenciaTotal", lbl = "lblContadorInteligencia"},
                {lista = "listaPericiasManipulacao", campo = "manipulacaoTotal", lbl = "lblContadorManipulacao"},
                {lista = "listaPericiasSabedoria", campo = "sabedoriaTotal", lbl = "lblContadorSabedoria"},
            }
            for _, item in ipairs(mapa) do
                local label = self[item.lbl]
                local atual = contarItensLista(item.lista)
                if label ~= nil then
                    local limite = limitePericiasDoAtributo(item.campo)
                    local extras = vagasExtrasPericia(item.campo)
                    local txt = tostring(atual) .. " / " .. tostring(limite)
                    if extras > 0 then txt = txt .. "  (+" .. extras .. ")" end
                    label:setText(txt)
                    if atual > limite then
                        label:setFontColor(COR.wine)
                    else
                        label:setFontColor(COR.faint)
                    end
                end

                -- ALTURA DO BLOCO PELO CONTEUDO (v0.42.1, L-01/T-02). O bloco
                -- de cada atributo era um card fixo de 260px com a lista
                -- align="client" dentro: vazio, sobravam ~160px de nada
                -- (sete vezes numa ficha nova, uma tela inteira em 1366×768);
                -- cheio, a lista rolava dentro de uma janelinha. Agora o card
                -- mede o que tem: cabecalho (40) + linha de botoes (36) +
                -- linhas × itemHeight (76) + margens, e o estado vazio e uma
                -- linha so, como o bloco da Constituicao ja era.
                -- Altura zero, e nao setVisible: esconder e mostrar um filho
                -- align="top" o manda para o topo da pilha.
                local sufixo = tostring(item.lista):gsub("^listaPericias", "")
                local bloco = self["abaAtr_bloco" .. sufixo]
                local vazio = self["abaAtr_vazio" .. sufixo]
                local alturaLista = (atual == 0) and 24 or (atual * 76 + 10)
                if bloco ~= nil then
                    pcall(function() bloco:setHeight(8 + 40 + 36 + alturaLista + 8) end)
                end
                if vazio ~= nil then
                    pcall(function() vazio:setHeight((atual == 0) and 24 or 0) end)
                end
            end
        end

        -- =================================================================
        -- QUALIDADES & DEFEITOS
        -- Economia (regra da mesa): 3 pontos base + ate 7 vindos de defeitos
        -- => teto de 10 pontos gastaveis em qualidades.
        -- =================================================================

        function somarPontosLista(nomeLista)
            local total = 0
            for _, item in ipairs(NDB.getChildNodes(sheet and sheet[nomeLista]) or {}) do
                total = total + (tonumber(item.pontosPagos) or 0)
            end
            return total
        end

        -- Devolve os escolhidos no formato que CatalogoQD.somarEfeitos espera
        function escolhidosQD()
            local lista = {}
            for _, nomeLista in ipairs({"listaQualidades", "listaDefeitos"}) do
                for _, item in ipairs(NDB.getChildNodes(sheet and sheet[nomeLista]) or {}) do
                    table.insert(lista, {nome = tostring(item.nome or ""), pontos = tonumber(item.pontosEscolhidos) or 0})
                end
            end
            return lista
        end

        function atualizarPainelPontosQD()
            if sheet == nil then return end
            local brutoDefeitos = somarPontosLista("listaDefeitos")
            local ganhoDefeitos = math.min(brutoDefeitos, CatalogoQD.MAX_PONTOS_DEFEITOS)
            local disponivel = CatalogoQD.PONTOS_BASE + ganhoDefeitos
            local gasto = somarPontosLista("listaQualidades")
            local saldo = disponivel - gasto

            if self.lblPontosDefeitos ~= nil then self.lblPontosDefeitos:setText(tostring(ganhoDefeitos)) end
            if self.lblPontosDefeitosAviso ~= nil then
                if brutoDefeitos > CatalogoQD.MAX_PONTOS_DEFEITOS then
                    self.lblPontosDefeitosAviso:setText("(" .. tostring(brutoDefeitos) .. " comprados - teto de 7)")
                else
                    self.lblPontosDefeitosAviso:setText("")
                end
            end
            if self.lblPontosDisponiveis ~= nil then self.lblPontosDisponiveis:setText(tostring(disponivel)) end
            if self.lblPontosGastos ~= nil then self.lblPontosGastos:setText(tostring(gasto)) end
            if self.lblPontosSaldo ~= nil then
                self.lblPontosSaldo:setText(tostring(saldo))
                if saldo < 0 then
                    self.lblPontosSaldo:setFontColor(COR.wine)
                elseif saldo == 0 then
                    self.lblPontosSaldo:setFontColor(COR.gold)
                else
                    self.lblPontosSaldo:setFontColor(COR.moss)
                end
            end
        end

        -- Busca o NO real (nao so um boolean) de uma qualidade/defeito ja
        -- adquirida, para permitir UPGRADE de tier em vez de bloquear como
        -- duplicata.
        local function buscarNoQD(listaCampo, nome)
            for _, item in ipairs(NDB.getChildNodes(sheet and sheet[listaCampo]) or {}) do
                if tostring(item.nome or "") == nome then return item end
            end
            return nil
        end

        -- Cria OU atualiza (upgrade) um item de Qualidade/Defeito.
        --   pontosEscolhidos = tier EFETIVO atual (o que vale pra automacao)
        --   pontosPagos      = quanto disso realmente saiu do saldo de PQ/PD
        -- A diferenca (pontosEscolhidos - pontosPagos) e o quanto foi
        -- concedido de graca (narrativa/mestre) - dai vem a borda dourada.
        local function salvarQD(noExistente, tipo, nome, pontosEscolhidos, pontosPagos, nomeLista)
            local dados = CatalogoQD.buscarPorNome(nome)
            local widgetLista = self[nomeLista]
            if widgetLista == nil then return end
            -- Em upgrade, NAO atualizamos os campos do no existente no lugar:
            -- o item de recordList so roda seu onNodeReady (que pinta o
            -- badge "X pago + Y gratis" e a borda dourada) quando o no e
            -- CRIADO, nao quando so os campos mudam. Por isso apagamos o no
            -- antigo e criamos um novo ja com os valores finais - a linha
            -- "renasce" e o visual atualiza na hora, sem precisar fechar e
            -- reabrir a ficha.
            if noExistente ~= nil then
                NDB.deleteNode(noExistente)
            end
            local node = widgetLista:append()
            if node ~= nil then
                node.tipo = tipo
                node.nome = nome
                node.pontosEscolhidos = pontosEscolhidos
                node.pontosPagos = pontosPagos
                node.descricao = dados and dados.descricao or ""
                node.pontosTexto = dados and dados.pontosTexto or ""
            end
            atualizarPainelPontosQD()
            atualizarBlocoRaca()
            recalcularTudo()
        end

        -- Estado transitorio de "qual item esta sendo detalhado agora" em
        -- cada popup - nao precisa ir para o sheet, vive so durante a sessao.
        local detalheQD = {}

        local function nomeListaDoPopup(nomePopup)
            return nomePopup == "popCatalogoQualidades" and "listaQualidades" or "listaDefeitos"
        end
        local function siglaDoPopup(nomePopup)
            return nomePopup == "popCatalogoQualidades" and "PQ" or "PD"
        end

        -- Chamada ao clicar num item da lista (coluna esquerda do popup).
        -- Preenche a coluna direita com titulo/descricao, os botoes de tier
        -- e o aviso de "voce ja possui isto" quando for o caso.
        function selecionarDetalheQD(tipo, nome, nomePopup)
            local dados = CatalogoQD.buscarPorNome(nome)
            local popupObj = self[nomePopup]
            if dados == nil or popupObj == nil then return end

            detalheQD[nomePopup] = {tipo = tipo, nome = nome}

            local sigla = siglaDoPopup(nomePopup)
            if self[nomePopup .. "_lblTitulo"] ~= nil then self[nomePopup .. "_lblTitulo"]:setText(nome) end
            if self[nomePopup .. "_lblPontosTexto"] ~= nil then
                self[nomePopup .. "_lblPontosTexto"]:setText(dados.pontosTexto .. " (" .. sigla .. ")")
            end
            if self[nomePopup .. "_lblDescricao"] ~= nil then
                -- Preenche cada painel de secao. Os paineis ficam SEMPRE
                -- visiveis (nunca escondemos): alternar visible= em elementos
                -- align="top" faz o layout se reorganizar e os titulos
                -- acabavam se amontoando no topo. Secao sem conteudo mostra
                -- um traco discreto.
                local secoes = {
                    {campo = "Descricao", texto = dados.descricao},
                    {campo = "Efeito",    texto = dados.efeito},
                    {campo = "Restricao", texto = dados.restricao},
                    {campo = "Automacao", texto = dados.automacao},
                }
                for _, sec in ipairs(secoes) do
                    local corpo = self[nomePopup .. "_lbl" .. sec.campo]
                    if corpo ~= nil then
                        local temTexto = (sec.texto ~= nil and sec.texto ~= "")
                        corpo:setText(temTexto and sec.texto or "—  (não se aplica a este item)")
                    end
                end
            end

            -- Aviso "voce ja possui isto" + reset do checkbox de gratuidade.
            local existente = buscarNoQD(nomeListaDoPopup(nomePopup), nome)
            if self[nomePopup .. "_lblJaPossui"] ~= nil then
                if existente ~= nil then
                    local pagos = tonumber(existente.pontosPagos) or 0
                    local efetivo = tonumber(existente.pontosEscolhidos) or 0
                    local extra = efetivo - pagos
                    local texto = "Você já possui: tier " .. tostring(efetivo) .. " (" .. tostring(pagos) .. " " .. sigla .. " pago"
                    if extra > 0 then texto = texto .. " + " .. tostring(extra) .. " de narrativa" end
                    texto = texto .. "). Escolher um tier maior abaixo faz upgrade, cobrando só a diferença."
                    self[nomePopup .. "_lblJaPossui"]:setText(texto)
                else
                    self[nomePopup .. "_lblJaPossui"]:setText("")
                end
            end
            if self[nomePopup .. "_chkGratis"] ~= nil then self[nomePopup .. "_chkGratis"].checked = false end

            -- botoes de tier fixos (ate 4) - mostra so os que existem, e some
            -- os 4 se o item for de faixa continua (nesse caso mostra o
            -- campo numerico + confirmar no lugar).
            for i = 1, 4 do
                local botao = self[nomePopup .. "_btnTier" .. i]
                local rotulo = self[nomePopup .. "_lblTier" .. i]
                if botao ~= nil then
                    if (not dados.faixaContinua) and dados.opcoesPontos[i] ~= nil then
                        botao:setVisible(true)
                        if rotulo ~= nil then rotulo:setText(tostring(dados.opcoesPontos[i]) .. " " .. sigla) end
                    else
                        botao:setVisible(false)
                    end
                end
            end

            local rectFaixa = self[nomePopup .. "_rectFaixa"]
            local btnFaixaConfirmar = self[nomePopup .. "_btnFaixaConfirmar"]
            local editFaixa = self[nomePopup .. "_editFaixa"]
            if rectFaixa ~= nil then rectFaixa:setVisible(dados.faixaContinua == true) end
            if btnFaixaConfirmar ~= nil then btnFaixaConfirmar:setVisible(dados.faixaContinua == true) end
            if editFaixa ~= nil and dados.faixaContinua then
                editFaixa:setText(tostring(dados.pontosMin))
            end
        end

        -- "indiceTier" e a posicao (1-4) no botao clicado.
        function confirmarAdicaoQD(nomePopup, indiceTier)
            local alvo = detalheQD[nomePopup]
            if alvo == nil then return end
            local dados = CatalogoQD.buscarPorNome(alvo.nome)
            if dados == nil then return end

            local pontos = dados.opcoesPontos[indiceTier]
            if pontos == nil then return end

            local gratis = false
            local chk = self[nomePopup .. "_chkGratis"]
            if chk ~= nil then gratis = (chk.checked == true) end

            processarQD(alvo.tipo, alvo.nome, pontos, gratis, nomeListaDoPopup(nomePopup), nomePopup)
        end

        function confirmarAdicaoQDFaixa(nomePopup)
            local alvo = detalheQD[nomePopup]
            if alvo == nil then return end
            local dados = CatalogoQD.buscarPorNome(alvo.nome)
            local popupObj = self[nomePopup]
            if dados == nil or popupObj == nil then return end
            local editFaixa = self[nomePopup .. "_editFaixa"]
            local pontos = n(editFaixa and editFaixa:getText())
            if pontos < dados.pontosMin then pontos = dados.pontosMin end
            if pontos > dados.pontosMax then pontos = dados.pontosMax end

            local gratis = false
            local chk = self[nomePopup .. "_chkGratis"]
            if chk ~= nil then gratis = (chk.checked == true) end

            processarQD(alvo.tipo, alvo.nome, pontos, gratis, nomeListaDoPopup(nomePopup), nomePopup)
        end

        -- Nucleo unico: decide entre CRIAR, ATUALIZAR (upgrade) ou colocar em
        -- espera por autorizacao do mestre. "pontosAlvo" e o tier EFETIVO
        -- desejado; so cobramos a diferenca entre ele e o que ja foi pago.
        function processarQD(tipo, nome, pontosAlvo, gratis, nomeLista, nomePopup)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                if self[nomePopup] ~= nil then self[nomePopup]:close() end
                if self.lblLimiteQDTexto ~= nil then self.lblLimiteQDTexto:setText(motivoTravaCriacao()) end
                if self.popLimiteQD ~= nil then self.popLimiteQD:show() end
                return
            end
            if self[nomePopup] ~= nil then self[nomePopup]:close() end

            local existente = buscarNoQD(nomeLista, nome)
            local pagosAtuais = existente and (tonumber(existente.pontosPagos) or 0) or 0
            local efetivoAtual = existente and (tonumber(existente.pontosEscolhidos) or 0) or 0

            if pontosAlvo <= efetivoAtual then
                return -- ja possui este tier ou um maior; nada a fazer
            end

            -- quanto isso custaria SE fosse pago integralmente agora
            local custoNecessario = gratis and 0 or (pontosAlvo - pagosAtuais)
            if custoNecessario < 0 then custoNecessario = 0 end

            if tipo == "Defeito" or custoNecessario == 0 then
                salvarQD(existente, tipo, nome, pontosAlvo, pagosAtuais + custoNecessario, nomeLista)
                return
            end

            -- Qualidade paga: precisa caber no saldo
            local ganhoDefeitos = math.min(somarPontosLista("listaDefeitos"), CatalogoQD.MAX_PONTOS_DEFEITOS)
            local disponivel = CatalogoQD.PONTOS_BASE + ganhoDefeitos
            local gasto = somarPontosLista("listaQualidades")
            if gasto + custoNecessario <= disponivel then
                salvarQD(existente, tipo, nome, pontosAlvo, pagosAtuais + custoNecessario, nomeLista)
            else
                sheet.pendQDTipo = tipo
                sheet.pendQDNome = nome
                sheet.pendQDPontosAlvo = pontosAlvo
                sheet.pendQDCusto = custoNecessario
                sheet.pendQDLista = nomeLista
                if self.lblLimiteQDTexto ~= nil then
                    self.lblLimiteQDTexto:setText(
                        "\"" .. nome .. "\" precisa de mais " .. tostring(custoNecessario) .. " PQ, mas voce so tem " ..
                        tostring(disponivel - gasto) .. " de saldo (disponivel " .. tostring(disponivel) ..
                        ", ja gasto " .. tostring(gasto) .. "). Compre mais defeitos ou peca autorizacao ao mestre.")
                end
                if self.popLimiteQD ~= nil then self.popLimiteQD:show() end
            end
        end

        function confirmarQDAlemDoLimite()
            if sheet == nil then return end
            -- Excecao de saldo = decisao do mestre.
            if not usuarioEhMestre() then
                if self.lblLimiteQDTexto ~= nil then
                    self.lblLimiteQDTexto:setText("Somente o MESTRE da mesa pode autorizar compras acima do saldo. Peça ao narrador para confirmar por você.")
                end
                return
            end
            local nomeLista = tostring(sheet.pendQDLista or "")
            local nome = tostring(sheet.pendQDNome or "")
            local existente = buscarNoQD(nomeLista, nome)
            local pagosAtuais = existente and (tonumber(existente.pontosPagos) or 0) or 0
            local custo = tonumber(sheet.pendQDCusto) or 0
            salvarQD(
                existente,
                tostring(sheet.pendQDTipo or ""),
                nome,
                tonumber(sheet.pendQDPontosAlvo) or 0,
                pagosAtuais + custo,
                nomeLista
            )
            if self.popLimiteQD ~= nil then self.popLimiteQD:close() end
        end

        function cancelarQDAlemDoLimite()
            if self.popLimiteQD ~= nil then self.popLimiteQD:close() end
        end

        function limparListaQD(nomeLista)
            if sheet == nil then return end
            if not podeEditarCriacao() then return end
            -- Idem: apaga filho por filho, nunca o container.
            for _, no in ipairs(NDB.getChildNodes(sheet[nomeLista]) or {}) do
                NDB.deleteNode(no)
            end
            atualizarPainelPontosQD()
            atualizarBlocoRaca()
            recalcularTudo()
        end

        -- =================================================================
        -- RACA (catalogo-popup, liberacao por qualidade e automacao)
        --
        -- REGRAS DE LIBERACAO (ver catalogoRacas.lua):
        --   Jogavel    -> livre
        --   NaoJogavel -> exige a qualidade "Mestico" ou "Sangue das racas
        --                 antigas" (ou autorizacao do mestre)
        --   Primordial -> so com autorizacao do mestre
        --
        -- MESTICO define quantas caracteristicas raciais o jogador ESCOLHE e
        -- quantas sao SORTEADAS: 0 pts = rola todas, 1 pt = escolhe metade,
        -- 2 pts = escolhe todas.
        -- =================================================================
        local detalheRacaAtual = nil -- nome da raca sendo exibida no popup agora

        -- Le, na lista de qualidades da ficha, se o personagem tem as
        -- qualidades que liberam racas e com quantos pontos (tier).
        -- Toda qualidade do livro que CONCEDE raca precisa ser lida aqui. A
        -- checagem 26 do verifica.py varre o catalogo de qualidades atras de
        -- "receba a raca" / "direito de fazer uma ficha com" e falha o build
        -- se aparecer uma que esta funcao nao conhece - foi o buraco que
        -- deixou Lobisomens travada ate a v0.35.6.
        function contextoRacial()
            local ctx = {temMestico = false, tierMestico = 0, temSangueAntigas = false,
                         temLinhagemNoite = false, autorizacaoMestre = false}
            if sheet == nil then return ctx end
            ctx.autorizacaoMestre = (sheet.autorizacaoMestreRaca == true)
            for _, item in ipairs(NDB.getChildNodes(sheet.listaQualidades) or {}) do
                local nome = tostring(item.nome or "")
                if nome == "Mestiço" then
                    ctx.temMestico = true
                    ctx.tierMestico = tonumber(item.pontosEscolhidos) or 0
                elseif nome == "Sangue das raças antigas" then
                    ctx.temSangueAntigas = true
                elseif nome == "Linhagem da noite" then
                    -- "Receba a raça 'Lobisomem (Nascido)'" - libera SO
                    -- Lobisomens (raca.linhagemNoite), e nao as nao-jogaveis
                    -- em geral.
                    ctx.temLinhagemNoite = true
                end
            end
            return ctx
        end

        -- Reconstroi a recordList de caracteristicas raciais da aba.
        -- Usamos recordList (nao slots fixos com visible=) porque alternar
        -- visible= em elementos align="top" reordena o layout - foi o que
        -- bagunçou esta aba antes.
        local function preencherListaCaracsRaciais(lista, marcarBloqueioHumanoPuro)
            if sheet == nil then return end
            local widget = self.listaCaracsRaciais
            if widget == nil then return end

            for _, no in ipairs(NDB.getChildNodes(sheet.listaCaracsRaciais) or {}) do
                NDB.deleteNode(no)
            end
            -- A ALTERNATIVA NAO ESCOLHIDA SOME DA LISTA (v0.42.1).
            -- Pedido do usuario, olhando a tela: deixar as duas ali e
            -- explicar num texto pequeno que uma nao vale polui o bloco
            -- roxo. Escolhida uma, so ela aparece. ENQUANTO NADA FOR
            -- ESCOLHIDO as DUAS continuam na lista: e a unica forma de o
            -- jogador ler o que cada uma faz antes de decidir — esconder
            -- as duas trocaria um bloco poluido por uma escolha as cegas.
            local dadosRacaAtual = nil
            if sheet ~= nil then
                dadosRacaAtual = CatalogoRacas.buscarPorNome(tostring(sheet.raca or ""))
            end
            local escolhido = sheet ~= nil and tostring(sheet.racaTracoEscolhido or "") or ""
            local quantosEntraram = 0
            for _, car in ipairs(lista or {}) do
                local ehAlternativa = (car.modo or "") == ""
                    and tracoEhAlternativaExclusiva(dadosRacaAtual, car.nome)
                -- ja escolheram, e nao foi esta: fica de fora
                local entra = not (ehAlternativa and escolhido ~= ""
                                   and escolhido ~= car.nome)
                if entra then
                    local node = widget:append()
                    if node ~= nil then
                        quantosEntraram = quantosEntraram + 1
                        node.nome = car.nome
                        node.descricao = car.descricao
                        node.origem = car.origem or ""
                        node.modo = car.modo or ""
                        -- O "OU" DO LIVRO. O campo leva um MARCADOR ASCII e a
                        -- frase acentuada e montada dentro do
                        -- itemCaracRacial.lfm — separa o valor logico do texto
                        -- de tela. (O embaralhado de 05/09/2026 nao vinha
                        -- daqui: a sonda mostrou o texto voltar ao normal ao
                        -- mudar a FORMA do rotulo do selo. Ver o CHANGELOG.)
                        if ehAlternativa then
                            node.alternativa = (escolhido == car.nome) and "sim" or "pendente"
                        else
                            node.alternativa = ""
                        end
                        node.bloqueada = (marcarBloqueioHumanoPuro == true
                            and car.nome == CatalogoRacas.CARACTERISTICA_SO_HUMANO_PURO)
                    end
                end
            end
            -- A lista vive dentro de um scrollBox: precisa de altura explicita.
            -- a altura conta o que ENTROU, nao o que veio: com a
            -- alternativa nao escolhida fora, sobraria buraco no fim.
            ajustarAlturaListaCaracs(quantosEntraram)
        end

        -- Preenche os slots do POPUP de raca (esses continuam sendo slots
        -- fixos, porque ali a lista e so leitura e o popup e recriado a cada
        -- abertura).
        local function preencherCaracteristicasPopup(lista, soHumanoPuro)
            for i = 1, 12 do
                local sec = self["popRaca_secCarac" .. i]
                local lblNome = self["popRaca_lblCaracNome" .. i]
                local lblDesc = self["popRaca_lblCaracDesc" .. i]
                local dado = lista and lista[i] or nil
                if sec ~= nil then sec:setVisible(dado ~= nil) end
                if dado ~= nil then
                    local nome = dado.nome
                    local desc = dado.descricao
                    if soHumanoPuro and dado.nome == CatalogoRacas.CARACTERISTICA_SO_HUMANO_PURO then
                        nome = nome .. "  (indisponível para mestiços)"
                        desc = "BLOQUEADA: esta característica só existe para humanos puros.\n\n" .. desc
                        if lblNome ~= nil then lblNome:setFontColor(COR.wine) end
                        if sec ~= nil then sec:setStrokeColor(COR.wine) end
                    else
                        if lblNome ~= nil then lblNome:setFontColor(COR.gold) end
                        if sec ~= nil then sec:setStrokeColor("#3A2E52") end
                    end
                    if lblNome ~= nil then lblNome:setText(nome) end
                    if lblDesc ~= nil then lblDesc:setText(desc) end
                end
            end
        end

        function selecionarDetalheRaca(nome)
            local dados = CatalogoRacas.buscarPorNome(nome)
            if dados == nil then return end
            detalheRacaAtual = nome

            local ctx = contextoRacial()
            local permitido, motivo = CatalogoRacas.podeEscolher(dados, ctx)

            pcall(function() atualizarSeletorAtributoRacial() end)
            pcall(function() atualizarSeletorDefesaMental() end)
            if self.popRaca_lblTitulo ~= nil then self.popRaca_lblTitulo:setText(dados.nome) end
            if self.popRaca_lblSubtitulo ~= nil then
                local rotuloCat = "Jogável"
                if dados.categoria == "NaoJogavel" then rotuloCat = "Não-jogável"
                elseif dados.categoria == "Primordial" then rotuloCat = "Primordial" end
                self.popRaca_lblSubtitulo:setText(
                    rotuloCat .. "   •   Origem: " .. dados.origem ..
                    "   •   Tipo: " .. dados.tipo .. "   •   Alinhamento: " .. dados.alinhamento)
            end

            -- Aviso de bloqueio / liberacao
            if self.popRaca_secAviso ~= nil then
                local mostrar = (motivo ~= "")
                self.popRaca_secAviso:setVisible(mostrar)
                if mostrar and self.popRaca_lblAviso ~= nil then
                    self.popRaca_lblAviso:setText(motivo)
                    if permitido then
                        self.popRaca_secAviso:setStrokeColor(COR.moss)
                        self.popRaca_lblAviso:setFontColor("#A9D6C4")
                    else
                        self.popRaca_secAviso:setStrokeColor(COR.wine)
                        self.popRaca_lblAviso:setFontColor("#E2AEB6")
                    end
                end
            end

            if self.popRaca_lblBase ~= nil then
                if dados.jogavel then
                    self.popRaca_lblBase:setText("Deslocamento: " .. dados.deslocamentoTexto .. "     •     Dado de Vida: " .. dados.dadoVidaTexto)
                else
                    self.popRaca_lblBase:setText("Sem regras de personagem definidas no documento da mesa.")
                end
            end

            preencherCaracteristicasPopup(dados.caracteristicas, false)
            if self.popRaca_lblLore ~= nil then self.popRaca_lblLore:setText(dados.lore) end

            if self.popRaca_lblBtnDefinir ~= nil then
                if permitido then
                    self.popRaca_lblBtnDefinir:setText("DEFINIR COMO MINHA RAÇA")
                    self.popRaca_lblBtnDefinir:setFontColor(COR.gold)
                else
                    self.popRaca_lblBtnDefinir:setText("BLOQUEADA - VEJA O AVISO ACIMA")
                    self.popRaca_lblBtnDefinir:setFontColor(COR.faint)
                end
            end
        end

        function confirmarDefinirRaca()
            if sheet == nil or detalheRacaAtual == nil then return end
            if not podeEditarCriacao() then
                if self.popRaca_lblBtnDefinir ~= nil then self.popRaca_lblBtnDefinir:setText("FICHA FINALIZADA - SÓ O MESTRE PODE ALTERAR") end
                return
            end
            local dados = CatalogoRacas.buscarPorNome(detalheRacaAtual)
            if dados == nil then return end

            local ctx = contextoRacial()
            local permitido = CatalogoRacas.podeEscolher(dados, ctx)
            if not permitido then return end -- botao bloqueado: nao faz nada

            sheet.raca = dados.nome
            if dados.jogavel then
                sheet.deslocamentoBaseRaca = dados.deslocamentoNum
                sheet.dadoVida = dados.dadoVidaNum
                -- aplicarAtributosBaseRaciais escreve os MODOS (voo, nado,
                -- forma alternativa) e refaz a conta do mestiço.
                aplicarAtributosBaseRaciais()
            end

            if self.popCatalogoRacas ~= nil then self.popCatalogoRacas:close() end
            -- Com sheet.raca ja gravado, as concessoes da nova raca entram e
            -- as da antiga saem na hora, antes de qualquer calculo.
            aplicarConcessoes()
            atualizarBlocoRaca()
            recalcularTudo()
        end

        -- Atualiza todo o bloco de raca na propria aba.
        -- =================================================================
        -- MESTICAGEM
        --
        -- Regra da mesa: um mestico e sempre HUMANO + outra raca, e fica com
        -- 3 caracteristicas raciais no total, tiradas de um "pool" formado
        -- pelas caracteristicas das DUAS racas.
        --   Mestico 0 PQ -> sorteia as 3
        --   Mestico 1 PQ -> escolhe 1 (metade de 3, arredondado pra baixo) e sorteia 2
        --   Mestico 2 PQ -> escolhe as 3
        -- "Favorecimento divino" e exclusiva de humano PURO, entao fica fora
        -- do pool de qualquer mestico.
        -- =================================================================
        local TOTAL_CARACS_MESTICO = 3

        -- =================================================================
        -- LACRE DE SORTEIO
        --
        -- PROBLEMA QUE ISTO RESOLVE: antes, "REFAZER HERANCA" e "LIMPAR
        -- RACA" apagavam o resultado inteiro, entao o jogador podia rolar as
        -- caracteristicas sorteadas quantas vezes quisesse ate cair um
        -- conjunto bom - o sorteio nao custava nada. Existiam ainda outras
        -- duas portas para o mesmo abuso: remover e recomprar a qualidade
        -- Mestico, e trocar a raca secundaria (o sorteio depende dela).
        --
        -- SOLUCAO: o sorteio grava um LACRE na ficha. A partir dele:
        --   * as caracteristicas SORTEADAS ficam imutaveis;
        --   * as ESCOLHIDAS continuam trocaveis a vontade (e o beneficio
        --     que o jogador pagou ao comprar o tier);
        --   * a raca secundaria fica congelada (faz parte do sorteio);
        --   * o TIER fica congelado: subir de Mestico 1 para 2 depois do
        --     sorteio NAO converte sorteadas em escolhidas sozinho - so com
        --     autorizacao do mestre (decisao da mesa).
        --
        -- O lacre vive em campos planos da ficha, entao SOBREVIVE a remover
        -- a qualidade Mestico e a limpar a raca: recomprar a qualidade
        -- devolve exatamente o mesmo sorteio, nao um novo.
        --
        -- IMPORTANTE: isto e uma trava de INTERFACE, nao de dados - o dono
        -- da ficha ainda consegue editar o NDB por outros caminhos. O que
        -- realmente segura a regra e a publicacao do sorteio no chat da
        -- mesa, com autor e data, testemunhada por todos.
        -- =================================================================
        local poolMestico = {}      -- pool atual mostrado no popup
        local escolhasMestico = {}  -- indices marcados pelo jogador
        local travadosMestico = {}  -- indices do pool ja lacrados (sorteados)

        -- Nome da raca PRINCIPAL (a do campo roxo no topo da aba de Raca).
        -- REGRA DA MESA (corrigida em v0.14.2): a mestiçagem nao e exclusiva
        -- de Humanos. Qualquer raca pode se mesticar com qualquer outra,
        -- desde que a raca PRINCIPAL seja das Jogaveis.
        function racaPrincipalMestico()
            if sheet == nil then return "" end
            return tostring(sheet.raca or "")
        end

        function racaPrincipalPodeMesticar()
            local r = CatalogoRacas.buscarPorNome(racaPrincipalMestico())
            if r == nil then return false end
            return r.categoria == "Jogavel"
        end

        -- Monta o pool (raca principal + secundaria), ja sem a caracteristica
        -- exclusiva de humano puro (que so existe em Humanos de sangue puro).
        local function montarPoolMestico(nomeSecundaria)
            local pool = {}
            local nomePrincipal = racaPrincipalMestico()
            local principal = CatalogoRacas.buscarPorNome(nomePrincipal)
            if principal ~= nil then
                for _, car in ipairs(principal.caracteristicas) do
                    if car.nome ~= CatalogoRacas.CARACTERISTICA_SO_HUMANO_PURO then
                        table.insert(pool, {nome = car.nome, descricao = car.descricao, origem = nomePrincipal})
                    end
                end
            end
            local outra = CatalogoRacas.buscarPorNome(nomeSecundaria)
            if outra ~= nil then
                for _, car in ipairs(outra.caracteristicas) do
                    table.insert(pool, {nome = car.nome, descricao = car.descricao, origem = outra.nome})
                end
            end
            return pool
        end

        -- =================================================================
        -- CHAT DA MESA
        -- Padrao do SDK: Firecast.getMesaDe(sheet) -> mesa.chat. Usamos
        -- asyncSendStd quando existe (permite TaleMark) e caimos em
        -- enviarMensagem quando nao. Tudo em pcall: a ficha pode estar aberta
        -- fora de uma mesa (editor da biblioteca), e nesse caso publicar no
        -- chat nao pode quebrar o fluxo.
        -- =================================================================
        local TALEMARK_PETRICHOR = {
            defaultTextStyle = {color = "#C9A24B"},
            parseCommonMarkStrongEmphasis = true,
            parseHeadings = false,
            parseHorzLines = false,
            parseURL = false,
            trimTexts = true,
        }

        local function mesaAtual()
            local ok, mesa = pcall(function() return Firecast.getMesaDe(sheet) end)
            if ok then return mesa end
            return nil
        end

        function nickDoUsuario()
            local mesa = mesaAtual()
            if mesa ~= nil and mesa.meuJogador ~= nil then
                local nick = tostring(mesa.meuJogador.nick or "")
                if nick ~= "" then return nick end
            end
            return "Jogador"
        end

        local function dataHoraTexto()
            local ok, txt = pcall(function() return os.date("%d/%m/%Y %H:%M") end)
            if ok and txt ~= nil then return tostring(txt) end
            return "data desconhecida"
        end

        -- ---------------------------------------------------------------
        -- PUBLICAR NO CHAT
        --
        -- A cor da mensagem viaja pelo "defaultTextStyle" do talemarkOptions,
        -- e nao por tag de cor no meio do texto.
        --
        -- MOTIVO: as tags de cor do Firecast sao "[§K<indice>]", com indice
        -- numerico, e NAO FECHAM - o que existe e repintar. As formas
        -- "[§K #RRGGBB]" e "[§K]" que esta ficha usava nao existem: a primeira
        -- pintava por acidente (o parser aceita a tag e cai numa cor
        -- qualquer) e a segunda saia LITERAL na tela do jogador.
        --
        -- Como o defaultTextStyle ja e passado por mensagem, dar a cor por ali
        -- resolve sem depender de indice de paleta, que varia por instalacao.
        --
        -- Para destaque dentro da frase, CommonMark: parseCommonMarkStrong-
        -- Emphasis esta ligado, entao "**texto**" desenha em negrito.
        -- ---------------------------------------------------------------
        function publicarNoChat(texto, cor)
            pcall(function()
                local mesa = mesaAtual()
                if mesa == nil or mesa.chat == nil then return end
                local opcoes = TALEMARK_PETRICHOR
                if cor ~= nil then
                    opcoes = {
                        defaultTextStyle = {color = cor},
                        parseCommonMarkStrongEmphasis = true,
                        parseHeadings = false,
                        parseHorzLines = false,
                        parseURL = false,
                        trimTexts = true,
                    }
                end
                if mesa.chat.asyncSendStd ~= nil then
                    mesa.chat:asyncSendStd(tostring(texto),
                        {impersonation = {mode = "none"}, talemarkOptions = opcoes})
                else
                    mesa.chat:enviarMensagem(tostring(texto))
                end
            end)
        end

        -- Negrito CommonMark com as pontas limpas: o "*" de abertura nao pode
        -- ter espaco depois nem o de fechamento antes, senao nao vira enfase.
        function neg(txt)
            local s = tostring(txt or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if s == "" then return "" end
            return "**" .. s .. "**"
        end
        -- =================================================================
        -- MENSAGENS DE MESA
        --
        -- Toda mensagem que a ficha manda para o chat nasce aqui, para que
        -- todas tenham a mesma cara. Cada anuncio tem um emblema, um titulo em
        -- negrito e o corpo.
        --
        -- O que pode ser usado, medido nesta instalacao do Firecast:
        --   - CommonMark "**negrito**" e "*italico*"  DESENHAM
        --   - emoji e blocos Unicode                  DESENHAM
        --   - acentuacao                              DESENHA
        --   - a cor vem do defaultTextStyle, por mensagem
        --
        -- O que NAO existe: tag de fechar cor. "[§K]" e "[§K #RRGGBB]" saem
        -- literais na tela. Nao volte a usar nenhuma das duas.
        --
        -- SEPARADOR: nao esta medido se o chat quebra linha com "\n" nesta
        -- instalacao, entao SEP e um ponto unico de troca. Se um dia a quebra
        -- for confirmada em mesa, muda-se aqui e as 17 mensagens mudam juntas.
        -- =================================================================

        local SEP = "  ·  "

        local EMBLEMA = {
            traco       = "🎭",
            favor       = "🕯️",
            troca       = "⚖️",
            bencao      = "✨",
            macula      = "🩸",
            lacre       = "🔒",
            rompido     = "🔓",
            proclamacao = "👑",
            -- retirar uma bênção ou uma proclamação não é o mesmo que uma
            -- mácula: a mácula é uma divindade que rejeita o personagem de
            -- saída; a revogação é o deus tomando de volta o que já deu.
            revogacao   = "⚱️",
            mestre      = "🛡️",
            mesticagem  = "⛓",
            aspecto     = "🌟",
            background  = "📖",
            nivel       = "⬆️",
        }

        -- Monta o anuncio inteiro. O titulo vai em negrito; o corpo, cru.
        function anuncio(chave, titulo, corpo)
            local emblema = EMBLEMA[chave] or "•"
            return emblema .. " " .. neg(titulo) .. SEP .. tostring(corpo or "")
        end

        -- Nome do personagem, com um fallback que nunca sai vazio na tela.
        function nomeDoPersonagem()
            local nome = tostring((sheet ~= nil and sheet.nome) or "")
            if nome == "" then return "O personagem" end
            return nome
        end

        -- As mensagens de traco, num lugar so: a de troca e usada pelo jogador
        -- e as outras duas pelo mestre.
        function mensagemTraco(acao, nome, anterior)
            if acao == "trocou" then
                return anuncio("traco", "TRAÇO DE PERSONALIDADE",
                    nomeDoPersonagem() .. " deixou de ser " .. neg(anterior) ..
                    " e agora é " .. neg(nome) .. ".")
            elseif acao == "concedeu" then
                return anuncio("traco", "TRAÇO DE PERSONALIDADE",
                    nomeDoPersonagem() .. " recebeu " .. neg(nome) ..
                    ", por " .. nickDoUsuario() .. ".")
            else
                return anuncio("traco", "TRAÇO DE PERSONALIDADE",
                    nomeDoPersonagem() .. " perdeu " .. neg(nome) ..
                    ", por " .. nickDoUsuario() .. ".")
            end
        end


        -- =================================================================
        -- ESTADO DO LACRE
        -- =================================================================
        function mesticagemLacrada()
            return sheet ~= nil and sheet.mesticoLacre == true
        end

        -- Tier que vale AGORA para decidir quantas caracteristicas o jogador
        -- escolhe. Antes do lacre: o tier atual da qualidade. Depois: o tier
        -- congelado no sorteio - a menos que o mestre autorize o reajuste.
        function tierEfetivoMestico()
            local ctx = contextoRacial()
            if not mesticagemLacrada() then return ctx.tierMestico end
            if sheet.mesticoReajusteAutorizado == true then return ctx.tierMestico end
            return tonumber(sheet.mesticoLacreTier) or ctx.tierMestico
        end

        local function estaEscolhido(indice)
            for _, v in ipairs(escolhasMestico) do
                if v == indice then return true end
            end
            return false
        end

        local function estaTravado(indice)
            return travadosMestico[indice] == true
        end

        local function qtdEscolhasPermitidas()
            return CatalogoRacas.escolhasPorTierMestico(tierEfetivoMestico(), TOTAL_CARACS_MESTICO)
        end

        -- Mensagem curta no rodape do painel de mesticagem da aba.
        function avisarMestico(texto, cor)
            if self.abaRaca_lblAvisoMestico == nil then return end
            self.abaRaca_lblAvisoMestico:setText(tostring(texto or ""))
            self.abaRaca_lblAvisoMestico:setFontColor(cor or COR.wine)
        end

        function motivoLacre()
            return "Herança lacrada em " .. tostring(sheet.mesticoLacreData or "?")
                .. " por " .. tostring(sheet.mesticoLacreAutor or "?")
                .. ". As características SORTEADAS não podem ser apagadas nem refeitas — peça ao mestre para quebrar o lacre."
        end

        -- =================================================================
        -- POPUP DE MESTICAGEM
        -- =================================================================
        local function repintarPoolMestico()
            local permitidas = qtdEscolhasPermitidas()
            local lacrada = mesticagemLacrada()
            for i = 1, 12 do
                local sec = self["popMest_secCarac" .. i]
                local lblNome = self["popMest_lblCaracNome" .. i]
                local lblDesc = self["popMest_lblCaracDesc" .. i]
                local dado = poolMestico[i]
                if sec ~= nil then sec:setVisible(dado ~= nil) end
                if dado ~= nil then
                    local travado = estaTravado(i)
                    local marcado = estaEscolhido(i)
                    local prefixo = ""
                    if travado then prefixo = "[LACRADA]  "
                    elseif marcado then prefixo = "[X]  " end
                    if lblNome ~= nil then
                        lblNome:setText(prefixo .. dado.nome .. "   (" .. dado.origem .. ")")
                        if travado then
                            lblNome:setFontColor(COR.rain)
                        else
                            lblNome:setFontColor(marcado and COR.gold or COR.muted)
                        end
                    end
                    if lblDesc ~= nil then
                        if travado then
                            lblDesc:setText("SORTEADA E LACRADA — não pode ser trocada.\n" .. dado.descricao)
                        else
                            lblDesc:setText(dado.descricao)
                        end
                    end
                    if sec ~= nil then
                        if travado then
                            sec:setStrokeColor(COR.rain)
                            sec:setStrokeSize(2)
                        else
                            sec:setStrokeColor(marcado and COR.gold or COR.line)
                            sec:setStrokeSize(marcado and 2 or 1)
                        end
                    end
                end
            end

            if self.popMest_lblContador ~= nil then
                if permitidas == 0 then
                    self.popMest_lblContador:setText("Seu tier de Mestiço não permite escolher: as "
                        .. tostring(TOTAL_CARACS_MESTICO) .. " características serão TODAS sorteadas.")
                else
                    self.popMest_lblContador:setText("Escolhidas " .. tostring(#escolhasMestico) .. " de "
                        .. tostring(permitidas) .. " permitidas  •  as outras "
                        .. tostring(TOTAL_CARACS_MESTICO - permitidas)
                        .. (lacrada and " permanecem lacradas" or " serão sorteadas"))
                end
            end

            if self.popMest_lblBtnConfirmar ~= nil then
                if lacrada then
                    if permitidas == 0 then
                        self.popMest_lblBtnConfirmar:setText("NADA A TROCAR NESTE TIER")
                        self.popMest_lblBtnConfirmar:setFontColor(COR.faint)
                    else
                        self.popMest_lblBtnConfirmar:setText("SALVAR AS ESCOLHIDAS  (as sorteadas não mudam)")
                        self.popMest_lblBtnConfirmar:setFontColor(COR.gold)
                    end
                else
                    self.popMest_lblBtnConfirmar:setText("CONFIRMAR E SORTEAR  •  RESULTADO FICA LACRADO")
                    self.popMest_lblBtnConfirmar:setFontColor(COR.gold)
                end
            end
        end

        -- Reconstroi pool + marcacoes a partir do que ja esta gravado.
        -- Com o lacre ativo, os indices correspondentes as SORTEADAS entram em
        -- travadosMestico e as ESCOLHIDAS ja vem pre-marcadas.
        local function prepararPoolMestico(nomeSecundaria)
            poolMestico = montarPoolMestico(nomeSecundaria)
            escolhasMestico = {}
            travadosMestico = {}
            if not mesticagemLacrada() then return end

            local definidas = caracteristicasMesticoDefinidas()
            for _, car in ipairs(definidas) do
                for i, p in ipairs(poolMestico) do
                    if p.nome == car.nome and p.origem == car.origem then
                        if car.modo == "Sorteada" then
                            travadosMestico[i] = true
                        else
                            table.insert(escolhasMestico, i)
                        end
                        break
                    end
                end
            end
        end

        function abrirPopupMestico()
            if self.popMestico == nil then return end

            -- REGRA DA MESA: a mestiçagem parte de uma raça PRINCIPAL das
            -- Jogáveis. A segunda raça pode ser qualquer uma (respeitadas as
            -- travas de acesso já existentes), mas a base precisa ser jogável.
            if racaPrincipalMestico() == "" then
                avisarMestico("Escolha primeiro a sua raça principal, no campo acima.", COR.wine)
                return
            end
            if not racaPrincipalPodeMesticar() then
                avisarMestico("A mestiçagem exige que a raça principal seja das Jogáveis. " ..
                    racaPrincipalMestico() .. " não é jogável.", COR.wine)
                return
            end

            local secundaria = tostring(sheet and sheet.mesticoRacaSecundaria or "")
            if secundaria ~= "" then
                escolherRacaSecundariaMestico(secundaria)
            else
                poolMestico = {}
                escolhasMestico = {}
                travadosMestico = {}
                repintarPoolMestico()
                if self.popMest_lblTitulo ~= nil then self.popMest_lblTitulo:setText("Escolha a segunda raça na lista ao lado") end
                if self.popMest_lblRegra ~= nil then self.popMest_lblRegra:setText("") end
            end
            abrirPopupAjustado(self.popMestico, 980, 660)
        end

        function escolherRacaSecundariaMestico(nome)
            local outra = CatalogoRacas.buscarPorNome(nome)
            if outra == nil then return end

            -- Mesma raça dos dois lados nao e mesticagem.
            if nome == racaPrincipalMestico() then
                if self.popMest_lblRegra ~= nil then
                    self.popMest_lblRegra:setText("A segunda raça precisa ser diferente da sua raça principal (" ..
                        racaPrincipalMestico() .. ").")
                    self.popMest_lblRegra:setFontColor("#E2AEB6")
                end
                return
            end

            -- Com o lacre ativo a raca secundaria faz parte do sorteio: nao
            -- pode ser trocada (era a quarta porta de re-sorteio).
            local secundariaAtual = tostring(sheet and sheet.mesticoRacaSecundaria or "")
            if mesticagemLacrada() and secundariaAtual ~= "" and nome ~= secundariaAtual then
                if self.popMest_lblRegra ~= nil then
                    self.popMest_lblRegra:setText("A segunda raça faz parte do sorteio lacrado e não pode ser trocada. "
                        .. motivoLacre())
                    self.popMest_lblRegra:setFontColor("#E2AEB6")
                end
                return
            end

            prepararPoolMestico(nome)
            if sheet ~= nil and not mesticagemLacrada() then sheet.mesticoRacaSecundaria = nome end

            if self.popMest_lblTitulo ~= nil then
                self.popMest_lblTitulo:setText(racaPrincipalMestico() .. "  +  " .. outra.nome)
            end
            if self.popMest_lblRegra ~= nil then
                local permitidas = qtdEscolhasPermitidas()
                local txt
                if mesticagemLacrada() then
                    txt = "HERANÇA LACRADA. As sorteadas estão fixas; você pode trocar apenas as "
                        .. tostring(permitidas) .. " ESCOLHIDAS entre as características não lacradas. "
                        .. motivoLacre()
                    self.popMest_lblRegra:setFontColor(COR.rain)
                else
                    txt = "Mestiço com " .. tostring(tierEfetivoMestico()) .. " PQ. O personagem fica com "
                        .. tostring(TOTAL_CARACS_MESTICO) .. " características no total, tiradas do conjunto abaixo (" .. racaPrincipalMestico() .. " + "
                        .. outra.nome .. "). "
                    if permitidas == 0 then
                        txt = txt .. "Neste tier você não escolhe nada: clique em CONFIRMAR para sortear as 3."
                    elseif permitidas >= TOTAL_CARACS_MESTICO then
                        txt = txt .. "Neste tier você escolhe todas as 3: marque 3 abaixo e confirme."
                    else
                        txt = txt .. "Neste tier você escolhe " .. tostring(permitidas) .. " e o resto é sorteado: marque e confirme."
                    end
                    txt = txt .. " O sorteio é DEFINITIVO e será publicado no chat da mesa."
                    self.popMest_lblRegra:setFontColor(COR.muted)
                end
                self.popMest_lblRegra:setText(txt)
            end
            repintarPoolMestico()
        end

        function alternarCaracMestico(indice)
            if poolMestico[indice] == nil then return end
            if estaTravado(indice) then return end -- sorteada e lacrada
            local permitidas = qtdEscolhasPermitidas()
            if estaEscolhido(indice) then
                for pos, v in ipairs(escolhasMestico) do
                    if v == indice then table.remove(escolhasMestico, pos); break end
                end
            else
                if #escolhasMestico >= permitidas then return end -- ja no limite
                table.insert(escolhasMestico, indice)
            end
            repintarPoolMestico()
        end

        function limparEscolhasMestico()
            -- Nunca limpa as lacradas: elas nem estao em escolhasMestico.
            escolhasMestico = {}
            repintarPoolMestico()
        end

        -- Grava a lista final nos campos planos da ficha.
        -- (Campos planos, e nao um no-container: depois de NDB.deleteNode o
        -- container voltava como nil e a gravacao quebrava. Sao no maximo 3
        -- itens, entao campos planos sao mais simples e confiaveis.)
        local function gravarCaracsMestico(resultado)
            NDB.beginUpdate(sheet)
            for i = 1, TOTAL_CARACS_MESTICO do
                local c = resultado[i]
                sheet["mestCarac" .. i .. "Nome"] = c and c.nome or ""
                sheet["mestCarac" .. i .. "Desc"] = c and c.descricao or ""
                sheet["mestCarac" .. i .. "Origem"] = c and c.origem or ""
                sheet["mestCarac" .. i .. "Modo"] = c and c.modo or ""
            end
            sheet.mesticoQtd = #resultado
            NDB.endUpdate(sheet)
            aplicarAtributosBaseRaciais()
        end

        -- Confirma. Dois caminhos bem diferentes:
        --   SEM lacre  -> escolhe + sorteia + LACRA + publica no chat.
        --   COM lacre  -> troca somente as ESCOLHIDAS, preservando byte a byte
        --                 as sorteadas. Nao ha rolagem nenhuma aqui.
        function confirmarMesticagem()
            if sheet == nil or #poolMestico == 0 then return end
            if not podeEditarCriacao() then
                if self.popMestico ~= nil then self.popMestico:close() end
                return
            end
            local permitidas = qtdEscolhasPermitidas()
            if #escolhasMestico < permitidas then return end -- ainda falta escolher

            if mesticagemLacrada() then
                -- ===== TROCA DE ESCOLHIDAS =====
                local resultado = {}
                for _, idx in ipairs(escolhasMestico) do
                    local c = poolMestico[idx]
                    table.insert(resultado, {nome = c.nome, descricao = c.descricao, origem = c.origem, modo = "Escolhida"})
                end
                for i = 1, #poolMestico do
                    if estaTravado(i) then
                        local c = poolMestico[i]
                        table.insert(resultado, {nome = c.nome, descricao = c.descricao, origem = c.origem, modo = "Sorteada"})
                    end
                end
                gravarCaracsMestico(resultado)

                -- O reajuste de tier autorizado pelo mestre e de uso unico:
                -- consome aqui, depois de aplicado.
                if sheet.mesticoReajusteAutorizado == true then
                    sheet.mesticoReajusteAutorizado = false
                    sheet.mesticoLacreTier = contextoRacial().tierMestico
                end

                if self.popMestico ~= nil then self.popMestico:close() end
                atualizarBlocoRaca()
                recalcularTudo()
                avisarMestico("Características escolhidas atualizadas. As sorteadas seguem lacradas.", COR.moss)
                return
            end

            -- ===== PRIMEIRO SORTEIO (ou re-sorteio autorizado) =====
            local disponiveis = {}
            for i = 1, #poolMestico do
                if not estaEscolhido(i) then table.insert(disponiveis, i) end
            end

            local resultado = {}
            for _, idx in ipairs(escolhasMestico) do
                local c = poolMestico[idx]
                table.insert(resultado, {nome = c.nome, descricao = c.descricao, origem = c.origem, modo = "Escolhida"})
            end

            if math.randomseed ~= nil and os ~= nil and os.time ~= nil then
                math.randomseed(os.time())
            end
            local faltam = TOTAL_CARACS_MESTICO - #resultado
            while faltam > 0 and #disponiveis > 0 do
                local pos = math.random(1, #disponiveis)
                local idx = table.remove(disponiveis, pos)
                local c = poolMestico[idx]
                table.insert(resultado, {nome = c.nome, descricao = c.descricao, origem = c.origem, modo = "Sorteada"})
                faltam = faltam - 1
            end

            gravarCaracsMestico(resultado)

            -- ===== LACRA =====
            local autor = nickDoUsuario()
            local quando = dataHoraTexto()
            NDB.beginUpdate(sheet)
            sheet.mesticoLacre = true
            sheet.mesticoLacreAutor = autor
            sheet.mesticoLacreData = quando
            sheet.mesticoLacreTier = contextoRacial().tierMestico
            sheet.mesticoRerollAutorizado = false
            sheet.mesticoReajusteAutorizado = false
            NDB.endUpdate(sheet)

            -- ===== PUBLICA NA MESA =====
            -- A trava de verdade e esta: o resultado fica testemunhado. Uma
            -- trava de interface sozinha nao impede quem edita o NDB por fora.
            local escolhidas, sorteadas = {}, {}
            for _, c in ipairs(resultado) do
                if c.modo == "Sorteada" then
                    table.insert(sorteadas, c.nome .. " (" .. c.origem .. ")")
                else
                    table.insert(escolhidas, c.nome .. " (" .. c.origem .. ")")
                end
            end
            local nomePers = tostring(sheet.nome or "Personagem")
            local msg = "**MESTIÇAGEM SELADA** — " .. nomePers
                .. "\nHerança: **" .. racaPrincipalMestico() .. " + " .. tostring(sheet.mesticoRacaSecundaria or "?") .. "**"
                .. "\nSorteadas: " .. (#sorteadas > 0 and table.concat(sorteadas, ", ") or "nenhuma")
                .. "\nEscolhidas: " .. (#escolhidas > 0 and table.concat(escolhidas, ", ") or "nenhuma")
                .. "\nLacrado por " .. autor .. " em " .. quando .. "."
            publicarNoChat(msg)

            if self.popMestico ~= nil then self.popMestico:close() end
            atualizarBlocoRaca()
            recalcularTudo()
            avisarMestico("Sorteio realizado e lacrado. Resultado publicado no chat da mesa.", COR.moss)
        end

        -- Le as caracteristicas ja definidas da mesticagem, como lista simples
        function caracteristicasMesticoDefinidas()
            local lista = {}
            if sheet == nil then return lista end
            local qtd = tonumber(sheet.mesticoQtd) or 0
            for i = 1, qtd do
                local nome = tostring(sheet["mestCarac" .. i .. "Nome"] or "")
                if nome ~= "" then
                    table.insert(lista, {
                        nome = nome,
                        descricao = tostring(sheet["mestCarac" .. i .. "Desc"] or ""),
                        origem = tostring(sheet["mestCarac" .. i .. "Origem"] or ""),
                        modo = tostring(sheet["mestCarac" .. i .. "Modo"] or ""),
                    })
                end
            end
            return lista
        end

        -- Se um jogador/espectador tentar marcar a autorizacao do mestre, a
        -- ficha desmarca de volta e avisa. (Nao da pra "esconder" o checkbox
        -- porque o mestre precisa dele na mesma tela.)
        function aoMudarAutorizacaoMestre()
            if sheet == nil then return end
            if sheet.autorizacaoMestreRaca == true and not usuarioEhMestre() then
                sheet.autorizacaoMestreRaca = false
                if self.abaRaca_lblStatus ~= nil then
                    self.abaRaca_lblStatus:setText("Somente o MESTRE da mesa pode liberar raças bloqueadas. Peça ao narrador para marcar esta opção.")
                    self.abaRaca_lblStatus:setFontColor("#E2AEB6")
                end
                return
            end
            atualizarBlocoRaca()
        end

        -- =================================================================
        -- AUTORIZACOES DO MESTRE (popup proprio)
        --
        -- Valvula de escape com uso unico: o mestre libera UMA acao, ela e
        -- consumida no proximo uso e a ficha volta a ficar lacrada. Isso evita
        -- deixar a ficha destravada para sempre por esquecimento.
        -- =================================================================
        function abrirPopupMestreMestico()
            if self.popMestreMest == nil then return end
            atualizarPopupMestreMestico()
            abrirPopupAjustado(self.popMestreMest, 720, 420)
        end

        function atualizarPopupMestreMestico()
            if self.popMestreMest_lblEstado == nil then return end
            local linhas = {}
            if mesticagemLacrada() then
                table.insert(linhas, "Estado: LACRADA — " .. motivoLacre())
                table.insert(linhas, "Tier congelado no sorteio: " .. tostring(sheet.mesticoLacreTier or 0)
                    .. " PQ   |   Tier atual da qualidade: " .. tostring(contextoRacial().tierMestico) .. " PQ")
            else
                table.insert(linhas, "Estado: SEM LACRE — nenhum sorteio foi feito ainda nesta ficha.")
            end
            if sheet.mesticoRerollAutorizado == true then
                table.insert(linhas, "AUTORIZAÇÃO ATIVA: um novo sorteio está liberado e será consumido no próximo uso.")
            end
            if sheet.mesticoReajusteAutorizado == true then
                table.insert(linhas, "AUTORIZAÇÃO ATIVA: o tier atual pode ser aplicado às escolhas, uma vez.")
            end
            self.popMestreMest_lblEstado:setText(table.concat(linhas, "\n"))

            if self.popMestreMest_lblAviso ~= nil then
                if usuarioEhMestre() then
                    self.popMestreMest_lblAviso:setText("Você é o mestre desta mesa: as ações abaixo estão liberadas.")
                    self.popMestreMest_lblAviso:setFontColor(COR.moss)
                else
                    self.popMestreMest_lblAviso:setText("Somente o MESTRE da mesa pode usar as ações abaixo. Peça ao narrador.")
                    self.popMestreMest_lblAviso:setFontColor(COR.wine)
                end
            end
        end

        -- Quebra o lacre e libera UM re-sorteio completo.
        function mestreQuebrarLacre()
            if sheet == nil then return end
            if not usuarioEhMestre() then
                if self.popMestreMest_lblAviso ~= nil then
                    self.popMestreMest_lblAviso:setText("Ação recusada: somente o MESTRE pode quebrar o lacre.")
                    self.popMestreMest_lblAviso:setFontColor(COR.wine)
                end
                return
            end
            if not mesticagemLacrada() then return end

            local autor = nickDoUsuario()
            NDB.beginUpdate(sheet)
            sheet.mesticoLacre = false
            sheet.mesticoRerollAutorizado = true
            sheet.mesticoReajusteAutorizado = false
            NDB.endUpdate(sheet)

            publicarNoChat(anuncio("mesticagem", "LACRE DE MESTIÇAGEM QUEBRADO",
                nomeDoPersonagem() .. " teve o lacre rompido por " .. autor ..
                ", em " .. dataHoraTexto() .. ". Um novo sorteio está liberado."), COR.gold)

            atualizarPopupMestreMestico()
            atualizarBlocoRaca()
            avisarMestico("Lacre quebrado pelo mestre. Um novo sorteio está liberado.")
        end

        -- Autoriza aplicar o tier ATUAL da qualidade as escolhas (converter
        -- sorteadas em escolhidas depois de um upgrade de Mestico 1 -> 2).
        -- Regra da mesa: isso NAO acontece sozinho, so com autorizacao.
        function mestreAutorizarReajusteTier()
            if sheet == nil then return end
            if not usuarioEhMestre() then
                if self.popMestreMest_lblAviso ~= nil then
                    self.popMestreMest_lblAviso:setText("Ação recusada: somente o MESTRE pode autorizar o reajuste de tier.")
                    self.popMestreMest_lblAviso:setFontColor(COR.wine)
                end
                return
            end
            if not mesticagemLacrada() then return end

            sheet.mesticoReajusteAutorizado = true
            publicarNoChat(anuncio("mestre", "REAJUSTE DE TIER AUTORIZADO",
                "Para " .. nomeDoPersonagem() .. ", o tier atual de Mestiço passa a valer " ..
                "para as escolhas. Autorizado por " .. nickDoUsuario() ..
                ", em " .. dataHoraTexto() .. "."), COR.gold)
            atualizarPopupMestreMestico()
            atualizarBlocoRaca()
            avisarMestico("Reajuste de tier autorizado: abra a mestiçagem e refaça suas escolhas.")
        end

        -- Cancela autorizacoes ativas que ainda nao foram usadas.
        function mestreCancelarAutorizacoes()
            if sheet == nil then return end
            if not usuarioEhMestre() then return end
            NDB.beginUpdate(sheet)
            sheet.mesticoRerollAutorizado = false
            sheet.mesticoReajusteAutorizado = false
            -- Se o lacre tinha sido quebrado e o sorteio ainda nao foi refeito,
            -- volta a lacrar com os dados que ja existem.
            if sheet.mesticoLacre ~= true and (tonumber(sheet.mesticoQtd) or 0) > 0 then
                sheet.mesticoLacre = true
            end
            NDB.endUpdate(sheet)
            atualizarPopupMestreMestico()
            atualizarBlocoRaca()
        end

        -- =================================================================
        -- LIMPEZAS (agora respeitando o lacre)
        -- =================================================================
        function resetarMesticagem()
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarMestico(motivoTravaCriacao(), COR.wine)
                return
            end
            if mesticagemLacrada() then
                avisarMestico(motivoLacre(), COR.wine)
                return
            end
            NDB.beginUpdate(sheet)
            for i = 1, TOTAL_CARACS_MESTICO do
                sheet["mestCarac" .. i .. "Nome"] = ""
                sheet["mestCarac" .. i .. "Desc"] = ""
                sheet["mestCarac" .. i .. "Origem"] = ""
                sheet["mestCarac" .. i .. "Modo"] = ""
            end
            sheet.mesticoQtd = 0
            sheet.mesticoRacaSecundaria = ""
            NDB.endUpdate(sheet)
            escolhasMestico = {}
            travadosMestico = {}
            poolMestico = {}
            atualizarBlocoRaca()
            recalcularTudo()
        end

        -- Limpa a definicao racial. Com a heranca lacrada, apaga a raca mas
        -- PRESERVA a heranca - senao "LIMPAR" viraria a porta dos fundos do
        -- re-sorteio.
        function resetarRacaCompleta()
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarMestico(motivoTravaCriacao(), COR.wine)
                return
            end
            NDB.beginUpdate(sheet)
            sheet.raca = ""
            sheet.deslocamentoBaseRaca = 0
            sheet.dadoVida = 0
            -- os modos vao junto: sem raça não há voo, nado nem forma
            sheet.deslocamentoBaseVoo = 0
            sheet.deslocamentoBaseNado = 0
            sheet.deslocamentoBaseEscalada = 0
            sheet.deslocamentoBaseFormaAlt = 0
            sheet.formaAlternativaNome = ""
            sheet.formaAlternativaRotuloBase = ""
            sheet.formaAlternativaLigada = false
            NDB.endUpdate(sheet)
            if mesticagemLacrada() then
                atualizarBlocoRaca()
                recalcularTudo()
                avisarMestico("Raça apagada. A herança mestiça continua lacrada e foi preservada.", COR.rain)
                return
            end
            resetarMesticagem()
        end

        function atualizarBlocoRaca()
            if sheet == nil then return end
            local nomeAtual = tostring(sheet.raca or "")
            local ctx = contextoRacial()

            if self.lblRacaAtual ~= nil then
                if nomeAtual == "" then
                    self.lblRacaAtual:setText("Clique para escolher uma raça")
                    self.lblRacaAtual:setFontColor(COR.faint)
                else
                    self.lblRacaAtual:setText(nomeAtual)
                    self.lblRacaAtual:setFontColor(COR.text)
                end
            end

            local dados = (nomeAtual ~= "") and CatalogoRacas.buscarPorNome(nomeAtual) or nil

            -- Situacao / liberacao
            if self.abaRaca_lblStatus ~= nil then
                if dados == nil and nomeAtual ~= "" then
                    -- Ficha antiga com raca DIGITADA (ate a v0.41.1 o campo
                    -- era texto livre) que o catalogo nao reconhece. Isto
                    -- era silencioso: nenhuma concessao racial entrava e
                    -- nada avisava (B-10). Agora diz o que a ficha ve.
                    self.abaRaca_lblStatus:setText("A ficha vê \"" .. nomeAtual ..
                        "\" no campo RAÇA e NÃO encontrou esse nome no catálogo — nenhuma concessão racial está sendo aplicada. Escolha a raça no catálogo acima para corrigir.")
                    self.abaRaca_lblStatus:setFontColor("#E2AEB6")
                elseif dados == nil then
                    self.abaRaca_lblStatus:setText("Nenhuma raça selecionada ainda. Abra o catálogo acima - Deslocamento e Dado de Vida são preenchidos automaticamente na aba 06 · COMBATE.")
                    self.abaRaca_lblStatus:setFontColor("#B9D3DD")
                else
                    local permitido, motivo = CatalogoRacas.podeEscolher(dados, ctx)
                    local rotuloCat = "Jogável"
                    if dados.categoria == "NaoJogavel" then rotuloCat = "Não-jogável"
                    elseif dados.categoria == "Primordial" then rotuloCat = "Primordial" end
                    local texto = rotuloCat .. "   •   Origem: " .. dados.origem .. "   •   Tipo: " .. dados.tipo
                    if motivo ~= "" then texto = texto .. "\n" .. motivo end
                    self.abaRaca_lblStatus:setText(texto)
                    self.abaRaca_lblStatus:setFontColor(permitido and "#A9D6C4" or "#E2AEB6")
                end
            end

            -- Base (deslocamento / dado de vida) - painel sempre visivel
            if self.abaRaca_lblBase ~= nil then
                if dados ~= nil and dados.jogavel then
                    -- Para mestiço o texto vem de textoAtributosBase(), que já
                    -- reflete o maior valor entre as duas raças.
                    self.abaRaca_lblBase:setText(textoAtributosBase())
                    self.abaRaca_lblBase:setFontColor("#B9D3DD")
                elseif dados ~= nil then
                    self.abaRaca_lblBase:setText("Raça sem regras mecânicas definidas — preencha Deslocamento e Dado de Vida à mão na aba 06 · COMBATE.")
                    self.abaRaca_lblBase:setFontColor(COR.faint)
                else
                    self.abaRaca_lblBase:setText("—")
                    self.abaRaca_lblBase:setFontColor(COR.faint)
                end
            end

            -- Painel de mesticagem (SEMPRE visivel: alternar visible= em
            -- align="top" reordena o layout). Quando nao ha mesticagem, o
            -- painel apenas explica isso.
            local ehMestico = ctx.temMestico
            local caracsMestico = ehMestico and caracteristicasMesticoDefinidas() or {}
            local usandoMestico = (ehMestico and #caracsMestico > 0)

            local lacrada = mesticagemLacrada()

            if self.abaRaca_lblMestico ~= nil then
                if not ehMestico then
                    self.abaRaca_lblMestico:setText("Personagem de sangue puro. Para jogar como mestiço, adquira a qualidade \"Mestiço\" na aba Qualidades & Defeitos - a herança (sua raça + outra) é definida aqui.")
                    self.abaRaca_lblMestico:setFontColor(COR.faint)
                else
                    local tierEfetivo = tierEfetivoMestico()
                    local escolhas = CatalogoRacas.escolhasPorTierMestico(tierEfetivo, TOTAL_CARACS_MESTICO)
                    local secundaria = tostring(sheet.mesticoRacaSecundaria or "")
                    local texto = "Mestiço (" .. tostring(ctx.tierMestico) .. " PQ) — fica com " .. tostring(TOTAL_CARACS_MESTICO) .. " características. "
                    if escolhas == 0 then
                        texto = texto .. "Neste tier todas são SORTEADAS."
                    elseif escolhas >= TOTAL_CARACS_MESTICO then
                        texto = texto .. "Neste tier você ESCOLHE todas."
                    else
                        texto = texto .. "Neste tier você ESCOLHE " .. tostring(escolhas) .. " e SORTEIA " .. tostring(TOTAL_CARACS_MESTICO - escolhas) .. "."
                    end
                    if tierEfetivo ~= ctx.tierMestico then
                        texto = texto .. "  (tier congelado no sorteio: " .. tostring(tierEfetivo) .. " PQ)"
                    end
                    if secundaria == "" then
                        texto = texto .. "\nHerança ainda não definida — clique aqui para definir."
                    elseif lacrada then
                        texto = texto .. "\nHerança: " .. racaPrincipalMestico() .. " + " .. secundaria .. ". Clique aqui para trocar as ESCOLHIDAS (as sorteadas estão lacradas)."
                    else
                        texto = texto .. "\nHerança: " .. racaPrincipalMestico() .. " + " .. secundaria .. ". Clique aqui para definir o resultado — o sorteio é definitivo."
                    end
                    local partes = {}
                    for _, car in ipairs(caracsMestico) do
                        table.insert(partes, car.modo:lower() .. ": " .. car.nome)
                    end
                    if #partes > 0 then
                        texto = texto .. "   [" .. table.concat(partes, "  |  ") .. "]"
                    end
                    self.abaRaca_lblMestico:setText(texto)
                    self.abaRaca_lblMestico:setFontColor("#E8DCBE")
                end
            end

            -- Selo do lacre + estado do botao de refazer.
            if self.abaRaca_lblLacre ~= nil then
                if not ehMestico then
                    self.abaRaca_lblLacre:setText("")
                elseif lacrada then
                    self.abaRaca_lblLacre:setText("LACRADA  •  " .. tostring(sheet.mesticoLacreData or "")
                        .. "  •  " .. tostring(sheet.mesticoLacreAutor or ""))
                    self.abaRaca_lblLacre:setFontColor(COR.rain)
                elseif sheet.mesticoRerollAutorizado == true then
                    self.abaRaca_lblLacre:setText("RE-SORTEIO AUTORIZADO PELO MESTRE")
                    self.abaRaca_lblLacre:setFontColor(COR.gold)
                else
                    self.abaRaca_lblLacre:setText("SEM LACRE  •  o sorteio ainda não foi feito")
                    self.abaRaca_lblLacre:setFontColor(COR.faint)
                end
            end
            if self.abaRaca_lblBtnRefazer ~= nil then
                if lacrada then
                    self.abaRaca_lblBtnRefazer:setText("LACRADA")
                    self.abaRaca_lblBtnRefazer:setFontColor(COR.faint)
                else
                    self.abaRaca_lblBtnRefazer:setText("REFAZER HERANÇA")
                    self.abaRaca_lblBtnRefazer:setFontColor("#9E3B4A")
                end
            end
            if self.abaRaca_lblAvisoMestico ~= nil and not ehMestico then
                self.abaRaca_lblAvisoMestico:setText("")
            end

            -- Lista de caracteristicas: se for mestico COM heranca definida,
            -- mostra o resultado da mesticagem (com selo Escolhida/Sorteada);
            -- caso contrario, as caracteristicas da propria raca.
            local listaExibir = dados and dados.caracteristicas or nil
            if usandoMestico then listaExibir = caracsMestico end

            if self.abaRaca_lblTituloCaracs ~= nil then
                if usandoMestico then
                    self.abaRaca_lblTituloCaracs:setText("CARACTERÍSTICAS RACIAIS  •  herança mestiça")
                elseif listaExibir ~= nil and #listaExibir > 0 then
                    self.abaRaca_lblTituloCaracs:setText("CARACTERÍSTICAS RACIAIS")
                else
                    self.abaRaca_lblTituloCaracs:setText("CARACTERÍSTICAS RACIAIS  •  escolha uma raça acima")
                end
            end

            preencherListaCaracsRaciais(listaExibir, ehMestico and not usandoMestico)
            pcall(function() atualizarEscolhaTracoRacial(dados) end)
            pcall(function() atualizarBrasaoRaca(dados) end)
        end

        -- =================================================================
        -- ATRIBUTOS BASE DO MESTIÇO
        --
        -- REGRA DE MESA (não está escrita no .bib - a entrada da qualidade
        -- Mestiço só fala das habilidades raciais): o mestiço fica com o MAIOR
        -- valor entre as duas raças, atributo por atributo. Ex.: Humanos
        -- (10m / 1d10) + Minotauros (8m / 1d12) resulta em 10m / 1d12.
        --
        -- É calculado atributo a atributo, não "o pacote da melhor raça".
        --
        -- Só grava nos momentos de decisão (escolher raça, confirmar
        -- mestiçagem), nunca a cada refresh: os dois campos são editáveis à mão
        -- em Cálculos & Combate e sobrescrever sempre brigaria com o jogador.
        -- =================================================================
        function aplicarAtributosBaseRaciais()
            if sheet == nil then return end
            local ctx = contextoRacial()
            local principal = CatalogoRacas.buscarPorNome(tostring(sheet.raca or ""))
            local desloc = principal and principal.deslocamentoNum or 0
            local dado = principal and principal.dadoVidaNum or 0

            -- Modos de deslocamento (terrestre ja vem em deslocamentoNum;
            -- voo e nado saem de deslocamentoModos, regerado do livro).
            local function modosDe(r)
                return (r and r.deslocamentoModos) or {}
            end
            local voo = n(modosDe(principal).voo)
            local nado = n(modosDe(principal).nado)
            -- ESCALADA: nenhuma raça do livro declara base hoje, entao isto e
            -- sempre 0 e o calculo cai no padrao da mesa (metade do
            -- deslocamento). O campo existe ja ligado para o dia em que uma
            -- declarar - o extrator de deslocamento reconhece "(escalada)".
            local escalada = n(modosDe(principal).escalada)
            local forma = principal and principal.formaAlternativa or nil

            if ctx.temMestico then
                -- Herança mestiça: raça PRINCIPAL + a secundária. O mestiço
                -- fica com o maior valor entre as duas — MESMA regra de mesa
                -- ja usada nos atributos, aplicada MODO A MODO. Um mestiço de
                -- Aarakocra com Sereia voa como Aarakocra e nada como Sereia.
                local secundaria = CatalogoRacas.buscarPorNome(tostring(sheet.mesticoRacaSecundaria or ""))
                if secundaria ~= nil then
                    desloc = math.max(desloc, secundaria.deslocamentoNum or 0)
                    dado = math.max(dado, secundaria.dadoVidaNum or 0)
                    voo = math.max(voo, n(modosDe(secundaria).voo))
                    nado = math.max(nado, n(modosDe(secundaria).nado))
                    escalada = math.max(escalada, n(modosDe(secundaria).escalada))
                    -- Forma alternativa nao se soma nem se compara: e um
                    -- estado do corpo. Vale a da principal; se ela nao tiver,
                    -- herda a da secundaria.
                    if forma == nil then forma = secundaria.formaAlternativa end
                end
            end

            NDB.beginUpdate(sheet)
            if desloc > 0 then sheet.deslocamentoBaseRaca = desloc end
            if dado > 0 then sheet.dadoVida = dado end

            -- Estes SEMPRE sao escritos, inclusive com zero: trocar de raça
            -- precisa APAGAR o voo da raça anterior. Guardar so quando > 0
            -- deixaria um Anão voando.
            sheet.deslocamentoBaseVoo = voo
            sheet.deslocamentoBaseNado = nado
            sheet.deslocamentoBaseEscalada = escalada
            if forma ~= nil then
                sheet.deslocamentoBaseFormaAlt = n(forma.terrestre)
                sheet.formaAlternativaNome = tostring(forma.nome or "")
                sheet.formaAlternativaRotuloBase = tostring(forma.rotuloBase or "")
            else
                sheet.deslocamentoBaseFormaAlt = 0
                sheet.formaAlternativaNome = ""
                sheet.formaAlternativaRotuloBase = ""
                sheet.formaAlternativaLigada = false
            end
            NDB.endUpdate(sheet)
        end

        -- Texto do painel "ATRIBUTOS BASE", explicando de onde veio cada valor
        -- quando o personagem é mestiço.
        function textoAtributosBase()
            if sheet == nil then return "—" end
            local desloc = n(sheet.deslocamentoBaseRaca)
            local dado = n(sheet.dadoVida)
            if desloc <= 0 and dado <= 0 then return "—" end
            local txt = "Deslocamento: " .. tostring(desloc) .. "m     •     Dado de Vida: 1d" .. tostring(dado)
            if contextoRacial().temMestico and tostring(sheet.mesticoRacaSecundaria or "") ~= "" then
                txt = txt .. "     •     mestiço fica com o MAIOR valor entre "
                    .. racaPrincipalMestico() .. " e " .. tostring(sheet.mesticoRacaSecundaria)
            end
            return txt
        end

        -- =================================================================
        -- CLASSE & SUBCLASSE
        --
        -- REGRAS DA MESA (documento "Classes e Traços"):
        --   * Pontos de classe nos niveis 1, 3, 5, 8, 11, 14, 17 e 20 -> 8 no
        --     total ao chegar no nivel 20.
        --   * Cada subclasse vai do nivel 1 ao 8; cada nivel custa 1 ponto.
        --   * No maximo DUAS subclasses por ficha, nao necessariamente da
        --     mesma classe.
        --   * A segunda so e liberada no nivel 11 E com a primeira ja no
        --     nivel 4 ou mais.
        --
        -- Guardamos em campos planos (classe1Nome/Sub/Nivel e classe2*) pelo
        -- mesmo motivo da mesticagem: sao pouquissimos campos e nos-container
        -- de recordList dao problema quando apagados/recriados.
        --
        -- VALVULA DE ESCAPE: "pontosClasseAjuste" soma (ou subtrai) pontos a
        -- mao, e o checkbox de autorizacao do mestre ignora os pre-requisitos
        -- da segunda subclasse. Automacao que prende o mestre e automacao ruim.
        -- =================================================================
        local subclasseEmDetalhe = nil  -- {classe=..., sub=...} exibido no popup

        function pontosClasseInfo()
            local info = {total = 0, gastos = 0, livres = 0}
            if sheet == nil then return info end
            local nivel = n(sheet.nivel)
            if nivel < 1 then nivel = 1 end
            info.total = CatalogoClasses.pontosNoNivel(nivel) + n(sheet.pontosClasseAjuste)
            info.gastos = n(sheet.classe1Nivel) + n(sheet.classe2Nivel)
            info.livres = info.total - info.gastos
            return info
        end

        -- Em qual slot (1 ou 2) esta gravada esta subclasse, se estiver.
        function slotDaSubclasse(nomeClasse, nomeSub)
            if sheet == nil then return nil end
            for slot = 1, 2 do
                if tostring(sheet["classe" .. slot .. "Nome"] or "") == nomeClasse
                    and tostring(sheet["classe" .. slot .. "Sub"] or "") == nomeSub then
                    return slot
                end
            end
            return nil
        end

        function slotOcupado(slot)
            return sheet ~= nil and tostring(sheet["classe" .. slot .. "Sub"] or "") ~= ""
        end

        -- Devolve (podeAbrir, motivo). O mestre pode liberar por fora.
        function podeAbrirSegundoSlot()
            if sheet == nil then return false, "" end
            if sheet.autorizacaoMestreClasse == true then
                return true, "Liberado por autorização do mestre."
            end
            local nivel = n(sheet.nivel)
            if nivel < CatalogoClasses.NIVEL_LIBERA_SEGUNDA then
                return false, "A segunda subclasse só é liberada no nível "
                    .. tostring(CatalogoClasses.NIVEL_LIBERA_SEGUNDA)
                    .. " (você está no " .. tostring(nivel) .. ")."
            end
            if n(sheet.classe1Nivel) < CatalogoClasses.NIVEL_MIN_PRIMEIRA_PARA_SEGUNDA then
                return false, "A primeira subclasse precisa estar no nível "
                    .. tostring(CatalogoClasses.NIVEL_MIN_PRIMEIRA_PARA_SEGUNDA)
                    .. " ou mais para abrir a segunda (está no "
                    .. tostring(n(sheet.classe1Nivel)) .. ")."
            end
            return true, ""
        end

        function avisarClasse(texto, cor)
            if self.popCls_lblAviso ~= nil then
                self.popCls_lblAviso:setText(tostring(texto or ""))
                self.popCls_lblAviso:setFontColor(cor or COR.wine)
            end
            if self.abaRaca_lblAvisoClasse ~= nil then
                self.abaRaca_lblAvisoClasse:setText(tostring(texto or ""))
                self.abaRaca_lblAvisoClasse:setFontColor(cor or COR.wine)
            end
        end

        function aoMudarAutorizacaoMestreClasse()
            if sheet == nil then return end
            if sheet.autorizacaoMestreClasse == true and not usuarioEhMestre() then
                sheet.autorizacaoMestreClasse = false
                avisarClasse("Somente o MESTRE da mesa pode liberar os pré-requisitos de classe.", COR.wine)
                return
            end
            atualizarBlocoClasse()
        end

        -- =================================================================
        -- BLOCO DA ABA
        -- =================================================================
        function atualizarBlocoClasse()
            if sheet == nil then return end
            local info = pontosClasseInfo()

            if self.abaRaca_lblPontosClasse ~= nil then
                local txt = tostring(info.livres) .. " livre(s)  •  "
                    .. tostring(info.gastos) .. " gasto(s)  •  " .. tostring(info.total) .. " total"
                self.abaRaca_lblPontosClasse:setText(txt)
                if info.livres < 0 then
                    self.abaRaca_lblPontosClasse:setFontColor(COR.wine)
                elseif info.livres > 0 then
                    self.abaRaca_lblPontosClasse:setFontColor(COR.gold)
                else
                    self.abaRaca_lblPontosClasse:setFontColor(COR.muted)
                end
            end

            for slot = 1, 2 do
                local lbl = self["abaRaca_lblClasse" .. slot]
                if lbl ~= nil then
                    local nomeClasse = tostring(sheet["classe" .. slot .. "Nome"] or "")
                    local nomeSub = tostring(sheet["classe" .. slot .. "Sub"] or "")
                    local nivelSub = n(sheet["classe" .. slot .. "Nivel"])
                    if nomeSub == "" then
                        if slot == 2 then
                            local pode, motivo = podeAbrirSegundoSlot()
                            lbl:setText("Slot 2 vazio — " .. (pode and "liberado: abra o catálogo para escolher." or motivo))
                            lbl:setFontColor(pode and COR.faint or "#7A5A60")
                        else
                            lbl:setText("Slot 1 vazio — abra o catálogo para escolher classe e subclasse.")
                            lbl:setFontColor(COR.faint)
                        end
                    else
                        -- O teto e por subclasse: arvores curtas (5 niveis)
                        -- existem de proposito no sistema.
                        local teto = CatalogoClasses.tetoDaSubclasse(nomeClasse, nomeSub)
                        local txt = nomeClasse .. "  •  " .. nomeSub
                        if nivelSub >= teto then
                            txt = txt .. "   —   árvore completa, invista na outra subclasse"
                        end
                        lbl:setText(txt)
                        lbl:setFontColor(COR.text)
                    end
                end

                -- Marcadores de nível: círculos de verdade, não caracteres.
                -- Preenchidos = níveis comprados; vazios = disponíveis;
                -- invisíveis = fora do teto desta árvore.
                local nomeClasse = tostring(sheet["classe" .. slot .. "Nome"] or "")
                local nomeSub = tostring(sheet["classe" .. slot .. "Sub"] or "")
                local nivelSub = n(sheet["classe" .. slot .. "Nivel"])
                local teto = (nomeSub ~= "")
                    and CatalogoClasses.tetoDaSubclasse(nomeClasse, nomeSub)
                    or CatalogoClasses.MAX_NIVEL_SUBCLASSE

                for i = 1, CatalogoClasses.MAX_NIVEL_SUBCLASSE do
                    local pip = self["abaRaca_pip" .. slot .. "_" .. i]
                    if pip ~= nil then
                        pip:setVisible(i <= teto)
                        if i <= nivelSub then
                            pip:setColor(COR.gold)
                            pip:setStrokeColor("#E8CE86")
                        else
                            pip:setColor("#12181C")
                            pip:setStrokeColor("#3A4750")
                        end
                    end
                end

                local lblNivel = self["abaRaca_lblNivelSlot" .. slot]
                if lblNivel ~= nil then
                    if nomeSub == "" then
                        lblNivel:setText("")
                    else
                        lblNivel:setText(tostring(nivelSub) .. " / " .. tostring(teto))
                        lblNivel:setFontColor(nivelSub >= teto and COR.moss or COR.gold)
                    end
                end
            end
        end

        -- =================================================================
        -- POPUP - CATALOGO DE CLASSES
        -- =================================================================
        -- Recebe opcionalmente o slot clicado na aba: nesse caso o catálogo já
        -- abre na subclasse daquele slot, com a descrição de todos os níveis -
        -- menos cliques para a consulta que o jogador mais faz.
        function abrirCatalogoClasses(slot)
            if self.popClasses == nil then return end
            local alvo = nil
            if slot ~= nil and sheet ~= nil then
                local nomeSub = tostring(sheet["classe" .. slot .. "Sub"] or "")
                if nomeSub ~= "" then
                    alvo = {classe = tostring(sheet["classe" .. slot .. "Nome"] or ""), sub = nomeSub}
                end
            end
            alvo = alvo or subclasseEmDetalhe
            if alvo ~= nil then
                selecionarDetalheSubclasse(alvo.classe, alvo.sub)
            end
            atualizarRodapeCatalogoClasses()
            abrirPopupAjustado(self.popClasses, 1080, 700)
        end

        function selecionarDetalheSubclasse(nomeClasse, nomeSub)
            local sub, classe = CatalogoClasses.buscarSubclasse(nomeClasse, nomeSub)
            if sub == nil then return end
            subclasseEmDetalhe = {classe = nomeClasse, sub = nomeSub}

            if self.popCls_lblTitulo ~= nil then self.popCls_lblTitulo:setText(nomeSub) end
            local teto = sub.totalNiveis
            if self.popCls_lblSubtitulo ~= nil then
                local txt = "Classe: " .. nomeClasse .. "   •   árvore de " .. tostring(teto) .. " níveis"
                if teto < CatalogoClasses.MAX_NIVEL_SUBCLASSE then
                    txt = txt .. " (curta: ao completá-la, os pontos seguintes vão para outra subclasse)"
                end
                self.popCls_lblSubtitulo:setText(txt)
                self.popCls_lblSubtitulo:setFontColor(COR.aura)
            end
            if self.popCls_lblDescricao ~= nil then self.popCls_lblDescricao:setText(sub.descricao) end

            if self.popCls_lblNota ~= nil then
                if sub.nota ~= nil and sub.nota ~= "" then
                    self.popCls_lblNota:setText(sub.nota)
                    self.popCls_lblNota:setFontColor(COR.gold)
                else
                    self.popCls_lblNota:setText("Sem observações específicas para esta subclasse.")
                    self.popCls_lblNota:setFontColor(COR.faint)
                end
            end

            local slot = slotDaSubclasse(nomeClasse, nomeSub)
            local nivelAtual = slot and n(sheet["classe" .. slot .. "Nivel"]) or 0

            for i = 1, CatalogoClasses.MAX_NIVEL_SUBCLASSE do
                local sec = self["popCls_secNivel" .. i]
                local tit = self["popCls_lblNivelTit" .. i]
                local txt = self["popCls_lblNivelTxt" .. i]
                -- Cards alem do teto desta arvore simplesmente nao existem.
                if sec ~= nil then sec:setVisible(i <= teto) end
                local adquirido = (i <= nivelAtual)
                if i <= teto and tit ~= nil then
                    tit:setText("NÍVEL " .. tostring(i) .. "   " .. string.rep("●", i)
                        .. (adquirido and "   ✓ ADQUIRIDO" or ""))
                    tit:setFontColor(adquirido and COR.gold or COR.faint)
                end
                if i <= teto and txt ~= nil then
                    txt:setText(CatalogoClasses.textoNivel(sub, i))
                    txt:setFontColor(adquirido and COR.text or COR.muted)
                end
                if i <= teto and sec ~= nil then
                    sec:setStrokeColor(adquirido and COR.gold or COR.line)
                    sec:setStrokeSize(adquirido and 2 or 1)
                end
            end

            atualizarRodapeCatalogoClasses()
        end

        function atualizarRodapeCatalogoClasses()
            local info = pontosClasseInfo()
            if self.popCls_lblPontos ~= nil then
                self.popCls_lblPontos:setText("PONTOS DE CLASSE:  " .. tostring(info.livres)
                    .. " livre(s)  •  " .. tostring(info.gastos) .. " gasto(s)  •  "
                    .. tostring(info.total) .. " total")
                self.popCls_lblPontos:setFontColor(info.livres < 0 and COR.wine or COR.gold)
            end

            local slot = nil
            if subclasseEmDetalhe ~= nil then
                slot = slotDaSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)
            end

            for s = 1, 2 do
                local lbl = self["popCls_lblSlot" .. s]
                if lbl ~= nil then
                    if slot == s then
                        lbl:setText("JÁ É A " .. tostring(s) .. "ª")
                        lbl:setFontColor(COR.moss)
                    elseif slotOcupado(s) then
                        lbl:setText("SUBSTITUIR A " .. tostring(s) .. "ª")
                        lbl:setFontColor("#D4838F")
                    else
                        lbl:setText("DEFINIR COMO " .. tostring(s) .. "ª")
                        lbl:setFontColor(COR.gold)
                    end
                end
            end

            if self.popCls_lblNivelBotoes ~= nil then
                if slot == nil or subclasseEmDetalhe == nil then
                    self.popCls_lblNivelBotoes:setText("—")
                else
                    local teto = CatalogoClasses.tetoDaSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)
                    self.popCls_lblNivelBotoes:setText("Nível "
                        .. tostring(n(sheet["classe" .. slot .. "Nivel"])) .. " de " .. tostring(teto))
                end
            end
        end

        -- =================================================================
        -- ACOES
        -- =================================================================
        function definirSubclasseNoSlot(slot)
            if sheet == nil or subclasseEmDetalhe == nil then return end
            -- classe e subclasse sao criacao de personagem
            if not podeEditarCriacao() then
                avisarClasse(motivoTravaCriacao(), COR.wine); return
            end
            slot = (slot == 2) and 2 or 1

            local outro = (slot == 1) and 2 or 1
            if tostring(sheet["classe" .. outro .. "Nome"] or "") == subclasseEmDetalhe.classe
                and tostring(sheet["classe" .. outro .. "Sub"] or "") == subclasseEmDetalhe.sub then
                avisarClasse("Esta subclasse já ocupa o outro slot. Escolha uma diferente.", COR.wine)
                return
            end

            if slot == 2 then
                local pode, motivo = podeAbrirSegundoSlot()
                if not pode then
                    avisarClasse(motivo .. "  O mestre pode liberar marcando a autorização na aba.", COR.wine)
                    return
                end
            end

            local info = pontosClasseInfo()
            local devolvidos = n(sheet["classe" .. slot .. "Nivel"])
            if (info.livres + devolvidos) < 1 then
                avisarClasse("Sem ponto de classe livre para investir no nível 1 desta subclasse.", COR.wine)
                return
            end

            NDB.beginUpdate(sheet)
            sheet["classe" .. slot .. "Nome"] = subclasseEmDetalhe.classe
            sheet["classe" .. slot .. "Sub"] = subclasseEmDetalhe.sub
            sheet["classe" .. slot .. "Nivel"] = 1
            NDB.endUpdate(sheet)

            avisarClasse("Definida como " .. tostring(slot) .. "ª subclasse, nível 1.", COR.moss)
            selecionarDetalheSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)
            atualizarBlocoClasse()
            recalcularTudo()
        end

        function alterarNivelSubclasseAtual(delta)
            if not podeEditarCriacao() then
                avisarClasse(motivoTravaCriacao(), COR.wine); return
            end
            if sheet == nil or subclasseEmDetalhe == nil then return end
            local slot = slotDaSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)
            if slot == nil then
                avisarClasse("Defina esta subclasse em um slot antes de subir de nível.", COR.wine)
                return
            end
            local atual = n(sheet["classe" .. slot .. "Nivel"])
            local alvo = atual + delta
            local teto = CatalogoClasses.tetoDaSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)

            if alvo > teto then
                avisarClasse("Nível " .. tostring(teto) .. " é o topo desta árvore. "
                    .. "Invista os próximos pontos em outra subclasse.", COR.wine)
                return
            end
            -- Zerar o nivel REMOVE a subclasse da ficha e devolve os pontos:
            -- e por isso que nao existe botao separado de "limpar slot".
            if alvo < 1 then
                removerSubclasseDoSlot(slot)
                return
            end
            if delta > 0 and pontosClasseInfo().livres < delta then
                avisarClasse("Sem ponto de classe livre. Pontos chegam nos níveis 1, 3, 5, 8, 11, 14, 17 e 20.", COR.wine)
                return
            end

            sheet["classe" .. slot .. "Nivel"] = alvo
            if alvo >= teto then
                avisarClasse("Árvore completa no nível " .. tostring(teto)
                    .. ". Os próximos pontos precisam ir para outra subclasse.", COR.gold)
            else
                avisarClasse("Subclasse agora no nível " .. tostring(alvo) .. ".", COR.moss)
            end
            selecionarDetalheSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)
            atualizarBlocoClasse()
            recalcularTudo()
        end

        function removerSubclasseDoSlot(slot)
            if not podeEditarCriacao() then
                avisarClasse(motivoTravaCriacao(), COR.wine); return
            end
            if sheet == nil then return end
            slot = (slot == 2) and 2 or 1
            NDB.beginUpdate(sheet)
            sheet["classe" .. slot .. "Nome"] = ""
            sheet["classe" .. slot .. "Sub"] = ""
            sheet["classe" .. slot .. "Nivel"] = 0
            NDB.endUpdate(sheet)
            avisarClasse("Subclasse removida da ficha; os pontos voltaram para o saldo.", COR.rain)
            if subclasseEmDetalhe ~= nil then
                selecionarDetalheSubclasse(subclasseEmDetalhe.classe, subclasseEmDetalhe.sub)
            end
            atualizarBlocoClasse()
            recalcularTudo()
        end

        -- =================================================================
        -- LAYOUT RESPONSIVO
        --
        -- O Grid System do SDK (g="row"/g="col") resolveria isto nativamente,
        -- mas exige SDK 3.7 E nao pode ser misturado com o atributo align= -
        -- ou seja, obrigaria a reescrever a ficha inteira. Como todo controle
        -- tem o evento onResize e as propriedades width/height sao gravaveis,
        -- da para fazer proporcao e adaptacao em Lua, cirurgicamente.
        --
        -- Regra geral: largura fixa em pixel so para molduras (botoes, icones,
        -- rotulos). Onde a proporcao importa, calcula-se no onResize.
        -- =================================================================

        local function larguraDe(ctrl)
            if ctrl == nil then return 0 end
            local ok, v = pcall(function() return ctrl.width end)
            if ok and type(v) == "number" then return v end
            return 0
        end

        local function alturaDe(ctrl)
            if ctrl == nil then return 0 end
            local ok, v = pcall(function() return ctrl.height end)
            if ok and type(v) == "number" then return v end
            return 0
        end

        local function definirAltura(ctrl, valor)
            if ctrl == nil then return end
            pcall(function() ctrl:setHeight(valor) end)
        end

        local function definirLargura(ctrl, valor)
            if ctrl == nil then return end
            pcall(function() ctrl:setWidth(valor) end)
        end

        local function definirVisivel(ctrl, valor)
            if ctrl == nil then return end
            pcall(function() ctrl:setVisible(valor) end)
        end

        -- ===== Qualidades & Defeitos: colunas sempre 50/50 =====
        -- Antes a coluna da esquerda tinha width="895" fixo: em 1920px dava
        -- meio a meio por coincidencia, em 1280px virava 70/30.
        function ajustarColunasQD()
            local total = larguraDe(self.pnlColunasQD)
            if total <= 0 then return end
            definirLargura(self.colQualidades, math.floor(total / 2))
        end

        -- ===== Barra de abas fluida =====
        -- MEDIDO na v0.39.2, com a propria ficha relatando a largura:
        --   janela 1920 -> barra 1794 ; janela 1904 -> barra 1778
        -- O desconto do Firecast (barra lateral + scrollbar + margens) e
        -- fixo em 126px. Numa janela de 1366 a barra recebe 1240.
        --
        -- Em 1240 cada botao fica com 120px. Com o icone, sobram 81 para o
        -- rotulo e "RACA & CLASSE" pede 84 — nao cabe. Sem o icone sobram
        -- 105. Por isso quem sai e o ICONE, nunca o texto: o icone e
        -- decoracao, o nome do capitulo e informacao.
        --
        -- rotuloMin = 84 (pior rotulo, medido com a MarcellusSC real) + 8 de
        -- folga. A folga nao e chute: o selo de medicao da v0.39.2 empurrou
        -- o "SECAO 01" e ele quebrou em duas linhas mesmo com a checagem 35
        -- dizendo que cabia por 5px. O ttf.py soma avancos e ignora
        -- entreletra, entao o modelo e otimista perto da borda.
        BARRA_ABAS = {
            gap        = 4,    -- margins right de cada botao
            padEsq     = 9,    -- margem interna do layout dentro do botao
            padDir     = 6,
            icone      = 24,   -- largura reservada ao icone
            rotuloMin  = 92,   -- 84 do pior rotulo + 8 de folga medida
            larguraPref = 131, -- 92 + 9 + 6 + 24: o modo cheio, com icone
            larguraMin  = 107, -- 92 + 9 + 6: o modo so-texto
        }

        local barraUltimaLargura, barraUltimoIcone = nil, nil

        -- DONA UNICA da largura de btnAba* e da visibilidade de icoAba*.
        -- Se outra rotina passar a escrever isso, o bug so aparece na ordem
        -- errada e "se conserta" ao trocar de aba — foi assim com o card da
        -- lua, e por isso existe a checagem 28.
        function ajustarBarraDeAbas()
            local barra = larguraDe(self.layBarraAbas)
            if barra == nil or barra <= 0 then return end
            local B = BARRA_ABAS
            local cabe = math.floor(barra / #abasDef) - B.gap
            local w = math.min(B.larguraPref, cabe)
            if w < B.larguraMin then w = B.larguraMin end
            local comIcone = (w - B.padEsq - B.padDir - B.icone) >= B.rotuloMin
            -- onResize dispara muitas vezes durante um arraste; sem esta
            -- guarda seriam 20 escritas por evento, sem nada mudar.
            if w == barraUltimaLargura and comIcone == barraUltimoIcone then return end
            barraUltimaLargura, barraUltimoIcone = w, comIcone
            for _, def in ipairs(abasDef) do
                local botao = self[def.botao]
                local ico   = self[def.ico]
                if botao ~= nil then definirLargura(botao, w) end
                if ico ~= nil then ico:setVisible(comIcone) end
            end
        end

        -- ===== Popups que cabem na tela =====
        -- Popup com width/height fixos maiores que a janela do Firecast fica
        -- com o rodape cortado. Aqui o tamanho desejado e so um teto: o real e
        -- limitado a 94% do que a ficha tem de espaco.
        function abrirPopupAjustado(popup, larguraDesejada, alturaDesejada)
            if popup == nil then return 0, 0 end
            local w = larguraDe(self)
            local h = alturaDe(self)
            local lw, lh = larguraDesejada, alturaDesejada
            if w > 0 then lw = math.min(larguraDesejada, math.floor(w * 0.94)); definirLargura(popup, lw) end
            if h > 0 then lh = math.min(alturaDesejada, math.floor(h * 0.94)); definirAltura(popup, lh) end
            pcall(function() popup:show() end)
            return lw, lh
        end

        -- Largura real que o popup de deuses vai ter, sem depender de perguntar
        -- a um controle que ainda nao foi desenhado.
        function tamanhoPopupDeuses()
            local w = larguraDe(self)
            if w <= 0 then return 1080 end
            return math.min(1080, math.floor(w * 0.94))
        end

        -- ===== Altura da lista de características =====
        -- Dentro de um scrollBox a lista precisa de height explícito. Ela cresce
        -- conforme os itens e quem rola é a aba, não a lista.
        local ALTURA_ITEM_CARAC = 78

        function ajustarAlturaListaCaracs(quantidade)
            local widget = self.listaCaracsRaciais
            if widget == nil then return end
            local qtd = tonumber(quantidade) or 0
            if qtd < 1 then qtd = 1 end   -- espaço para o estado vazio
            definirAltura(widget, qtd * ALTURA_ITEM_CARAC + 6)
        end

        -- =================================================================
        -- CICLO DE VIDA
        -- =================================================================
        -- =================================================================
        -- REPARO AUTOMATICO DE NOS "TRAVADOS"
        --
        -- Sempre que o template de um item de recordList muda (como acabamos
        -- de fazer com o de pericias), o Firecast pode nao conseguir religar
        -- corretamente os scripts/eventos dos itens que ja existiam ANTES da
        -- atualizacao - eles ficam visiveis mas surdos a clique e sem rodar
        -- o onNodeReady (por isso a descricao some e o botao de remover para
        -- de funcionar so para os itens antigos).
        --
        -- Para nunca mais isso travar a ficha de um jogador (nem nesta nem
        -- em futuras atualizacoes de qualquer lista), esta rotina roda toda
        -- vez que a ficha abre: ela LE os dados de cada item de cada lista,
        -- APAGA o no antigo e CRIA um no novo com os mesmos dados. O novo no
        -- e construido 100% pelo template atual, entao fica "saudavel" -
        -- exatamente como os itens adicionados nesta sessao ja se comportam.
        -- Como so mexe nos campos que a propria lista usa, e seguro rodar
        -- sempre, mesmo quando nao ha nada para reparar.
        -- =================================================================
        -- Completa campos que faltam nos itens salvos por versoes antigas,
        -- SEM apagar nem recriar no nenhum.
        --
        -- ATENCAO - historico: a versao anterior desta rotina apagava o
        -- NO-CONTAINER da lista (NDB.deleteNode(sheet[nomeLista])) e recriava
        -- os itens. Isso deixava os itens numa arvore desconectada do
        -- recordList, e o resultado era que o botao "x" de cada linha parava
        -- de funcionar (o NDB.deleteNode do item nao surtia efeito). Nunca
        -- mais apagar o container aqui: so preenchemos campos no lugar.
        -- ---------------------------------------------------------------
        -- OS CAMPOS DE UM ITEM DE HABILIDADE — FONTE UNICA
        --
        -- Esta lista e usada em TRES lugares: o reparo de nos antigos, a
        -- reconstrucao da lista (que apaga e recria cada no para forcar o
        -- onNodeReady) e a checagem 29 do verifica.py.
        --
        -- POR QUE ELA EXISTE. A reconstrucao copia campo a campo, e campo que
        -- nao esta na lista some EM SILENCIO na primeira edicao. Ja mordeu
        -- duas vezes:
        --   * "creditoEmbutido" - o desconto sumia depois da primeira edicao;
        --   * "progressiva" e os seis "efeitoRankX" (v0.38.x) - o jogador
        --     preenchia os blocos, salvava, e a habilidade voltava vazia.
        -- E, ao consertar a segunda, apareceu a terceira: "imagem" tambem
        -- nunca esteve na lista, entao a arte da habilidade vinha sendo
        -- perdida a cada edicao desde a v0.33.
        --
        -- Havia um comentario avisando disso no lugar certo. Comentario nao
        -- impede esquecimento: a checagem 29 impede.
        -- ---------------------------------------------------------------
        CAMPOS_HABILIDADE = {
            "tipo", "nome", "rank", "poderVinculado", "tags", "energia",
            "dadoBase", "modificador", "alcance", "duracao", "elemento",
            "descricao", "efeito", "custoPago", "origemGratis",
            "corpoACorpo", "emArea", "creditoEmbutido", "rotuloGratis",
            "imagem",
            "progressiva",
            "efeitoRankE", "efeitoRankD", "efeitoRankC",
            "efeitoRankB", "efeitoRankA", "efeitoRankEX",
        }

        local function repararListaGenerica(nomeLista, camposParaCopiar)
            if sheet == nil then return end
            local itens = NDB.getChildNodes(sheet[nomeLista])
            if itens == nil or #itens == 0 then return end

            for _, no in ipairs(itens) do
                -- descricao ausente: busca no catalogo certo
                if no.descricao == nil or no.descricao == "" then
                    if no.atributo ~= nil then
                        local doCat = CatalogoPericias.buscar(tostring(no.atributo), tostring(no.nome or ""))
                        if doCat ~= nil then no.descricao = doCat.descricao end
                    elseif no.tipo ~= nil then
                        local doCat = CatalogoQD.buscarPorNome(tostring(no.nome or ""))
                        if doCat ~= nil then
                            no.descricao = doCat.descricao
                            no.pontosTexto = doCat.pontosTexto
                        end
                    end
                end
                -- Qualidade/Defeito de versoes antigas nao separava
                -- "pontosPagos" de "pontosEscolhidos" (tudo era pago).
                if no.tipo ~= nil and no.pontosPagos == nil then
                    no.pontosPagos = no.pontosEscolhidos
                end
            end
        end

        local listasJaReparadas = {}

        local function repararSeNecessario(nomeLista, camposParaCopiar)
            if listasJaReparadas[nomeLista] then return end
            if self[nomeLista] == nil then return end -- widget da lista ainda nao foi construido (aba nunca visitada)
            repararListaGenerica(nomeLista, camposParaCopiar)
            listasJaReparadas[nomeLista] = true
        end

        -- Grafias antigas da mesma classe (M-06): "Artificie" era o nome no
        -- catalogo de classes e "Artífice" a tag de habilidade. A mesa
        -- decidiu (05/09/2026) "Artíficie", e o dado antigo e convertido ao
        -- abrir. Nao existe versao a partir da qual isto possa parar de
        -- rodar: ficha antiga e a maioria.
        local GRAFIAS_ARTIFICIE = { ["Artificie"] = true, ["Artífice"] = true, ["Artifice"] = true }

        function repararGrafiaArtificie()
            if sheet == nil then return end
            for slot = 1, 2 do
                local c = tostring(sheet["classe" .. slot .. "Nome"] or "")
                if GRAFIAS_ARTIFICIE[c] then sheet["classe" .. slot .. "Nome"] = "Artíficie" end
            end
            for _, h in ipairs(NDB.getChildNodes(sheet.listaHabilidades) or {}) do
                local t = tostring(h.tags or "")
                if t ~= "" then
                    -- troca por texto plano, grafia a grafia: padrao Lua com
                    -- classe de caracteres nao le acento (UTF-8 e 2 bytes)
                    local novo = t
                    for grafia, _ in pairs(GRAFIAS_ARTIFICIE) do
                        novo = novo:gsub(grafia, "Artíficie")
                    end
                    if novo ~= t then h.tags = novo end
                end
            end
        end

        function repararNosAntigos()
            pcall(function() repararGrafiaArtificie() end)
            local listasPericia = {
                "listaPericiasCarisma", "listaPericiasDestreza", "listaPericiasForca",
                "listaPericiasInteligencia", "listaPericiasManipulacao", "listaPericiasSabedoria",
            }
            for _, nomeLista in ipairs(listasPericia) do
                repararSeNecessario(nomeLista, {"atributo", "nome", "aprovadoMestre", "descricao"})
            end
            repararSeNecessario("listaQualidades", {"tipo", "nome", "pontosEscolhidos", "pontosPagos", "descricao", "pontosTexto"})
            repararSeNecessario("listaDefeitos", {"tipo", "nome", "pontosEscolhidos", "pontosPagos", "descricao", "pontosTexto"})
            repararSeNecessario("listaHabilidades", CAMPOS_HABILIDADE)
        end

        -- =================================================================
        -- PODERES
        --
        -- MODELO DE DADOS - por que texto serializado e nao recordList:
        --   A quantidade de poderes NAO e fixa. A mecanica de Bencao (trocar
        --   3 favores com um deus que nao e seu pai/mae) libera comprar
        --   tambem do kit DAQUELE deus. Campos planos numerados obrigariam a
        --   migrar fichas ja preenchidas quando as bencoes entrarem.
        --   Serializar resolve: dado de tamanho livre em campo plano.
        --
        -- FORMATO: registros separados por ";", campos por "|"
        --   nome|nivel|log|deus
        --   log = "nivelDoPoder@nivelDoPersonagem", separados por virgula
        --   ex: "Cura|3|1@1,2@3,3@5|Ditrys"
        --   Nenhum dos 48 nomes de poder contem ";", "|" ou "@" (conferido).
        --
        -- A ABA MOSTRA SO O QUE FOI ADQUIRIDO. O kit e opcional: o jogador
        -- pode comprar um unico poder e investir todo o resto em habilidades
        -- e feiticos. Listar os 5 do kit em "nivel 0" comunicava o oposto
        -- ("preencha os cinco"), entao poderes entram pelo catalogo.
        -- =================================================================

        local GANHO_PONTOS_PODER = {
            [1]=2, [2]=2, [3]=3, [4]=2,  [5]=3, [6]=3, [7]=2, [8]=2, [9]=3,
            [10]=4, [11]=2, [12]=3, [13]=2, [14]=3, [15]=3, [16]=2, [17]=2,
            [18]=3, [19]=2, [20]=5,
        }

        -- Quantos slots de exibicao existem no XML da aba.
        -- 5 do kit nativo + margem para varias bencoes (cada bencao abre um
        -- kit inteiro de 5). 24 cobre pai/mae + 3 bencoes completas com folga.
        local MAX_SLOTS_PODER = 24

        -- Altura dos blocos quando visiveis. Ocultar = altura 0.
        local ALTURA_SLOT_PODER = 80
        local ALTURA_GRUPO_PODER = 32
        local ALTURA_VAZIO_PODER = 70

        -- Nunca usamos setVisible nos blocos da lista: no Firecast, tornar
        -- visivel em runtime um elemento align="top" que estava invisivel o
        -- insere no TOPO da pilha, e nao na posicao declarada. Foi o que jogou
        -- a secao "FORA DOS KITS" para cima de tudo ao registrar uma bencao.
        -- Controlar ALTURA preserva a ordem do XML em qualquer cenario.
        local function definirAlturaPod(ctrl, valor)
            if ctrl == nil then return end
            pcall(function() ctrl:setHeight(valor) end)
        end

        local function definirLarguraPod(ctrl, valor)
            if ctrl == nil then return end
            pcall(function() ctrl:setWidth(valor) end)
        end

        -- O BLOCO DO SELO DO CABECALHO MORA AQUI, e nao la em cima junto do
        -- catalogo de deuses, por um motivo do Lua: definirAlturaPod e
        -- `local`, e local so existe A PARTIR DA LINHA em que e declarado.
        -- Escrito acima, atualizarPopupSeloCabecalho enxergava um GLOBAL de
        -- mesmo nome, que e nil — e o popup estourava "attempt to call a nil
        -- value" na hora de abrir. Quem pegou foi a bateria, antes de instalar.
        -- ---------------------------------------------------------------
        -- SELO DO CABECALHO (v0.45.0)
        --
        -- O brasao da mesa, nos dois lados do titulo, passa a poder ser o
        -- selo de uma divindade. Automatico quando o semideus e PROCLAMADO
        -- — a proclamacao e marco raro ("so vem do seu proprio Aspecto
        -- Divino", e so uma vez), entao ela merece aparecer na ficha
        -- inteira. E escolhivel entre os vinculos que o personagem
        -- realmente tem: o aspecto e cada bencao. Nao se exibe o selo de
        -- um deus com quem nao se tem vinculo nenhum.
        -- ---------------------------------------------------------------
        function selosDisponiveis()
            -- chave "brasao", e nao "": "" quer dizer NUNCA ESCOLHEU, e e o
            -- que deixa a proclamacao mandar. Se o brasao fosse "", um
            -- personagem proclamado nao teria como voltar para ele — clicaria
            -- no brasao e o automatico devolveria o selo do deus. Foi uma
            -- assercao que mostrou isso.
            if sheet == nil then
                return { { chave = "", rotulo = "Automático", nota = "",
                           src = SELO_NEUTRO.pequeno } }
            end
            -- AUTOMATICO e a primeira opcao, e nao um estado invisivel.
            -- Sem ela, quem escolhesse um selo NUNCA MAIS voltava a seguir a
            -- proclamacao: "" so existia enquanto ninguem tivesse clicado, e
            -- nao havia clique que devolvesse "". Achado testando na tela.
            local proc = tostring(sheet.proclamadoPor or "")
            local notaAuto = "segue a sua proclamação"
            if proc == "" then
                notaAuto = "sem proclamação, fica o brasão da mesa"
            else
                notaAuto = "segue a sua proclamação — hoje, " .. proc
            end
            local r = { { chave = "", rotulo = "Automático", nota = notaAuto,
                          src = seloAutomatico() },
                        { chave = "brasao", rotulo = "Brasão da mesa",
                          nota = "o padrão da mesa, fixo", src = SELO_NEUTRO.pequeno } }
            local asp = tostring(sheet.aspectoDivino or "")
            if asp ~= "" and SELO_DO_DEUS[asp] ~= nil then
                local nota = "seu aspecto divino"
                if tostring(sheet.proclamadoPor or "") == asp then
                    nota = "seu aspecto divino  ✦  proclamou você"
                end
                table.insert(r, { chave = asp, rotulo = asp, nota = nota,
                                  src = SELO_DO_DEUS[asp].pequeno })
            end
            for _, d in ipairs(deusesAbencoados()) do
                if d ~= "" and d ~= asp and SELO_DO_DEUS[d] ~= nil then
                    table.insert(r, { chave = d, rotulo = d, nota = "bênção",
                                      src = SELO_DO_DEUS[d].pequeno })
                end
            end
            return r
        end

        -- o que o AUTOMATICO daria agora. Separado para o proprio seletor
        -- poder desenhar a opcao "Automático" com o selo que ela produz.
        -- BRASAO DA RACA (v0.46.0), no card da aba 04.
        -- So as 10 racas JOGAVEIS tem brasao: sao as que um jogador escolhe.
        -- As nao-jogaveis e as primordiais aparecem sem, e o card encosta na
        -- esquerda — melhor do que um escudo generico repetido, que nao
        -- identificaria nada. A checagem 48 cobra que nenhuma jogavel fique
        -- de fora: uma so sem brasao, ao lado das outras nove com, e o
        -- conjunto inteiro parece quebrado.
        -- Caminhos em LITERAL, como os selos, para a checagem 33 alcancar.
        -- =================================================================
        -- BRASOES DE RACA
        --
        -- TODA raca do catalogo tem escudo, nao so as dez Jogaveis. A v0.46.0
        -- so fez as Jogaveis por uma premissa MINHA que era falsa ("ninguem
        -- escolhe as outras na criacao"): as doze NaoJogaveis entram pela
        -- qualidade "Mestico" (como raca secundaria) e pela "Sangue das racas
        -- antigas" (como raca PRINCIPAL, no lugar de uma Jogavel). As sete
        -- Primordiais nao entram na criacao, mas ganham escudo pelo mesmo
        -- motivo que ganharam selo na v0.44.1: peso de lore, e meio conjunto
        -- parece quebrado.
        --
        -- A checagem 48 cobra as 29 e o tamanho 96x96 de cada arquivo (a arte
        -- de pacote nao escala - checagem 19).
        -- =================================================================
        BRASAO_DA_RACA = {
            -- Jogaveis
            ["Anoes"]           = "imagens/brasao_raca_anoes.png",
            ["Drow"]            = "imagens/brasao_raca_drow.png",
            ["Elfos"]           = "imagens/brasao_raca_elfos.png",
            ["Fadas"]           = "imagens/brasao_raca_fadas.png",
            ["Gnomos"]          = "imagens/brasao_raca_gnomos.png",
            ["Humanos"]         = "imagens/brasao_raca_humanos.png",
            ["Lizarianos"]      = "imagens/brasao_raca_lizarianos.png",
            ["Orcs"]            = "imagens/brasao_raca_orcs.png",
            ["Selkies"]         = "imagens/brasao_raca_selkies.png",
            ["Vampiros"]        = "imagens/brasao_raca_vampiros.png",
            -- Nao jogaveis (Mestico / Sangue das racas antigas)
            ["Aarakocras"]      = "imagens/brasao_raca_aarakocras.png",
            ["Harpias"]         = "imagens/brasao_raca_harpias.png",
            ["Giffs"]           = "imagens/brasao_raca_giffs.png",
            ["SereiaseTritoes"] = "imagens/brasao_raca_sereiasetritoes.png",
            ["Centauros"]       = "imagens/brasao_raca_centauros.png",
            ["Ghiscari"]        = "imagens/brasao_raca_ghiscari.png",
            ["Ninfas"]          = "imagens/brasao_raca_ninfas.png",
            ["Lobisomens"]      = "imagens/brasao_raca_lobisomens.png",
            ["Minotauros"]      = "imagens/brasao_raca_minotauros.png",
            ["Satiros"]         = "imagens/brasao_raca_satiros.png",
            ["Ursaris"]         = "imagens/brasao_raca_ursaris.png",
            ["Goblins"]         = "imagens/brasao_raca_goblins.png",
            -- Primordiais (lore; nao entram na criacao)
            ["Banshees"]        = "imagens/brasao_raca_banshees.png",
            ["Criofenix"]       = "imagens/brasao_raca_criofenix.png",
            ["Dragoes"]         = "imagens/brasao_raca_dragoes.png",
            ["Fenix"]           = "imagens/brasao_raca_fenix.png",
            ["Gigantes"]        = "imagens/brasao_raca_gigantes.png",
            ["Krakens"]         = "imagens/brasao_raca_krakens.png",
            ["Unicornios"]      = "imagens/brasao_raca_unicornios.png",
        }

        -- Escudo da raca PRINCIPAL (esquerda) e o da SEGUNDA raca do mestico
        -- (direita), pedido na tela em 05/09/2026: com so um escudo, o card de
        -- um mestico mostrava metade da heranca dele.
        --
        -- Os dois pods sao RECONCILIADOS a cada chamada, nao criados-e-
        -- esquecidos: quem tira a qualidade Mestico, troca a raca secundaria
        -- ou limpa a raca precisa ver o escudo SUMIR. Por isso as duas pontas
        -- terminam sempre num definirLarguraPod, inclusive no caminho em que
        -- nao ha arquivo (largura 0) - e por isso a largura sai de UMA funcao
        -- so (checagem 45: uma propriedade, um dono).
        function atualizarBrasaoRaca(dados)
            local arq = nil
            if dados ~= nil and dados.chave ~= nil then
                arq = BRASAO_DA_RACA[dados.chave]
            end
            if arq ~= nil and self.abaRaca_imgBrasao ~= nil then
                pcall(function() self.abaRaca_imgBrasao.src = arq end)
            end
            definirLarguraPod(self.abaRaca_wrapBrasao, arq ~= nil and 96 or 0)

            -- SEGUNDO escudo: so existe quando ha mesticagem COM heranca
            -- definida. Sem a qualidade comprada, ou com a heranca ainda em
            -- branco, o pod vai a zero e o texto reocupa a largura.
            local arq2 = nil
            if sheet ~= nil and contextoRacial().temMestico then
                local seg = CatalogoRacas.buscarPorNome(tostring(sheet.mesticoRacaSecundaria or ""))
                if seg ~= nil and seg.chave ~= nil then
                    arq2 = BRASAO_DA_RACA[seg.chave]
                end
            end
            if arq2 ~= nil and self.abaRaca_imgBrasao2 ~= nil then
                pcall(function() self.abaRaca_imgBrasao2.src = arq2 end)
            end
            definirLarguraPod(self.abaRaca_wrapBrasao2, arq2 ~= nil and 96 or 0)
        end

        function seloAutomatico()
            if sheet == nil then return SELO_NEUTRO.pequeno end
            local proc = tostring(sheet.proclamadoPor or "")
            if proc ~= "" and SELO_DO_DEUS[proc] ~= nil then
                return SELO_DO_DEUS[proc].pequeno
            end
            return SELO_NEUTRO.pequeno
        end

        function seloDoCabecalho()
            if sheet == nil then return SELO_NEUTRO.pequeno end
            local escolhido = tostring(sheet.seloCabecalho or "")
            if escolhido == "brasao" then return SELO_NEUTRO.pequeno end
            if escolhido ~= "" then
                for _, o in ipairs(selosDisponiveis()) do
                    if o.chave == escolhido then return o.src end
                end
                -- RECONCILIACAO, e nao criar-e-esquecer: a fonte do selo saiu
                -- da ficha (a bencao foi removida, o aspecto trocou). Limpa o
                -- campo em vez de deixa-lo apontando para um vinculo que nao
                -- existe mais — senao o selo de um deus estranho fica na ficha
                -- para sempre, e ninguem lembra de onde veio.
                sheet.seloCabecalho = ""
            end
            return seloAutomatico()
        end

        function atualizarSeloCabecalho()
            local src = seloDoCabecalho()
            for _, n in ipairs({ "imgSeloCabE", "imgSeloCabD" }) do
                local w = self[n]
                if w ~= nil then pcall(function() w.src = src end) end
            end
        end

        -- O clique do slot manda o INDICE, e a funcao resolve pela lista do
        -- momento. A primeira versao mandava uma constante por slot
        -- (SELO_OPCAO_1...), que nao existia: chegaria nil, o campo seria
        -- zerado e todo clique voltaria para o brasao da mesa — errado em
        -- silencio, sem erro nenhum na tela.
        function escolherSeloPorSlot(i)
            local ops = selosDisponiveis()
            local o = ops[i]
            if o == nil then return end
            escolherSeloCabecalho(o.chave)
        end

        function escolherSeloCabecalho(chave)
            if sheet == nil then return end
            sheet.seloCabecalho = tostring(chave or "")
            atualizarSeloCabecalho()
            atualizarPopupSeloCabecalho()
        end

        SLOTS_SELO_CAB = 12

        function atualizarPopupSeloCabecalho()
            local ops = selosDisponiveis()
            local atual = seloDoCabecalho()
            for i = 1, SLOTS_SELO_CAB do
                local wrap = self["popSel_wrap" .. i]
                local o = ops[i]
                if o == nil then
                    definirAlturaPod(wrap, 0)
                else
                    definirAlturaPod(wrap, 46)
                    pcall(function() self["popSel_img" .. i].src = o.src end)
                    if self["popSel_lbl" .. i] ~= nil then
                        self["popSel_lbl" .. i]:setText(o.rotulo)
                    end
                    if self["popSel_nota" .. i] ~= nil then
                        self["popSel_nota" .. i]:setText(o.nota)
                    end
                    if self["popSel_rect" .. i] ~= nil then
                        local emUso = (o.src == atual)
                        self["popSel_rect" .. i]:setStrokeColor(emUso and COR.gold or "#22323A")
                        self["popSel_rect" .. i]:setStrokeSize(emUso and 2 or 1)
                    end
                end
            end
            if self.popSel_lblVazio ~= nil then
                if #ops <= 1 then
                    self.popSel_lblVazio:setText("Você ainda não tem vínculo com nenhuma divindade. Escolha um Aspecto Divino na seção I, ou receba uma bênção trocando 3 Favores na seção IX — as duas coisas colocam o selo aqui.")
                else
                    self.popSel_lblVazio:setText("")
                end
            end
        end

        function abrirPopupSeloCabecalho()
            if self.popSeloCab == nil then return end
            atualizarPopupSeloCabecalho()
            abrirPopupAjustado(self.popSeloCab, 460, 460)
        end

        function fecharPopupSeloCabecalho()
            if self.popSeloCab ~= nil then self.popSeloCab:close() end
        end


        -- Carimbo de data/hora proprio.
        -- NAO reaproveita "dataHoraTexto": aquela e uma "local function"
        -- declarada mais abaixo no arquivo, e em Lua uma local so existe a
        -- partir da linha em que foi declarada. Chamar de cima da para tras
        -- resulta em "attempt to call a nil value".
        function carimboDeTempo()
            local ok, txt = pcall(function() return os.date("%d/%m/%Y %H:%M") end)
            if ok and txt ~= nil then return tostring(txt) end
            return "data desconhecida"
        end

        -- Chave de widget a partir do nome do poder. Precisa bater EXATAMENTE
        -- com os nomes rectPod_<chave> gerados no XML do catalogo.
        -- Nome -> chave de widget. O XML tem um retangulo por deus/poder com o
        -- nome ja normalizado; esta funcao precisa chegar EXATAMENTE na mesma
        -- string, senao self["rectFav_" .. chave] devolve nil.
        --
        -- E quando devolve nil, NADA acontece: quem chama pula a linha e o
        -- widget fica com a altura que tinha antes. Foi assim que Sýdos, um
        -- deus GRANDE, aparecia na lista de escolha de PRIMORDIAL (bug da
        -- v0.35.3): faltava o "ý" na tabela de acentos, o gsub final apagava a
        -- letra, chavePoder devolvia "Sdos", o widget "rectFav_Sydos" nunca
        -- era encontrado, e ele ficava com os 26px da listagem anterior.
        -- Nenhum erro, nenhum aviso — so um deus errado na tela.
        --
        -- A tabela agora cobre o alfabeto acentuado do portugues inteiro e os
        -- vizinhos mais provaveis (ý, ñ, tremas, crases). A checagem 25 do
        -- verifica.py confere, deus a deus, se chavePoder bate com o XML.
        function chavePoder(nome)
            local s = tostring(nome or "")
            local de = {
                ["á"]="a",["à"]="a",["ã"]="a",["â"]="a",["ä"]="a",
                ["é"]="e",["è"]="e",["ê"]="e",["ë"]="e",
                ["í"]="i",["ì"]="i",["î"]="i",["ï"]="i",
                ["ó"]="o",["ò"]="o",["ô"]="o",["õ"]="o",["ö"]="o",
                ["ú"]="u",["ù"]="u",["û"]="u",["ü"]="u",
                ["ý"]="y",["ÿ"]="y",["ñ"]="n",["ç"]="c",
                ["Á"]="A",["À"]="A",["Â"]="A",["Ã"]="A",["Ä"]="A",
                ["É"]="E",["È"]="E",["Ê"]="E",["Ë"]="E",
                ["Í"]="I",["Ì"]="I",["Î"]="I",["Ï"]="I",
                ["Ó"]="O",["Ò"]="O",["Ô"]="O",["Õ"]="O",["Ö"]="O",
                ["Ú"]="U",["Ù"]="U",["Û"]="U",["Ü"]="U",
                ["Ý"]="Y",["Ñ"]="N",["Ç"]="C",
            }
            for k, v in pairs(de) do s = s:gsub(k, v) end
            s = s:gsub("[^A-Za-z0-9]", "")
            return s
        end

        -- =============================================================
        -- BUSCA NOS CATALOGOS (v0.48.0)
        -- =============================================================
        -- UX, nao regra. O livro nao versa sobre interface e nada aqui
        -- decide numero de jogo -- por isso este bloco nao cita o livro, e
        -- a ausencia e proposital, nao esquecimento.
        --
        -- FILTRAR NAO RECONSTROI A LISTA. Os 412 cards dos tres catalogos
        -- sao estaticos no XML e cada um ja carrega sua chave dentro do
        -- proprio onClick. Reconstruir e que perderia a chave (foi assim
        -- que creditoEmbutido sumiu na v0.28 e imagem na v0.33) e, no
        -- popItens, quebraria os 250 indices posicionais que a checagem 20
        -- amarra. Aqui a busca so ESCONDE card que ja existe: quem sobra
        -- continua com exatamente o mesmo onClick de sempre.
        --
        -- ESCONDER E POR ALTURA ZERO, nunca por visible=: visible em
        -- align="top" REORDENA o layout neste SDK.
        --
        -- E A MARGEM SOBRA quando a altura vai a zero: sao 3px em 250
        -- cards (750px de vao fantasma) e 4px em 49. Dai o cuidado com a
        -- margem abaixo, que NAO e detalhe de acabamento.
        -- -------------------------------------------------------------

        -- Altura do card de cada lista, MEDIDA no XML em 05/09/2026:
        -- 49 cards de 44px, 250 de 28px, 113 de 26px -- uniforme dentro de
        -- cada lista. A checagem 51 confere estes tres numeros contra o
        -- XML, porque medida copiada a mao para dentro do Lua envelhece
        -- calada e o card volta com a altura errada.
        local ALTURA_CARD_CATALOGO = { qd = 44, item = 28, poder = 26 }

        -- Margem original de cada widget, LIDA do proprio widget na
        -- primeira vez e guardada. Ler em vez de repetir aqui a tabela do
        -- XML e o que faz as TRES formas de margem do catalogo de poderes
        -- (bottom=3 / left=12,bottom=2 / left=12,bottom=6) e as duas dos
        -- cabecalhos do popItens sobreviverem sem uma segunda copia para
        -- divergir da primeira.
        local margemDoWidget = {}
        local margemFoiLida = {}

        local ZERO_MARGENS = { left = 0, top = 0, right = 0, bottom = 0 }

        local function guardarMargem(nome, ctrl)
            if margemFoiLida[nome] == nil then
                local ok, m = pcall(function() return ctrl:getMargins() end)
                margemFoiLida[nome] = (ok and m ~= nil)
                if margemFoiLida[nome] then margemDoWidget[nome] = m end
            end
            return margemFoiLida[nome]
        end

        -- ESTADO ATUAL de cada linha, para nao repintar o que nao mudou.
        --
        -- MEDIDO na tela em 06/09/2026: a v0.48.0 travava por segundos a cada
        -- tecla no catalogo de itens. Duas causas, e as duas somavam:
        --
        --  (a) a DOBRA era refeita a cada tecla. chavePoder() percorre uma
        --      tabela de ~50 acentos com um gsub por entrada, e o filtro da
        --      loja a chamava DUAS vezes por card (nome e qualidade) mais uma
        --      vez por nome buscado: 250 cards x 3 x 50 = 37 mil gsubs por
        --      TECLA. Agora o indice e montado UMA vez e reusado.
        --
        --  (b) todo card recebia setHeight e setMargins a cada tecla, mesmo
        --      os 240 que ja estavam escondidos e continuariam escondidos.
        --      Cada um e uma chamada ao host. Agora so muda quem MUDA.
        --
        -- Guardar estado tem um preco conhecido: ele pode dessincronizar do
        -- widget. Por isso zerarEstadoCatalogo() e chamado ao ABRIR o popup,
        -- que e o unico momento em que alguem pode ter mexido por fora.
        local estadoLinha = {}

        local function zerarEstadoCatalogo()
            estadoLinha = {}
        end

        -- Mostra ou esconde uma linha de catalogo (card ou cabecalho).
        --
        -- A margem so e mexida quando a original pode ser LIDA antes. Zerar
        -- sem saber restaurar apagaria o recuo left=12 dos 41 cards que sao
        -- as alternativas do mesmo slot ("um dos dois") e o left=6 dos
        -- subtitulos de consumivel -- e card mentindo sobre a estrutura do
        -- kit e pior que vao em branco. Nao conseguiu ler -> so a altura
        -- muda, e o vao fica. Escada, nao aposta.
        -- SUSPENDER O DESENHO DURANTE A PASSADA.
        --
        -- MEDIDO em 06/09/2026: a PRIMEIRA busca no catalogo de itens muda 254
        -- linhas de uma vez (refinar depois custa 8 -- o memo funciona). Se
        -- cada setHeight dentro do scrollBox dispara um reflow dos 250 filhos,
        -- o custo e quadratico, e e o que explica travar em itens e poderes e
        -- nao em qualidades, que tem 49.
        --
        -- Este SDK nao tem beginUpdate/endUpdate para GUI -- so para no de NDB
        -- (sdk/ndb.lua:123). O equivalente possivel e esconder a lista, mexer,
        -- e devolver: duas chamadas em vez de 254 reflows.
        --
        -- E TESTE, e esta escrito assim de proposito. Nao consigo medir reflow
        -- do host daqui: o harness troca setHeight por escrita em tabela. Se na
        -- tela isto nao ajudar, ou se a lista piscar, o conserto e apagar as
        -- duas chamadas -- o filtro funciona sem elas.
        --
        -- O scrollBox e o unico filho align="client" do painel, e a caixa de
        -- busca (align="top") e declarada antes dele: nao ha irmao para
        -- reordenar, que e a armadilha conhecida do visible= neste SDK.
        local function suspenderLista(nomeSb, suspender)
            local sb = self[nomeSb]
            if sb == nil then return end
            pcall(function() sb:setVisible(not suspender) end)
        end

        local function mostrarLinhaCatalogo(nome, altura, mostrar)
            if estadoLinha[nome] == mostrar then return true end
            local ctrl = self[nome]
            if ctrl == nil then return false end
            estadoLinha[nome] = mostrar
            pcall(function() ctrl:setHeight(mostrar and altura or 0) end)
            if guardarMargem(nome, ctrl) then
                pcall(function()
                    ctrl:setMargins(mostrar and margemDoWidget[nome] or ZERO_MARGENS)
                end)
            end
            return true
        end

        -- ===============================================================
        -- FAREJADOR DA BUSCA
        -- ===============================================================
        -- A busca continuou pesada depois de duas correcoes minhas: a
        -- tempestade de gsub (que era real, e caiu de 153 ms para 13 ms no
        -- harness) e o reflow (que tentei suspender escondendo a lista, e nao
        -- resolveu). Duas explicacoes gastas para o mesmo sintoma.
        --
        -- A lei da casa manda parar e construir o instrumento. E ele tem de
        -- rodar DENTRO do Firecast: o harness troca setHeight por escrita em
        -- tabela, entao ele mede o Lua e nao mede o host -- que e justamente
        -- onde o tempo esta.
        --
        -- COMO USAR: digite  !t  na caixa de busca do catalogo. A ficha mede
        -- e escreve o laudo acima da lista. Nao muda nada na ficha.
        --
        -- Os quatro numeros separam as quatro suspeitas, e cada um mede UMA
        -- coisa: percorrer o indice, ler margem, mudar altura, mudar margem.
        function farejarBusca(qual)
            if sheet == nil then return end
            local lbl = self["lblLaudo" .. qual]
            if lbl == nil then return end

            local alvos, altura
            if qual == "Itens" then
                alvos, altura = {}, ALTURA_CARD_CATALOGO.item
                for _, e in ipairs(montarIndiceItens().linhas) do
                    alvos[#alvos + 1] = e.w
                end
            else
                alvos, altura = {}, ALTURA_CARD_CATALOGO.poder
                for _, kit in ipairs(montarIndicePoderes().kits) do
                    for _, s in ipairs(kit.slots) do
                        for _, c in ipairs(s.cards) do alvos[#alvos + 1] = c.w end
                    end
                end
            end
            local n0 = #alvos

            -- 1. so o Lua: percorre o indice e compara, sem tocar em widget
            local t0 = os.clock()
            local casaram = 0
            for _, w in ipairs(alvos) do
                if string.find(w, "zzz", 1, true) ~= nil then casaram = casaram + 1 end
            end
            local tLua = os.clock() - t0

            -- 2. so ACHAR o widget (self[nome]), sem chamar metodo nenhum
            t0 = os.clock()
            for _, w in ipairs(alvos) do local _ = self[w] end
            local tAchar = os.clock() - t0

            -- 3. LER a margem: e _obj_getProp, e roda uma vez por card na
            --    primeira passada
            t0 = os.clock()
            for _, w in ipairs(alvos) do
                pcall(function() local _ = self[w]:getMargins() end)
            end
            local tLer = os.clock() - t0

            -- 4. MUDAR a altura, que e a suspeita principal
            t0 = os.clock()
            for _, w in ipairs(alvos) do
                pcall(function() self[w]:setHeight(altura) end)
            end
            local tAltura = os.clock() - t0

            -- 5. MUDAR a margem
            t0 = os.clock()
            for _, w in ipairs(alvos) do
                pcall(function() self[w]:setMargins(ZERO_MARGENS) end)
            end
            local tMargem = os.clock() - t0

            -- devolve tudo ao lugar, para o farejador nao deixar estrago
            for _, w in ipairs(alvos) do
                if margemFoiLida[w] then
                    pcall(function() self[w]:setMargins(margemDoWidget[w]) end)
                end
                pcall(function() self[w]:setHeight(altura) end)
            end
            estadoLinha = {}

            local function ms(v) return string.format("%.0f", v * 1000) end
            lbl:setText(n0 .. " cards  ·  laco " .. ms(tLua) ..
                " ms  ·  achar widget " .. ms(tAchar) ..
                " ms  ·  LER margem " .. ms(tLer) ..
                " ms  ·  MUDAR altura " .. ms(tAltura) ..
                " ms  ·  MUDAR margem " .. ms(tMargem) .. " ms")
            pcall(function() lbl:setHeight(34) end)
        end

        -- A dobra da busca e chavePoder(): ela ja tira acento e tudo que nao
        -- e alfanumerico, e e ELA que gera o sufixo do nome do widget. Buscar
        -- com a mesma funcao que batizou o card e o que faz "pocao" achar
        -- "Pocao de Cura" sem uma tabela de acentos paralela para envelhecer
        -- -- e a checagem 25 ja cobra essa funcao, deus a deus.
        function dobrarBusca(texto)
            return string.lower(chavePoder(texto))
        end

        function buscaCasa(alvoDobrado, agulhaDobrada)
            if agulhaDobrada == "" then return true end
            return string.find(alvoDobrado, agulhaDobrada, 1, true) ~= nil
        end

        -- OS INDICES, montados UMA vez por catalogo.
        --
        -- Cada entrada ja traz o nome do widget e o texto dobrado contra o
        -- qual comparar. Depois disto, uma tecla custa um string.find por
        -- linha -- e nao uma dobra inteira.
        local indiceQD, indiceItens, indicePoderes

        local function montarIndiceQD()
            if indiceQD ~= nil then return indiceQD end
            indiceQD = {}
            for _, it in ipairs(CatalogoQD.itens) do
                indiceQD[#indiceQD + 1] = {
                    w = "rectLinhaQD_" .. tostring(it.chave),
                    tipo = tostring(it.tipo),
                    alvo = dobrarBusca(it.nome or it.chave),
                }
            end
            return indiceQD
        end

        local function montarIndiceItens()
            if indiceItens ~= nil then return indiceItens end
            local linhas, faixas, subs = {}, {}, {}
            local vistas, vistosSub = {}, {}
            for _, it in ipairs(CatalogoItens.itens) do
                local cat = tostring(it.categoria)
                local sub = it.subtipo ~= nil and tostring(it.subtipo) or nil
                linhas[#linhas + 1] = {
                    w = "itmL_" .. chavePoder(it.nome) .. chavePoder(it.qualidade),
                    alvo = dobrarBusca(tostring(it.nome) .. tostring(it.qualidade)),
                    cat = cat, sub = sub,
                }
                if not vistas[cat] then
                    vistas[cat] = true
                    faixas[#faixas + 1] = {chave = cat, w = "itmCab_" .. chavePoder(cat)}
                end
                if sub ~= nil and not vistosSub[sub] then
                    vistosSub[sub] = true
                    subs[#subs + 1] = {chave = sub, w = "itmSub_" .. chavePoder(sub)}
                end
            end
            indiceItens = {linhas = linhas, faixas = faixas, subs = subs}
            return indiceItens
        end

        local function montarIndicePoderes()
            if indicePoderes ~= nil then return indicePoderes end
            local kits = {}
            for _, deus in ipairs(CatalogoDeuses.itens) do
                local chaveDeus = chavePoder(deus.nome)
                local kit = {cab = "podCab_" .. chaveDeus, slots = {}}
                for i, slot in ipairs(deus.slots or {}) do
                    local s = {rotulo = (#slot > 1) and ("podSlot_" .. chaveDeus .. "_" .. i) or nil,
                               cards = {}}
                    for _, nomePoder in ipairs(slot) do
                        s.cards[#s.cards + 1] = {
                            w = "rectPod_" .. chaveDeus .. "_" .. chavePoder(nomePoder),
                            alvo = dobrarBusca(nomePoder),
                        }
                    end
                    kit.slots[#kit.slots + 1] = s
                end
                kits[#kits + 1] = kit
            end
            local fora = {}
            for _, nomePoder in ipairs({"Magia", "Hemocinese"}) do
                fora[#fora + 1] = {w = "rectPod_" .. chavePoder(nomePoder),
                                   alvo = dobrarBusca(nomePoder)}
            end
            indicePoderes = {kits = kits, fora = fora}
            return indicePoderes
        end

        -- QUALIDADES E DEFEITOS -- o caso limpo dos tres.
        --
        -- Os dois popups dividem o prefixo rectLinhaQD_ e sao listas planas:
        -- nenhum cabecalho de secao dentro do scrollBox. Mas cada um tem sua
        -- PROPRIA caixa de busca, entao o filtro recebe o TIPO e so mexe nos
        -- cards daquele popup. Filtrar os dois de uma passada esconderia
        -- cards do popup vizinho com a caixa dele vazia.
        --
        -- it.chave JA E a forma dobrada ("Anjoguardiao") e it.nome e a de
        -- tela ("Anjo guardiao"): 37 das 49 entradas divergem. O widget vem
        -- da CHAVE; a busca casa contra o NOME, que e o que o jogador esta
        -- lendo quando digita.
        function filtrarCatalogoQD(texto, tipo)
            local agulha = dobrarBusca(texto)
            for _, e in ipairs(montarIndiceQD()) do
                if tipo == nil or e.tipo == tipo then
                    mostrarLinhaCatalogo(e.w, ALTURA_CARD_CATALOGO.qd,
                                         buscaCasa(e.alvo, agulha))
                end
            end
        end

        -- LOJA -- 250 cards, 9 cabecalhos de categoria e 6 subtitulos.
        --
        -- Ate a v0.48.0 os 15 cabecalhos NAO TINHAM name=, entao o Lua nao os
        -- alcancava. Filtrar sem eles deixaria "ARMADURA" flutuando sem nada
        -- embaixo -- a lista pareceria quebrada sem erro nenhum.
        --
        -- Cabecalho some quando NENHUM item da sua faixa sobreviveu: e
        -- derivado do resultado da busca, recalculado a cada tecla. Nao
        -- existe estado de cabecalho para dessincronizar.
        function filtrarCatalogoItens(texto)
            if tostring(texto) == "!t" then return farejarBusca("Itens") end
            local agulha = dobrarBusca(texto)
            suspenderLista("sbListaItens", true)
            local ix = montarIndiceItens()
            local sobrouCat, sobrouSub = {}, {}
            for _, e in ipairs(ix.linhas) do
                local casa = buscaCasa(e.alvo, agulha)
                mostrarLinhaCatalogo(e.w, ALTURA_CARD_CATALOGO.item, casa)
                if casa then
                    sobrouCat[e.cat] = true
                    if e.sub ~= nil then sobrouSub[e.sub] = true end
                end
            end
            for _, f in ipairs(ix.faixas) do
                mostrarLinhaCatalogo(f.w, 24, sobrouCat[f.chave] == true)
            end
            for _, s in ipairs(ix.subs) do
                mostrarLinhaCatalogo(s.w, 18, sobrouSub[s.chave] == true)
            end
            suspenderLista("sbListaItens", false)
        end

        -- PODERES -- 113 cards em 18 kits, mais os dois de FORA DOS KITS.
        --
        -- E o unico dos tres com hierarquia: rotulo de divindade, rotulo de
        -- slot ("SLOT 2 - um dos dois") e card. Os dois rotulos so ganharam
        -- name= na v0.48.0, e pelo GERADOR, nunca a mao -- batizar aqui faria
        -- a checagem 44 acusar na proxima regeracao.
        --
        -- ATENCAO A MARGEM: 41 destes cards tem left=12, o recuo que mostra
        -- que sao alternativas do MESMO slot. mostrarLinhaCatalogo so mexe na
        -- margem quando conseguiu ler a original antes, exatamente para nao
        -- apagar esse recuo.
        function filtrarCatalogoPoderes(texto)
            if tostring(texto) == "!t" then return farejarBusca("Poderes") end
            local agulha = dobrarBusca(texto)
            suspenderLista("sbListaPoderes", true)
            local ix = montarIndicePoderes()
            for _, kit in ipairs(ix.kits) do
                local sobrouNoKit = false
                for _, s in ipairs(kit.slots) do
                    local sobrouNoSlot = false
                    for _, c in ipairs(s.cards) do
                        local casa = buscaCasa(c.alvo, agulha)
                        mostrarLinhaCatalogo(c.w, ALTURA_CARD_CATALOGO.poder, casa)
                        if casa then sobrouNoSlot = true; sobrouNoKit = true end
                    end
                    if s.rotulo ~= nil then
                        mostrarLinhaCatalogo(s.rotulo, 14, sobrouNoSlot)
                    end
                end
                mostrarLinhaCatalogo(kit.cab, 20, sobrouNoKit)
            end
            local sobrouFora = false
            for _, c in ipairs(ix.fora) do
                local casa = buscaCasa(c.alvo, agulha)
                mostrarLinhaCatalogo(c.w, ALTURA_CARD_CATALOGO.poder, casa)
                if casa then sobrouFora = true end
            end
            mostrarLinhaCatalogo("podCab_Foradoskits", 20, sobrouFora)
            suspenderLista("sbListaPoderes", false)
        end

        -- ABRIR ZERANDO O FILTRO (decisao de 05/09/2026).
        --
        -- Sem isto, reabrir o popup mostraria 3 de 250 por causa de um
        -- filtro esquecido, e o catalogo pareceria quebrado -- declarado,
        -- visivel na tela, alimentando nada, sem erro nenhum. E o texto
        -- NAO e gravado no NDB de proposito: a caixa nao tem field=, entao
        -- nao ha campo novo para serializar por uma preferencia de UI.
        --
        -- setText dispara onChange tambem quando e o SCRIPT que escreve --
        -- documentado na caixa de vida da criatura, onde isso ja causou
        -- recursao infinita. Aqui e inofensivo: o onChange refaz o filtro
        -- vazio, e filtrar nao escreve na caixa. Mesmo assim o filtro e
        -- chamado explicitamente logo abaixo, para a lista voltar inteira
        -- mesmo se o onChange nao vier.
        local function zerarCaixaBusca(caixa)
            if caixa == nil then return end
            pcall(function() caixa:setText("") end)
        end

        function abrirCatalogoQualidades()
            zerarEstadoCatalogo()
            zerarCaixaBusca(self.edBuscaQualidades)
            filtrarCatalogoQD("", "Qualidade")
            abrirPopupAjustado(self.popCatalogoQualidades, 920, 600)
        end

        function abrirCatalogoDefeitos()
            zerarEstadoCatalogo()
            zerarCaixaBusca(self.edBuscaDefeitos)
            filtrarCatalogoQD("", "Defeito")
            abrirPopupAjustado(self.popCatalogoDefeitos, 920, 600)
        end

        function pontosPoderPorNivel(nivel)
            local total = 0
            for i = 1, math.min(math.max(n(nivel), 1), 20) do
                total = total + (GANHO_PONTOS_PODER[i] or 0)
            end
            return total
        end

        -- Total = tabela de nivel + concedidos + gratis de Hemocinese.
        --
        -- "Concedidos" existe porque Favores viram pontos (2 favores = 1
        -- ponto, 3 favores = 3 pontos) e porque o mestre pode conceder por
        -- narrativa. E campo do MESTRE, editavel na aba de Poderes.
        --
        -- "hemocinesePontosGratis" e separado de proposito: e escrito pelo
        -- motor a cada recalculo e sobrescreveria o que o mestre digitou se
        -- morasse no mesmo campo. Ele cobre a frase "Se voce ja tiver upado o
        -- poder, os pontos recebidos se convertem em pontos de poder comuns"
        -- (Racas / Orcs): o direito entra no bolso sempre, tenha ele virado
        -- nivel de Hemocinese ou nao.
        function pontosPoderTotais()
            if sheet == nil then return 0 end
            return pontosPoderPorNivel(sheet.nivel)
                 + n(sheet.poderPontosConcedidos)
                 + n(sheet.hemocinesePontosGratis)
        end

        -- ---------------------------------------------------------------
        -- SERIALIZACAO
        -- ---------------------------------------------------------------
        function lerPoderes()
            local lista = {}
            if sheet == nil then return lista end
            for _, reg in ipairs(partirTexto(sheet.poderesDados, ";")) do
                local campos = {}
                for c in string.gmatch(reg .. "|", "([^|]*)|") do
                    table.insert(campos, c)
                end
                if campos[1] ~= nil and campos[1] ~= "" then
                    table.insert(lista, {
                        nome = campos[1],
                        nivel = tonumber(campos[2]) or 0,
                        log = campos[3] or "",
                        deus = campos[4] or "",
                    })
                end
            end
            return lista
        end

        function gravarPoderes(lista)
            if sheet == nil then return end
            local partes = {}
            for _, p in ipairs(lista) do
                if n(p.nivel) > 0 then
                    table.insert(partes, table.concat({
                        p.nome, tostring(n(p.nivel)), p.log or "", p.deus or ""
                    }, "|"))
                end
            end
            sheet.poderesDados = table.concat(partes, ";")
        end

        function acharPoder(lista, nomePoder)
            for _, p in ipairs(lista) do
                if p.nome == nomePoder then return p end
            end
            return nil
        end

        function nivelDoPoder(nomePoder)
            local p = acharPoder(lerPoderes(), nomePoder)
            if p == nil then return 0 end
            return n(p.nivel)
        end

        function pontosPoderGastos()
            local total = 0
            for _, p in ipairs(lerPoderes()) do total = total + n(p.nivel) end
            return total
        end

        -- Poderes e habilidades saem do MESMO bolso. O saldo precisa
        -- descontar os dois; considerar so os poderes fazia o total nao mudar
        -- depois de comprar ou subir uma habilidade.
        -- gastosHabilidadesLiquido() vive no bloco de HABILIDADES, mais
        -- abaixo. Como sao globais chamadas em runtime a ordem nao importa;
        -- o pcall cobre so o instante da carga.
        function gastosEmHabilidadesSeguro()
            local ok, v = pcall(function() return gastosHabilidadesLiquido() end)
            if ok and v ~= nil then return v end
            return 0
        end

        function saldoPontosPoder()
            return pontosPoderTotais() - pontosPoderGastos() - gastosEmHabilidadesSeguro()
        end

        -- ---------------------------------------------------------------
        -- ACESSO AOS KITS
        --
        -- O catalogo mostra o kit dos 18 deuses grandes, mas so libera a
        -- compra do deus de quem o personagem e filho/legado (Aspecto
        -- Divino) ou de quem o abencoou.
        -- Bencao: 3 favores com um deus que NAO e seu pai/mae podem ser
        -- trocados por ser abencoado, e isso da acesso ao kit dele.
        -- Guardado em campo plano serializado ("Kaern;Mungus").
        -- ---------------------------------------------------------------
        function deusesAbencoados()
            if sheet == nil then return {} end
            return partirTexto(sheet.deusesAbencoados, ";")
        end

        function deusEhAcessivel(nomeDeus)
            if sheet == nil or nomeDeus == nil or nomeDeus == "" then return false end
            -- "Magia" nao vem de divindade nenhuma: e o poder dos feiticos,
            -- liberado pela qualidade Coracao de Mana.
            if nomeDeus == "Coração de Mana" then
                return sheet.temCoracaoDeMana == true
            end
            -- Hemocinese tambem nao vem de divindade: vem da raca (Orcs e
            -- Vampiros). Sem esta linha o card abria mas o botao de subir
            -- nivel ficava travado, e o poder concedido era um beco sem saida.
            if nomeDeus == "Herança racial" then
                return temHemocineseRacial()
            end
            if tostring(sheet.aspectoDivino or "") == nomeDeus then return true end
            for _, d in ipairs(deusesAbencoados()) do
                if d == nomeDeus then return true end
            end
            return false
        end

        function motivoDeusBloqueado(nomeDeus)
            if nomeDeus == "Coração de Mana" then
                return "Requer a qualidade Coração de Mana, marcada no capítulo VI."
            end
            if nomeDeus == "Herança racial" then
                return "Hemocinese é exclusivo de Orcs e Vampiros — vem da característica racial [Hemocinese], não de uma divindade. Um mestiço com Orc ou Vampiro na herança também recebe."
            end
            if tostring(sheet and sheet.aspectoDivino or "") == "" then
                return "Escolha primeiro o seu Aspecto Divino, no capítulo I."
            end
            return "Você não é filho nem abençoado de " .. tostring(nomeDeus) ..
                ". É preciso trocar 3 Favores com esta divindade para receber a bênção."
        end

        function concederBencao(nomeDeus)
            if sheet == nil then return end
            if not usuarioEhMestre() then
                avisarPoderes("Ação recusada: somente o MESTRE registra uma bênção.", COR.wine)
                return
            end
            if deusEhAcessivel(nomeDeus) then return end
            local atual = tostring(sheet.deusesAbencoados or "")
            if atual == "" then
                sheet.deusesAbencoados = nomeDeus
            else
                sheet.deusesAbencoados = atual .. ";" .. nomeDeus
            end
            publicarNoChat(anuncio("bencao", "BÊNÇÃO CONCEDIDA",
                    tostring(sheet.nome or "Personagem") .. " foi abençoado por **" ..
                nomeDeus .. "** e passa a ter acesso ao kit desta divindade."), COR.aura)
            atualizarBlocoPoderes()
            mostrarDetalhePoder(poderEmDetalhe, deusEmDetalhePoder)
        end

        -- ---------------------------------------------------------------
        -- TETOS E LIMITES
        -- ---------------------------------------------------------------
        function tetoNivelPassivo()
            if sheet == nil then return 2 end
            local dados = DadosSistema.dadosDoNivel(n(sheet.nivel))
            if dados ~= nil and dados.poderPassivoMax ~= nil then
                return n(dados.poderPassivoMax)
            end
            return 2
        end

        function tetoNivelDoPoder(poder)
            if poder == nil then return 5 end
            if poder.tipo == "passivo" then
                return math.min(5, tetoNivelPassivo())
            end
            return 5
        end

        function qtdPassivosAdquiridos()
            local q = 0
            for _, item in ipairs(lerPoderes()) do
                local p = CatalogoPoderes.buscar(item.nome)
                if p ~= nil and p.tipo == "passivo" then q = q + 1 end
            end
            return q
        end

        function qtdPoderesDeAtributo()
            local q = 0
            for _, item in ipairs(lerPoderes()) do
                local p = CatalogoPoderes.buscar(item.nome)
                if p ~= nil and p.atributo ~= nil then q = q + 1 end
            end
            return q
        end

        -- Livro [2.4]: dois poderes de atributo, "NUNCA oriundos do mesmo
        -- aspecto divino". Devolve o nome do aspecto repetido, ou "".
        -- Audita o que ESTA gravado — a recusa em comprarNivelPoder so pega
        -- quem compra a partir da v0.42.1; ficha antiga ja podia estar fora.
        function aspectoRepetidoEmPoderDeAtributo()
            local porDeus = {}
            for _, item in ipairs(lerPoderes()) do
                local p = CatalogoPoderes.buscar(item.nome)
                if p ~= nil and p.atributo ~= nil and n(item.nivel) > 0 then
                    local d = tostring(item.deus or "")
                    if d ~= "" then
                        porDeus[d] = (porDeus[d] or 0) + 1
                        if porDeus[d] >= 2 then return d end
                    end
                end
            end
            return ""
        end

        -- ---------------------------------------------------------------
        -- LOG DE COMPRA POR NIVEL
        -- Regra: "e proibido upar um poder duas vezes em um mesmo nivel".
        -- Sem registrar EM QUE nivel cada ponto foi gasto a regra e
        -- inaplicavel - o jogador fura sem nem perceber.
        -- ---------------------------------------------------------------
        function poderJaUpouNesteNivel(item)
            if item == nil or sheet == nil then return false end
            local atual = n(sheet.nivel)
            for _, par in ipairs(partirTexto(item.log, ",")) do
                local _, nvPers = string.match(par, "^(%d+)@(%d+)$")
                if nvPers ~= nil and n(nvPers) == atual then return true end
            end
            return false
        end

        -- ---------------------------------------------------------------
        -- LACRE DO ASPECTO DIVINO
        -- ---------------------------------------------------------------
        function aspectoLacrado()
            return sheet ~= nil and sheet.aspectoLacre == true
        end

        function selarAspectoDivino()
            if sheet == nil or aspectoLacrado() then return end
            sheet.aspectoLacre = true
            sheet.aspectoLacreDeus = tostring(sheet.aspectoDivino or "")
            sheet.aspectoLacreAutor = nickDoUsuario()
            sheet.aspectoLacreData = carimboDeTempo()
            publicarNoChat(anuncio("lacre", "ASPECTO DIVINO LACRADO",
                    tostring(sheet.nome or "Personagem") .. " comprometeu-se com **" ..
                tostring(sheet.aspectoDivino or "?") ..
                "** ao gastar o primeiro ponto de poder."), COR.aura)
        end

        function podeTrocarAspecto()
            if not aspectoLacrado() then return true end
            return sheet.autorizacaoMestreAspecto == true
        end

        function romperLacreAspecto()
            if sheet == nil then return end
            if not usuarioEhMestre() then
                avisarPoderes("Ação recusada: somente o MESTRE pode romper o lacre do Aspecto Divino.", COR.wine)
                return
            end
            sheet.autorizacaoMestreAspecto = true
            publicarNoChat(anuncio("rompido", "LACRE DO ASPECTO ROMPIDO",
                    "por " .. 
                nickDoUsuario() .. " para " .. tostring(sheet.nome or "personagem") ..
                ". A próxima troca de divindade está autorizada."), COR.wine)
            avisarPoderes("Lacre rompido: a próxima troca de divindade está liberada (uso único).", COR.gold)
            atualizarBlocoPoderes()
        end

        function autorizarUpDuploPoder()
            if sheet == nil then return end
            if not usuarioEhMestre() then
                avisarPoderes("Ação recusada: somente o MESTRE pode autorizar duas subidas no mesmo nível.", COR.wine)
                return
            end
            sheet.autorizacaoMestrePoder = true
            publicarNoChat(anuncio("mestre", "AUTORIZAÇÃO DO MESTRE",
                     nickDoUsuario() ..
                " liberou uma subida extra de poder neste nível para " ..
                tostring(sheet.nome or "personagem") .. " (uso único)."), COR.gold)
            avisarPoderes("Autorizado: uma subida extra neste nível (uso único).", COR.gold)
            atualizarBlocoPoderes()
        end

        -- ---------------------------------------------------------------
        -- COMPRA E DEVOLUCAO
        -- ---------------------------------------------------------------
        function comprarNivelPoder(nomePoder)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarPoderes(motivoTravaCriacao(), COR.wine); return
            end
            local poder = CatalogoPoderes.buscar(nomePoder)
            if poder == nil then return end

            local lista = lerPoderes()
            local item = acharPoder(lista, nomePoder)
            local atual = 0
            if item ~= nil then atual = n(item.nivel) end
            local novo = atual + 1

            if novo > 5 then
                avisarPoderes("Este poder já está no nível máximo (5).", COR.muted); return
            end

            local teto = tetoNivelDoPoder(poder)
            if novo > teto then
                avisarPoderes("Poder passivo limitado ao nível " .. teto ..
                    " enquanto o personagem estiver no nível " .. n(sheet.nivel) .. ".", COR.muted)
                return
            end

            if saldoPontosPoder() < 1 then
                avisarPoderes("Sem pontos de poder disponíveis.", COR.wine); return
            end

            -- limites de composicao: so valem ao ADQUIRIR (nivel 0 -> 1)
            local avisosDeCompra = {}
            local usouAutorizacao = false
            if atual == 0 then
                if poder.tipo == "passivo" and qtdPassivosAdquiridos() >= 3 then
                    avisarPoderes("Limite atingido: nenhum personagem pode ter mais de três poderes passivos.", COR.wine)
                    return
                end
                if poder.atributo ~= nil and qtdPoderesDeAtributo() >= 2 then
                    avisarPoderes("Limite atingido: no máximo dois poderes que bonificam atributos.", COR.wine)
                    return
                end
                -- Livro [2.4]: "Um semideus apenas pode possuir um máximo de
                -- dois poderes que bonifiquem atributos, NUNCA ORIUNDOS DO
                -- MESMO ASPECTO DIVINO." A metade "nunca do mesmo aspecto"
                -- faltava ate a v0.41.1 (P-03); a origem ja estava gravada
                -- em item.deus. A autorizacao do mestre (de uso unico, a
                -- mesma do up duplo) libera a excecao — Lei 2.
                local meuDeus = deusDonoDoPoder(nomePoder)
                if poder.atributo ~= nil and meuDeus ~= "" then
                    for _, it in ipairs(lista) do
                        local p2 = CatalogoPoderes.buscar(it.nome)
                        if p2 ~= nil and p2.atributo ~= nil and n(it.nivel) > 0
                           and tostring(it.deus or "") == meuDeus then
                            if sheet.autorizacaoMestrePoder == true then
                                usouAutorizacao = true
                                table.insert(avisosDeCompra, "Exceção autorizada pelo MESTRE: " ..
                                    it.nome .. " e " .. nomePoder .. " bonificam atributo e vêm do mesmo aspecto (" .. meuDeus .. ").")
                            else
                                avisarPoderes("Você já tem " .. it.nome .. ", que bonifica atributo e vem de " ..
                                    meuDeus .. ". O livro [2.4] não permite dois poderes de atributo do mesmo aspecto divino. " ..
                                    "Só o MESTRE libera (botão AUTORIZAR SUBIDA EXTRA). [a ficha vê na sua lista: " ..
                                    it.nome .. " de " .. tostring(it.deus or "") .. "]", COR.wine)
                                return
                            end
                        end
                    end
                end
                -- O "OU" DO KIT (P-02). O livro escreve o slot como
                -- "Manipulação sobrenatural ou Carisma Sobrenatural": um dos
                -- dois. DECISAO DA MESA (05/09/2026): a ficha AVISA e deixa
                -- passar — o mestre decide. Ate a v0.41.1 nao dizia nada.
                if meuDeus ~= "" then
                    -- Nem todo slot com "ou" tem DOIS lados: o slot 4 de
                    -- Ras'buz tem tres (agua, terra, ar). Contar em vez de
                    -- cravar a palavra "dois" e o mesmo conserto que o
                    -- rotulo do catalogo levou (05/09/2026).
                    local alternativas = alternativasDoSlot(meuDeus, nomePoder)
                    for _, alt in ipairs(alternativas) do
                        local it = acharPoder(lista, alt)
                        if it ~= nil and n(it.nivel) > 0 and tostring(it.deus or "") == meuDeus then
                            table.insert(avisosDeCompra, "⚠ O kit de " .. meuDeus ..
                                " dá " .. alt .. " OU " .. nomePoder ..
                                " — um só dos " .. (#alternativas + 1) ..
                                " deste slot. Você agora tem os dois; confirme com o mestre.")
                        end
                    end
                end
                -- Livro [2.4]: "É proibido possuir um poder passivo de
                -- atributo e um poder passivo que bonifique uma perícia
                -- vinculada ao mesmo atributo." As pericias dos passivos
                -- "épicos" sao ESCOLHIDAS pelo jogador e a ficha nao as
                -- guarda por poder, entao isto e LEMBRETE, nao trava.
                if poder.tipo == "passivo" then
                    local atributosDeAtr = {}
                    for _, it in ipairs(lista) do
                        local p2 = CatalogoPoderes.buscar(it.nome)
                        if p2 ~= nil and p2.atributo ~= nil and n(it.nivel) > 0 then
                            table.insert(atributosDeAtr, p2.atributo)
                        end
                    end
                    if poder.atributo == nil and #atributosDeAtr > 0 then
                        table.insert(avisosDeCompra, "Lembrete [2.4]: as perícias que você escolher para " ..
                            nomePoder .. " não podem ser de " .. table.concat(atributosDeAtr, " nem de ") ..
                            " — passivo de atributo e passivo de perícia do mesmo atributo não coexistem.")
                    end
                end
                -- Ativos antagonicos: so os pares que o livro escreve
                if poder.tipo == "ativo" then
                    local outro = antagonicoJaComprado(nomePoder, lista)
                    if outro ~= nil then
                        table.insert(avisosDeCompra, "⚠ " .. nomePoder .. " e " .. outro ..
                            " são de naturezas antagônicas ([2.4]: \"não é possível comprar poderes ativos que possuam naturezas antagônicas\"). Confirme com o mestre.")
                    end
                end
                if #lista >= MAX_SLOTS_PODER then
                    avisarPoderes("Limite de exibição da ficha atingido (" .. MAX_SLOTS_PODER ..
                        " poderes). Avise o desenvolvedor da ficha.", COR.wine)
                    return
                end
            end

            if item ~= nil and poderJaUpouNesteNivel(item) then
                if sheet.autorizacaoMestrePoder == true then
                    usouAutorizacao = true
                else
                    avisarPoderes("Este poder já subiu de nível no nível " .. n(sheet.nivel) ..
                        " do personagem. Só o MESTRE pode autorizar uma exceção.", COR.wine)
                    return
                end
            end

            if item == nil then
                item = { nome = nomePoder, nivel = 0, log = "",
                         deus = deusDonoDoPoder(nomePoder) }
                table.insert(lista, item)
            end
            item.nivel = novo
            local marca = tostring(novo) .. "@" .. tostring(n(sheet.nivel))
            if item.log == "" then item.log = marca else item.log = item.log .. "," .. marca end

            gravarPoderes(lista)
            if usouAutorizacao then sheet.autorizacaoMestrePoder = false end
            selarAspectoDivino()
            aplicarConcessoes()

            publicarNoChat("" .. tostring(sheet.nome or "Personagem") ..
                " elevou o poder **" .. nomePoder .. "** ao nível " .. novo ..
                " (" .. poder.tipo .. ").", COR.gold)
            atualizarBlocoHabilidades()
            if #avisosDeCompra > 0 then
                avisarPoderes(table.concat(avisosDeCompra, "  "), COR.gold)
            end
        end

        function devolverNivelPoder(nomePoder)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarPoderes(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerPoderes()
            local item = acharPoder(lista, nomePoder)
            if item == nil or n(item.nivel) <= 0 then return end

            -- REGRA DA MESA: um poder ativo adquirido fica preso ao
            -- personagem - nao se "devolve" um poder como se devolve um
            -- ponto. Enquanto a ficha esta EM CRIACAO liberamos para
            -- corrigir erro de clique; depois de finalizada, so o mestre.
            local poderCat = CatalogoPoderes.buscar(nomePoder)
            if n(item.nivel) == 1 and poderCat ~= nil and poderCat.tipo == "ativo"
               and fichaEstaFinalizada() and not usuarioEhMestre() then
                avisarPoderes("Poderes ativos ficam presos ao personagem. Só o MESTRE pode remover.", COR.wine)
                return
            end

            item.nivel = n(item.nivel) - 1
            local partes = partirTexto(item.log, ",")
            table.remove(partes)
            item.log = table.concat(partes, ",")

            gravarPoderes(lista)
            aplicarConcessoes()

            -- Removeu o poder por completo: a habilidade Rank E gratuita que
            -- nasceu dele vai junto (regra confirmada na mesa).
            if item.nivel == 0 then
                for _, h in ipairs(todasHabilidades()) do
                    if tostring(h.poderVinculado or "") == nomePoder
                       and tostring(h.origemGratis or "") == "poder" then
                        NDB.deleteNode(h)
                    end
                end
            end
            if item.nivel == 0 then
                avisarPoderes("Poder removido e ponto devolvido ao saldo.", COR.muted)
            else
                avisarPoderes("Ponto devolvido ao saldo.", COR.muted)
            end
            atualizarBlocoPoderes()
        end

        -- Qual divindade oferece este poder (para gravar a origem).
        -- Prioriza o Aspecto Divino, depois os deuses que abencoaram.
        function deusDonoDoPoder(nomePoder)
            if sheet == nil then return "" end
            local candidatos = {tostring(sheet.aspectoDivino or "")}
            for _, d in ipairs(deusesAbencoados()) do table.insert(candidatos, d) end
            for _, nomeDeus in ipairs(candidatos) do
                local deus = CatalogoDeuses.buscarPorNome(nomeDeus)
                if deus ~= nil then
                    for _, slot in ipairs(deus.slots) do
                        for _, p in ipairs(slot) do
                            if p == nomePoder then return nomeDeus end
                        end
                    end
                end
            end
            return ""
        end

        -- ---------------------------------------------------------------
        -- CATALOGO DE PODERES (popup mestre-detalhe)
        -- ---------------------------------------------------------------
        poderEmDetalhe = nil
        deusEmDetalhePoder = nil

        -- ESTADO VAZIO DO CATALOGO DE PODERES (v0.42.1).
        -- Irmao do M-09, que so foi consertado no catalogo de ITENS: sem
        -- nada selecionado, o painel da direita mostrava "PROGRESSÃO",
        -- "NÍVEL 1"... "NÍVEL 5" com todas as linhas em branco — um
        -- esqueleto que parece uma ficha quebrada. Quem procurou o irmao no
        -- lote da v0.42.1 olhou os itens e parou ali.
        function esvaziarDetalhePoder()
            definirAlturaPod(self.popPod_sepProg, 0)
            definirAlturaPod(self.popPod_lblProgTit, 0)
            for i = 1, 5 do
                definirAlturaPod(self["popPod_lblNivelTit" .. i], 0)
                definirAlturaPod(self["popPod_lblNivel" .. i], 0)
            end
            definirAlturaPod(self.popPod_lblDesc, 40)
            if self.popPod_lblNome ~= nil then
                self.popPod_lblNome:setText("Selecione um poder à esquerda")
            end
            if self.popPod_lblTipo ~= nil then self.popPod_lblTipo:setText("") end
            if self.popPod_lblOrigem ~= nil then self.popPod_lblOrigem:setText("") end
            if self.popPod_lblDesc ~= nil then
                self.popPod_lblDesc:setText("Clique num poder da lista para ver o que ele faz e o que cada nível acrescenta. O botão de adquirir aparece embaixo.")
            end
            if self.popPod_lblBtnAdquirir ~= nil then
                self.popPod_lblBtnAdquirir:setText("")
            end
            if self.popPod_lblSaldo ~= nil then
                self.popPod_lblSaldo:setText("Saldo: " .. saldoPontosPoder() .. " ponto(s)")
            end
        end

        function abrirPopupPoderes()
            if self.popPoderes == nil then return end
            if poderEmDetalhe ~= nil then
                mostrarDetalhePoder(poderEmDetalhe, deusEmDetalhePoder)
            else
                esvaziarDetalhePoder()
            end
            destacarPoderSelecionado()
            -- Zera o filtro a cada abertura, como nos outros dois catalogos.
            zerarEstadoCatalogo()
            if self.lblLaudoPoderes ~= nil then
                pcall(function() self.lblLaudoPoderes:setHeight(0) end)
            end
            if self.edBuscaPoderes ~= nil then
                pcall(function() self.edBuscaPoderes:setText("") end)
            end
            filtrarCatalogoPoderes("")
            abrirPopupAjustado(self.popPoderes, 1080, 680)
        end

        function fecharPopupPoderes()
            if self.popPoderes ~= nil then self.popPoderes:close() end
            atualizarBlocoPoderes()
        end

        function mostrarDetalhePoder(nomePoder, nomeDeus)
            if nomePoder == nil then return end
            local poder = CatalogoPoderes.buscar(nomePoder)
            if poder == nil then return end
            -- desfaz o estado vazio: quem zera altura precisa devolver
            definirAlturaPod(self.popPod_sepProg, 1)
            definirAlturaPod(self.popPod_lblProgTit, 18)
            for i = 1, 5 do
                definirAlturaPod(self["popPod_lblNivelTit" .. i], 16)
                definirAlturaPod(self["popPod_lblNivel" .. i], 34)
            end
            definirAlturaPod(self.popPod_lblDesc, 130)
            poderEmDetalhe = nomePoder
            deusEmDetalhePoder = nomeDeus

            if self.popPod_lblNome ~= nil then self.popPod_lblNome:setText(poder.nome) end

            if self.popPod_lblTipo ~= nil then
                local txt = "Poder " .. poder.tipo
                if poder.atributo ~= nil then
                    txt = txt .. "   •   bonifica " .. poder.atributo
                end
                if poder.tipo == "ativo" then
                    txt = txt .. "   •   cada nível destrava um rank de habilidade"
                    self.popPod_lblTipo:setFontColor(COR.aura)
                else
                    self.popPod_lblTipo:setFontColor(COR.moss)
                end
                self.popPod_lblTipo:setText(txt)
            end

            if self.popPod_lblOrigem ~= nil then
                self.popPod_lblOrigem:setText("Kit de " .. tostring(nomeDeus or "?"))
            end

            if self.popPod_lblDesc ~= nil then
                self.popPod_lblDesc:setText(poder.descricao)
            end

            -- 5 niveis de progressao
            local nivelAtual = nivelDoPoder(poder.nome)
            local teto = tetoNivelDoPoder(poder)
            for i = 1, 5 do
                local lbl = self["popPod_lblNivel" .. i]
                local cab = self["popPod_lblNivelTit" .. i]
                if lbl ~= nil then
                    local rank = ""
                    if poder.tipo == "ativo" then
                        rank = "   (habilidades rank " .. CatalogoPoderes.rankPorNivel[i] .. ")"
                    end
                    lbl:setText(poder.progressao[i] .. rank)
                    if i <= nivelAtual then
                        lbl:setFontColor(COR.text)
                    elseif i <= teto then
                        lbl:setFontColor(COR.muted)
                    else
                        lbl:setFontColor(COR.faint)
                    end
                end
                if cab ~= nil then
                    local t = "NÍVEL " .. i
                    if i == nivelAtual then t = t .. "  ◆ ATUAL"
                    elseif i > teto then t = t .. "  — acima do teto do seu nível"
                    end
                    cab:setText(t)
                    if i <= nivelAtual then
                        cab:setFontColor(COR.gold)
                    elseif i <= teto then
                        cab:setFontColor(COR.aura)
                    else
                        cab:setFontColor(COR.faint)
                    end
                end
            end

            -- rodape: adquirir / subir / bloqueado
            if self.popPod_lblBtnAdquirir ~= nil then
                local acessivel = deusEhAcessivel(nomeDeus)
                if not acessivel then
                    self.popPod_lblBtnAdquirir:setText(string.upper(motivoDeusBloqueado(nomeDeus)))
                    self.popPod_lblBtnAdquirir:setFontColor(COR.faint)
                elseif nivelAtual == 0 then
                    self.popPod_lblBtnAdquirir:setText("ADQUIRIR " .. string.upper(poder.nome) .. " — 1 PONTO")
                    self.popPod_lblBtnAdquirir:setFontColor(COR.gold)
                elseif nivelAtual >= teto then
                    self.popPod_lblBtnAdquirir:setText("NÍVEL MÁXIMO ALCANÇADO (" .. nivelAtual .. " / " .. teto .. ")")
                    self.popPod_lblBtnAdquirir:setFontColor(COR.moss)
                else
                    self.popPod_lblBtnAdquirir:setText("SUBIR PARA O NÍVEL " .. (nivelAtual + 1) .. " — 1 PONTO")
                    self.popPod_lblBtnAdquirir:setFontColor(COR.gold)
                end
            end

            if self.popPod_lblSaldo ~= nil then
                self.popPod_lblSaldo:setText("Saldo: " .. saldoPontosPoder() .. " ponto(s)")
            end

            -- botao de bencao, so para o mestre e so em deus bloqueado.
            -- "Coração de Mana" e "Herança racial" nao sao divindades: nao ha
            -- bencao a conceder ali, e o botao so confundiria o mestre.
            local mostraBencao = usuarioEhMestre() and
                not deusEhAcessivel(nomeDeus) and
                nomeDeus ~= "Coração de Mana" and
                nomeDeus ~= "Herança racial" and
                tostring(sheet and sheet.aspectoDivino or "") ~= ""
            definirAlturaPod(self.popPod_secBencao, mostraBencao and 30 or 0)

            destacarPoderSelecionado()
        end

        function adquirirPoderEmDetalhe()
            if poderEmDetalhe == nil then return end
            if not deusEhAcessivel(deusEmDetalhePoder) then
                if self.popPod_lblSaldo ~= nil then
                    self.popPod_lblSaldo:setText(motivoDeusBloqueado(deusEmDetalhePoder))
                    self.popPod_lblSaldo:setFontColor(COR.wine)
                end
                return
            end
            comprarNivelPoder(poderEmDetalhe)
            mostrarDetalhePoder(poderEmDetalhe, deusEmDetalhePoder)
        end

        function concederBencaoEmDetalhe()
            if deusEmDetalhePoder == nil then return end
            concederBencao(deusEmDetalhePoder)
        end

        -- O REALCE ACENDE O CARD DO PAR (deus, poder) — v0.42.1, P-01.
        --
        -- Os cards do catalogo sao um por par, 113 no total, mas ate a
        -- v0.41.1 o name= era rectPod_<poder>: 35 dos 49 poderes estao em
        -- mais de um kit, dois widgets nao podem ter o mesmo nome, e so a
        -- primeira copia era batizada. 64 cards nunca acendiam, e comprar
        -- "Carisma sobrenatural" pelo kit de Aslot acendia o card de AMMIS
        -- (o primeiro do XML). O name agora e rectPod_<deus>_<poder>, gerado
        -- por verif/gera_catalogo_poderes.py, e a checagem 44 cobra isso.
        -- O poder comprado guarda o deus de origem (item.deus): acende so
        -- o card daquele kit. Ficha antiga sem deus gravado acende em todos
        -- os kits onde o poder existe — melhor do que no kit errado.
        function destacarPoderSelecionado()
            -- FORA DOS KITS: um card por poder, batizado pelo nome antigo
            -- (rectPod_<poder>), com a origem que nao e divindade:
            -- "Coração de Mana" da Magia e "Herança racial" da Hemocinese.
            local foraDosKits = {{"Magia", "Coração de Mana"}, {"Hemocinese", "Herança racial"}}
            local comprados = {}
            for _, p in ipairs(lerPoderes()) do
                if n(p.nivel) > 0 then comprados[p.nome] = tostring(p.deus or "") end
            end
            local function pintar(card, nomePoder, nomeDeus)
                if card == nil then return end
                local dono = comprados[nomePoder]
                local emDetalhe = (nomePoder == poderEmDetalhe) and
                    (deusEmDetalhePoder == nil or nomeDeus == nil or nomeDeus == deusEmDetalhePoder)
                if emDetalhe then
                    card:setStrokeColor(COR.aura); card:setStrokeSize(2)
                elseif dono ~= nil and (dono == "" or nomeDeus == nil or dono == nomeDeus) then
                    card:setStrokeColor(COR.gold); card:setStrokeSize(1)
                else
                    card:setStrokeColor(COR.line); card:setStrokeSize(1)
                end
            end
            for _, deus in ipairs(CatalogoDeuses.itens) do
                for _, slot in ipairs(deus.slots or {}) do
                    for _, nomePoder in ipairs(slot) do
                        pintar(self["rectPod_" .. chavePoder(deus.nome) .. "_" .. chavePoder(nomePoder)],
                               nomePoder, deus.nome)
                    end
                end
            end
            for _, par in ipairs(foraDosKits) do
                pintar(self["rectPod_" .. chavePoder(par[1])], par[1], par[2])
            end
        end

        -- As alternativas do MESMO slot do kit (o "ou" do livro): para
        -- "Carisma sobrenatural" em Aslot devolve {"Manipulação sobrenatural"}.
        function alternativasDoSlot(nomeDeus, nomePoder)
            local outras = {}
            local deus = CatalogoDeuses.buscarPorNome(nomeDeus)
            if deus == nil then return outras end
            for _, slot in ipairs(deus.slots or {}) do
                local neste = false
                for _, p in ipairs(slot) do if p == nomePoder then neste = true end end
                if neste then
                    for _, p in ipairs(slot) do
                        if p ~= nomePoder then table.insert(outras, p) end
                    end
                end
            end
            return outras
        end

        -- PODERES ATIVOS ANTAGONICOS — livro [2.4], "Limitação de poderes
        -- ativos antagônicos": "fogo e água, fogo e gelo, eletricidade e
        -- terra, amor e raiva, cura e necromancia etc." A lista do livro
        -- termina em "etc.", entao ela NAO e enumeravel e uma recusa dura
        -- inventaria regra: os pares escritos viram AVISO, e o resto fica
        -- com o mestre. Decisao registrada no CONTEXTO (05/09/2026).
        PARES_ANTAGONICOS = {
            {"Manipulação do fogo", "Manipulação da água"},
            {"Manipulação do fogo", "Manipulação do gelo"},
            {"Manipulação da eletricidade", "Manipulação da terra"},
            {"Manipulação do amor", "Manipulação da raiva"},
            {"Cura", "Necromancia"},
        }

        function antagonicoJaComprado(nomePoder, lista)
            for _, par in ipairs(PARES_ANTAGONICOS) do
                local outro = nil
                if par[1] == nomePoder then outro = par[2] elseif par[2] == nomePoder then outro = par[1] end
                if outro ~= nil then
                    local it = acharPoder(lista, outro)
                    if it ~= nil and n(it.nivel) > 0 then return outro end
                end
            end
            return nil
        end

        -- ---------------------------------------------------------------
        -- ORDENACAO POR ORIGEM
        --
        -- Os poderes do pai/mae vem SEMPRE primeiro, depois os de cada
        -- bencao (na ordem em que foram concedidas), e por ultimo os que
        -- nao vem de divindade (Magia, do Coracao de Mana).
        -- A lista serializada guarda a ordem de compra; a exibicao reordena.
        -- ---------------------------------------------------------------
        -- Origens que NAO sao divindade. Ate a v0.32.1 havia uma so (o Coracao
        -- de Mana, do poder Magia) e o rotulo estava escrito na mao em dois
        -- lugares - por isso Hemocinese, que vem da RACA, aparecia com o selo
        -- "CORAÇÃO DE MANA". Agora cada origem se descreve aqui.
        --
        -- Mas acrescentar a terceira NAO e uma linha, e este comentario ja
        -- disse que era. Medido em 04/09/2026: o NOME de cada origem aparece
        -- a mao em 7 lugares (6 aqui no script, 1 no XML). Uma origem nova
        -- precisa de:
        --   1. a entrada nesta tabela (grupo, selo e ordem — ordem repetida
        --      deixa a ordenacao instavel);
        --   2. os QUATRO ramos que decidem por origem: deusEhAcessivel,
        --      motivoDeusBloqueado, mostrarDetalhePoder e
        --      destacarPoderSelecionado. Faltando o ramo, a origem nova cai
        --      no caminho de divindade e se comporta como um deus;
        --   3. o onClick do card no XML, onde o nome e string livre — um
        --      typo ali e o bug do Hemocinese de novo, sem erro nenhum.
        -- A checagem 17 cobra os tres pontos. Comentario nao e guarda-corpo.
        local ORIGENS_SEM_DIVINDADE = {
            ["Coração de Mana"] = {
                grupo = "FORA DOS KITS  ·  CORAÇÃO DE MANA",
                selo  = "CORAÇÃO DE MANA",
                ordem = 998,
            },
            ["Herança racial"] = {
                grupo = "FORA DOS KITS  ·  HERANÇA RACIAL",
                selo  = "HERANÇA RACIAL",
                ordem = 999,
            },
        }
        -- Fichas anteriores a esta versao gravavam deus vazio, e nessa epoca
        -- o unico poder sem divindade era Magia.
        local ORIGEM_PADRAO_SEM_DEUS = "Coração de Mana"

        function origemSemDivindade(nomeDeus)
            local d = tostring(nomeDeus or "")
            if d == "" then d = ORIGEM_PADRAO_SEM_DEUS end
            return ORIGENS_SEM_DIVINDADE[d]
        end

        function poderesOrdenados()
            local lista = lerPoderes()
            local aspecto = tostring(sheet and sheet.aspectoDivino or "")
            local ordemDeus = {}
            local rotulo = {}

            if aspecto ~= "" then
                ordemDeus[aspecto] = 1
                rotulo[aspecto] = "KIT DE " .. string.upper(aspecto) .. "  ·  ASPECTO DIVINO"
            end
            local i = 2
            for _, d in ipairs(deusesAbencoados()) do
                if ordemDeus[d] == nil then
                    ordemDeus[d] = i
                    rotulo[d] = "BÊNÇÃO DE " .. string.upper(d)
                    i = i + 1
                end
            end

            -- estavel: mantem a ordem de compra dentro de cada grupo
            local saida = {}
            for idx, item in ipairs(lista) do
                item.indiceReal = idx
                item.ordem = ordemDeus[item.deus] or 900
                local semDeus = origemSemDivindade(item.deus)
                if semDeus ~= nil then
                    item.grupo = semDeus.grupo
                    item.selo  = semDeus.selo
                    item.ordem = semDeus.ordem
                else
                    item.grupo = rotulo[item.deus] or ("KIT DE " .. string.upper(item.deus))
                end
                table.insert(saida, item)
            end
            table.sort(saida, function(a, b)
                if a.ordem ~= b.ordem then return a.ordem < b.ordem end
                return a.indiceReal < b.indiceReal
            end)
            return saida
        end

        -- ---------------------------------------------------------------
        -- RENDERIZACAO DA ABA
        -- ---------------------------------------------------------------
        function avisarPoderes(texto, cor)
            if self.abaPod_lblAviso == nil then return end
            self.abaPod_lblAviso:setText(tostring(texto or ""))
            self.abaPod_lblAviso:setFontColor(cor or COR.muted)
        end

        function atualizarBlocoPoderes()
            if sheet == nil then return end

            local totais = pontosPoderTotais()
            local gastosPod = pontosPoderGastos()
            local gastosHab = gastosEmHabilidadesSeguro()
            local gastos = gastosPod + gastosHab
            if self.abaPod_lblTotal ~= nil then self.abaPod_lblTotal:setText(tostring(totais)) end
            if self.abaPod_lblGastos ~= nil then self.abaPod_lblGastos:setText(tostring(gastos)) end
            if self.abaPod_lblGastosDetalhe ~= nil then
                self.abaPod_lblGastosDetalhe:setText(gastosPod .. " poderes · " .. gastosHab .. " habilidades")
            end
            if self.abaPod_lblSaldo ~= nil then
                local saldo = totais - gastos
                self.abaPod_lblSaldo:setText(tostring(saldo))
                if saldo < 0 then self.abaPod_lblSaldo:setFontColor(COR.wine)
                elseif saldo > 0 then self.abaPod_lblSaldo:setFontColor(COR.gold)
                else self.abaPod_lblSaldo:setFontColor(COR.muted) end
            end

            local lista = poderesOrdenados()

            -- estado vazio (altura, nunca visibilidade)
            definirAlturaPod(self.abaPod_wrapVazio, (#lista == 0) and ALTURA_VAZIO_PODER or 0)

            local grupoAnterior = nil
            for i = 1, MAX_SLOTS_PODER do
                local item = lista[i]
                definirAlturaPod(self["abaPod_wrapSlot" .. i],
                    (item ~= nil) and ALTURA_SLOT_PODER or 0)

                -- cabecalho de grupo: so na primeira linha de cada origem
                local mostraGrupo = (item ~= nil) and (item.grupo ~= grupoAnterior)
                definirAlturaPod(self["abaPod_wrapGrupo" .. i],
                    mostraGrupo and ALTURA_GRUPO_PODER or 0)
                if mostraGrupo then
                    local lblG = self["abaPod_lblGrupo" .. i]
                    if lblG ~= nil then
                        lblG:setText(item.grupo)
                        if item.ordem == 1 then lblG:setFontColor(COR.gold)
                        elseif item.ordem >= 998 then lblG:setFontColor(COR.rain)
                        else lblG:setFontColor(COR.aura) end
                    end
                end
                if item ~= nil then grupoAnterior = item.grupo end

                if item ~= nil then
                    local poder = CatalogoPoderes.buscar(item.nome)
                    local nivel = n(item.nivel)
                    local teto = tetoNivelDoPoder(poder)

                    local lblNome = self["abaPod_lblNome" .. i]
                    if lblNome ~= nil then
                        lblNome:setText(item.nome)
                        lblNome:setFontColor(COR.text)
                    end

                    local lblTipo = self["abaPod_lblTipo" .. i]
                    if lblTipo ~= nil and poder ~= nil then
                        lblTipo:setText(string.upper(poder.tipo))
                        if poder.tipo == "ativo" then lblTipo:setFontColor(COR.aura)
                        else lblTipo:setFontColor(COR.moss) end
                    end

                    -- selo de origem: de qual divindade este poder veio
                    local lblOrig = self["abaPod_lblOrigem" .. i]
                    local secOrig = self["abaPod_secOrigem" .. i]
                    if lblOrig ~= nil then
                        local cor, txt
                        if item.selo ~= nil then
                            txt = item.selo; cor = COR.rain
                        elseif item.ordem == 1 then
                            txt = string.upper(item.deus) .. "  ·  PAI/MÃE"; cor = COR.gold
                        else
                            txt = string.upper(item.deus) .. "  ·  BÊNÇÃO"; cor = COR.aura
                        end
                        lblOrig:setText(txt)
                        lblOrig:setFontColor(cor)
                        if secOrig ~= nil then secOrig:setStrokeColor(cor) end
                    end

                    for j = 1, 5 do
                        local pip = self["abaPod_pip" .. i .. "_" .. j]
                        if pip ~= nil then
                            definirLarguraPod(pip, (j <= teto) and 14 or 0)
                            if j <= nivel then
                                pip:setColor(COR.gold); pip:setStrokeColor(COR.gold)
                            else
                                pip:setColor("#12181C"); pip:setStrokeColor("#3A4750")
                            end
                        end
                    end

                    local lblCont = self["abaPod_lblCont" .. i]
                    if lblCont ~= nil then
                        lblCont:setText(nivel .. " / " .. teto)
                        if nivel >= teto then lblCont:setFontColor(COR.moss)
                        else lblCont:setFontColor(COR.muted) end
                    end

                    local lblEfeito = self["abaPod_lblEfeito" .. i]
                    if lblEfeito ~= nil and poder ~= nil then
                        lblEfeito:setText(CatalogoPoderes.textoNivel(poder, nivel))
                        lblEfeito:setFontColor(COR.muted)
                    end
                end
            end

            if self.abaPod_lblExtras ~= nil then
                local extras = 0
                local ok, v = pcall(function() return pontosExtrasDoSistema() end)
                if ok and v ~= nil then extras = v end
                self.abaPod_lblExtras:setText(tostring(extras))
                if extras > 0 then
                    self.abaPod_lblExtras:setFontColor(COR.moss)
                else
                    self.abaPod_lblExtras:setFontColor(COR.faint)
                end
            end

            if self.abaPod_lblLimites ~= nil then
                -- A METADE "NUNCA DO MESMO ASPECTO" TAMBEM CONTA (v0.42.1).
                -- A v0.42.1 passou a RECUSAR a compra do segundo poder de
                -- atributo do mesmo aspecto (P-03), mas o contador continuou
                -- dizendo so "2/2", em cor neutra, para uma ficha que ja
                -- estava fora da regra desde antes — declarado, na tela,
                -- alimentando nada. Agora ele audita o que ESTA gravado.
                local mesmoAspecto = aspectoRepetidoEmPoderDeAtributo()
                self.abaPod_lblLimites:setText(
                    "Passivos " .. qtdPassivosAdquiridos() .. "/3          " ..
                    "Poderes de atributo " .. qtdPoderesDeAtributo() .. "/2" ..
                    (mesmoAspecto ~= "" and ("  ⚠ os dois vêm de " .. mesmoAspecto ..
                        " — o livro [2.4] não permite; peça ao mestre") or "") ..
                    "          Teto de passivo no nível " .. n(sheet.nivel) ..
                    ": " .. tetoNivelPassivo())
                if mesmoAspecto ~= "" then
                    self.abaPod_lblLimites:setFontColor(COR.gold)
                else
                    self.abaPod_lblLimites:setFontColor(COR.faint)
                end
            end

            if self.abaPod_lblLacre ~= nil then
                if aspectoLacrado() then
                    self.abaPod_lblLacre:setText("ASPECTO LACRADO em " ..
                        tostring(sheet.aspectoLacreDeus or "?") .. " — por " ..
                        tostring(sheet.aspectoLacreAutor or "?") .. ", " ..
                        tostring(sheet.aspectoLacreData or "?"))
                    self.abaPod_lblLacre:setFontColor(COR.rain)
                else
                    self.abaPod_lblLacre:setText("Aspecto ainda não lacrado — o lacre fecha ao gastar o primeiro ponto.")
                    self.abaPod_lblLacre:setFontColor(COR.faint)
                end
            end
            local ehMestre = usuarioEhMestre()
            definirLarguraPod(self.abaPod_wrapAutorizar, ehMestre and 264 or 0)
            definirLarguraPod(self.abaPod_wrapRomper, ehMestre and 256 or 0)
        end

        -- Botoes +/- de cada linha (indice do slot vem gravado no XML).
        function slotPoderMais(indice)
            local item = poderesOrdenados()[indice]
            if item == nil then return end
            comprarNivelPoder(item.nome)
        end

        function slotPoderMenos(indice)
            local item = poderesOrdenados()[indice]
            if item == nil then return end
            devolverNivelPoder(item.nome)
        end

        function slotPoderDetalhe(indice)
            local item = poderesOrdenados()[indice]
            if item == nil then return end
            mostrarDetalhePoder(item.nome, item.deus)
            abrirPopupPoderes()
        end

        -- =================================================================
        -- HABILIDADES E FEITICOS
        --
        -- Diferente de poderes, habilidades sao CRIADAS pelo jogador: nome,
        -- rank, tags, aura, dado, alcance, duracao, elemento, efeito. Por
        -- isso aqui usamos recordList de verdade (itemHabilidade.lfm), e nao
        -- campo serializado: sao muitos campos e o jogador digita texto livre,
        -- onde qualquer separador (";" "|") poderia corromper o registro.
        --
        -- TRES TIPOS:
        --   "poder"   vinculada a um poder ATIVO adquirido. O rank e limitado
        --             pelo NIVEL DO PODER (1->E/D, 2->C, 3->B, 4->A, 5->EX).
        --             REGRA DA MESA: o rank do PERSONAGEM nao limita - um
        --             personagem rank C pode ter habilidade EX se subiu o
        --             poder o bastante.
        --   "classe"  nao depende de poder e pode chegar a EX; em troca os
        --             efeitos sao mais fracos. A regra exata ainda nao esta
        --             fechada na mesa, entao esta categoria e a MAIS LIVRE:
        --             a ficha nao trava rank nem tags, so informa a tabela.
        --   "feitico" vem do poder "Magia" + qualidade Coracao de Mana. Gasta
        --             MANA e tem tabela propria (dados mais fracos, menos
        --             tags), com valores diferentes para "Bruxas".
        --
        -- GRATUIDADES (todas confirmadas no livro):
        --   - 1 habilidade Rank E gratis sempre que um poder ATIVO novo chega
        --     ao nivel 1, em qualquer nivel do personagem;
        --   - primeira habilidade Rank EX gratis no nivel 15;
        --   - segunda habilidade Rank EX gratis no nivel 20;
        --   - +1 ponto de skill gratuito no nivel 19 (abate custo de
        --     habilidades, nao de poderes).
        -- =================================================================

        local RANK_POR_NIVEL_PODER = {"E/D", "C", "B", "A", "EX"}

        -- Ranks liberados por um poder ativo no nivel N. O nivel 1 libera
        -- E e D de uma vez (o livro escreve o primeiro degrau como "E/D").
        local RANKS_LIBERADOS_PODER = {
            [1] = {"E", "D"},
            [2] = {"E", "D", "C"},
            [3] = {"E", "D", "C", "B"},
            [4] = {"E", "D", "C", "B", "A"},
            [5] = {"E", "D", "C", "B", "A", "EX"},
        }

        function listaHabilidadesNode()
            if sheet == nil then return nil end
            return sheet.listaHabilidades
        end

        function todasHabilidades()
            if sheet == nil then return {} end
            return NDB.getChildNodes(sheet.listaHabilidades) or {}
        end

        -- ---------------------------------------------------------------
        -- SLOTS CONCEDIDOS
        --
        -- MODELO (definido pela mesa): quando o personagem ganha uma
        -- habilidade/feitico de graca, a ficha CRIA UM SLOT proprio ja com o
        -- desconto embutido. Quem cria pelo botao normal paga o preco cheio,
        -- sem nenhuma regra especial.
        --
        -- Por que assim: antes o desconto era procurado na hora da criacao,
        -- e o credito de Rank E do poder disputava com o Rank D da subclasse
        -- - a primeira habilidade criada pegava o credito "errado". Com o
        -- credito preso ao slot, cada concessao e independente.
        --
        -- O CREDITO E O CUSTO CHEIO DO RANK CONCEDIDO, nao 1 ponto:
        -- um feitico Rank D de graca vale 2 pontos, entao subi-lo para C
        -- (custo 3) sai por 1. Assim o desconto acompanha o slot por toda a
        -- evolucao dele.
        --   custoPago = max(0, custoDoRank(rankAtual) - creditoEmbutido)
        -- ---------------------------------------------------------------

        -- Concessoes que a ficha deve materializar como slot.
        -- Cada uma tem chave unica, para nao criar duas vezes.
        function slotsConcedidosDesejados()
            local r = {}
            if sheet == nil then return r end

            -- 1) um Rank E por poder ATIVO adquirido. Se o poder e "Magia",
            --    o slot nasce como FEITICO; nos demais, como habilidade.
            for _, item in ipairs(lerPoderes()) do
                local p = CatalogoPoderes.buscar(item.nome)
                if p ~= nil and p.tipo == "ativo" and n(item.nivel) > 0 then
                    local ehMagia = (item.nome == "Magia")
                    table.insert(r, {
                        chave = "auto:poder:" .. item.nome,
                        tipo = ehMagia and "feitico" or "poder",
                        rank = "E",
                        poderVinculado = item.nome,
                        rotulo = item.nome,
                    })
                end
            end

            -- 2) concessoes de subclasse (hoje: Especialista arcano)
            for _, con in ipairs(creditosDeSubclasse()) do
                table.insert(r, {
                    chave = "auto:" .. con.chave,
                    tipo = con.tipo,
                    rank = con.rank,
                    poderVinculado = (con.tipo == "feitico") and "Magia" or "",
                    rotulo = con.rotulo,
                })
            end

            -- 3) habilidades Rank EX dos niveis 15 e 20
            local nv = n(sheet.nivel)
            if nv >= 15 then
                table.insert(r, {chave = "auto:nivel15", tipo = "classe", rank = "EX",
                                 poderVinculado = "", rotulo = "nível 15"})
            end
            if nv >= 20 then
                table.insert(r, {chave = "auto:nivel20", tipo = "classe", rank = "EX",
                                 poderVinculado = "", rotulo = "nível 20"})
            end
            return r
        end

        function acharSlotPorChave(chave)
            for _, h in ipairs(todasHabilidades()) do
                if tostring(h.origemGratis or "") == chave then return h end
            end
            return nil
        end

        -- Cria os slots que faltam e retira os que perderam a fonte.
        sincronizandoSlots = false

        function sincronizarSlotsConcedidos()
            if sheet == nil or self.listaHabilidades == nil then return end
            if sincronizandoSlots then return end
            sincronizandoSlots = true

            pcall(function()
                local desejados = slotsConcedidosDesejados()
                local porChave = {}
                for _, d in ipairs(desejados) do porChave[d.chave] = d end

                -- cria o que falta
                for _, d in ipairs(desejados) do
                    if acharSlotPorChave(d.chave) == nil then
                        local credito = CatalogoHabilidades.custoDoRank(d.rank, d.tipo == "feitico")
                        local tabela = CatalogoHabilidades.dadosDoRank(d.rank, d.tipo == "feitico")
                        local no = self.listaHabilidades:append()
                        if no ~= nil then
                            no.tipo = d.tipo
                            no.nome = ""              -- vazio: o jogador batiza
                            no.rank = d.rank
                            no.poderVinculado = d.poderVinculado
                            no.tags = ""
                            no.energia = tabela and tabela.energiaMin or 0
                            no.dadoBase = tabela and tabela.dadoBase or ""
                            no.modificador = tabela and tabela.modificador or 0
                            no.alcance = tabela and tabela.alcanceMax or 0
                            no.duracao = tostring(tabela and tabela.duracao or ""):gsub("%.%s*$", "")
                            no.elemento = ""
                            no.descricao = ""
                            no.efeito = ""
                            no.custoPago = 0
                            no.creditoEmbutido = credito
                            no.origemGratis = d.chave
                            no.rotuloGratis = d.rotulo
                        end
                    end
                end

                -- retira (ou desconta) o que perdeu a fonte
                local paraRemover = {}
                for _, h in ipairs(todasHabilidades()) do
                    local og = tostring(h.origemGratis or "")
                    if og:sub(1, 5) == "auto:" and porChave[og] == nil then
                        if tostring(h.nome or "") == "" then
                            table.insert(paraRemover, h)
                        else
                            -- ja foi preenchida: mantemos o que o jogador
                            -- escreveu, mas o desconto acaba junto com a fonte
                            h.creditoEmbutido = 0
                            h.origemGratis = ""
                            h.rotuloGratis = ""
                            h.custoPago = CatalogoHabilidades.custoDoRank(
                                tostring(h.rank or "E"), tostring(h.tipo or "") == "feitico")
                        end
                    end
                end
                for _, h in ipairs(paraRemover) do NDB.deleteNode(h) end
            end)

            sincronizandoSlots = false
        end

        -- +1 ponto de skill gratuito no nivel 19: abate custo de habilidades.
        function descontoSkillNivel19()
            if sheet == nil then return 0 end
            if n(sheet.nivel) >= 19 then return 1 end
            return 0
        end

        -- ---------------------------------------------------------------
        -- CONCESSOES DE SUBCLASSE
        --
        -- Varredura do catalogo de classes: hoje so a "Especialista arcano"
        -- (Arcanista) entrega itens que saem do bolso de pontos, e o gatilho
        -- e o NIVEL DA SUBCLASSE, nao o do personagem.
        --   nivel 1 -> feitico Rank D    nivel 5 -> Rank C
        --   nivel 6 -> Rank B            nivel 7 -> Rank A
        --   nivel 8 -> Rank EX
        -- Para incluir outra subclasse basta uma linha nova aqui.
        -- ---------------------------------------------------------------
        local CONCESSOES_SUBCLASSE = {
            {classe = "Arcanista", sub = "Especialista arcano", nivel = 1, tipo = "feitico", rank = "D"},
            {classe = "Arcanista", sub = "Especialista arcano", nivel = 5, tipo = "feitico", rank = "C"},
            {classe = "Arcanista", sub = "Especialista arcano", nivel = 6, tipo = "feitico", rank = "B"},
            {classe = "Arcanista", sub = "Especialista arcano", nivel = 7, tipo = "feitico", rank = "A"},
            {classe = "Arcanista", sub = "Especialista arcano", nivel = 8, tipo = "feitico", rank = "EX"},
        }

        function creditosDeSubclasse()
            local r = {}
            if sheet == nil then return r end
            for slot = 1, 2 do
                local nomeClasse = tostring(sheet["classe" .. slot .. "Nome"] or "")
                local nomeSub = tostring(sheet["classe" .. slot .. "Sub"] or "")
                local nivelSub = n(sheet["classe" .. slot .. "Nivel"])
                for _, con in ipairs(CONCESSOES_SUBCLASSE) do
                    if con.classe == nomeClasse and con.sub == nomeSub and nivelSub >= con.nivel then
                        table.insert(r, {
                            tipo = con.tipo,
                            rank = con.rank,
                            chave = "sub:" .. nomeSub .. ":" .. con.nivel,
                            rotulo = nomeSub .. " nível " .. con.nivel,
                        })
                    end
                end
            end
            return r
        end

        -- ---------------------------------------------------------------
        -- ECONOMIA
        -- ---------------------------------------------------------------
        -- Pontos que o SISTEMA concedeu: a soma dos creditos embutidos nos
        -- slots concedidos, mais o ponto de skill do nivel 19. E o campo
        -- EXTRAS - diferente de CONCEDIDOS, que o mestre preenche a mao.
        function pontosExtrasDoSistema()
            local total = 0
            for _, h in ipairs(todasHabilidades()) do
                total = total + n(h.creditoEmbutido)
            end
            return total + descontoSkillNivel19()
        end

        function gastosHabilidades()
            local total = 0
            for _, h in ipairs(todasHabilidades()) do
                total = total + n(h.custoPago)
            end
            return total
        end

        -- O desconto do nivel 19 so vale para habilidades, nunca para poderes.
        function gastosHabilidadesLiquido()
            local bruto = gastosHabilidades() - descontoSkillNivel19()
            if bruto < 0 then return 0 end
            return bruto
        end

        -- ---------------------------------------------------------------
        -- RANKS DISPONIVEIS
        -- ---------------------------------------------------------------

        -- Poderes ATIVOS ja adquiridos, para o seletor do construtor.
        -- Poderes ativos que geram HABILIDADE comum.
        -- "Magia" fica de fora de proposito: ela e o poder dos FEITICOS, e
        -- so gera feiticos. Deixa-la aqui permitia criar uma habilidade
        -- comum a partir da Magia, o que a regra nao admite.
        function poderesAtivosAdquiridos()
            local r = {}
            for _, item in ipairs(lerPoderes()) do
                local p = CatalogoPoderes.buscar(item.nome)
                if p ~= nil and p.tipo == "ativo" and n(item.nivel) > 0
                   and item.nome ~= "Magia" then
                    table.insert(r, {nome = item.nome, nivel = n(item.nivel), deus = item.deus})
                end
            end
            return r
        end

        function ranksLiberadosPorPoder(nomePoder)
            local nivel = nivelDoPoder(nomePoder)
            if nivel < 1 then return {} end
            if nivel > 5 then nivel = 5 end
            return RANKS_LIBERADOS_PODER[nivel] or {}
        end

        -- Habilidade de classe nao depende de poder: todos os ranks liberados.
        function ranksLiberadosParaTipo(tipo, nomePoder)
            if tipo == "classe" then
                return CatalogoHabilidades.ranks
            end
            -- HABILIDADE RACIAL: todos os ranks livres. Ela nao sai de um
            -- poder ativo, entao nao ha nivel de poder que a limite - foi o
            -- que travou o cadastro da Forma Bestial Lupina na v0.38.0, com a
            -- mensagem "O poder  ainda não libera habilidades de rank E"
            -- (repare o espaco duplo: o nome do poder estava vazio, porque
            -- nao existe poder nenhum). E se ela for PROGRESSIVA, o rank nem e
            -- escolha: quem manda e o rank do personagem, bloco a bloco.
            if tipo == "racial" then
                return CatalogoHabilidades.ranks
            end
            if tipo == "feitico" then
                -- feiticos seguem o nivel do poder "Magia"
                return ranksLiberadosPorPoder("Magia")
            end
            return ranksLiberadosPorPoder(nomePoder)
        end

        function rankEstaLiberado(rank, tipo, nomePoder)
            for _, r in ipairs(ranksLiberadosParaTipo(tipo, nomePoder)) do
                if r == rank then return true end
            end
            return false
        end

        -- ---------------------------------------------------------------
        -- CUSTO E GRATUIDADE
        --
        -- Decide se a habilidade sai de graca e por que. "ignorarNo" existe
        -- para a edicao: ao recalcular uma habilidade que ja existe, ela nao
        -- deve competir consigo mesma pelo credito que ja estava usando.
        -- ---------------------------------------------------------------
        -- Custo de uma habilidade: preco cheio do rank menos o credito que
        -- o slot carrega. Slot criado pelo botao normal tem credito 0 e paga
        -- cheio; slot concedido carrega o custo do rank concedido, e esse
        -- desconto vale para sempre, inclusive ao subir de rank.
        -- ---------------------------------------------------------------
        -- HABILIDADE RACIAL PROGRESSIVA  (v0.38.0)
        --
        -- Seis blocos de texto, um por rank. A ficha usa o bloco do rank
        -- ATUAL do personagem e troca sozinha quando ele sobe de nivel - e o
        -- que a mesa chamou de "progride naturalmente". A escada de ranks do
        -- livro (E=1 D=4 C=8 B=12 A=16 EX=19) ja e o gatilho pronto.
        --
        -- REGRA DA MESA (30/08/2026): os blocos SUBSTITUEM, nao acumulam.
        -- No rank C valem +40 de vida, e nao +20+30+40.
        -- ---------------------------------------------------------------
        function alternarProgressiva()
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            habRascunho.progressiva = not (habRascunho.progressiva == true)
            atualizarBlocoProgressivo()
        end

        function atualizarBlocoProgressivo()
            if habRascunho == nil then return end
            local ehRacial = (habRascunho.tipo == "racial")
            local prog = ehRacial and (habRascunho.progressiva == true)

            -- altura, e nao visible: filho align="top" escondido e mostrado
            -- de novo vai para o topo da pilha.
            definirAlturaPod(self.popHab_wrapProgressiva, ehRacial and 36 or 0)
            -- ALTURA CALCULADA, e nao chutada. Cada bloco ocupa
            -- 15 (rotulo) + 46 (caixa) + 15 (leitura) + 6 (margem) = 82, mais
            -- 26 do cabecalho. Eu tinha posto 508 no olho; a conta da 518, e
            -- o que passa da altura do wrap e CORTADO - o layout nao rola
            -- sozinho. Bloco cortado nao da erro: ele so nao existe na tela,
            -- e quem preenche nao percebe que faltou.
            local alturaRanks = 26 + (#CatalogoProgressiva.RANKS * 82) + 12
            definirAlturaPod(self.popHab_wrapRanks, prog and alturaRanks or 0)

            if self.popHab_lblProgressiva ~= nil then
                self.popHab_lblProgressiva:setText(
                    (prog and "[X]  PROGRESSIVA" or "[  ]  PROGRESSIVA"))
                self.popHab_lblProgressiva:setFontColor(prog and COR.gold or COR.muted)
            end
            if self.popHab_btnProgressiva ~= nil then
                self.popHab_btnProgressiva:setStrokeColor(prog and COR.gold or COR.line)
            end

            local rankAtual = "E"
            if sheet ~= nil then
                rankAtual = tostring(DadosSistema.dadosDoNivel(n(sheet.nivel)).rank or "E")
            end
            if self.popHab_lblProgAjuda ~= nil then
                if prog then
                    -- Mapa rapido de quais blocos tem conteudo. E a primeira
                    -- coisa que se olha ao reabrir uma habilidade para saber
                    -- se o que foi digitado sobreviveu.
                    local mapa = {}
                    for _, r in ipairs(CatalogoProgressiva.RANKS) do
                        local cheio = tostring(habRascunho["efeitoRank" .. r] or ""):gsub("%s", "") ~= ""
                        table.insert(mapa, cheio and r or "·")
                    end
                    self.popHab_lblProgAjuda:setText("rank do personagem: " .. rankAtual ..
                        "   ·   blocos preenchidos: " .. table.concat(mapa, " "))
                else
                    self.popHab_lblProgAjuda:setText("marque para o efeito evoluir com o rank")
                end
            end

            for _, r in ipairs(CatalogoProgressiva.RANKS) do
                local w = self["popHab_edRank" .. r]
                if w ~= nil and prog then
                    w:setText(tostring(habRascunho["efeitoRank" .. r] or ""))
                end
                -- O QUE A FICHA ENTENDEU de cada bloco. Extrator que engole em
                -- silencio e pior que nenhum: some com o efeito e o jogador
                -- so descobre quando o numero da errado na mesa.
                local lbl = self["popHab_lblLeituraRank" .. r]
                if lbl ~= nil and prog then
                    local bruto = tostring(habRascunho["efeitoRank" .. r] or "")
                    local resumo = CatalogoProgressiva.resumoDoBloco(bruto)
                    -- BLOCO VAZIO PRECISA DIZER QUE ESTA VAZIO. Antes ele
                    -- ficava mudo, e "reabri e o bloco sumiu" era
                    -- indistinguivel de "eu nao preenchi esse".
                    if bruto:gsub("%s", "") == "" then
                        resumo = "— vazio —"
                        lbl:setFontColor(COR.wine)
                    else
                        lbl:setFontColor((r == rankAtual) and COR.gold or COR.faint)
                    end
                    lbl:setText(resumo)
                end
            end
        end

        -- ---------------------------------------------------------------
        -- WIDGETS  ->  RASCUNHO
        --
        -- O popup DESENHA a partir do rascunho (atualizarConstrutorHab), e
        -- quem digita escreve no WIDGET. Se uma acao qualquer redesenhar o
        -- popup antes de alguem copiar o widget de volta, o rascunho antigo
        -- sobrescreve o que foi digitado - e o texto some sem aviso.
        --
        -- Era o bug dos blocos de rank da v0.38.1: o jogador colava os seis
        -- efeitos, clicava em qualquer coisa, o popup se repintava e os seis
        -- campos voltavam a vazio. Ao salvar, o que ia para a ficha era o
        -- vazio.
        --
        -- Os campos de descricao e efeito tinham a MESMA falha desde sempre;
        -- ela quase nunca mordia porque texto costuma ser a ultima coisa que
        -- se digita antes de salvar. Consertado junto.
        --
        -- REGRA: toda acao do construtor que redesenha chama isto ANTES.
        -- Nao da para chamar de dentro de atualizarConstrutorHab(), porque na
        -- ABERTURA os widgets ainda tem o texto da habilidade anterior - ali o
        -- rascunho e a fonte da verdade, e nao a tela.
        -- ---------------------------------------------------------------
        function lerCamposDoConstrutor()
            if habRascunho == nil then return end
            if self.popHab_edNome ~= nil then habRascunho.nome = tostring(self.popHab_edNome:getText() or "") end
            if self.popHab_edDescricao ~= nil then habRascunho.descricao = tostring(self.popHab_edDescricao:getText() or "") end
            if self.popHab_edEfeito ~= nil then habRascunho.efeito = tostring(self.popHab_edEfeito:getText() or "") end
            -- Os seis blocos so sao lidos quando a habilidade E progressiva.
            -- Duas razoes, e as duas dao bug se ignoradas:
            --   1) VAZAMENTO ENTRE HABILIDADES. Os widgets nao sao limpos ao
            --      trocar de habilidade; abrir uma progressiva e depois uma
            --      comum deixaria os campos escondidos com o texto da
            --      primeira, e salvar a segunda gravaria os blocos da outra.
            --   2) DESMARCAR E MARCAR DE NOVO. Com a caixa desmarcada o bloco
            --      fica escondido e a repintura nao o preenche; ler dali
            --      apagaria o rascunho de quem so queria dar uma conferida.
            -- Com a guarda, enquanto a caixa esta desmarcada o RASCUNHO e a
            -- fonte da verdade, e o texto volta intacto ao remarcar.
            if habRascunho.progressiva == true then
                for _, r in ipairs(CatalogoProgressiva.RANKS) do
                    local w = self["popHab_edRank" .. r]
                    if w ~= nil then habRascunho["efeitoRank" .. r] = tostring(w:getText() or "") end
                end
            end
            if self.popHab_edEnergia ~= nil then habRascunho.energia = n(self.popHab_edEnergia:getText()) end
            if self.popHab_edAlcance ~= nil then habRascunho.alcance = n(self.popHab_edAlcance:getText()) end
            if self.popHab_edDado ~= nil then habRascunho.dadoBase = tostring(self.popHab_edDado:getText() or "") end
            if self.popHab_edModificador ~= nil then habRascunho.modificador = n(self.popHab_edModificador:getText()) end
            if self.popHab_edDuracao ~= nil then habRascunho.duracao = tostring(self.popHab_edDuracao:getText() or "") end
        end

        function calcularCustoHabilidade(rank, tipo, creditoEmbutido)
            -- HABILIDADE RACIAL NAO CUSTA PONTO DE PODER. Ela vem da raca ou
            -- de uma qualidade ja paga ("Linhagem da noite [06 pontos]"
            -- concede a Forma Bestial Lupina); cobrar de novo seria cobrar
            -- duas vezes pela mesma coisa.
            if tipo == "racial" then return 0 end
            local cheio = CatalogoHabilidades.custoDoRank(rank, tipo == "feitico")
            local liquido = cheio - n(creditoEmbutido)
            if liquido < 0 then liquido = 0 end
            return liquido
        end

        -- ---------------------------------------------------------------
        -- CONSTRUTOR
        -- ---------------------------------------------------------------
        habEmEdicao = nil          -- no NDB da habilidade sendo editada
        habRascunho = nil          -- estado do formulario

        function novoRascunhoHab(tipo)
            return {
                tipo = tipo or "poder",
                progressiva = false,
                efeitoRankE = "", efeitoRankD = "", efeitoRankC = "",
                efeitoRankB = "", efeitoRankA = "", efeitoRankEX = "",
                nome = "",
                rank = "E",
                poderVinculado = "",
                tags = {},
                energia = 0,
                dadoBase = "",
                modificador = 0,
                alcance = 0,
                duracao = "",
                elemento = "",
                descricao = "",
                efeito = "",
                corpoACorpo = false,
                emArea = false,
                creditoEmbutido = 0,
                rotuloGratis = "",
            }
        end

        function abrirConstrutorHabilidade(tipo)
            if self.popHabilidade == nil then return end
            if not podeEditarCriacao() then
                avisarHabilidades(motivoTravaCriacao(), COR.wine)
                return
            end
            habEmEdicao = nil
            habRascunho = novoRascunhoHab(tipo)
            habRascunho.creditoEmbutido = 0     -- criada pelo botao: paga cheio
            habRascunho.imagem = ""
            -- limpa o rascunho da imagem: sem isso, a arte da ultima
            -- habilidade aberta apareceria na proxima que fosse criada
            sheet.imagemHabEdicao = ""

            -- pre-seleciona o primeiro poder ativo disponivel
            local ativos = poderesAtivosAdquiridos()
            if tipo == "poder" then
                if #ativos == 0 then
                    if nivelDoPoder("Magia") > 0 then
                        avisarHabilidades("O poder Magia gera feitiços, não habilidades comuns. " ..
                            "Use o botão FEITIÇO, ou crie uma habilidade de classe.", COR.muted)
                    else
                        avisarHabilidades("Nenhum poder ativo adquirido. Habilidades de poder precisam de um poder ativo; " ..
                            "você ainda pode criar uma habilidade de classe.", COR.muted)
                    end
                    return
                end
                habRascunho.poderVinculado = ativos[1].nome
            elseif tipo == "feitico" then
                if nivelDoPoder("Magia") < 1 then
                    avisarHabilidades("Feitiços exigem o poder \"Magia\" (qualidade Coração de Mana).", COR.muted)
                    return
                end
                habRascunho.poderVinculado = "Magia"
            end

            aplicarTabelaDoRank()
            atualizarConstrutorHab()
            abrirPopupAjustado(self.popHabilidade, 1020, 700)
        end

        -- O popup ABRE mesmo com a ficha finalizada: e nele que estao o dado,
        -- o alcance, a duracao e o efeito da habilidade, que o jogador precisa
        -- consultar em jogo. Quem trava e o botao de salvar.
        function editarHabilidade(no)
            if no == nil or self.popHabilidade == nil then return end
            habEmEdicao = no
            habRascunho = {
                tipo = tostring(no.tipo or "poder"),
                nome = tostring(no.nome or ""),
                rank = tostring(no.rank or "E"),
                poderVinculado = tostring(no.poderVinculado or ""),
                tags = {},
                energia = n(no.energia),
                dadoBase = tostring(no.dadoBase or ""),
                modificador = n(no.modificador),
                alcance = n(no.alcance),
                duracao = tostring(no.duracao or ""),
                elemento = tostring(no.elemento or ""),
                descricao = tostring(no.descricao or ""),
                efeito = tostring(no.efeito or ""),
                corpoACorpo = (no.corpoACorpo == true),
                emArea = (no.emArea == true),
                creditoEmbutido = n(no.creditoEmbutido),
                rotuloGratis = tostring(no.rotuloGratis or ""),
                imagem = tostring(no.imagem or ""),
                progressiva = (no.progressiva == true),
            }
            -- os seis blocos de rank entram fora da tabela literal para nao
            -- repetir seis linhas quase iguais
            for _, r in ipairs(CatalogoProgressiva.RANKS) do
                habRascunho["efeitoRank" .. r] = tostring(no["efeitoRank" .. r] or "")
            end
            -- IMAGEM: mesmo padrao do editor de item. O widget <image> precisa
            -- de "field=", e dentro de popup o field resolve contra a raiz da
            -- ficha. Em vez de brigar com a armadilha, usamos a raiz como
            -- RASCUNHO: copia para ca ao abrir, copia de volta ao salvar.
            sheet.imagemHabEdicao = habRascunho.imagem
            habRascunho.tags = expandirTags(no.tags)
            atualizarConstrutorHab()
            abrirPopupAjustado(self.popHabilidade, 1020, 700)
        end

        -- Preenche aura/dado/modificador/alcance/duracao a partir da tabela
        -- de balanceamento do rank. O jogador ainda pode ajustar tudo na mao
        -- (varias regras do livro mexem nesses numeros).
        function aplicarTabelaDoRank()
            if habRascunho == nil then return end
            local d = CatalogoHabilidades.dadosDoRank(habRascunho.rank, habRascunho.tipo == "feitico")
            if d == nil then return end
            local ehBruxa = personagemEhBruxa()

            habRascunho.energia = d.energiaMin
            if ehBruxa and habRascunho.tipo == "feitico" then
                habRascunho.dadoBase = d.dadoBaseBruxa
                habRascunho.modificador = d.modificadorBruxa
            else
                habRascunho.dadoBase = d.dadoBase
                habRascunho.modificador = d.modificador
            end
            habRascunho.duracao = tostring(d.duracao or ""):gsub("%.%s*$", "")

            -- Regras do livro que mexem no alcance:
            --  - corpo-a-corpo: alcance fixo em 5m
            --  - em area: sempre metade do alcance padrao do rank
            if habRascunho.corpoACorpo then
                habRascunho.alcance = 5
            elseif habRascunho.emArea then
                habRascunho.alcance = math.floor(d.alcanceMax / 2)
            else
                habRascunho.alcance = d.alcanceMax
            end
        end

        function definirRankHab(rank)
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            habRascunho.rank = rank
            -- tags acima do novo limite sao cortadas
            local lim = limiteTagsAtual()
            while #habRascunho.tags > lim do table.remove(habRascunho.tags) end
            aplicarTabelaDoRank()
            atualizarConstrutorHab()
        end

        function definirTipoHab(tipo)
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            habRascunho.tipo = tipo
            if tipo == "classe" then
                habRascunho.poderVinculado = ""
            elseif tipo == "feitico" then
                habRascunho.poderVinculado = "Magia"
            else
                local ativos = poderesAtivosAdquiridos()
                if #ativos > 0 then habRascunho.poderVinculado = ativos[1].nome end
            end
            aplicarTabelaDoRank()
            atualizarConstrutorHab()
        end

        function definirPoderHab(nomePoder)
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            habRascunho.poderVinculado = nomePoder
            -- se o rank atual nao e mais permitido pelo novo poder, recua
            if not rankEstaLiberado(habRascunho.rank, habRascunho.tipo, nomePoder) then
                local libs = ranksLiberadosParaTipo(habRascunho.tipo, nomePoder)
                habRascunho.rank = libs[#libs] or "E"
                aplicarTabelaDoRank()
            end
            atualizarConstrutorHab()
        end

        -- ---------------------------------------------------------------
        -- LINHAGEM DE UNARIS (bruxas)
        --
        -- A qualidade "Linhagem de Unaris" torna a personagem uma bruxa:
        -- feiticos rolam dados maiores e ganham uma tag extra nos ranks C e
        -- A ("Aumente a escala de dano de suas magias", no efeito da
        -- qualidade). A ficha detecta a qualidade sozinha, mas o construtor
        -- expoe uma caixa para o mestre corrigir a mao se precisar.
        function temLinhagemDeUnaris()
            if sheet == nil then return false end
            for _, q in ipairs(NDB.getChildNodes(sheet.listaQualidades) or {}) do
                if tostring(q.nome or "") == "Linhagem de Unaris" then return true end
            end
            return false
        end

        function personagemEhBruxa()
            if sheet == nil then return false end
            -- override manual do mestre vence a deteccao automatica
            if sheet.bruxaManual == true then return true end
            if sheet.bruxaManual == false then return false end
            return temLinhagemDeUnaris()
        end

        function alternarBruxa()
            lerCamposDoConstrutor()
            if sheet == nil or habRascunho == nil then return end
            sheet.bruxaManual = not personagemEhBruxa()
            aplicarTabelaDoRank()
            atualizarConstrutorHab()
        end

        function limiteTagsAtual()
            if habRascunho == nil then return 2 end
            local d = CatalogoHabilidades.dadosDoRank(habRascunho.rank, habRascunho.tipo == "feitico")
            if d == nil then return 2 end
            if habRascunho.tipo == "feitico" and personagemEhBruxa() then
                return d.tagsMaxBruxa
            end
            return d.tagsMax
        end

        -- Clicar ACUMULA a tag (Ofensivo, Ofensivo (2x), ...). Para tirar
        -- uma instancia, clique no chip correspondente em "tags escolhidas".
        function alternarTagHab(nomeTag)
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            if #habRascunho.tags >= limiteTagsAtual() then
                avisarConstrutor("Rank " .. habRascunho.rank .. " permite no máximo " ..
                    limiteTagsAtual() .. " tags (repetições contam como vagas).", COR.wine)
                return
            end
            -- tags opostas: proibidas, exceto no rank EX
            local teste = {}
            for _, t in ipairs(habRascunho.tags) do table.insert(teste, t) end
            table.insert(teste, nomeTag)
            local a, b = CatalogoHabilidades.conflitoDeTags(teste, habRascunho.rank)
            if a ~= nil then
                avisarConstrutor("Tags opostas: [" .. a .. "] e [" .. b ..
                    "] não podem estar na mesma habilidade (só no rank EX).", COR.wine)
                return
            end
            table.insert(habRascunho.tags, nomeTag)
            -- a primeira tag elemental vira o elemento da habilidade
            if CatalogoHabilidades.categoriaDaTag(nomeTag) == "Elemental" and habRascunho.elemento == "" then
                habRascunho.elemento = nomeTag
            end
            atualizarConstrutorHab()
        end

        -- Chips de tags escolhidas: cada clique remove UMA instancia.
        tagsNoConstrutor = {}

        function removerTagPorChip(indice)
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            local alvo = tagsNoConstrutor[indice]
            if alvo == nil then return end
            for i = #habRascunho.tags, 1, -1 do
                if habRascunho.tags[i] == alvo then
                    table.remove(habRascunho.tags, i)
                    break
                end
            end
            -- se a tag elemental sumiu de vez, limpa o campo elemento
            if habRascunho.elemento == alvo and contarTag(alvo) == 0 then
                habRascunho.elemento = ""
            end
            atualizarConstrutorHab()
        end

        function alternarCorpoACorpo()
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            habRascunho.corpoACorpo = not habRascunho.corpoACorpo
            if habRascunho.corpoACorpo then habRascunho.emArea = false end
            aplicarTabelaDoRank()
            atualizarConstrutorHab()
        end

        function alternarEmArea()
            lerCamposDoConstrutor()
            if habRascunho == nil then return end
            habRascunho.emArea = not habRascunho.emArea
            if habRascunho.emArea then habRascunho.corpoACorpo = false end
            aplicarTabelaDoRank()
            atualizarConstrutorHab()
        end

        function avisarConstrutor(texto, cor)
            if self.popHab_lblAviso == nil then return end
            self.popHab_lblAviso:setText(tostring(texto or ""))
            self.popHab_lblAviso:setFontColor(cor or COR.muted)
        end

        -- ---------------------------------------------------------------
        -- SALVAR
        -- ---------------------------------------------------------------
        function salvarHabilidade()
            if habRascunho == nil or sheet == nil then return end
            if not podeEditarCriacao() then
                avisarConstrutor("Ficha finalizada: dá para consultar, mas não alterar. Peça ao mestre para destravar.", COR.wine)
                return
            end

            lerCamposDoConstrutor()
            -- a imagem vem do campo de rascunho da raiz, e nao de um widget
            habRascunho.imagem = tostring(sheet.imagemHabEdicao or "")

            if habRascunho.nome == "" then
                avisarConstrutor("Dê um nome à habilidade.", COR.wine); return
            end

            if habRascunho.tipo ~= "classe" and habRascunho.tipo ~= "racial"
               and habRascunho.poderVinculado == "" then
                avisarConstrutor("Escolha o poder de origem.", COR.wine); return
            end

            -- Progressiva sem nenhum bloco preenchido nao progride nada.
            if habRascunho.tipo == "racial" and habRascunho.progressiva then
                local algum = false
                for _, r in ipairs(CatalogoProgressiva.RANKS) do
                    if tostring(habRascunho["efeitoRank" .. r] or ""):gsub("%s", "") ~= "" then
                        algum = true
                    end
                end
                if not algum then
                    avisarConstrutor("Habilidade PROGRESSIVA sem nenhum bloco de rank preenchido. Cole ao menos o efeito do rank em que ela começa.", COR.wine)
                    return
                end
            end

            -- Magia so produz feiticos, nunca habilidade comum.
            if habRascunho.tipo == "poder" and habRascunho.poderVinculado == "Magia" then
                avisarConstrutor("O poder Magia gera feitiços, não habilidades. Use o tipo FEITIÇO.", COR.wine)
                return
            end

            if not rankEstaLiberado(habRascunho.rank, habRascunho.tipo, habRascunho.poderVinculado) then
                avisarConstrutor("O poder " .. habRascunho.poderVinculado ..
                    " ainda não libera habilidades de rank " .. habRascunho.rank .. ".", COR.wine)
                return
            end

            local custo = calcularCustoHabilidade(habRascunho.rank, habRascunho.tipo,
                habRascunho.creditoEmbutido)

            -- saldo: o custo entra no mesmo pool dos poderes
            local jaPago = 0
            if habEmEdicao ~= nil then jaPago = n(habEmEdicao.custoPago) end
            if custo - jaPago > saldoPontosPoder() then
                avisarConstrutor("Sem pontos suficientes: esta habilidade custa " .. custo ..
                    " e você tem " .. saldoPontosPoder() .. " disponível(is).", COR.wine)
                return
            end

            local ehEdicao = (habEmEdicao ~= nil)
            local no = habEmEdicao
            if no == nil then
                if self.listaHabilidades == nil then return end
                no = self.listaHabilidades:append()
                if no == nil then return end
            end

            no.tipo = habRascunho.tipo
            no.nome = habRascunho.nome
            no.rank = habRascunho.rank
            no.poderVinculado = habRascunho.poderVinculado
            no.tags = agruparTags(habRascunho.tags)
            no.energia = habRascunho.energia
            no.dadoBase = habRascunho.dadoBase
            no.modificador = habRascunho.modificador
            no.alcance = habRascunho.alcance
            no.duracao = habRascunho.duracao
            no.elemento = habRascunho.elemento
            no.descricao = habRascunho.descricao
            no.efeito = habRascunho.efeito
            no.progressiva = (habRascunho.progressiva == true)
            for _, r in ipairs(CatalogoProgressiva.RANKS) do
                no["efeitoRank" .. r] = tostring(habRascunho["efeitoRank" .. r] or "")
            end
            no.corpoACorpo = habRascunho.corpoACorpo
            no.emArea = habRascunho.emArea
            no.imagem = tostring(habRascunho.imagem or "")
            no.custoPago = custo
            no.creditoEmbutido = n(habRascunho.creditoEmbutido)
            -- origemGratis/rotuloGratis pertencem ao SLOT e sao definidos pela
            -- sincronizacao das concessoes; salvar nao os altera.

            local etiqueta = "habilidade"
            if habRascunho.tipo == "feitico" then etiqueta = "feitiço" end
            local textoCusto = custo .. " ponto(s)"
            if custo == 0 then textoCusto = "gratuita" end
            publicarNoChat("" .. tostring(sheet.nome or "Personagem") ..
                " registrou a " .. etiqueta .. " **" .. habRascunho.nome ..
                "** — rank " .. habRascunho.rank .. ", " .. textoCusto .. ".", COR.gold)

            -- Edicao: o item ja existia, entao o onNodeReady dele nao roda
            -- de novo sozinho. Reconstruir a lista forca o redesenho na hora.
            if ehEdicao then reconstruirListaHabilidades() end

            habEmEdicao = nil
            habRascunho = nil
            if self.popHabilidade ~= nil then self.popHabilidade:close() end
            atualizarBlocoHabilidades()
        end

        function fecharConstrutorHabilidade()
            habEmEdicao = nil
            habRascunho = nil
            if self.popHabilidade ~= nil then self.popHabilidade:close() end
        end

        -- ---------------------------------------------------------------
        -- RENDERIZACAO
        -- ---------------------------------------------------------------
        function avisarHabilidades(texto, cor)
            if self.abaHab_lblAviso == nil then return end
            self.abaHab_lblAviso:setText(tostring(texto or ""))
            self.abaHab_lblAviso:setFontColor(cor or COR.muted)
        end

        -- ---------------------------------------------------------------
        -- TAGS EMPILHAVEIS
        --
        -- A mesma tag pode entrar varias vezes ("Ofensivo (3x)") - e como a
        -- mesa usa para intensificar dano, cura e afins. Cada repeticao
        -- consome uma vaga do limite de tags do rank.
        -- Guardamos AGRUPADO no no ("Ofensivo (2x), Fogo") porque e o que
        -- aparece na ficha; internamente o rascunho trabalha com a lista
        -- expandida, que e mais simples de contar.
        --
        -- O livro nao define quanto cada repeticao acrescenta, entao a ficha
        -- nao calcula nada: apenas registra a pilha e deixa os numeros na
        -- mao do mestre.
        -- ---------------------------------------------------------------
        function agruparTags(lista)
            local ordem, cont = {}, {}
            for _, t in ipairs(lista or {}) do
                if cont[t] == nil then cont[t] = 0; table.insert(ordem, t) end
                cont[t] = cont[t] + 1
            end
            local partes = {}
            for _, t in ipairs(ordem) do
                if cont[t] > 1 then
                    table.insert(partes, t .. " (" .. cont[t] .. "x)")
                else
                    table.insert(partes, t)
                end
            end
            return table.concat(partes, ", ")
        end

        function expandirTags(texto)
            local r = {}
            for _, parte in ipairs(partirTexto(tostring(texto or ""), ",")) do
                local limpo = parte:gsub("^%s+", ""):gsub("%s+$", "")
                local nome, qtd = limpo:match("^(.-)%s*%((%d+)x%)$")
                if nome ~= nil and qtd ~= nil then
                    for _ = 1, tonumber(qtd) do table.insert(r, nome) end
                elseif limpo ~= "" then
                    table.insert(r, limpo)
                end
            end
            return r
        end

        function contarTag(nomeTag)
            if habRascunho == nil then return 0 end
            local q = 0
            for _, t in ipairs(habRascunho.tags) do
                if t == nomeTag then q = q + 1 end
            end
            return q
        end

        -- ---------------------------------------------------------------
        -- RECONSTRUCAO DA LISTA
        --
        -- O onNodeReady do template so roda quando o item e CRIADO. Ao
        -- editar uma habilidade, os campos calculados por script (rank,
        -- resumo, tags, custo, selo de origem) nao eram reprocessados e a
        -- linha so mudava depois de fechar e reabrir a ficha.
        -- Aqui lemos tudo, apagamos os nos e recriamos NA MESMA ORDEM, o que
        -- forca o onNodeReady de cada item. Usa apenas append/deleteNode,
        -- que sao as APIs ja comprovadas neste projeto.
        -- Nunca apagamos o no-container: so os filhos.
        -- ---------------------------------------------------------------
        function reconstruirListaHabilidades()
            if sheet == nil or self.listaHabilidades == nil then return end
            -- ATENCAO: campo novo no item precisa entrar TAMBEM aqui, senao
            -- a reconstrucao o perde silenciosamente. Foi o que aconteceu com
            -- "creditoEmbutido": o desconto sumia depois da primeira edicao.
            local campos = CAMPOS_HABILIDADE

            -- Primeiro guardamos OS NOS numa tabela propria. Iterar a lista
            -- viva enquanto se apaga dela pula elementos - foi o que duplicou
            -- itens no teste.
            local nos = {}
            for _, no in ipairs(todasHabilidades()) do table.insert(nos, no) end

            local copia = {}
            for _, no in ipairs(nos) do
                local reg = {}
                for _, campo in ipairs(campos) do reg[campo] = no[campo] end
                table.insert(copia, reg)
            end

            for _, no in ipairs(nos) do
                NDB.deleteNode(no)
            end

            for _, reg in ipairs(copia) do
                local novo = self.listaHabilidades:append()
                if novo ~= nil then
                    for _, campo in ipairs(campos) do novo[campo] = reg[campo] end
                end
            end
        end

        function ajustarAlturaListaHabilidades()
            if self.listaHabilidades == nil then return end
            local qtd = #todasHabilidades()
            if qtd < 1 then qtd = 0 end
            definirAlturaPod(self.listaHabilidades, qtd * 56 + 4)
        end

        function atualizarBlocoHabilidades()
            if sheet == nil then return end
            sincronizarSlotsConcedidos()

            -- Resumo dos slots concedidos: quantos existem e quantos ainda
            -- estao por preencher (sem nome).
            if self.abaHab_lblCreditos ~= nil then
                local concedidos, vazios = 0, 0
                for _, h in ipairs(todasHabilidades()) do
                    if n(h.creditoEmbutido) > 0 then
                        concedidos = concedidos + 1
                        if tostring(h.nome or "") == "" then vazios = vazios + 1 end
                    end
                end
                local partes = {}
                if concedidos > 0 then
                    table.insert(partes, "Concedidas pelo sistema: " .. concedidos)
                    if vazios > 0 then
                        table.insert(partes, vazios .. " por preencher — clique para batizar")
                    end
                end
                if descontoSkillNivel19() > 0 then
                    table.insert(partes, "1 ponto de skill do nível 19 aplicado")
                end
                if #partes == 0 then
                    table.insert(partes, "Cada poder ativo desbloqueado abre uma habilidade gratuita.")
                end
                self.abaHab_lblCreditos:setText(table.concat(partes, "          "))
            end

            if self.abaHab_lblGastos ~= nil then
                self.abaHab_lblGastos:setText(tostring(gastosHabilidadesLiquido()))
            end
            if self.abaHab_lblQtd ~= nil then
                self.abaHab_lblQtd:setText(tostring(#todasHabilidades()))
            end

            -- estado vazio
            definirAlturaPod(self.abaHab_wrapVazio, (#todasHabilidades() == 0) and 56 or 0)

            -- botao de feiticos so aparece com o poder Magia
            definirLarguraPod(self.abaHab_wrapFeitico, (nivelDoPoder("Magia") > 0) and 200 or 0)
            -- HABILIDADE DE RAÇA: aparece para quem tem raça definida. Nao
            -- exige poder nem qualidade - qualquer raça pode ter caracteristica
            -- que vira habilidade, e o construtor recusa o que nao servir.
            definirLarguraPod(self.abaHab_wrapRacial,
                (tostring(sheet and sheet.raca or "") ~= "") and 230 or 0)

            ajustarAlturaListaHabilidades()
            atualizarBlocoPoderes()
        end

        -- ---------------------------------------------------------------
        -- RENDER DO CONSTRUTOR
        -- ---------------------------------------------------------------
        -- Poderes listados no seletor, na ordem em que aparecem na tela.
        poderesNoConstrutor = {}

        function popHabEscolherPoder(indice)
            local p = poderesNoConstrutor[indice]
            if p == nil then return end
            definirPoderHab(p.nome)
        end

        function atualizarConstrutorHab()
            if habRascunho == nil then return end
            local ehFeitico = (habRascunho.tipo == "feitico")

            if self.popHab_lblTitulo ~= nil then
                local t = "CONSTRUTOR DE HABILIDADE"
                if ehFeitico then t = "CONSTRUTOR DE FEITIÇO" end
                if habEmEdicao ~= nil then t = "EDITAR " .. t:gsub("CONSTRUTOR DE ", "") end
                self.popHab_lblTitulo:setText("✦  " .. t .. "  ✦")
            end

            -- campos de texto
            if self.popHab_edNome ~= nil then self.popHab_edNome:setText(habRascunho.nome) end
            if self.popHab_edEnergia ~= nil then self.popHab_edEnergia:setText(tostring(habRascunho.energia)) end
            if self.popHab_edDado ~= nil then self.popHab_edDado:setText(habRascunho.dadoBase) end
            if self.popHab_edModificador ~= nil then self.popHab_edModificador:setText(tostring(habRascunho.modificador)) end
            if self.popHab_edAlcance ~= nil then self.popHab_edAlcance:setText(tostring(habRascunho.alcance)) end
            if self.popHab_edDuracao ~= nil then self.popHab_edDuracao:setText(habRascunho.duracao) end
            if self.popHab_edDescricao ~= nil then self.popHab_edDescricao:setText(habRascunho.descricao) end
            if self.popHab_edEfeito ~= nil then self.popHab_edEfeito:setText(habRascunho.efeito) end
            atualizarBlocoProgressivo()

            if self.popHab_lblEnergiaTit ~= nil then
                self.popHab_lblEnergiaTit:setText(ehFeitico and "MANA" or "AURA")
            end

            -- tipo selecionado
            local tipos = {
                {chave = "poder", btn = self.popHab_btnTipoPoder, lbl = self.popHab_lblTipoPoder, cor = COR.aura},
                {chave = "classe", btn = self.popHab_btnTipoClasse, lbl = self.popHab_lblTipoClasse, cor = COR.moss},
                {chave = "feitico", btn = self.popHab_btnTipoFeitico, lbl = self.popHab_lblTipoFeitico, cor = COR.rain},
                {chave = "racial", btn = self.popHab_btnTipoRacial, lbl = self.popHab_lblTipoRacial, cor = COR.gold},
            }
            for _, t in ipairs(tipos) do
                local ativo = (habRascunho.tipo == t.chave)
                if t.btn ~= nil then t.btn:setStrokeColor(ativo and t.cor or COR.line) end
                if t.lbl ~= nil then t.lbl:setFontColor(ativo and t.cor or COR.muted) end
            end

            -- lista de poderes de origem
            poderesNoConstrutor = {}
            if habRascunho.tipo == "poder" then
                poderesNoConstrutor = poderesAtivosAdquiridos()
            elseif ehFeitico then
                local nv = nivelDoPoder("Magia")
                if nv > 0 then
                    poderesNoConstrutor = {{nome = "Magia", nivel = nv, deus = ""}}
                end
            end

            local qtd = #poderesNoConstrutor
            if qtd > 8 then qtd = 8 end
            definirAlturaPod(self.popHab_wrapListaPoderes, qtd * 29)
            for i = 1, 8 do
                local p = poderesNoConstrutor[i]
                if habRascunho.tipo == "racial" then p = nil end   -- racial nao tem poder de origem
                definirAlturaPod(self["popHab_wrapPoder" .. i], (p ~= nil) and 29 or 0)
                if p ~= nil then
                    local lbl = self["popHab_lblPoder" .. i]
                    if lbl ~= nil then lbl:setText(p.nome) end
                    local lblNv = self["popHab_lblPoderNv" .. i]
                    if lblNv ~= nil then
                        local libs = ranksLiberadosPorPoder(p.nome)
                        lblNv:setText("nível " .. p.nivel .. " · até " .. (libs[#libs] or "E"))
                    end
                    local rect = self["popHab_rectPoder" .. i]
                    if rect ~= nil then
                        if p.nome == habRascunho.poderVinculado then
                            rect:setStrokeColor(COR.aura); rect:setStrokeSize(2)
                        else
                            rect:setStrokeColor(COR.line); rect:setStrokeSize(1)
                        end
                    end
                end
            end

            -- aviso quando o tipo nao usa poder
            if self.popHab_lblSemPoder ~= nil then
                if habRascunho.tipo == "racial" then
                    if habRascunho.progressiva == true then
                        self.popHab_lblSemPoder:setText("Habilidade racial PROGRESSIVA: não sai de poder nenhum, não custa ponto, " ..
                            "e o RANK abaixo é só a etiqueta da linha — quem manda é o rank do personagem, " ..
                            "que escolhe sozinho qual dos seis blocos vale hoje.")
                    else
                        self.popHab_lblSemPoder:setText("Habilidade racial: vem da raça ou de uma qualidade já paga, " ..
                            "então não custa ponto de poder e nenhum rank fica bloqueado.")
                    end
                    definirAlturaPod(self.popHab_lblSemPoder, 46)
                elseif habRascunho.tipo == "classe" then
                    self.popHab_lblSemPoder:setText("Habilidade de classe não depende de poder e pode chegar ao rank EX, " ..
                        "mas seus efeitos são mais fracos. As regras desta categoria ainda estão sendo fechadas na mesa, " ..
                        "então a ficha deixa todos os campos livres — combine os valores com o mestre.")
                    definirAlturaPod(self.popHab_lblSemPoder, 46)
                else
                    self.popHab_lblSemPoder:setText("")
                    definirAlturaPod(self.popHab_lblSemPoder, 0)
                end
            end
            local semPoderDeOrigem = (habRascunho.tipo == "classe" or habRascunho.tipo == "racial")
            definirAlturaPod(self.popHab_lblPoderTitulo, semPoderDeOrigem and 0 or 16)

            -- ranks: liberados x bloqueados
            local libs = ranksLiberadosParaTipo(habRascunho.tipo, habRascunho.poderVinculado)
            for _, r in ipairs(CatalogoHabilidades.ranks) do
                local liberado = false
                for _, l in ipairs(libs) do if l == r then liberado = true end end
                local btn = self["popHab_btnRank" .. r]
                local lbl = self["popHab_lblRank" .. r]
                if btn ~= nil and lbl ~= nil then
                    if r == habRascunho.rank then
                        btn:setStrokeColor(COR.gold); btn:setStrokeSize(2); lbl:setFontColor(COR.gold)
                    elseif liberado then
                        btn:setStrokeColor(COR.line); btn:setStrokeSize(1); lbl:setFontColor(COR.text)
                    else
                        btn:setStrokeColor("#1A262C"); btn:setStrokeSize(1); lbl:setFontColor(COR.faint)
                    end
                end
            end

            -- explicacao do rank
            if self.popHab_lblRankInfo ~= nil then
                local d = CatalogoHabilidades.dadosDoRank(habRascunho.rank, ehFeitico)
                local energiaNome = ehFeitico and "Mana" or "Aura"
                if d ~= nil then
                    local custoTxt = (habRascunho.tipo == "racial")
                        and "não custa ponto (vem da raça)"
                        or ("custa " .. d.custo .. " ponto(s)")
                    local txt = "Rank " .. habRascunho.rank .. ": " .. custoTxt ..
                        ", até " .. limiteTagsAtual() .. " tags, " .. energiaNome .. " " ..
                        d.energiaMin .. " a " .. d.energiaMax .. ", alcance máximo " ..
                        d.alcanceMax .. "m, " .. d.duracao .. ". " .. d.efeitoAdicional
                    if habRascunho.tipo ~= "classe" and habRascunho.poderVinculado ~= "" then
                        local nv = nivelDoPoder(habRascunho.poderVinculado)
                        txt = txt .. "  —  " .. habRascunho.poderVinculado .. " está no nível " .. nv ..
                            " e libera até " .. (libs[#libs] or "E") .. "."
                    end
                    self.popHab_lblRankInfo:setText(txt)
                end
            end

            -- Linhagem de Unaris: so faz diferenca em feitico
            definirAlturaPod(self.popHab_wrapBruxa, ehFeitico and 54 or 0)
            if ehFeitico and self.popHab_btnBruxa ~= nil then
                local bruxa = personagemEhBruxa()
                self.popHab_btnBruxa:setStrokeColor(bruxa and COR.aura or COR.line)
                if self.popHab_lblBruxa ~= nil then
                    if bruxa then
                        self.popHab_lblBruxa:setText("✦  BRUXA — escala de magia aumentada")
                        self.popHab_lblBruxa:setFontColor(COR.aura)
                    else
                        local auto = temLinhagemDeUnaris()
                        if auto then
                            self.popHab_lblBruxa:setText("BRUXA desligada manualmente (tem a qualidade)")
                        else
                            self.popHab_lblBruxa:setText("NÃO É BRUXA — clique se tiver Linhagem de Unaris")
                        end
                        self.popHab_lblBruxa:setFontColor(COR.muted)
                    end
                end
            end

            -- modificadores de alcance
            if self.popHab_btnCorpo ~= nil then
                self.popHab_btnCorpo:setStrokeColor(habRascunho.corpoACorpo and COR.gold or COR.line)
                if self.popHab_lblCorpo ~= nil then
                    self.popHab_lblCorpo:setFontColor(habRascunho.corpoACorpo and COR.gold or COR.muted)
                end
            end
            if self.popHab_btnArea ~= nil then
                self.popHab_btnArea:setStrokeColor(habRascunho.emArea and COR.gold or COR.line)
                if self.popHab_lblArea ~= nil then
                    self.popHab_lblArea:setFontColor(habRascunho.emArea and COR.gold or COR.muted)
                end
            end

            -- tags
            if self.popHab_lblTagsLimite ~= nil then
                self.popHab_lblTagsLimite:setText("TAGS  " .. #habRascunho.tags .. " / " ..
                    limiteTagsAtual() .. "   ·   clique acumula")
            end
            for _, t in ipairs(CatalogoHabilidades.todasAsTags()) do
                local card = self["popHab_tag" .. chavePoder(t.nome)]
                local lbl = self["popHab_lblTag" .. chavePoder(t.nome)]
                local vezes = contarTag(t.nome)
                if card ~= nil then
                    card:setStrokeColor((vezes > 0) and COR.aura or COR.line)
                    card:setStrokeSize((vezes > 0) and 2 or 1)
                end
                if lbl ~= nil then
                    -- o proprio card mostra quantas vezes a tag foi empilhada
                    if vezes > 1 then
                        lbl:setText(t.nome .. "   (" .. vezes .. "x)")
                    else
                        lbl:setText(t.nome)
                    end
                    lbl:setFontColor((vezes > 0) and COR.text or COR.muted)
                end
            end

            -- chips: um por tag distinta, com a contagem
            tagsNoConstrutor = {}
            local ordem, cont = {}, {}
            for _, t in ipairs(habRascunho.tags) do
                if cont[t] == nil then cont[t] = 0; table.insert(ordem, t) end
                cont[t] = cont[t] + 1
            end
            for i = 1, 5 do
                local nomeTag = ordem[i]
                tagsNoConstrutor[i] = nomeTag
                local temChip = (nomeTag ~= nil)
                local texto = ""
                if temChip then
                    texto = nomeTag
                    if cont[nomeTag] > 1 then texto = texto .. "  " .. cont[nomeTag] .. "x" end
                end
                -- largura proporcional ao texto (bytes servem: as tags sao curtas)
                local largura = 0
                if temChip then largura = 30 + #texto * 7 end
                definirLarguraPod(self["popHab_wrapChip" .. i], largura)
                local lblChip = self["popHab_lblChip" .. i]
                if lblChip ~= nil then lblChip:setText(texto .. "   ×") end
            end
            if self.popHab_lblTagsEscolhidas ~= nil then
                if #habRascunho.tags == 0 then
                    self.popHab_lblTagsEscolhidas:setText("Nenhuma tag escolhida.")
                else
                    self.popHab_lblTagsEscolhidas:setText("")
                end
            end

            -- custo previsto
            if self.popHab_lblCusto ~= nil then
                local credito = n(habRascunho.creditoEmbutido)
                local cheio = CatalogoHabilidades.custoDoRank(habRascunho.rank, ehFeitico)
                local custo = calcularCustoHabilidade(habRascunho.rank, habRascunho.tipo, credito)
                if credito > 0 then
                    local txt = "Concedida por " .. tostring(habRascunho.rotuloGratis or "sistema") ..
                        ": " .. credito .. " ponto(s) de desconto"
                    if custo == 0 then
                        txt = txt .. "   ·   sai de graça"
                    else
                        txt = txt .. "   ·   " .. cheio .. " − " .. credito .. " = " .. custo ..
                            " ponto(s)   ·   saldo " .. saldoPontosPoder()
                    end
                    self.popHab_lblCusto:setText(txt)
                    self.popHab_lblCusto:setFontColor(COR.gold)
                else
                    self.popHab_lblCusto:setText("Custo: " .. custo .. " ponto(s)   ·   saldo atual " .. saldoPontosPoder())
                    self.popHab_lblCusto:setFontColor(COR.muted)
                end
            end
        end

        -- =================================================================
        -- CONCESSOES AUTOMATICAS
        --
        -- Varias partes do sistema entregam coisas de graca em OUTRAS abas:
        -- uma caracteristica racial da uma pericia, um poder de atributo da
        -- uma qualidade e +1 no atributo, e assim por diante. Sem isso
        -- automatizado o jogador acaba pagando do proprio bolso por algo que
        -- o sistema deveria dar.
        --
        -- COMO FUNCIONA
        --   Cada linha de CONCESSOES declara uma FONTE (o que precisa estar
        --   na ficha) e um EFEITO (o que isso entrega). A cada recalculo
        --   comparamos as fontes ativas com o que ja foi aplicado, gravado em
        --   "concessoesAplicadas". Aplicar duas vezes nao acumula, e perder a
        --   fonte desfaz o efeito.
        --
        -- TIPOS DE FONTE
        --   caracRacial : a caracteristica esta na lista de caracteristicas
        --   poderNivel  : o poder esta no nivel N ou acima
        --   qualidade   : a qualidade esta na ficha
        --
        -- TIPOS DE EFEITO
        --   atributo     : soma no campo <attr>Bonus (o segundo campo, de
        --                  bonus racial/poder)
        --   qualidade    : entra na lista de Qualidades com pontosPagos = 0
        --   defeito      : entra na lista de Defeitos com pontosPagos = 0.
        --                  REGRA DA MESA: defeito concedido NAO rende PD -
        --                  e um defeito ganho de graca, nao uma escolha. Como
        --                  o ganho de PD e a soma de "pontosPagos", gravar 0
        --                  ja resolve isso sozinho.
        --   pericia      : entra na lista do atributo, ignorando o limite
        --   periciaLivre : nao escolhe nada; abre +1 vaga de pericia naquele
        --                  atributo para o jogador escolher (o texto do livro
        --                  diz "escolha uma pericia deste atributo")
        -- =================================================================

        -- O campo "tier" e o CUSTO REAL da qualidade no catalogo, e nao um
        -- numero qualquer: e ele que seleciona a faixa de efeito
        -- (CatalogoQD.somarEfeitos le item.efeitos[tier]) e o que aparece no
        -- selo de pontos do item. Conferido um a um contra o "pontosTexto".
        local CONCESSOES = {
            -- ----- caracteristicas raciais -----
            {chave = "drow_animais", fonte = {tipo = "caracRacial", nome = "Mestres da domesticação"},
             efeito = {tipo = "pericia", atributo = "Carisma", nome = "Animais"},
             rotulo = "Mestres da domesticação"},

            {chave = "vamp_beleza", fonte = {tipo = "caracRacial", nome = "Sedutores"},
             efeito = {tipo = "qualidade", nome = "Beleza sobrenatural", tier = 3},
             rotulo = "Sedutores (Vampiros)"},

            {chave = "vamp_segredo", fonte = {tipo = "caracRacial", nome = "Cabeça a prêmio"},
             efeito = {tipo = "defeito", nome = "Segredo obscuro", tier = 3},
             rotulo = "Cabeça a prêmio (Vampiros)"},

            {chave = "harpia_intoler", fonte = {tipo = "caracRacial", nome = "Intolerância a mortos-vivos"},
             efeito = {tipo = "defeito", nome = "Intolerância", tier = 2},
             rotulo = "Intolerância (Harpias)"},

            -- ----- bonus de atributo racial -----
            -- Extraidas do catalogo de racas. Cada uma da +N num ou dois
            -- atributos e eleva o TETO daquele atributo (9 ou 10 conforme a
            -- raca). O bonus vai para o campo "+", nunca para o valor base.
            --
            -- DEDUPLICADAS POR CARACTERISTICA: "Super forca" aparece em seis
            -- racas e "Vigorosos" em tres, sempre com o mesmo efeito. Como a
            -- ficha guarda a CARACTERISTICA (e nao a raca), uma entrada por
            -- raca fazia o bonus ser aplicado varias vezes - Constituicao
            -- ganhava +6 em vez de +2.
            {chave = "rac_agilidadeaprimor", fonte = {tipo = "caracRacial", nome = "Agilidade aprimorada"},
             efeito = {tipo = "atributoRacial", atributos = {"Destreza"}, valor = 1, teto = 10},
             rotulo = "Agilidade aprimorada"},
            {chave = "rac_agilidadeelfica", fonte = {tipo = "caracRacial", nome = "Agilidade élfica"},
             efeito = {tipo = "atributoRacial", atributos = {"Destreza"}, valor = 1, teto = 10},
             rotulo = "Agilidade élfica"},
            {chave = "rac_carismaticos", fonte = {tipo = "caracRacial", nome = "Carismáticos"},
             efeito = {tipo = "atributoRacial", atributos = {"Carisma"}, valor = 1, teto = 10},
             rotulo = "Carismáticos"},
            {chave = "rac_fisiologiadeguer", fonte = {tipo = "caracRacial", nome = "Fisiologia de guerra"},
             efeito = {tipo = "atributoRacial", atributos = {"Força", "Destreza"}, valor = 1, teto = 9},
             rotulo = "Fisiologia de guerra"},
            {chave = "rac_graciosidade", fonte = {tipo = "caracRacial", nome = "Graciosidade"},
             efeito = {tipo = "atributoRacial", atributos = {"Destreza", "Carisma"}, valor = 1, teto = 9},
             rotulo = "Graciosidade"},
            {chave = "rac_manipuladoras", fonte = {tipo = "caracRacial", nome = "Manipuladoras"},
             efeito = {tipo = "atributoRacial", atributos = {"Manipulação"}, valor = 1, teto = 10},
             rotulo = "Manipuladoras"},
            {chave = "rac_manipuladores", fonte = {tipo = "caracRacial", nome = "Manipuladores"},
             efeito = {tipo = "atributoRacial", atributos = {"Manipulação"}, valor = 1, teto = 10},
             rotulo = "Manipuladores"},
            -- Lizarianos, Selkies, Sereias e Tritões, Lobisomens, Minotauros, Ursaris
            {chave = "rac_superforca", fonte = {tipo = "caracRacial", nome = "Super força"},
             efeito = {tipo = "atributoRacial", atributos = {"Força"}, valor = 1, teto = 10},
             rotulo = "Super força"},
            -- Anões, Vampiros, Minotauros
            {chave = "rac_vigorosos", fonte = {tipo = "caracRacial", nome = "Vigorosos"},
             efeito = {tipo = "atributoRacial", atributos = {"Constituição"}, valor = 2, teto = 10},
             rotulo = "Vigorosos"},

            -- ----- humanos -----
            -- "1 pericia adicional LIVRE": nao e de um atributo especifico,
            -- entao abre vaga no total geral, e nao no limite de um atributo.
            {chave = "hum_multitarefas", fonte = {tipo = "caracRacial", nome = "Multitarefas"},
             efeito = {tipo = "periciaLivreGeral"},
             rotulo = "Multitarefas (Humanos)"},
            -- "1 ponto adicional de atributo": entra no BOLSO de pontos, e nao
            -- como bonus no valor de um atributo.
            {chave = "hum_versatilidade", fonte = {tipo = "caracRacial", nome = "Versatilidade humana"},
             efeito = {tipo = "pontoAtributo", valor = 1, teto = 10},
             rotulo = "Versatilidade humana"},

            -- ----- poderes de atributo: nivel 1 -----
            {chave = "pod_car1", fonte = {tipo = "poderNivel", nome = "Carisma sobrenatural", nivel = 1},
             efeito = {tipo = "qualidade", nome = "Beleza sobrenatural", tier = 3},
             rotulo = "Carisma sobrenatural"},
            {chave = "pod_con1", fonte = {tipo = "poderNivel", nome = "Constituição sobrenatural", nivel = 1},
             efeito = {tipo = "qualidade", nome = "Vigor expandido", tier = 2},
             rotulo = "Constituição sobrenatural"},
            {chave = "pod_int1", fonte = {tipo = "poderNivel", nome = "Inteligência sobrenatural", nivel = 1},
             efeito = {tipo = "qualidade", nome = "Genialidade", tier = 3},
             rotulo = "Inteligência sobrenatural"},
            {chave = "pod_sab1", fonte = {tipo = "poderNivel", nome = "Sabedoria sobrenatural", nivel = 1},
             efeito = {tipo = "qualidade", nome = "Vontade de ferro", tier = 2},
             rotulo = "Sabedoria sobrenatural"},

            -- ----- poderes de atributo: pericias de escolha -----
            {chave = "pod_for1_per", fonte = {tipo = "poderNivel", nome = "Força sobrenatural", nivel = 1},
             efeito = {tipo = "periciaLivre", atributo = "Força"},
             rotulo = "Força sobrenatural"},
            {chave = "pod_man1_per", fonte = {tipo = "poderNivel", nome = "Manipulação sobrenatural", nivel = 1},
             efeito = {tipo = "periciaLivre", atributo = "Manipulação"},
             rotulo = "Manipulação sobrenatural"},
            {chave = "pod_int3_per", fonte = {tipo = "poderNivel", nome = "Inteligência sobrenatural", nivel = 3},
             efeito = {tipo = "periciaLivre", atributo = "Inteligência"},
             rotulo = "Inteligência sobrenatural (nível 3)"},
            {chave = "pod_int5_per", fonte = {tipo = "poderNivel", nome = "Inteligência sobrenatural", nivel = 5},
             efeito = {tipo = "periciaLivre", atributo = "Inteligência"},
             rotulo = "Inteligência sobrenatural (nível 5)"},
            {chave = "pod_sab3_per", fonte = {tipo = "poderNivel", nome = "Sabedoria sobrenatural", nivel = 3},
             efeito = {tipo = "periciaLivre", atributo = "Sabedoria"},
             rotulo = "Sabedoria sobrenatural (nível 3)"},

            -- ----- qualidade que da pericia -----
            {chave = "qual_beleza_seducao", fonte = {tipo = "qualidade", nome = "Beleza sobrenatural"},
             efeito = {tipo = "pericia", atributo = "Manipulação", nome = "Sedução"},
             rotulo = "Beleza sobrenatural"},
        }

        -- Bonus de atributo dos 7 poderes sobrenaturais.
        -- A progressao da +1 nos niveis 1 a 4 e +2 no nivel 5 (total +6).
        -- Fica separado da tabela acima porque o valor depende do nivel do
        -- poder, e nao e um liga-desliga.
        local BONUS_ATRIBUTO_ACUMULADO = {0, 1, 2, 3, 4, 6}

        local CAMPO_ATRIBUTO = {
            ["Força"] = "forca", ["Destreza"] = "destreza",
            ["Constituição"] = "constituicao", ["Inteligência"] = "inteligencia",
            ["Sabedoria"] = "sabedoria", ["Carisma"] = "carisma",
            ["Manipulação"] = "manipulacao",
        }

        -- ===============================================================
        -- ONDE A AUTOMACAO DO ATRIBUTO MORA (v0.49.0)
        -- ===============================================================
        -- DECISAO DA MESA, 06/09/2026: "nos atributos deveriamos ter um
        -- terceiro campo a direita, esse campo servira para expressar todas
        -- as automatizacoes da ficha (...) basicamente todas as automatizacoes
        -- que ja fazemos, mas elas estao vinculadas nos campos de atributo
        -- bonus".
        --
        -- Ate a v0.48.0 raca, poder e qualidade somavam no MESMO campo em que
        -- o jogador digita o bonus dele. Funcionava, e escondia de quem olha a
        -- ficha de onde cada ponto veio -- e era o que obrigava a maquina de
        -- concessoes a somar e subtrair em vez de simplesmente recalcular.
        --
        -- E VARIAVEL, e nao constante, por um motivo so: o REPARO abaixo
        -- precisa desfazer as concessoes de onde elas estavam (Bonus) antes
        -- de reaplica-las onde elas passam a morar (Concedido). Fora desse
        -- instante ela nunca muda.
        CAMPO_AUTO_ATRIBUTO = "Concedido"

        -- REPARO, uma vez por ficha.
        --
        -- Desfaz cada concessao JA APLICADA de dentro do Bonus usando a
        -- funcao que a ficha ja usa para isso quando uma fonte sai -- ou
        -- seja, a inversa exata, e nao uma conta nova escrita para a ocasiao.
        -- Depois zera o registro do que estava aplicado, e o
        -- aplicarConcessoes() seguinte reaplica tudo no campo novo.
        --
        -- O bonus de poder tem contabilidade propria (BonusDePoder guarda o
        -- quanto ja foi lancado), entao ele e devolvido na mao aqui e o
        -- sincronizador o refaz no campo novo.
        --
        -- E reparo solto, e nao bloco de migracao de versao: reparo escrito
        -- como elseif de migracao nunca roda para quem esta na versao antiga.
        function separarAutomacoesDoBonus()
            if sheet == nil then return end
            if tostring(sheet.atributosAutoSeparados or "") == "1" then return end

            CAMPO_AUTO_ATRIBUTO = "Bonus"
            pcall(function()
                local aplicadas = chavesConcedidas()
                for _, con in ipairs(CONCESSOES) do
                    if aplicadas[con.chave] then
                        pcall(function() desfazerEfeitoConcessao(con) end)
                    end
                end
                sheet.concessoesAplicadas = ""
                for _, chave in ipairs({"carisma", "constituicao", "destreza",
                                        "forca", "inteligencia", "manipulacao",
                                        "sabedoria"}) do
                    local lancado = n(sheet[chave .. "BonusDePoder"])
                    if lancado ~= 0 then
                        local novo = n(sheet[chave .. "Bonus"]) - lancado
                        if novo < 0 then novo = 0 end
                        sheet[chave .. "Bonus"] = novo
                        sheet[chave .. "BonusDePoder"] = 0
                    end
                    sheet[chave .. "Concedido"] = 0
                end
            end)
            CAMPO_AUTO_ATRIBUTO = "Concedido"
            sheet.atributosAutoSeparados = "1"
        end

        function chavesConcedidas()
            if sheet == nil then return {} end
            local r = {}
            for _, k in ipairs(partirTexto(sheet.concessoesAplicadas, ";")) do r[k] = true end
            return r
        end

        function gravarChavesConcedidas(mapa)
            if sheet == nil then return end
            local partes = {}
            for k, v in pairs(mapa) do
                if v then table.insert(partes, k) end
            end
            table.sort(partes)
            sheet.concessoesAplicadas = table.concat(partes, ";")
        end

        -- Consulta em DUAS fontes, nesta ordem:
        --   1. o catalogo da raca gravada em sheet.raca;
        --   2. a recordList de caracteristicas da aba.
        --
        -- A recordList e reconstruida quando a aba de Raca desenha, e nao no
        -- instante em que a raca muda. Depender so dela fazia os bonus
        -- entrarem apenas depois de fechar e reabrir a ficha - o catalogo, ao
        -- contrario, responde assim que sheet.raca e gravado.
        -- A lista continua sendo consultada porque e ela que guarda as
        -- caracteristicas ESCOLHIDAS de um mestico, que nao saem do catalogo
        -- de uma raca so.
        -- As alternativas exclusivas da raca ("X OU Y" no livro), se houver.
        function alternativasExclusivasDaRaca(dados)
            if dados == nil then return {} end
            return dados.escolhaExclusiva or {}
        end

        function tracoEhAlternativaExclusiva(dados, nome)
            for _, alt in ipairs(alternativasExclusivasDaRaca(dados)) do
                if alt == nome then return true end
            end
            return false
        end

        -- Escolha de CRIACAO (trava do mestre). Clicar de novo desfaz.
        function escolherTracoRacial(nome)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                if self.abaRaca_lblEscolhaTraco ~= nil then
                    self.abaRaca_lblEscolhaTraco:setText(motivoTravaCriacao())
                    self.abaRaca_lblEscolhaTraco:setFontColor(COR.wine)
                end
                return
            end
            local dados = CatalogoRacas.buscarPorNome(tostring(sheet.raca or ""))
            if not tracoEhAlternativaExclusiva(dados, nome) then return end
            if tostring(sheet.racaTracoEscolhido or "") == nome then
                sheet.racaTracoEscolhido = ""
            else
                sheet.racaTracoEscolhido = nome
            end
            recalcularTudo()
            atualizarBlocoRaca()
        end

        function escolherTracoRacialPorIndice(i)
            if sheet == nil then return end
            local dados = CatalogoRacas.buscarPorNome(tostring(sheet.raca or ""))
            local alts = alternativasExclusivasDaRaca(dados)
            if alts[i] ~= nil then escolherTracoRacial(alts[i]) end
        end

        function atualizarEscolhaTracoRacial(dados)
            if self.abaRaca_wrapEscolhaTraco == nil then return end
            local alts = alternativasExclusivasDaRaca(dados)
            pcall(function() self.abaRaca_wrapEscolhaTraco:setHeight((#alts > 0) and 78 or 0) end)
            if #alts == 0 then return end
            local escolhido = tostring(sheet.racaTracoEscolhido or "")
            if self.abaRaca_lblEscolhaTraco ~= nil then
                local pend = pendenciaTracoRacial()
                if pend ~= "" then
                    self.abaRaca_lblEscolhaTraco:setText(pend)
                    self.abaRaca_lblEscolhaTraco:setFontColor(COR.gold)
                else
                    self.abaRaca_lblEscolhaTraco:setText("Escolha do livro (" .. table.concat(alts, " OU ") ..
                        "): você ficou com " .. escolhido .. ". Clique de novo para desfazer.")
                    self.abaRaca_lblEscolhaTraco:setFontColor(COR.moss)
                end
            end
            for i = 1, 2 do
                local btn = self["abaRaca_btnTraco" .. i]
                local lbl = self["abaRaca_lblTraco" .. i]
                local nome = alts[i]
                local marcada = (nome ~= nil and nome == escolhido)
                if lbl ~= nil then
                    lbl:setText(nome and string.upper(nome) or "")
                    lbl:setFontColor(marcada and COR.gold or COR.muted)
                end
                if btn ~= nil then
                    btn:setStrokeColor(marcada and COR.gold or COR.line)
                    btn:setStrokeSize(marcada and 2 or 1)
                end
            end
        end

        -- Pendencia para a aba 04: raca com "ou" e nada escolhido.
        function pendenciaTracoRacial()
            if sheet == nil then return "" end
            local dados = CatalogoRacas.buscarPorNome(tostring(sheet.raca or ""))
            local alts = alternativasExclusivasDaRaca(dados)
            if #alts == 0 then return "" end
            local escolhido = tostring(sheet.racaTracoEscolhido or "")
            if escolhido ~= "" then return "" end
            return "O livro dá " .. table.concat(alts, " OU ") .. " — escolha UMA abaixo. Enquanto não escolher, nenhuma das duas está valendo."
        end

        function temCaracRacial(nome)
            if sheet == nil then return false end

            -- Defensivo: se o catalogo nao estiver carregado, cai direto na
            -- lista em vez de estourar. Sem isso, um erro aqui era engolido
            -- pelo pcall do motor e TODAS as concessoes falhavam caladas.
            local dados = nil
            if CatalogoRacas ~= nil then
                local ok, res = pcall(function()
                    return CatalogoRacas.buscarPorNome(tostring(sheet.raca or ""))
                end)
                if ok then dados = res end
            end
            if dados ~= nil then
                for _, car in ipairs(dados.caracteristicas or {}) do
                    if tostring(car.nome or "") == nome then
                        -- Humano puro perde a caracteristica exclusiva quando
                        -- vira mestico; o resto vale normalmente.
                        local exclusiva = ""
                        pcall(function() exclusiva = CatalogoRacas.CARACTERISTICA_SO_HUMANO_PURO end)
                        if nome == exclusiva and exclusiva ~= "" and n(sheet.mesticoQtd) > 0 then
                            return false
                        end
                        -- O "OU" do livro (B-04): das alternativas exclusivas
                        -- da raca, so a ESCOLHIDA existe. Sem escolha, nenhuma.
                        if tracoEhAlternativaExclusiva(dados, nome) then
                            return tostring(sheet.racaTracoEscolhido or "") == nome
                        end
                        return true
                    end
                end
            end

            for _, item in ipairs(NDB.getChildNodes(sheet.listaCaracsRaciais) or {}) do
                if tostring(item.nome or "") == nome then return true end
            end
            return false
        end

        function temQualidadeNaFicha(nome)
            if sheet == nil then return false end
            for _, q in ipairs(NDB.getChildNodes(sheet.listaQualidades) or {}) do
                if tostring(q.nome or "") == nome then return true end
            end
            return false
        end

        function fonteEstaAtiva(fonte)
            if fonte == nil then return false end
            if fonte.tipo == "caracRacial" then
                return temCaracRacial(fonte.nome)
            elseif fonte.tipo == "poderNivel" then
                return nivelDoPoder(fonte.nome) >= n(fonte.nivel)
            elseif fonte.tipo == "qualidade" then
                return temQualidadeNaFicha(fonte.nome)
            end
            return false
        end

        -- Nome da lista de pericias de um atributo (ex.: listaPericiasCarisma).
        function listaDePericiasDe(atributo)
            local base = CAMPO_ATRIBUTO[atributo]
            if base == nil then return nil end
            return "listaPericias" .. string.upper(string.sub(base, 1, 1)) .. string.sub(base, 2)
        end

        -- ---------------------------------------------------------------
        -- APLICAR / DESFAZER
        -- ---------------------------------------------------------------
        function aplicarEfeitoConcessao(con)
            local ef = con.efeito
            if ef == nil or sheet == nil then return false end

            if ef.tipo == "qualidade" or ef.tipo == "defeito" then
                local nomeLista = (ef.tipo == "qualidade") and "listaQualidades" or "listaDefeitos"
                local widget = self[nomeLista]
                if widget == nil then return false end
                -- ja existe na ficha? entao so registramos a origem, sem duplicar
                for _, item in ipairs(NDB.getChildNodes(sheet[nomeLista]) or {}) do
                    if tostring(item.nome or "") == ef.nome then
                        if n(item.pontosEscolhidos) < n(ef.tier) then
                            item.pontosEscolhidos = n(ef.tier)
                        end
                        item.origemConcessao = con.rotulo
                        return true
                    end
                end
                local dados = CatalogoQD.buscarPorNome(ef.nome)
                local node = widget:append()
                if node == nil then return false end
                node.tipo = (ef.tipo == "qualidade") and "Qualidade" or "Defeito"
                node.nome = ef.nome
                node.pontosEscolhidos = n(ef.tier)
                node.pontosPagos = 0          -- de graca: nao gasta PQ nem rende PD
                node.origemConcessao = con.rotulo
                node.descricao = dados and dados.descricao or ""
                node.pontosTexto = dados and dados.pontosTexto or ""
                return true

            elseif ef.tipo == "pericia" then
                local nomeLista = listaDePericiasDe(ef.atributo)
                if nomeLista == nil then return false end
                local widget = self[nomeLista]
                if widget == nil then return false end
                for _, item in ipairs(NDB.getChildNodes(sheet[nomeLista]) or {}) do
                    if tostring(item.nome or "") == ef.nome then
                        item.origemConcessao = con.rotulo
                        return true
                    end
                end
                local dados = CatalogoPericias.buscar(ef.atributo, ef.nome)
                local node = widget:append()
                if node == nil then return false end
                node.atributo = ef.atributo
                node.nome = ef.nome
                node.aprovadoMestre = true    -- concedida: entra fora do limite
                node.origemConcessao = con.rotulo
                node.descricao = dados and dados.descricao or ""
                return true

            elseif ef.tipo == "periciaLivre" then
                local base = CAMPO_ATRIBUTO[ef.atributo]
                if base == nil then return false end
                local campo = base .. "PericiasBonus"
                sheet[campo] = n(sheet[campo]) + 1
                return true

            elseif ef.tipo == "periciaLivreGeral" then
                sheet.periciasBonusGeral = n(sheet.periciasBonusGeral) + 1
                return true

            elseif ef.tipo == "atributoRacial" then
                -- +N no campo de BONUS de cada atributo listado, e o teto
                -- daquele atributo passa a ser o da raca (9 ou 10).
                local lancados = 0
                for _, nomeAtr in ipairs(ef.atributos or {}) do
                    local base = CAMPO_ATRIBUTO[nomeAtr]
                    if base ~= nil then
                        sheet[base .. CAMPO_AUTO_ATRIBUTO] = n(sheet[base .. CAMPO_AUTO_ATRIBUTO]) + n(ef.valor)
                        sheet[base .. "TetoRacial"] = n(ef.teto)
                        lancados = lancados + 1
                    end
                end
                return lancados > 0

            elseif ef.tipo == "pontoAtributo" then
                -- REGRA DA MESA: este ponto NAO entra no bolso de pontos de
                -- evolucao (que continua 18 no nivel 7). Ele vai direto para o
                -- campo de BONUS do atributo que o jogador escolher no popup
                -- da raca. Enquanto nao escolher, fica pendente.
                local nomeAtr = tostring(sheet.atributoRacialEscolhido or "")
                if nomeAtr == "" then return false end
                local base = CAMPO_ATRIBUTO[nomeAtr]
                if base == nil then return false end
                local v = n(ef.valor)
                if v == 0 then v = 1 end
                sheet[base .. CAMPO_AUTO_ATRIBUTO] = n(sheet[base .. CAMPO_AUTO_ATRIBUTO]) + v
                local t = n(ef.teto)
                if t == 0 then t = 10 end
                sheet[base .. "TetoRacial"] = t
                sheet.atributoRacialLancado = nomeAtr
                sheet.atributoRacialValor = v
                return true
            end
            return false
        end

        function desfazerEfeitoConcessao(con)
            local ef = con.efeito
            if ef == nil or sheet == nil then return end

            if ef.tipo == "qualidade" or ef.tipo == "defeito" then
                local nomeLista = (ef.tipo == "qualidade") and "listaQualidades" or "listaDefeitos"
                for _, item in ipairs(NDB.getChildNodes(sheet[nomeLista]) or {}) do
                    if tostring(item.nome or "") == ef.nome
                       and tostring(item.origemConcessao or "") == con.rotulo then
                        -- so remove o que foi 100% concedido; se o jogador
                        -- pagou por cima, mantemos e apenas soltamos a marca
                        if n(item.pontosPagos) <= 0 then
                            NDB.deleteNode(item)
                        else
                            item.origemConcessao = ""
                        end
                        return
                    end
                end

            elseif ef.tipo == "pericia" then
                local nomeLista = listaDePericiasDe(ef.atributo)
                if nomeLista == nil then return end
                for _, item in ipairs(NDB.getChildNodes(sheet[nomeLista]) or {}) do
                    if tostring(item.nome or "") == ef.nome
                       and tostring(item.origemConcessao or "") == con.rotulo then
                        NDB.deleteNode(item)
                        return
                    end
                end

            elseif ef.tipo == "periciaLivre" then
                local base = CAMPO_ATRIBUTO[ef.atributo]
                if base == nil then return end
                local campo = base .. "PericiasBonus"
                local novo = n(sheet[campo]) - 1
                if novo < 0 then novo = 0 end
                sheet[campo] = novo

            elseif ef.tipo == "periciaLivreGeral" then
                local novo = n(sheet.periciasBonusGeral) - 1
                if novo < 0 then novo = 0 end
                sheet.periciasBonusGeral = novo

            elseif ef.tipo == "atributoRacial" then
                for _, nomeAtr in ipairs(ef.atributos or {}) do
                    local base = CAMPO_ATRIBUTO[nomeAtr]
                    if base ~= nil then
                        local novo = n(sheet[base .. CAMPO_AUTO_ATRIBUTO]) - n(ef.valor)
                        if novo < 0 then novo = 0 end
                        sheet[base .. CAMPO_AUTO_ATRIBUTO] = novo
                        sheet[base .. "TetoRacial"] = 0
                    end
                end

            elseif ef.tipo == "pontoAtributo" then
                -- devolve o bonus ao atributo em que ele foi lancado
                local nomeAtr = tostring(sheet.atributoRacialLancado or "")
                local base = CAMPO_ATRIBUTO[nomeAtr]
                if base ~= nil then
                    local v = n(sheet.atributoRacialValor)
                    if v == 0 then v = 1 end
                    local novo = n(sheet[base .. CAMPO_AUTO_ATRIBUTO]) - v
                    if novo < 0 then novo = 0 end
                    sheet[base .. CAMPO_AUTO_ATRIBUTO] = novo
                    sheet[base .. "TetoRacial"] = 0
                end
                sheet.atributoRacialLancado = ""
                sheet.atributoRacialValor = 0
            end
        end

        -- ---------------------------------------------------------------
        -- BONUS DE ATRIBUTO DOS PODERES SOBRENATURAIS
        --
        -- Diferente das demais concessoes, este valor MUDA conforme o poder
        -- sobe. Guardamos quanto ja foi lancado em cada atributo para somar
        -- apenas a diferenca - assim o campo de bonus do jogador (que pode
        -- ter valores de outras origens) nunca e sobrescrito.
        -- ---------------------------------------------------------------
        function sincronizarBonusAtributoDePoderes()
            if sheet == nil then return end
            for _, poder in ipairs(CatalogoPoderes.itens) do
                if poder.atributo ~= nil then
                    local base = CAMPO_ATRIBUTO[poder.atributo]
                    if base ~= nil then
                        local nivel = nivelDoPoder(poder.nome)
                        if nivel > 5 then nivel = 5 end
                        local desejado = BONUS_ATRIBUTO_ACUMULADO[nivel + 1] or 0
                        local campoLancado = base .. "BonusDePoder"
                        local lancado = n(sheet[campoLancado])
                        if desejado ~= lancado then
                            local campoBonus = base .. CAMPO_AUTO_ATRIBUTO
                            sheet[campoBonus] = n(sheet[campoBonus]) + (desejado - lancado)
                            sheet[campoLancado] = desejado
                        end
                    end
                end
            end
        end

        -- ---------------------------------------------------------------
        -- HEMOCINESE
        --
        -- Nao passa pela tabela CONCESSOES de proposito: o nivel concedido
        -- MUDA com o nivel do personagem, e CONCESSOES e liga-desliga.
        -- Segue o mesmo padrao de sincronizarBonusAtributoDePoderes().
        --
        -- ARMADILHA REAL: a caracteristica se chama [Hemocinese] em DUAS
        -- racas, com efeitos DIFERENTES. Indexar so pelo nome daria a
        -- progressao automatica do Orc ao Vampiro tambem.
        --
        --   Racas / Orcs:
        --     "[Hemocinese] receba o poder exclusivo 'Hemocinese' em sua
        --      ficha, comecando com 1 ponto no mesmo e recebendo upgrades
        --      automaticos nos niveis 5, 10, 15 e 20; Se voce ja tiver upado
        --      o poder, os pontos recebidos se convertem em pontos de poder
        --      comuns."
        --
        --   Racas / Vampiros:
        --     "[Hemocinese] receba o poder exclusivo 'Hemocinese',
        --      substituindo um poder ativo em sua ficha; Este poder pode
        --      coexistir com o poder 'Magia'."
        --
        -- O Vampiro nao ganha a escada automatica: o texto dele nao a cita.
        -- E a ultima frase e a autorizacao expressa para Hemocinese conviver
        -- com Magia - por isso nada aqui bloqueia a bruxa-vampira.
        --
        -- "Os pontos se convertem em pontos de poder comuns" cai fora de
        -- graca: hemocinesePontosGratis entra em pontosPoderTotais() SEMPRE,
        -- tenha o jogador subido o poder por conta propria ou nao. Se ele ja
        -- pagou pelo nivel, o direito vira saldo no bolso, que e o que o
        -- livro manda.
        -- ---------------------------------------------------------------
        local NIVEIS_UPGRADE_HEMOCINESE = {5, 10, 15, 20}   -- so para Orcs
        local NIVEL_MAXIMO_PODER = 5

        function temHemocineseRacial()
            return temCaracRacial("Hemocinese")
        end

        -- A escada automatica e exclusiva dos Orcs. Vale para o mestico que
        -- tem Orc em qualquer um dos dois lados da heranca.
        function hemocineseComEscadaAutomatica()
            if sheet == nil then return false end
            if tostring(sheet.raca or "") == "Orcs" then return true end
            if tostring(sheet.mesticoRacaSecundaria or "") == "Orcs" then return true end
            return false
        end

        -- Quantos niveis do poder o personagem tem DE GRACA hoje.
        function direitoHemocinese()
            if sheet == nil or not temHemocineseRacial() then return 0 end
            local direito = 1                      -- "comecando com 1 ponto"
            if hemocineseComEscadaAutomatica() then
                local nivel = n(sheet.nivel)
                for _, marco in ipairs(NIVEIS_UPGRADE_HEMOCINESE) do
                    if nivel >= marco then direito = direito + 1 end
                end
            end
            if direito > NIVEL_MAXIMO_PODER then direito = NIVEL_MAXIMO_PODER end
            return direito
        end

        -- Origem gravada no registro do poder. NAO e uma divindade: e o que
        -- faz a linha da aba mostrar "HERANÇA RACIAL" em vez do selo do
        -- Coracao de Mana, que era o unico "sem divindade" que existia antes.
        local ORIGEM_HEMOCINESE = "Herança racial"

        function sincronizarHemocinese()
            if sheet == nil then return end
            local direito = direitoHemocinese()
            local lancado = n(sheet.hemocineseConcedidoLancado)

            sheet.hemocinesePontosGratis = direito

            -- Migracao das fichas da v0.32.0, que gravaram o poder com a
            -- origem vazia e por isso herdavam o selo do Coracao de Mana.
            -- Roda antes do atalho de "nada mudou", senao a ficha ja
            -- sincronizada nunca seria corrigida.
            do
                local lista = lerPoderes()
                local p = acharPoder(lista, "Hemocinese")
                if p ~= nil and tostring(p.deus or "") ~= ORIGEM_HEMOCINESE then
                    p.deus = ORIGEM_HEMOCINESE
                    gravarPoderes(lista)
                end
            end

            if direito == lancado then
                -- Nada mudou no direito, mas o poder pode ter sumido da lista
                -- (ficha migrada de versao anterior a esta). Garante presenca.
                if direito > 0 and nivelDoPoder("Hemocinese") <= 0 then
                    lancado = 0
                else
                    return
                end
            end

            local lista = lerPoderes()
            local p = acharPoder(lista, "Hemocinese")
            local atual = p and n(p.nivel) or 0
            local novo = atual + (direito - lancado)
            if novo < 0 then novo = 0 end
            if novo > NIVEL_MAXIMO_PODER then novo = NIVEL_MAXIMO_PODER end

            if p == nil then
                if novo > 0 then
                    table.insert(lista, {nome = "Hemocinese", nivel = novo,
                                         log = "concedido pela raça",
                                         deus = ORIGEM_HEMOCINESE})
                end
            else
                p.nivel = novo
                -- gravarPoderes descarta nivel 0, entao o poder sai sozinho
                -- da lista quando a raca deixa de conceder e o jogador nao
                -- tinha pago nada por cima.
            end

            gravarPoderes(lista)
            sheet.hemocineseConcedidoLancado = direito
        end

        -- ---------------------------------------------------------------
        -- MOTOR
        -- ---------------------------------------------------------------
        aplicandoConcessoes = false

        function aplicarConcessoes()
            if sheet == nil then return end
            -- as concessoes mexem em listas que disparam recalculos; a trava
            -- evita reentrada infinita
            if aplicandoConcessoes then return end
            aplicandoConcessoes = true

            local ok = pcall(function()
                sincronizarBonusAtributoDePoderes()

                local aplicadas = chavesConcedidas()
                local mudou = false

                for _, con in ipairs(CONCESSOES) do
                    -- pcall POR CONCESSAO: se uma falhar, as seguintes ainda
                    -- rodam. Com um pcall unico envolvendo o laco, um erro no
                    -- meio abortava tudo o que vinha depois.
                    pcall(function()
                        local ativa = fonteEstaAtiva(con.fonte)
                        if ativa and not aplicadas[con.chave] then
                            if aplicarEfeitoConcessao(con) then
                                aplicadas[con.chave] = true
                                mudou = true
                            end
                        elseif (not ativa) and aplicadas[con.chave] then
                            desfazerEfeitoConcessao(con)
                            aplicadas[con.chave] = nil
                            mudou = true
                        end
                    end)
                end

                if mudou then gravarChavesConcedidas(aplicadas) end
            end)

            aplicandoConcessoes = false
            return ok
        end

        -- ---------------------------------------------------------------
        -- ATRIBUTO FAVORECIDO PELA RACA
        --
        -- Racas que dao "+1 ponto de atributo a sua escolha" (hoje so a
        -- Versatilidade humana). O ponto vai para o BONUS do atributo
        -- escolhido, e aquele atributo passa a ter limite 10 no BASE, em vez
        -- do teto normal de 8.
        -- ---------------------------------------------------------------
        -- Caracteristicas que dao "+1 ponto de atributo A SUA ESCOLHA".
        -- So estas abrem o seletor. As demais racas ja definem QUAL atributo
        -- recebe o bonus (Anoes -> Constituicao, Elfos -> Destreza, etc.), e
        -- nesse caso o "favorecido" e fixo: nao ha o que escolher.
        local CARACS_ATRIBUTO_A_ESCOLHER = {"Versatilidade humana"}

        -- Recebe o nome da raca EM DETALHE no popup. Sem isso o seletor
        -- aparecia em todas as racas, porque a checagem olhava so a ficha.
        function racaPermiteEscolherAtributo(nomeRaca)
            local dados = CatalogoRacas.buscarPorNome(tostring(nomeRaca or ""))
            if dados == nil then return false end
            for _, car in ipairs(dados.caracteristicas or {}) do
                for _, alvo in ipairs(CARACS_ATRIBUTO_A_ESCOLHER) do
                    if tostring(car.nome or "") == alvo then return true end
                end
            end
            return false
        end

        function racaDaAtributoAEscolher()
            for _, alvo in ipairs(CARACS_ATRIBUTO_A_ESCOLHER) do
                if temCaracRacial(alvo) then return true end
            end
            return false
        end

        function escolherAtributoRacial(nomeAtributo)
            if sheet == nil then return end
            if not podeEditarCriacao() then return end
            if CAMPO_ATRIBUTO[nomeAtributo] == nil then return end
            local anterior = tostring(sheet.atributoRacialLancado or "")
            if anterior == nomeAtributo then return end

            -- A chave e limpa SEMPRE, e nao so quando ja havia escolha.
            -- Fichas vindas de versoes anteriores podem ter a concessao
            -- marcada como aplicada sem nada lancado; sem limpar, o motor
            -- pulava a aplicacao e o bonus nunca entrava no campo.
            local aplicadasAgora = chavesConcedidas()
            aplicadasAgora["hum_versatilidade"] = nil
            gravarChavesConcedidas(aplicadasAgora)

            -- tira o bonus do atributo anterior antes de lancar no novo
            if anterior ~= "" then
                local baseAnt = CAMPO_ATRIBUTO[anterior]
                if baseAnt ~= nil then
                    local v = n(sheet.atributoRacialValor)
                    if v == 0 then v = 1 end
                    local novo = n(sheet[baseAnt .. "Bonus"]) - v
                    if novo < 0 then novo = 0 end
                    sheet[baseAnt .. "Bonus"] = novo
                    -- zera tambem o teto: sem o bonus, o atributo volta a 8
                    sheet[baseAnt .. "TetoRacial"] = 0
                end
                sheet.atributoRacialLancado = ""
                sheet.atributoRacialValor = 0
            end

            sheet.atributoRacialEscolhido = nomeAtributo
            aplicarConcessoes()
            pcall(function() recalcularTudo() end)
            pcall(function() atualizarSeletorAtributoRacial() end)
        end

        function atualizarSeletorAtributoRacial()
            if self.popRaca_secAtributo == nil then return end
            -- Aparece somente quando a raca ABERTA NO POPUP e uma das que
            -- deixam escolher, e o personagem de fato a possui.
            local mostra = racaPermiteEscolherAtributo(detalheRacaAtual)
                and racaDaAtributoAEscolher()
            definirAlturaPod(self.popRaca_secAtributo, mostra and 116 or 0)
            if not mostra then return end
            local escolhido = tostring(sheet and sheet.atributoRacialEscolhido or "")
            for nomeAtr, base in pairs(CAMPO_ATRIBUTO) do
                local btn = self["popRaca_btnAtr" .. base]
                local lbl = self["popRaca_lblAtr" .. base]
                if btn ~= nil then
                    if nomeAtr == escolhido then
                        btn:setStrokeColor(COR.gold); btn:setStrokeSize(2)
                        if lbl ~= nil then lbl:setFontColor(COR.gold) end
                    else
                        btn:setStrokeColor(COR.line); btn:setStrokeSize(1)
                        if lbl ~= nil then lbl:setFontColor(COR.muted) end
                    end
                end
            end
            if self.popRaca_lblAtributoAtual ~= nil then
                if escolhido == "" then
                    self.popRaca_lblAtributoAtual:setText("Nenhum escolhido — o +1 de bônus só entra depois da escolha.")
                else
                    self.popRaca_lblAtributoAtual:setText(escolhido ..
                        ": +1 de bônus aplicado, e o limite do valor base sobe para 10.")
                end
            end
        end

        -- ---------------------------------------------------------------
        -- LIMITES DO VALOR BASE
        --
        -- O valor BASE de um atributo respeita dois tetos: o do nivel atual
        -- (4 no nivel 1, subindo ate 8 no 19) e o maximo absoluto de 8 - que
        -- vira 10 no atributo favorecido pela raca.
        -- O campo de BONUS nao tem teto: e justamente por onde raras, poderes
        -- e itens ultrapassam o limite.
        -- ---------------------------------------------------------------
        function limiteBaseDoAtributo(nomeAtributo)
            if sheet == nil then return 8 end
            local dados = DadosSistema.dadosDoNivel(n(sheet.nivel))
            local limite = 8
            if dados ~= nil and dados.limiteAtributo ~= nil then
                limite = n(dados.limiteAtributo)
            end
            -- REGRA DA MESA: o limite do NIVEL vale para TODOS os atributos,
            -- sem excecao - no nivel 7 nenhum passa de 5, tenha bonus racial
            -- ou nao. A progressao so chega a 8 no NIVEL 17, e dali em diante
            -- o teto racial (9 ou 10) passa a valer no atributo favorecido.
            if limite < 8 then return limite end

            local base = CAMPO_ATRIBUTO[nomeAtributo]
            if base == nil then return limite end
            local tetoRacial = n(sheet[base .. "TetoRacial"])
            if tetoRacial > limite then return tetoRacial end
            return limite
        end

        -- Corta o que passou do teto e devolve um aviso, se cortou algo.
        function aplicarLimitesDeAtributo()
            if sheet == nil then return "" end
            local cortados = {}
            -- percorre CAMPO_ATRIBUTO (local DESTE bloco) e nao
            -- ATRIBUTOS_DA_FICHA, que so e declarada mais abaixo no arquivo:
            -- uma local em Lua nao existe antes da linha em que aparece.
            for nomeAtr, campo in pairs(CAMPO_ATRIBUTO) do
                local limite = limiteBaseDoAtributo(nomeAtr)
                local atual = n(sheet[campo .. "Base"])
                if atual > limite then
                    sheet[campo .. "Base"] = limite
                    table.insert(cortados, nomeAtr .. " › " .. limite)
                end
            end
            if #cortados == 0 then return "" end
            return "Limite de atributo aplicado: " .. table.concat(cortados, ", ") ..
                ". O teto vale só para o valor base; bônus podem ultrapassar."
        end

        -- Texto para a aba: o que a ficha concedeu sozinho.
        function resumoConcessoes()
            local aplicadas = chavesConcedidas()
            local linhas = {}
            for _, con in ipairs(CONCESSOES) do
                if aplicadas[con.chave] then
                    local ef = con.efeito
                    local oque = ""
                    if ef.tipo == "qualidade" then oque = "qualidade " .. ef.nome
                    elseif ef.tipo == "defeito" then oque = "defeito " .. ef.nome
                    elseif ef.tipo == "pericia" then oque = "perícia " .. ef.nome
                    elseif ef.tipo == "periciaLivre" then oque = "+1 vaga de perícia de " .. ef.atributo
                    elseif ef.tipo == "periciaLivreGeral" then oque = "+1 vaga de perícia (livre)"
                    elseif ef.tipo == "pontoAtributo" then oque = "+" .. n(ef.valor) .. " ponto de atributo (à escolha)"
                    elseif ef.tipo == "atributoRacial" then
                        oque = "+" .. n(ef.valor) .. " de bônus em " ..
                            table.concat(ef.atributos or {}, " e ") .. " (teto " .. n(ef.teto) .. ")" end
                    table.insert(linhas, oque .. " (por " .. con.rotulo .. ")")
                end
            end
            return linhas
        end

        -- =================================================================
        -- ECONOMIA DE ATRIBUTOS E PERICIAS
        --
        -- Fonte: [2.3] Sistema e Evolucao do .bib.
        --   Nivel 1: 15 pontos de atributo e 6 pericias iniciais.
        --   +1 ponto de atributo nos niveis 2, 4, 6, 8, 11, 13, 15, 17 e 18
        --   (24 pontos no nivel 20; 18 no nivel 7).
        --   Pericias adicionais nos niveis 3(+1), 5(+2), 7(+1), 9(+1),
        --   12(+1), 14(+1), 16(+1) e 18(+2) - 16 no nivel 20.
        --
        -- O limite POR ATRIBUTO continua sendo a pontuacao do atributo
        -- ("nao e possivel ter mais pericias de um atributo do que pontos,
        -- salvo pericias que explicitamente ignorem o limite").
        -- =================================================================

        local ATRIBUTO_PONTOS_INICIAIS = 15
        local PERICIAS_INICIAIS = 6

        -- Conferido contra a tabela de níveis do livro, nível a nível.
        -- O nivel 4 estava faltando: no nivel 7 dava 17 em vez de 18.
        local GANHO_ATRIBUTO_POR_NIVEL = {
            [2]=1, [4]=1, [6]=1, [8]=1, [11]=1, [13]=1, [15]=1, [17]=1, [18]=1,
        }
        local GANHO_PERICIAS_POR_NIVEL = {
            [3]=1, [5]=2, [7]=1, [9]=1, [12]=1, [14]=1, [16]=1, [18]=2,
        }

        local ATRIBUTOS_DA_FICHA = {
            {nome = "Força", campo = "forca"},
            {nome = "Destreza", campo = "destreza"},
            {nome = "Constituição", campo = "constituicao"},
            {nome = "Inteligência", campo = "inteligencia"},
            {nome = "Sabedoria", campo = "sabedoria"},
            {nome = "Carisma", campo = "carisma"},
            {nome = "Manipulação", campo = "manipulacao"},
        }

        function pontosAtributoTotais()
            if sheet == nil then return ATRIBUTO_PONTOS_INICIAIS end
            local total = ATRIBUTO_PONTOS_INICIAIS
            for i = 1, math.min(math.max(n(sheet.nivel), 1), 20) do
                total = total + (GANHO_ATRIBUTO_POR_NIVEL[i] or 0)
            end
            -- Somente evolucao (mais o ajuste manual do mestre). O ponto que
            -- a raca da NAO entra aqui: ele vai para o campo de BONUS do
            -- atributo escolhido, e o bolso de evolucao segue 18 no nivel 7.
            return total + n(sheet.pontosAtributoAjuste)
        end

        -- Os pontos gastos sao a soma dos campos BASE. O campo de bonus fica
        -- de fora de proposito: bonus racial e de poder nao sai do bolso do
        -- jogador.
        function pontosAtributoGastos()
            if sheet == nil then return 0 end
            local total = 0
            for _, a in ipairs(ATRIBUTOS_DA_FICHA) do
                total = total + n(sheet[a.campo .. "Base"])
            end
            return total
        end

        -- Bonus que vieram de raca, poderes e afins (o campo "+" de cada
        -- atributo). Mostrado como EXTRAS, para o jogador ver que nao pagou.
        function pontosAtributoExtras()
            if sheet == nil then return 0 end
            local total = 0
            for _, a in ipairs(ATRIBUTOS_DA_FICHA) do
                total = total + n(sheet[a.campo .. "Bonus"])
            end
            return total
        end

        function periciasTotaisPermitidas()
            if sheet == nil then return PERICIAS_INICIAIS end
            local total = PERICIAS_INICIAIS
            for i = 1, math.min(math.max(n(sheet.nivel), 1), 20) do
                total = total + (GANHO_PERICIAS_POR_NIVEL[i] or 0)
            end
            -- So o que vem da EVOLUCAO (mais o ajuste manual do mestre). As
            -- vagas concedidas por raca/poder ficam em vagasPericiaConcedidas
            -- e sao somadas no painel - se entrassem aqui tambem, o total
            -- contaria as mesmas vagas duas vezes.
            return total + n(sheet.periciasAjuste)
        end

        function listasDePericias()
            return {
                {lista = "listaPericiasForca", campo = "forcaTotal", nome = "Força"},
                {lista = "listaPericiasDestreza", campo = "destrezaTotal", nome = "Destreza"},
                {lista = "listaPericiasConstituicao", campo = "constituicaoTotal", nome = "Constituição"},
                {lista = "listaPericiasInteligencia", campo = "inteligenciaTotal", nome = "Inteligência"},
                {lista = "listaPericiasSabedoria", campo = "sabedoriaTotal", nome = "Sabedoria"},
                {lista = "listaPericiasCarisma", campo = "carismaTotal", nome = "Carisma"},
                {lista = "listaPericiasManipulacao", campo = "manipulacaoTotal", nome = "Manipulação"},
            }
        end

        -- Quantas pericias o jogador realmente escolheu. As concedidas
        -- (origemConcessao preenchida) nao entram: sao de graca e, no caso da
        -- Seducao da Beleza sobrenatural, o livro diz que ignoram o limite.
        function periciasEscolhidas()
            if sheet == nil then return 0 end
            local total = 0
            for _, item in ipairs(listasDePericias()) do
                for _, p in ipairs(NDB.getChildNodes(sheet[item.lista]) or {}) do
                    if tostring(p.origemConcessao or "") == "" then
                        total = total + 1
                    end
                end
            end
            return total
        end

        function periciasConcedidas()
            if sheet == nil then return 0 end
            local total = 0
            for _, item in ipairs(listasDePericias()) do
                for _, p in ipairs(NDB.getChildNodes(sheet[item.lista]) or {}) do
                    if tostring(p.origemConcessao or "") ~= "" then
                        total = total + 1
                    end
                end
            end
            return total
        end

        -- Vagas extras concedidas por poderes ("uma pericia deste atributo a
        -- sua escolha"), somadas de todos os atributos.
        function vagasPericiaConcedidas()
            if sheet == nil then return 0 end
            local total = n(sheet.periciasBonusGeral)
            for _, a in ipairs(ATRIBUTOS_DA_FICHA) do
                total = total + n(sheet[a.campo .. "PericiasBonus"])
            end
            return total
        end

        -- ---------------------------------------------------------------
        -- BONUS DE DEFESA VINDOS DOS PODERES
        --
        -- Os quatro poderes de atributo somam +1 na defesa correspondente
        -- ao chegarem ao NIVEL 2 (levantado na progressao de cada um):
        --   Força sobrenatural      -> Defesa - Aparar
        --   Destreza sobrenatural   -> Defesa - Esquiva
        --   Carisma sobrenatural    -> Defesa empática
        --   Sabedoria sobrenatural  -> Defesa telepática
        -- "Escudo psíquico" tambem da +1 (nivel 3) e +2 (nivel 5), mas numa
        -- defesa A ESCOLHER - por isso vai num campo proprio, e nao aqui.
        -- ---------------------------------------------------------------
        local DEFESA_POR_PODER = {
            aparar     = {poder = "Força sobrenatural", nivel = 2, valor = 1},
            esquiva    = {poder = "Destreza sobrenatural", nivel = 2, valor = 1},
            empatica   = {poder = "Carisma sobrenatural", nivel = 2, valor = 1},
            telepatica = {poder = "Sabedoria sobrenatural", nivel = 2, valor = 1},
        }

        function bonusDefesaDePoder(qual)
            local d = DEFESA_POR_PODER[qual]
            if d == nil then return 0 end
            local ok, nivel = pcall(function() return nivelDoPoder(d.poder) end)
            if not ok or n(nivel) < d.nivel then return 0 end
            return d.valor
        end

        -- Escudo psiquico: +1 no nivel 3 e +2 no nivel 5, na defesa que o
        -- jogador escolher no campo da aba de Combate.
        function bonusEscudoPsiquico(qual)
            if sheet == nil then return 0 end
            if tostring(sheet.escudoPsiquicoDefesa or "") ~= qual then return 0 end
            local ok, nivel = pcall(function() return nivelDoPoder("Escudo psíquico") end)
            if not ok then return 0 end
            if n(nivel) >= 5 then return 2 end
            if n(nivel) >= 3 then return 1 end
            return 0
        end

        -- Drow, "Mente fechada": +2 na Defesa Mental. REGRA DA MESA: existem
        -- DUAS defesas mentais - Telepática e Empática - e o jogador escolhe
        -- em qual delas o bônus recai. A escolha fica no popup da raça.
        function bonusDefesaRacial(qual)
            if not temCaracRacial("Mente fechada") then return 0 end
            local escolhida = tostring(sheet and sheet.defesaMentalDrow or "")
            if escolhida == "" then return 0 end   -- sem escolha, nao aplica
            if escolhida == qual then return 2 end
            return 0
        end

        -- Racas que pedem escolha de defesa mental.
        function racaPermiteEscolherDefesa(nomeRaca)
            local dados = nil
            if CatalogoRacas ~= nil then
                local ok, res = pcall(function()
                    return CatalogoRacas.buscarPorNome(tostring(nomeRaca or ""))
                end)
                if ok then dados = res end
            end
            if dados == nil then return false end
            for _, car in ipairs(dados.caracteristicas or {}) do
                if tostring(car.nome or "") == "Mente fechada" then return true end
            end
            return false
        end

        function escolherDefesaMental(qual)
            if sheet == nil then return end
            if not podeEditarCriacao() then return end
            if qual ~= "telepatica" and qual ~= "empatica" then return end
            sheet.defesaMentalDrow = qual
            pcall(function() recalcularTudo() end)
            pcall(function() atualizarSeletorDefesaMental() end)
        end

        function atualizarSeletorDefesaMental()
            if self.popRaca_secDefesa == nil then return end
            local mostra = racaPermiteEscolherDefesa(detalheRacaAtual)
                and temCaracRacial("Mente fechada")
            definirAlturaPod(self.popRaca_secDefesa, mostra and 84 or 0)
            if not mostra then return end
            local escolhida = tostring(sheet and sheet.defesaMentalDrow or "")
            local mapa = {
                {chave = "telepatica", btn = self.popRaca_btnDefTele, lbl = self.popRaca_lblDefTele},
                {chave = "empatica", btn = self.popRaca_btnDefEmp, lbl = self.popRaca_lblDefEmp},
            }
            for _, m in ipairs(mapa) do
                if m.btn ~= nil then
                    if m.chave == escolhida then
                        m.btn:setStrokeColor(COR.gold); m.btn:setStrokeSize(2)
                        if m.lbl ~= nil then m.lbl:setFontColor(COR.gold) end
                    else
                        m.btn:setStrokeColor(COR.line); m.btn:setStrokeSize(1)
                        if m.lbl ~= nil then m.lbl:setFontColor(COR.muted) end
                    end
                end
            end
            if self.popRaca_lblDefesaAtual ~= nil then
                if escolhida == "" then
                    self.popRaca_lblDefesaAtual:setText("Nenhuma escolhida — o +2 só entra depois da escolha.")
                elseif escolhida == "telepatica" then
                    self.popRaca_lblDefesaAtual:setText("+2 aplicado na Defesa telepática.")
                else
                    self.popRaca_lblDefesaAtual:setText("+2 aplicado na Defesa empática.")
                end
            end
        end

        -- Efeitos PERMANENTES de subclasse que mexem em valores da ficha.
        -- Varredura das 36 subclasses (273 níveis descritos): só dois são
        -- permanentes e numéricos sobre campos calculados. Os demais são
        -- condicionais ("sempre que", "ao atacar") ou incidem em testes
        -- específicos, e ficam com o mestre.
        --   Espadachim/Samurai nível 4  -> +3 nas defesas mentais e empática
        --   Duelista/Passos de vento nível 2 -> deslocamento e corrida dobram
        function nivelDaSubclasse(nomeClasse, nomeSub)
            if sheet == nil then return 0 end
            for slot = 1, 2 do
                if tostring(sheet["classe" .. slot .. "Nome"] or "") == nomeClasse
                   and tostring(sheet["classe" .. slot .. "Sub"] or "") == nomeSub then
                    return n(sheet["classe" .. slot .. "Nivel"])
                end
            end
            return 0
        end

        function bonusDefesaSubclasse(qual)
            -- "defesas mentais e empáticas": as duas mentais da mesa sao a
            -- telepatica e a empatica.
            if qual ~= "telepatica" and qual ~= "empatica" then return 0 end
            if nivelDaSubclasse("Espadachim", "Samurai") >= 4 then return 3 end
            return 0
        end

        function deslocamentoDobrado()
            return nivelDaSubclasse("Duelista", "Passos de vento") >= 2
        end

        -- ---------------------------------------------------------------
        -- CATEGORIA DE TAMANHO
        --
        -- As seis categorias sao do livro (Sistema e Evolucao, "Categoria de
        -- Tamanho"). A ORDEM importa: o card anda de uma em uma, e ela vai do
        -- menor para o maior.
        --
        -- REGRA DA MESA (21/08/2026): o livro nao diz o tamanho de nenhuma
        -- raca — so cita doze delas como exemplo, e as outras dezessete
        -- ficariam em branco. Em vez de deduzir raca por raca, TODA ficha
        -- nasce MEDIO e o jogador ajusta durante a criacao. Depois de
        -- finalizada, so o mestre muda — mesma trava de raca e classe.
        --
        -- O campo e INDICATIVO: nenhum numero muda por causa dele. Alcance
        -- efetivo, bonus de ocultacao, espaco no grid e a diferenca de
        -- categoria entre oponentes ficam com a narrativa, por decisao da
        -- mesa. Se um dia forem automatizados, e aqui que a tabela entra.
        -- ---------------------------------------------------------------
        -- Recusas e avisos da aba de Combate. Toda recusa diz POR QUE e QUEM
        -- pode liberar — nunca só "não permitido".
        function avisarCombate(texto, cor)
            if self.cmb_lblAviso == nil then return end
            self.cmb_lblAviso:setText(tostring(texto or ""))
            self.cmb_lblAviso:setFontColor(cor or COR.muted)
        end

        local TAMANHOS = {"Minúsculo", "Pequeno", "Médio", "Grande", "Enorme", "Colossal"}
        local TAMANHO_PADRAO = "Médio"

        function tamanhoDoPersonagem()
            if sheet == nil then return TAMANHO_PADRAO end
            local t = tostring(sheet.tamanho or "")
            for _, v in ipairs(TAMANHOS) do
                if v == t then return t end
            end
            return TAMANHO_PADRAO      -- inclusive para ficha antiga, sem o campo
        end

        function indiceDoTamanho()
            local atual = tamanhoDoPersonagem()
            for i, v in ipairs(TAMANHOS) do
                if v == atual then return i end
            end
            return 3                   -- Médio
        end

        -- passo = -1 (menor) ou +1 (maior). Nao circula: parar no extremo
        -- avisa que chegou ao fim, e circular faria Colossal virar Minúsculo
        -- com um clique distraido.
        function mudarTamanho(passo)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarCombate("Tamanho é da CRIAÇÃO. Com a ficha finalizada, só o mestre muda.", COR.wine)
                return
            end
            local novo = indiceDoTamanho() + n(passo)
            if novo < 1 or novo > #TAMANHOS then
                avisarCombate("\"" .. TAMANHOS[indiceDoTamanho()] ..
                    "\" já é o " .. ((novo < 1) and "menor" or "maior") ..
                    " tamanho da tabela.", COR.muted)
                return
            end
            sheet.tamanho = TAMANHOS[novo]
            recalcularTudo()
        end

        -- ---------------------------------------------------------------
        -- FORMA ALTERNATIVA
        --
        -- Duas racas declaram o deslocamento em dois ESTADOS DO CORPO, e nao
        -- em modos de locomocao:
        --   Lobisomens  "12m (forma mortal) / 24m (forma bestial)"
        --   Ursaris     "8m (em pé) / 18m (postura Ursari)"
        --
        -- Isso nao e voo nem nado - e o mesmo deslocamento terrestre com o
        -- corpo em outro estado. Por isso vira um INTERRUPTOR, e nao um card
        -- proprio: os dois valores nunca valem ao mesmo tempo.
        --
        -- Transformar-se e acao de JOGO, nao de criacao: fica livre mesmo com
        -- a ficha finalizada. Travar isso obrigaria a chamar o mestre no meio
        -- do combate.
        --
        -- O interruptor so aparece para quem tem forma; ver ajustarGradeCombate.
        -- ---------------------------------------------------------------
        function temFormaAlternativa()
            if sheet == nil then return false end
            return n(sheet.deslocamentoBaseFormaAlt) > 0
                and tostring(sheet.formaAlternativaNome or "") ~= ""
        end

        function formaAlternativaAtiva()
            if sheet == nil or not temFormaAlternativa() then return false end
            return sheet.formaAlternativaLigada == true
        end

        function alternarFormaAlternativa()
            if sheet == nil or not temFormaAlternativa() then return end
            sheet.formaAlternativaLigada = not formaAlternativaAtiva()
            recalcularTudo()
        end

        -- ---------------------------------------------------------------
        -- FASE DA LUA  (v0.38.0)
        --
        -- Card com setas na linha de RECURSOS, so para lobisomens. A fase e
        -- do MUNDO, nao do personagem - por isso ela nao esta presa ao estado
        -- da ficha (criacao/finalizada): o mestre gira a lua quando a
        -- campanha vira a noite, com a ficha finalizada ou nao.
        --
        -- Os bonus numericos da fase (deslocamento, iniciativa, teto de
        -- absorcao) so ENTRAM nos calculos com a FORMA BESTIAL LIGADA. O
        -- texto da habilidade e explicito: "recebe o bônus especial
        -- dependendo da fase da lua maior NA PRIMEIRA TRANSFORMAÇÃO". Lua
        -- cheia sem estar transformado nao da nada.
        -- ---------------------------------------------------------------
        function personagemEhLobisomem()
            if sheet == nil then return false end
            local r = tostring(sheet.raca or "")
            if r == "Lobisomens" then return true end
            -- mestico: a raca secundaria tambem conta
            if tostring(sheet.mesticoRacaSecundaria or "") == "Lobisomens" then return true end
            return false
        end

        function faseLuaAtual()
            local nome = tostring(sheet and sheet.faseLua or "")
            local f = CatalogoProgressiva.faseLua(nome)
            if f ~= nil then return f end
            return CatalogoProgressiva.FASES_LUA[1]   -- padrao: Nova
        end

        -- Circula, ao contrario do tamanho do personagem: a lua e um ciclo,
        -- e depois do Eclipse vem a Nova de novo.
        function mudarFaseLua(passo)
            if sheet == nil then return end
            local lista = CatalogoProgressiva.FASES_LUA
            local i = CatalogoProgressiva.indiceDaFase(tostring(sheet.faseLua or ""))
            i = i + n(passo)
            if i < 1 then i = #lista end
            if i > #lista then i = 1 end
            sheet.faseLua = lista[i].nome
            recalcularTudo()
        end

        -- Bonus numericos que valem AGORA: soma do bloco do rank atual da(s)
        -- habilidade(s) racial(is) progressiva(s) com a fase da lua. Devolve
        -- tudo zerado quando a forma bestial esta desligada.
        -- Aceita true, "true" e 1 - ver o comentario dentro de
        -- bonusFormaBestial sobre por que a leitura e defensiva aqui.
        function ehVerdadeiro(v)
            return v == true or v == 1 or v == "true" or v == "1"
        end

        -- Existe alguma habilidade racial progressiva cadastrada? Usada so
        -- para o interruptor avisar que ha bonus esperando a transformacao.
        function temHabilidadeProgressiva()
            if sheet == nil then return false end
            for _, h in ipairs(NDB.getChildNodes(sheet.listaHabilidades) or {}) do
                if tostring(h.tipo or "") == "racial" and ehVerdadeiro(h.progressiva) then
                    return true
                end
            end
            return false
        end

        function bonusFormaBestial()
            local z = {vida = 0, absorcao = 0, defesas = 0, dadosDano = 0,
                       regen = 0, deslocamento = 0, iniciativa = 0,
                       tetoAbsorcao = 0, rank = "", fonte = ""}
            if sheet == nil or not formaAlternativaAtiva() then return z end

            local rank = tostring(DadosSistema.dadosDoNivel(n(sheet.nivel)).rank or "E")
            z.rank = rank

            for _, h in ipairs(NDB.getChildNodes(sheet.listaHabilidades) or {}) do
                -- Leitura DEFENSIVA do booleano. O NDB ja devolveu este
                -- campo de mais de uma forma ao longo do desenvolvimento, e
                -- um "true" que volta como texto ou como 1 faria a habilidade
                -- inteira ser ignorada sem erro nenhum.
                if tostring(h.tipo or "") == "racial" and ehVerdadeiro(h.progressiva) then
                    local bloco = tostring(h["efeitoRank" .. rank] or "")
                    local num = CatalogoProgressiva.lerBloco(bloco)
                    z.vida = z.vida + num.vida
                    z.absorcao = z.absorcao + num.absorcao
                    z.defesas = z.defesas + num.defesas
                    z.dadosDano = z.dadosDano + num.dadosDano
                    z.regen = z.regen + num.regen
                    if z.fonte == "" then z.fonte = tostring(h.nome or "") end
                end
            end

            if personagemEhLobisomem() then
                local f = faseLuaAtual()
                z.deslocamento = z.deslocamento + n(f.deslocamento)
                z.iniciativa = z.iniciativa + n(f.iniciativa)
                if n(f.tetoAbsorcao) > z.tetoAbsorcao then
                    z.tetoAbsorcao = n(f.tetoAbsorcao)
                end
            end
            return z
        end

        function atualizarCardLua()
            if sheet == nil then return end
            -- NAO MEXER NA LARGURA AQUI.
            --
            -- Quem dimensiona card da aba de Combate e ajustarGradeCombate(),
            -- que divide a linha entre os cards VISIVEIS - e
            -- cardVisivelCombate("Lua") ja devolve false para quem nao e
            -- lobisomem. A v0.38.0 forcava 196 nesta linha, e como esta funcao
            -- roda DEPOIS da grade, as duas brigavam: a cada clique na seta a
            -- linha inteira se desalinhava, e so voltava ao normal ao trocar
            -- de aba - que e quando a grade roda de novo por ultimo.
            --
            -- Regra que fica: largura de card e assunto de UMA funcao so. Aqui
            -- se escreve texto, nunca tamanho.
            if not personagemEhLobisomem() then return end

            local f = faseLuaAtual()
            if self.cmb_lblLua ~= nil then self.cmb_lblLua:setText(f.nome) end
            if self.cmb_contaLua ~= nil then
                -- A conta diz se o bonus esta VALENDO agora. Sem isso, lua
                -- cheia em forma mortal parece estar dando algo e nao esta.
                local partes = {}
                if n(f.deslocamento) > 0 then table.insert(partes, "+" .. n(f.deslocamento) .. "m") end
                if n(f.iniciativa) > 0 then table.insert(partes, "+" .. n(f.iniciativa) .. " inic.") end
                if n(f.tetoAbsorcao) > 0 then table.insert(partes, "absorção até " .. n(f.tetoAbsorcao) .. "%") end
                local resumo = (#partes > 0) and table.concat(partes, "  ·  ") or "efeito narrativo"
                if formaAlternativaAtiva() then
                    self.cmb_contaLua:setText(resumo .. "  ·  VALENDO")
                    self.cmb_contaLua:setFontColor(COR.gold)
                else
                    self.cmb_contaLua:setText(resumo .. "  ·  só transformado")
                    self.cmb_contaLua:setFontColor(COR.faint)
                end
            end
            if self.cmb_lblLuaEscala ~= nil then
                self.cmb_lblLuaEscala:setText(CatalogoProgressiva.indiceDaFase(f.nome) ..
                    " / " .. #CatalogoProgressiva.FASES_LUA)
            end
        end

        -- Altura zero, e nao setVisible: um elemento align="top" escondido e
        -- mostrado de novo vai para o topo da pilha (armadilhas-sdk.md).
        function atualizarInterruptorDeForma()
            local wrap = self.cmb_wrapForma
            if wrap == nil then return end
            local tem = temFormaAlternativa()
            pcall(function() wrap:setHeight(tem and 34 or 0) end)
            if not tem then return end

            local ligada = formaAlternativaAtiva()
            local nomeForma = tostring(sheet.formaAlternativaNome or "")
            local nomeBase = tostring(sheet.formaAlternativaRotuloBase or "")
            if nomeBase == "" then nomeBase = "forma normal" end

            -- O INTERRUPTOR DIZ O QUE ESTA APLICANDO.
            --
            -- Sem isto, "os ganhos nao estao contando" e indistinguivel de
            -- "eu esqueci de me transformar" - foi exatamente a duvida que a
            -- mesa levantou. Transformado, a linha lista o que entrou; em
            -- forma mortal, ela avisa que existe bonus esperando.
            local bb = bonusFormaBestial()
            local aplicados = {}
            if bb.vida ~= 0 then table.insert(aplicados, "+" .. bb.vida .. " vida") end
            if bb.absorcao ~= 0 then table.insert(aplicados, "+" .. bb.absorcao .. "% absorção") end
            if bb.defesas ~= 0 then table.insert(aplicados, "+" .. bb.defesas .. " defesas") end
            if bb.dadosDano ~= 0 then table.insert(aplicados, "+" .. bb.dadosDano .. " dados de dano") end
            if bb.regen ~= 0 then table.insert(aplicados, "regenera " .. bb.regen .. "/turno") end
            if bb.deslocamento ~= 0 then table.insert(aplicados, "+" .. bb.deslocamento .. "m") end
            if bb.iniciativa ~= 0 then table.insert(aplicados, "+" .. bb.iniciativa .. " iniciativa") end

            if self.cmb_lblForma ~= nil then
                if ligada then
                    local txt = "✦  EM " .. string.upper(nomeForma)
                    if #aplicados > 0 then
                        txt = txt .. "  ·  rank " .. bb.rank .. ": " ..
                            table.concat(aplicados, ", ")
                    else
                        txt = txt .. "  ·  nenhum número entrando — confira o bloco do rank na habilidade"
                    end
                    self.cmb_lblForma:setText(txt .. "  —  clique para voltar à " .. nomeBase)
                    self.cmb_lblForma:setFontColor(COR.gold)
                else
                    self.cmb_lblForma:setText("Em " .. nomeBase ..
                        "  —  clique para assumir a " .. nomeForma ..
                        (temHabilidadeProgressiva() and "  (há bônus de habilidade esperando a transformação)" or ""))
                    self.cmb_lblForma:setFontColor(COR.muted)
                end
            end
            if self.cmb_secForma ~= nil then
                self.cmb_secForma:setStrokeColor(ligada and COR.gold or COR.line)
                self.cmb_secForma:setStrokeSize(ligada and 2 or 1)
            end
        end

        -- ---------------------------------------------------------------
        -- ECONOMIA DE ACOES — as fontes que NAO vem do nivel
        --
        -- A base e a evolucao por nivel vivem em calculos.lua. Aqui ficam
        -- poder e classe. A lista abaixo e o resultado de uma varredura
        -- COMPLETA do livro e dos catalogos (poderes, classes, racas,
        -- qualidades, defeitos, itens): nao ha mais nenhuma fonte.
        -- A verificacao de empacotamento refaz essa varredura e falha se
        -- aparecer uma fonte nova que nao esteja aqui.
        --
        -- livre = true  -> soma no numero grande do card
        -- livre = false -> acao RESTRITA: aparece numa linha propria, com o
        --                  para-que-serve. Regra da mesa (21/08/2026): nao
        --                  inflar o numero que o jogador usa no turno.
        -- ---------------------------------------------------------------
        local ACOES_EXTRAS = {
            -- Poderes e Pericias / "Destreza sobrenatural"
            --   Nivel 1: "+1 no Atributo Destreza; Você recebe uma reação extra"
            --   Nivel 3: "+1 no Atributo Destreza; +1 Ação Bônus por Turno"
            --   Nivel 5: "+2 no Atributo Destreza; +1 Ação padrão por Turno"
            {tipo = "reacao", livre = true, poder = "Destreza sobrenatural",
             nivelPoder = 1, rotulo = "Destreza sobrenatural nível 1"},
            {tipo = "bonus", livre = true, poder = "Destreza sobrenatural",
             nivelPoder = 3, rotulo = "Destreza sobrenatural nível 3"},
            {tipo = "padrao", livre = true, poder = "Destreza sobrenatural",
             nivelPoder = 5, rotulo = "Destreza sobrenatural nível 5"},

            -- Classes e Tracos / Devoto / "Mártir", primeiro ponto de classe:
            --   "Você ganha uma 'Ação de Reação' na ficha; A partir do nível
            --    10 serão duas, que só podem ser usadas para receber um dano
            --    que acertaria um aliado a até 15 metros de você."
            --
            -- "a partir do nivel 10" e lido como nivel do PERSONAGEM: os
            -- pontos de classe do Martir vao so ate 8, entao nao pode ser
            -- nivel de classe. Marcado como leitura, nao como texto literal.
            {tipo = "reacao", livre = false, classe = "Devoto", sub = "Mártir",
             nivelSub = 1, rotulo = "Mártir ○",
             restricao = "só para receber um dano que acertaria um aliado a até 15 m"},
            {tipo = "reacao", livre = false, classe = "Devoto", sub = "Mártir",
             nivelSub = 1, nivelPersonagem = 10, rotulo = "Mártir ○ (nível 10)",
             restricao = "só para receber um dano que acertaria um aliado a até 15 m"},
        }

        -- Fontes CONDICIONAIS: nunca somam, porque dependem de uma situacao
        -- que a ficha nao tem como saber. Viram aviso embaixo do card.
        local ACOES_CONDICIONAIS = {
            {classe = "Arcanista", sub = "Mago de batalha", nivelSub = 4,
             texto = "Mago de batalha ○○○○: +1 Ação padrão e +1 Ação bônus enquanto estiver lutando em desvantagem numérica."},
            {classe = "Guerreiro", sub = "Combatente crítico", nivelSub = 3,
             texto = "Combatente crítico ○○○: +1 Ação padrão após um acerto crítico, gasta na hora."},
            {classe = "Atirador", sub = "Combatente crítico", nivelSub = 3,
             texto = "Combatente crítico ○○○: +1 Ação padrão após um acerto crítico, gasta na hora."},
            {classe = "Duelista", sub = "Combatente crítico", nivelSub = 3,
             texto = "Combatente crítico ○○○: +1 Ação padrão após um acerto crítico, gasta na hora."},
            -- A varredura de catalogos encontrou esta: e a UNICA fonte de acao
            -- de MOVIMENTO extra do sistema inteiro. A acao de movimento nao
            -- tem card ("por padrao todos tem uma acao de movimento", Sistema
            -- e Evolucao, e nada mais no livro a multiplica), entao ela vive
            -- aqui como lembrete em vez de virar um quarto contador.
            {classe = "Espadachim", sub = "Ninja", nivelSub = 3,
             texto = "Ninja ○○○: +1 Ação de movimento extra, para se mover depois de um ataque corpo a corpo."},
            -- "Ação de Ataque Extra por Turno" (Força sobrenatural, niveis 3 e
            -- 5) e o unico lugar do livro onde esse termo aparece, e ele nunca
            -- e definido. Decisao da mesa (21/08/2026): e MULTIATAQUE — mais um
            -- golpe dentro da mesma ação de ataque, e nao uma quarta ação.
            -- Por isso nao vira card nem soma: fica como lembrete.
            {poder = "Força sobrenatural", nivelPoder = 3,
             texto = "Força sobrenatural nível 3: +1 ataque extra por turno (mais um golpe dentro da sua ação de ataque, não uma ação a mais)."},
            {poder = "Força sobrenatural", nivelPoder = 5,
             texto = "Força sobrenatural nível 5: +1 ataque extra por turno (acumula com o do nível 3)."},
        }

        local function fonteDeAcaoAtiva(f)
            if sheet == nil then return false end
            if f.nivelPersonagem ~= nil and n(sheet.nivel) < n(f.nivelPersonagem) then
                return false
            end
            if f.poder ~= nil then
                return nivelDoPoder(f.poder) >= n(f.nivelPoder)
            end
            if f.classe ~= nil then
                return nivelDaSubclasse(f.classe, f.sub) >= n(f.nivelSub)
            end
            return false
        end

        -- Devolve, para um tipo de acao: quantas LIVRES, quantas RESTRITAS,
        -- e os textos de origem de cada grupo.
        function extrasDeAcao(tipo)
            local livres, restritas = 0, 0
            local fontesLivres, fontesRestritas = {}, {}
            for _, f in ipairs(ACOES_EXTRAS) do
                if f.tipo == tipo and fonteDeAcaoAtiva(f) then
                    if f.livre then
                        livres = livres + 1
                        table.insert(fontesLivres, f.rotulo)
                    else
                        restritas = restritas + 1
                        table.insert(fontesRestritas,
                            f.rotulo .. " — " .. tostring(f.restricao or ""))
                    end
                end
            end
            return livres, restritas, fontesLivres, fontesRestritas
        end

        function avisosDeAcaoCondicionais()
            local r = {}
            for _, f in ipairs(ACOES_CONDICIONAIS) do
                if fonteDeAcaoAtiva(f) then table.insert(r, f.texto) end
            end
            return r
        end

        function bonusTotalDefesa(qual)
            return bonusDefesaDePoder(qual) + bonusEscudoPsiquico(qual)
                + bonusDefesaRacial(qual) + bonusDefesaSubclasse(qual)
        end

        -- ---------------------------------------------------------------
        -- CALCULO DE ROLAGEM DE PERICIA
        --
        --   total = valor do atributo + proficiencia + extras do sistema
        --           + ajuste manual
        --
        -- "Extras do sistema" sao bonus que outras partes da ficha dao aquela
        -- pericia especifica - hoje as caracteristicas raciais que citam a
        -- pericia pelo nome e escalam com o nivel (ex.: Drow em "Animais",
        -- +1 ate o nivel 10 e +2 do 11 em diante).
        --
        -- O ajuste manual existe porque nem tudo cabe em regra fixa: um
        -- feitico que aumenta Percepcao por alguns turnos, um item, uma
        -- bencao do mestre. Automacao que prende o usuario e automacao ruim.
        -- ---------------------------------------------------------------

        -- {pericia, atributo, bonus ate o nivel 10, bonus do 11 em diante,
        --  fonte} - extraido das caracteristicas raciais do catalogo.
        -- Levantadas uma a uma no catalogo de racas e de qualidades. Todas
        -- seguem o mesmo desenho: um valor ate o nivel 10 e outro do 11 em
        -- diante.
        local BONUS_PERICIA_FONTE = {
            -- Drow
            {pericia = "Animais", atributo = "Carisma", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Mestres da domesticação"},
            -- Elfos. O campo "raca" esta aqui pelo mesmo motivo das Fadas e
            -- dos Centauros abaixo (M-04): sem ele, o que separava os tres
            -- homonimos era so o N maiusculo de "Natureza" — uma
            -- padronizacao de grafia daria Sobrevivencia a Fadas e Centauros.
            {pericia = "Natureza", atributo = "Inteligência", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Conexão com a Natureza", raca = "Elfos"},
            {pericia = "Sobrevivência", atributo = "Sabedoria", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Conexão com a Natureza", raca = "Elfos"},
            -- ATENCAO: "Conexão com a natureza" existe em Fadas E Centauros
            -- com valores DIFERENTES (+1/+2 contra +2/+4). Por isso estas
            -- entradas trazem o campo "raca": sem ele, um Centauro receberia
            -- o bonus mais fraco das Fadas.
            {pericia = "Natureza", atributo = "Inteligência", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Conexão com a natureza", raca = "Fadas"},
            {pericia = "Animais", atributo = "Carisma", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Conexão com a natureza", raca = "Fadas"},
            -- Centauros
            {pericia = "Natureza", atributo = "Inteligência", ate10 = 2, apos11 = 4,
             fonte = "caracRacial", nome = "Conexão com a natureza", raca = "Centauros"},
            {pericia = "Arcos", atributo = "Destreza", ate10 = 2, apos11 = 4,
             fonte = "caracRacial", nome = "Aptidão com arcos"},
            {pericia = "Bestas", atributo = "Destreza", ate10 = 2, apos11 = 4,
             fonte = "caracRacial", nome = "Aptidão com arcos"},
            -- Ursaris
            {pericia = "Intimidação", atributo = "Manipulação", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Rugido amedrontador"},
            {pericia = "Subjugar", atributo = "Força", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Rugido amedrontador"},
            -- Goblins
            {pericia = "Prestidigitação", atributo = "Destreza", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Maestria furtiva"},
            {pericia = "Furtividade", atributo = "Destreza", ate10 = 1, apos11 = 2,
             fonte = "caracRacial", nome = "Maestria furtiva"},
            -- Qualidade: o bonus e fixo em +2 (a vantagem do nivel 10 nao e
            -- numero, entao entra so como marcacao)
            {pericia = "Vontade", atributo = "Sabedoria", ate10 = 2, apos11 = 2,
             fonte = "qualidade", nome = "Vontade de ferro"},
        }

        -- Escolas de magia entre as quais a Linhagem de Unaris escolhe.
        CatalogoEscolasDeMagia = {
            {nome = "Encantamentos (magia/forja)", atributo = "Carisma"},
            {nome = "Transmutação (magia)", atributo = "Destreza"},
            {nome = "Evocação (magia)", atributo = "Inteligência"},
            {nome = "Invocação", atributo = "Manipulação"},
            {nome = "Clarividência (magia/oráculos)", atributo = "Sabedoria"},
        }

        function bonusSistemaDaPericia(atributo, nomePericia)
            if sheet == nil then return 0, "" end
            local total, fontes = 0, {}
            local nivel = n(sheet.nivel)

            for _, b in ipairs(BONUS_PERICIA_FONTE) do
                if b.pericia == nomePericia and b.atributo == atributo then
                    local ativo = false
                    if b.fonte == "caracRacial" then
                        ativo = temCaracRacial(b.nome)
                        -- entradas com "raca" so valem naquela raca (ver o
                        -- caso de "Conexão com a natureza")
                        if ativo and b.raca ~= nil then
                            ativo = (tostring(sheet.raca or "") == b.raca)
                        end
                    elseif b.fonte == "qualidade" then
                        ativo = temQualidadeNaFicha(b.nome)
                    end
                    if ativo then
                        local v = (nivel >= 11) and b.apos11 or b.ate10
                        total = total + v
                        table.insert(fontes, b.nome .. " +" .. v)
                    end
                end
            end

            -- [Magia inata], da Linhagem de Unaris: +1 em testes de magia ate
            -- o nivel 10 e +2 do 11 em diante. Vale em TODAS as pericias
            -- magicas, nao em uma so - o texto diz "testes de magia".
            -- (A escolha de UMA escola, no popup da qualidade, e outra coisa:
            -- da VANTAGEM nos dados, tratada em periciaComVantagem.)
            if temQualidadeNaFicha("Linhagem de Unaris") and periciaEhMagica(nomePericia) then
                local v = (nivel >= 11) and 2 or 1
                total = total + v
                table.insert(fontes, "Magia inata +" .. v)
            end
            -- [Magia inata] dos ELFOS ([1.6]): mesmo texto, outra fonte. So
            -- entra se o elfo ESCOLHEU esta alternativa (B-04); ate a
            -- v0.41.1 o elfo nunca recebia, e a Conexao entrava sem escolha.
            if temCaracRacial("Magia inata") and periciaEhMagica(nomePericia) then
                local v = (nivel >= 11) and 2 or 1
                total = total + v
                table.insert(fontes, "Magia inata (Elfos) +" .. v)
            end

            return total, table.concat(fontes, ", ")
        end

        function periciaEhMagica(nomePericia)
            for _, esc in ipairs(CatalogoEscolasDeMagia) do
                if esc.nome == nomePericia then return true end
            end
            return false
        end

        -- A escola escolhida no popup da qualidade rola com VANTAGEM. Isso
        -- nao e um numero somavel, entao a linha da pericia apenas marca.
        function periciaComVantagem(nomePericia)
            if sheet == nil then return false end
            -- Vontade de ferro: a partir do nivel 10 a pericia "Vontade"
            -- passa a ser rolada com vantagem.
            if nomePericia == "Vontade" and n(sheet.nivel) >= 10
               and temQualidadeNaFicha("Vontade de ferro") then
                return true
            end
            if not temQualidadeNaFicha("Linhagem de Unaris") then return false end
            return tostring(sheet.periciaMagiaEscolhida or "") == nomePericia
        end

        -- Aviso para a aba: a qualidade existe mas a escola com vantagem
        -- ainda nao foi escolhida.
        function pendenciaEscolaDeMagia()
            if sheet == nil then return "" end
            if not temQualidadeNaFicha("Linhagem de Unaris") then return "" end
            if tostring(sheet.periciaMagiaEscolhida or "") ~= "" then return "" end
            return "Linhagem de Unaris: escolha logo abaixo em qual escola de magia você rola com VANTAGEM (livro [2.2])."
        end

        -- A ESCOLHA DA ESCOLA (v0.42.1, B-02). E escolha de CRIACAO: com a
        -- ficha finalizada so o mestre troca. Grava a pericia (o nome da
        -- escola E o nome da pericia magica) e recalcula: periciaComVantagem
        -- e pendenciaEscolaDeMagia ja liam este campo desde a v0.3x.
        function escolherEscolaDeMagia(nomeEscola)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                if self.abaAtr_lblNota ~= nil then
                    self.abaAtr_lblNota:setText(motivoTravaCriacao())
                    self.abaAtr_lblNota:setFontColor(COR.wine)
                end
                return
            end
            if not periciaEhMagica(nomeEscola) then return end
            if tostring(sheet.periciaMagiaEscolhida or "") == nomeEscola then
                sheet.periciaMagiaEscolhida = ""   -- clicar de novo desfaz
            else
                sheet.periciaMagiaEscolhida = nomeEscola
            end
            recalcularTudo()
        end

        function atualizarSeletorEscola()
            if self.abaAtr_wrapEscola == nil then return end
            local tem = sheet ~= nil and temQualidadeNaFicha("Linhagem de Unaris")
            pcall(function() self.abaAtr_wrapEscola:setHeight(tem and 44 or 0) end)
            if not tem then return end
            local escolhida = tostring(sheet.periciaMagiaEscolhida or "")
            if self.abaAtr_lblEscolaTit ~= nil then
                if escolhida == "" then
                    self.abaAtr_lblEscolaTit:setText("LINHAGEM DE UNARIS — vantagem em qual escola?")
                else
                    self.abaAtr_lblEscolaTit:setText("LINHAGEM DE UNARIS — vantagem em " .. escolhida)
                end
            end
            for i, esc in ipairs(CatalogoEscolasDeMagia) do
                local btn = self["abaAtr_btnEscola" .. i]
                local lbl = self["abaAtr_lblEscola" .. i]
                local marcada = (esc.nome == escolhida)
                if btn ~= nil then
                    btn:setStrokeColor(marcada and COR.gold or COR.line)
                    btn:setStrokeSize(marcada and 2 or 1)
                end
                if lbl ~= nil then lbl:setFontColor(marcada and COR.gold or COR.muted) end
            end
        end

        function campoBaseDoAtributo(atributo)
            for _, a in ipairs(ATRIBUTOS_DA_FICHA) do
                if a.nome == atributo then return a.campo end
            end
            return nil
        end

        -- Devolve total e as parcelas, para a linha da pericia poder abrir a
        -- conta em vez de mostrar um numero solto.
        -- TESTE DE PERICIA E ROLAGEM, entao ele le o total DE ROLAGEM.
        --
        -- Pedido na tela em 06/09/2026: com Ferido, a linha da pericia dizia
        -- "atributo 1 - prof +3" e somava +4, ignorando a penalidade. O
        -- mestre ofereceu duas saidas: usar o atributo penalizado, ou dar a
        -- pericia uma terceira coluna de automacao como a do atributo.
        --
        -- A primeira, e por uma razao e nao por ser menor: a pericia JA
        -- DERIVA do atributo. Uma coluna propria seria um segundo lugar de
        -- onde a mesma penalidade poderia vir, e "uma propriedade, um dono" e
        -- justamente o que impede o dia em que as duas se somam. Lendo o
        -- total de rolagem, a penalidade chega uma vez so e a linha mostra de
        -- onde ela veio: "atributo -1 - prof +3" com total +2.
        --
        -- Quem NAO e rolagem continua no total limpo: valorDoAtributo(), que
        -- serve ao requisito de item e a capacidade da mochila.
        function calculoDaPericia(atributo, nomePericia, ajusteManual)
            local campo = campoBaseDoAtributo(atributo)
            local valorAtributo = 0
            if campo ~= nil and sheet ~= nil then
                valorAtributo = n(sheet[campo .. "TotalRolagem"])
            end
            local prof = 0
            if sheet ~= nil then
                local dados = DadosSistema.dadosDoNivel(n(sheet.nivel))
                if dados ~= nil then prof = n(dados.prof) end
            end
            local extras, textoExtras = bonusSistemaDaPericia(atributo, nomePericia)
            -- acessorios equipados que bonificam uma pericia especifica
            local okItem, bItem = pcall(function() return bonusItemPericia(nomePericia) end)
            if okItem and n(bItem) ~= 0 then
                extras = extras + n(bItem)
                if textoExtras ~= "" then textoExtras = textoExtras .. ", " end
                textoExtras = textoExtras .. "item +" .. n(bItem)
            end
            local manual = n(ajusteManual)
            local total = valorAtributo + prof + extras + manual
            return total, valorAtributo, prof, extras, manual, textoExtras
        end

        -- ---------------------------------------------------------------
        -- PAINEL DO TOPO DA ABA
        -- ---------------------------------------------------------------
        function atualizarPainelAtributosPericias()
            if sheet == nil then return end

            local totalAtr = pontosAtributoTotais()
            local gastosAtr = pontosAtributoGastos()
            local extrasAtr = pontosAtributoExtras()
            local saldoAtr = totalAtr - gastosAtr

            if self.abaAtr_lblPontosTotal ~= nil then
                self.abaAtr_lblPontosTotal:setText(tostring(totalAtr))
            end
            if self.abaAtr_lblPontosGastos ~= nil then
                self.abaAtr_lblPontosGastos:setText(tostring(gastosAtr))
            end
            if self.abaAtr_lblPontosSaldo ~= nil then
                self.abaAtr_lblPontosSaldo:setText(tostring(saldoAtr))
                if saldoAtr < 0 then
                    self.abaAtr_lblPontosSaldo:setFontColor(COR.wine)
                elseif saldoAtr > 0 then
                    self.abaAtr_lblPontosSaldo:setFontColor(COR.gold)
                else
                    self.abaAtr_lblPontosSaldo:setFontColor(COR.muted)
                end
            end
            if self.abaAtr_lblPontosExtras ~= nil then
                self.abaAtr_lblPontosExtras:setText(tostring(extrasAtr))
                if extrasAtr > 0 then
                    self.abaAtr_lblPontosExtras:setFontColor(COR.moss)
                else
                    self.abaAtr_lblPontosExtras:setFontColor(COR.faint)
                end
            end

            local totalPer = periciasTotaisPermitidas()
            local usadasPer = periciasEscolhidas()
            local concedidasPer = periciasConcedidas()
            local vagasPer = vagasPericiaConcedidas()

            if self.abaAtr_lblPerTotal ~= nil then
                self.abaAtr_lblPerTotal:setText(tostring(totalPer + vagasPer))
            end
            if self.abaAtr_lblPerUsadas ~= nil then
                self.abaAtr_lblPerUsadas:setText(tostring(usadasPer))
            end
            if self.abaAtr_lblPerSaldo ~= nil then
                local saldoPer = totalPer + vagasPer - usadasPer
                self.abaAtr_lblPerSaldo:setText(tostring(saldoPer))
                if saldoPer < 0 then
                    self.abaAtr_lblPerSaldo:setFontColor(COR.wine)
                elseif saldoPer > 0 then
                    self.abaAtr_lblPerSaldo:setFontColor(COR.gold)
                else
                    self.abaAtr_lblPerSaldo:setFontColor(COR.muted)
                end
            end
            if self.abaAtr_lblPerExtras ~= nil then
                self.abaAtr_lblPerExtras:setText(tostring(concedidasPer + vagasPer))
                if (concedidasPer + vagasPer) > 0 then
                    self.abaAtr_lblPerExtras:setFontColor(COR.moss)
                else
                    self.abaAtr_lblPerExtras:setFontColor(COR.faint)
                end
            end

            if self.abaAtr_lblNota ~= nil then
                local prof = 0
                local dados = DadosSistema.dadosDoNivel(n(sheet.nivel))
                if dados ~= nil then prof = n(dados.prof) end
                local partes = {}
                table.insert(partes, "Proficiência do nível " .. n(sheet.nivel) .. ": +" .. prof)
                table.insert(partes, "cada atributo limita quantas perícias dele você pode ter")
                if concedidasPer > 0 then
                    table.insert(partes, concedidasPer .. " perícia(s) concedida(s) não ocupam vaga")
                end
                local pend = pendenciaEscolaDeMagia()
                if pend ~= "" then
                    self.abaAtr_lblNota:setText(pend)
                    self.abaAtr_lblNota:setFontColor(COR.gold)
                else
                    self.abaAtr_lblNota:setText(table.concat(partes, "   ·   "))
                    self.abaAtr_lblNota:setFontColor(COR.faint)
                end
            end
            pcall(function() atualizarSeletorEscola() end)
        end

        -- =================================================================
        -- ABA CALCULOS & COMBATE - renderizacao
        --
        -- Nenhum numero e digitado aqui: todos vem das outras secoes. Cada
        -- card mostra a CONTA embaixo do valor, para o jogador conferir de
        -- onde saiu - e cada um tem um campo de ajuste para o que o sistema
        -- nao cobre.
        -- =================================================================

        -- ---------------------------------------------------------------
        -- GRADE DA ABA DE COMBATE
        --
        -- Os cards de cada linha dividem a largura disponivel em partes
        -- iguais. Sem isso, largura fixa deixava um vao a direita em tela
        -- larga e apertava em tela estreita.
        -- Cards ocultos (Mana sem Coração de mana, Prana sem bruxa, Vitae sem
        -- vampiro) ficam com largura 0 e nao entram na divisao - os visiveis
        -- se espalham para ocupar a linha inteira.
        --
        -- Roda no onResize do scrollBox e ao fim de cada recalculo.
        -- ---------------------------------------------------------------
        local GRADE_COMBATE = {
            {linha = "cmb_linhaRecursos",  cards = {"Hp", "Ap", "Mp", "Prana", "Pv", "Sangue", "Descanso", "Lua"}},
            {linha = "cmb_linhaDefesas",   cards = {"DefAparar", "DefEsquiva", "DefEmpatica", "DefTelepatica", "Ferido"}},
            -- MOVIMENTO tem uma linha só para ele. Voo e nado sao FIXOS: uma
            -- raça que não voa mostra "—" e o campo de ajuste continua ali,
            -- para o mestre conceder voo por outra via. "Montado" é o único
            -- condicional da linha, porque depende de haver montaria montada.
            {linha = "cmb_linhaMovimento", cards = {"Deslocamento", "Corrida", "Voo", "Nado", "Escalada", "Montado"}},
            -- Tamanho, iniciativa e proficiência saíram da linha de movimento:
            -- nenhum dos três é deslocamento, e misturados ali empurravam voo
            -- e nado para fora da tela.
            -- (CARDS_DE_TEXTO, logo abaixo da tabela, marca quais mostram
            --  palavra em vez de numero)
            {linha = "cmb_linhaPerfil",    cards = {"Tamanho", "Iniciativa", "Prof"}},
            {linha = "cmb_linhaAcoes",     cards = {"AcoesPadrao", "AcoesBonus", "AcoesReacao", "Inspiracao", "Mochila"}},
        }

        -- Cards cujo valor e uma PALAVRA. A escala de fonte do card e feita
        -- para numeros de ate tres digitos; "Minúsculo" no mesmo corpo
        -- transborda a caixa.
        local CARDS_DE_TEXTO = {Tamanho = true, Lua = true, Ferido = true,
                        Hp = true, Ap = true, Mp = true, Prana = true, Pv = true}

        -- quais cards estao ativos para este personagem
        --
        -- DECISAO DO MESTRE (22/08/2026) - vampira que TAMBEM tem "Linhagem
        -- de Unaris" (a "vampibruxa"): existe UMA reserva so, o VITAE, e o
        -- Prana entra DENTRO dele como parcela. O card de Prana some.
        --
        -- POR QUE. Tutorial de Ficha, "Pontos de mana": na Linhagem de
        -- Unaris "os Pontos de mana e Pontos de aura serao fundidos em uma
        -- coisa so". Tutorial, "Pontos de vitae": o vampiro usa o Vitae
        -- "no lugar da Aura e da Mana" - isto e, no lugar exatamente dessa
        -- reserva fundida. Duas barras lado a lado dariam a ela duas
        -- reservas gastaveis, que e o que o "no lugar de" proibe.
        --
        -- HISTORICO DESTA LINHA - vale ler antes de mexer nela de novo:
        -- ate a v0.31.3 ela devolvia "ehBruxa and nao-vampiro", e eu tratei
        -- isso como bug de visibilidade na v0.32.0, liberando o card. O
        -- esconder estava CERTO; o que estava errado era Calculos.pv, que
        -- ignorava o Prana. Consertei o sintoma e deixei a causa. Agora o
        -- Prana volta a ficar oculto para vampira - mas desta vez o numero
        -- dele esta dentro do Vitae, e a conta embaixo do card mostra a
        -- parcela.
        function cardVisivelCombate(nome)
            if sheet == nil then return true end
            if nome == "Mp" then
                return sheet.temCoracaoDeMana == true and sheet.ehVampiro ~= true
            elseif nome == "Prana" then
                return personagemEhBruxa() and sheet.ehVampiro ~= true
            elseif nome == "Pv" then
                return sheet.ehVampiro == true
            elseif nome == "Sangue" then
                -- Cada 50ml = 1 ponto de Vitae ([1.6], [Sede de sangue]).
                -- So o vampiro recupera assim, entao so ele ve o card.
                return sheet.ehVampiro == true
            elseif nome == "Hp" then
                -- DECISAO DA MESA, 06/09/2026: "retira o campo de vida dos
                -- vampiros, deixa so vitae". Para o vampiro o Vitae E a
                -- vida, e as duas barras lado a lado diziam que ele tinha
                -- duas coisas para gastar.
                --
                -- sheet.hp CONTINUA sendo calculado de proposito: e o que
                -- faz a barra voltar certa no instante em que a raca deixa
                -- de ser Vampiros, sem migracao nenhuma. O numero fica
                -- invisivel e nao alimenta nada enquanto durar a vampirice
                -- - o que e aceitavel porque nenhuma outra rotina o le
                -- (medido em 06/09/2026: tres sitios, todos aqui).
                return sheet.ehVampiro ~= true
            elseif nome == "Ap" then
                return sheet.ehVampiro ~= true
            elseif nome == "Lua" then
                -- Fase da lua: so lobisomem tem ciclo lunar na ficha.
                return personagemEhLobisomem()
            elseif nome == "Montado" then
                -- só enquanto existe uma montaria montada na aba Criaturas
                return montariaMontada() ~= nil
            end
            -- Voo e Nado sao FIXOS (decisao da mesa, 21/08/2026): aparecem
            -- para todo mundo. Quem nao tem o modo ve "—" e continua com o
            -- campo de ajuste do lado, que e por onde o mestre concede voo
            -- vindo de poder, transformacao ou item.
            return true
        end

        function ajustarGradeCombate()
            if self.cmb_linhaRecursos == nil then return end
            -- A largura util e medida uma vez por passada, na melhor fonte
            -- disponivel. Na PRIMEIRA montagem as linhas ainda nao tem
            -- largura (retornam 0 ou um valor minusculo), e usar esse numero
            -- espremia todos os cards - so ao mexer em algo, com o layout ja
            -- desenhado, eles se abriam. Por isso caimos para o scrollBox e
            -- depois para o painel, que ja existem nesse momento.
            local disponivel = 0
            local function medir(ctrl, desconto)
                if disponivel > 0 or ctrl == nil then return end
                pcall(function()
                    local v = ctrl.width
                    if type(v) == "number" and v > 320 then disponivel = v - (desconto or 0) end
                end)
            end
            medir(self.cmb_linhaRecursos, 0)
            medir(self.cmb_scroll, 0)
            medir(self.pnlAba3, 36)      -- margens laterais do scrollBox
            if disponivel <= 0 then disponivel = 1180 end

            -- MEDIDA VELHA E PIOR QUE MEDIDA NENHUMA (v0.42.1, T-01). Os
            -- tres widgets acima sao da propria aba de Combate: enquanto ela
            -- esta escondida, eles guardam a geometria da ULTIMA vez em que
            -- foram desenhados. Redimensionar a janela em outra aba e entrar
            -- aqui dava cards de 430px (a janela de 1920) numa janela de
            -- 1366: o quarto card ficava fora da tela, sem erro, e "se
            -- consertava" ao trocar de aba e voltar. A rede de seguranca so
            -- cobria medida ZERO; medida positiva e velha passava direto.
            --
            -- A barra de abas esta SEMPRE visivel, entao a largura dela e a
            -- da janela de agora (margens 12+12). O scrollBox desconta 18+18
            -- de margem e ~18 da barra de rolagem: a linha util e a barra
            -- menos ~30. Se a medida da aba discordar disso por mais que a
            -- folga de uma barra de rolagem, ela e velha, e a barra manda.
            pcall(function()
                local barra = self.layBarraAbas and self.layBarraAbas.width
                if type(barra) == "number" and barra > 320 then
                    local pelaBarra = barra - 30
                    if math.abs(disponivel - pelaBarra) > 60 then
                        disponivel = pelaBarra
                    end
                end
            end)

            for _, grupo in ipairs(GRADE_COMBATE) do
                local total = disponivel

                local visiveis = {}
                for _, nome in ipairs(grupo.cards) do
                    if cardVisivelCombate(nome) then table.insert(visiveis, nome) end
                end
                local qtd = #visiveis
                if qtd > 0 then
                    -- Divisao pura pela quantidade visivel. NAO se impoe um
                    -- minimo alto aqui: com 5 cards, um minimo de 150 exigiria
                    -- 750px de linha, e em tela menor o ultimo card seria
                    -- empurrado para fora. O piso baixo existe so para o card
                    -- nao sumir de vez.
                    local largura = math.floor(total / qtd)
                    if largura < 96 then largura = 96 end
                    -- Fonte do valor proporcional a largura: em card estreito
                    -- um numero de 3 digitos em corpo 27 nao caberia.
                    local corpo = 27
                    if largura < 130 then corpo = 18
                    elseif largura < 165 then corpo = 21
                    elseif largura < 200 then corpo = 24 end

                    -- Cards cujo valor e PALAVRA, e nao numero: "Minúsculo"
                    -- em corpo 24 nao cabe onde "24m" cabe folgado. Recebem
                    -- uma escala propria, mais baixa.
                    local corpoTexto = corpo - 6
                    if corpoTexto < 12 then corpoTexto = 12 end

                    for _, nome in ipairs(grupo.cards) do
                        local w = 0
                        if cardVisivelCombate(nome) then w = largura end
                        pcall(function() self["cmb_wrap" .. nome]:setWidth(w) end)
                        local tamanhoFonte = CARDS_DE_TEXTO[nome] and corpoTexto or corpo
                        pcall(function() self["cmb_lbl" .. nome]:setFontSize(tamanhoFonte) end)
                        -- nos cinco cards de recurso o numero e um <edit> ao
                        -- lado do rotulo: os dois precisam do MESMO corpo, ou
                        -- a linha sai com duas alturas de texto
                        pcall(function()
                            local ed = self["cmb_edAtual" .. nome]
                            if ed ~= nil then ed:setFontSize(tamanhoFonte) end
                        end)
                    end
                end
            end
        end

        -- ---------------------------------------------------------------
        -- QUEM TEM CADA BARRA
        --
        -- Nada disso e marcado a mao: sai do que ja esta na ficha.
        --   Mana  -> qualidade "Coração de mana"
        --   Prana -> qualidade "Linhagem de Unaris" (bruxa)
        --   Vitae -> raça Vampiros, ou "Sede de sangue" herdada por mestiço
        -- Os campos temCoracaoDeMana e ehVampiro continuam existindo porque
        -- os calculos leem deles; passaram a ser ESCRITOS pela deteccao, e
        -- nao por caixas de marcar.
        -- ---------------------------------------------------------------
        function temCoracaoDeManaAuto()
            if sheet == nil then return false end
            if temQualidadeNaFicha("Coração de mana") then return true end
            -- toda bruxa e maga por definicao
            if temQualidadeNaFicha("Linhagem de Unaris") then return true end
            return false
        end

        function ehVampiroAuto()
            if sheet == nil then return false end
            if tostring(sheet.raca or "") == "Vampiros" then return true end
            return temCaracRacial("Sede de sangue")
        end

        function sincronizarMarcadoresDeEnergia()
            if sheet == nil then return end
            sheet.temCoracaoDeMana = temCoracaoDeManaAuto()
            sheet.ehVampiro = ehVampiroAuto()
        end

        function escolherDefesaEscudo(qual)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local validas = {aparar = true, esquiva = true, empatica = true, telepatica = true}
            if not validas[qual] then return end
            sheet.escudoPsiquicoDefesa = qual
            recalcularTudo()
        end

        local ROTULO_DEFESA = {
            aparar = "Aparar", esquiva = "Esquiva",
            empatica = "Empática", telepatica = "Telepática",
        }

        local function porTexto(nome, texto)
            local lbl = self["cmb_conta" .. nome]
            if lbl ~= nil then lbl:setText(tostring(texto or "")) end
        end

        local function porValor(nome, valor)
            local lbl = self["cmb_lbl" .. nome]
            if lbl ~= nil then lbl:setText(tostring(valor)) end
        end

        -- O card de recurso mostra ATUAL / MAXIMO (decisao da mesa,
        -- 06/09/2026). O atual vem primeiro porque e o numero que a mesa
        -- olha durante a sessao; o maximo fica do lado para dar a escala.
        --
        -- Estes cinco entram em CARDS_DE_TEXTO: "10 / 25" e mais largo que
        -- tres digitos, e a escala de fonte grande estoura a caixa. Nao e
        -- decoracao — e a mesma razao pela qual "Minusculo" ja estava la.
        -- O card de recurso mostra ATUAL / MAXIMO, e o ATUAL e o campo
        -- EDITAVEL da linha grande (mesa, 06/09/2026: "o campo de vida atual
        -- deveria ser o editavel"). O <edit> se pinta sozinho pelo field=;
        -- o que a ficha escreve aqui e so a metade direita.
        --
        -- E a fonte do rotulo acompanha a do campo: a escala dinamica mexe no
        -- rotulo, e sem isto o "/ 25" mudaria de corpo e o numero ao lado
        -- nao, deixando os dois de tamanhos diferentes na mesma linha.
        local function porRecurso(nome, chave)
            porValor(nome, "/ " .. n(sheet[chave]))
        end

        -- Os dois so existem para o card MONTADO, que e o unico com titulo
        -- variavel e com uma segunda linha de conta. Os outros cards tem
        -- titulo fixo no XML e uma linha so.
        local function porTituloMontado(texto)
            if self.cmb_tituloMontado ~= nil then
                self.cmb_tituloMontado:setText(tostring(texto or "MONTADO"))
            end
        end

        local function porModosMontado(texto)
            if self.cmb_modosMontado ~= nil then
                self.cmb_modosMontado:setText(tostring(texto or ""))
            end
        end

        function atualizarAbaCombate()
            if sheet == nil then return end
            local nivel = n(sheet.nivel)
            local dados = DadosSistema.dadosDoNivel(nivel)
            local rank = dados and dados.rank or "E"
            local prof = dados and n(dados.prof) or 0
            local rankNum = DadosSistema.ordemRank[rank] or 1

            local ehBruxa = temQualidadeNaFicha("Linhagem de Unaris")
            local ehVampiroSangue = temCaracRacial("Sede de sangue")

            -- ---------- RECURSOS ----------
            -- As CONTAS vem prontas de recalcularTudo(), montadas junto do
            -- valor e com as mesmas parcelas (v0.42.1). Aqui so se copia.
            porRecurso("Hp", "hp")
            porTexto("Hp", CONTAS.Hp)

            -- SANGUE BEBIDO. Livro, Racas/Vampiros [1.6], "[Sede de sangue]":
            -- "Cada 50ml recupera 1 ponto de Vitae."
            --
            -- Divisao INTEIRA, e nao proporcional: o livro escreve "cada
            -- 50ml", que e degrau. 149 ml sao 2 pontos, nao 2,98 - e por
            -- isso a conta usa parenteses, que na gramatica das contas
            -- desta ficha significa "arredonda o grupo para baixo".
            do
                local ml = n(sheet.sangueBebidoMl)
                porValor("Sangue", math.floor(ml / 50))
                CONTAS.Sangue = "(" .. ml .. " ÷ 50) [ml de sangue]"
                porTexto("Sangue", CONTAS.Sangue)
            end

            -- DESCANSO: as duas linhas dizem o que cada botao vai fazer, com
            -- o MESMO numero que aplicarDescanso soma. Card mostrando um
            -- valor e botao aplicando outro e a classe de bug da conta do
            -- deslocamento, que mentiu por duas versoes.
            do
                -- efeitosQD e LOCAL de recalcularTudo e NAO se enxerga daqui:
                -- a pintura mora em atualizarAbaCombate. Indexar nil derruba
                -- a pintura no meio e os cards seguintes simplesmente deixam
                -- de existir - foi o que aconteceu ao escrever isto. A fonte
                -- e recalculada, e e a MESMA que aplicarDescanso usa, para o
                -- numero mostrado e o aplicado nunca divergirem.
                local efDesc = CatalogoQD.somarEfeitos(escolhidosQD())
                local pctV = efDesc.descansoHpPercent or 0
                local pctA = efDesc.descansoApPercent or 0
                local function linha(tipo)
                    local d = DESCANSO[tipo]
                    if sheet.ehVampiro then
                        return d.rotulo:lower() .. " " .. d.horas .. "h: Vitae só com sangue"
                    end
                    local partes = {"+" .. ganhoDescanso(sheet.hp, percentVidaDescanso(tipo), pctV) .. " vida"}
                    table.insert(partes, "+" .. ganhoDescanso(sheet.ap, d.energia, pctA) .. " aura")
                    if sheet.temCoracaoDeMana then
                        table.insert(partes, "+" .. ganhoDescanso(sheet.mp, d.energia, 0) .. " mana")
                    end
                    return d.rotulo:lower() .. " " .. d.horas .. "h: " .. table.concat(partes, " · ")
                end
                porValor("Descanso", sheet.ehVampiro and 0
                    or ganhoDescanso(sheet.hp, percentVidaDescanso("longo"), pctV))
                if self.cmb_contaDescanso ~= nil then
                    self.cmb_contaDescanso:setText(linha("longo"))
                end
                if self.cmb_curtoDescanso ~= nil then
                    self.cmb_curtoDescanso:setText(linha("curto"))
                end
            end

            -- A Aura e SEMPRE calculada e nunca zera: todo ser vivo tem
            -- Aura. O que muda entre magos, bruxas e vampiros e de qual
            -- barra a energia e gasta.
            porRecurso("Ap", "ap")
            porTexto("Ap", CONTAS.Ap)

            porRecurso("Mp", "mp")
            porTexto("Mp", CONTAS.Mp)

            -- PRANA: so a bruxa tem. E a soma das outras duas barras.
            porRecurso("Prana", "prana")
            porTexto("Prana", CONTAS.Prana)

            -- Quem aparece e quanto ocupa fica com ajustarGradeCombate:
            -- os cards visiveis dividem a linha em partes iguais.
            ajustarGradeCombate()

            porRecurso("Pv", "pv")
            porTexto("Pv", CONTAS.Pv)

            -- destaca o recurso que o personagem realmente usa.
            -- A combinacao vampiro + bruxa vem PRIMEIRO: se cair no texto de
            -- vampiro puro, a jogadora nao entende de onde saiu o numero
            -- alto do Vitae.
            if self.cmb_lblNotaRecursos ~= nil then
                if sheet.ehVampiro == true and ehBruxa then
                    -- A conta do Prana e escrita por extenso aqui porque o
                    -- card dele nao aparece mais: sem isto, o Vitae salta de
                    -- 73 para 156 sem nada na tela explicando de onde veio.
                    -- O ajuste manual do Prana entra na frase quando existe -
                    -- senao "29 + 54 = 93" nao fecharia, e uma conta que nao
                    -- fecha e pior do que nao mostrar conta nenhuma.
                    local contaPrana = "mana " .. n(sheet.mp) .. " + aura " .. n(sheet.ap)
                    if n(sheet.ajustePrana) ~= 0 then
                        contaPrana = contaPrana .. " + ajuste " .. n(sheet.ajustePrana)
                    end
                    self.cmb_lblNotaRecursos:setText("Vampira da Linhagem de Unaris: você tem UMA reserva só — o VITAE — e ela é alta de propósito. Na Linhagem de Unaris a Mana e a Aura já se fundem numa energia só, o Prana (" .. contaPrana .. " = " .. n(sheet.prana) .. "), e no vampiro o Vitae fica no lugar dessa energia — então o Prana entra dentro do Vitae, e não ao lado dele. Por isso o card de Prana não aparece: não há uma segunda barra para gastar.")
                elseif sheet.ehVampiro == true then
                    self.cmb_lblNotaRecursos:setText("Vampiro: você gasta VITAE. Aura e Mana não aparecem porque o Vitae toma o lugar das duas.")
                elseif ehBruxa then
                    self.cmb_lblNotaRecursos:setText("Linhagem de Unaris: você gasta do PRANA, que é a soma da sua Mana com a sua Aura. As duas seguem calculadas em separado.")
                elseif sheet.temCoracaoDeMana then
                    self.cmb_lblNotaRecursos:setText("Coração de Mana: você tem Mana e Aura, cada uma com sua barra.")
                else
                    self.cmb_lblNotaRecursos:setText("")
                end
            end

            -- ---------- DEFESAS ----------
            local defs = {
                {n = "DefAparar", campo = "defesaAparar", base = 9,
                 atr = "Força", val = n(sheet.forcaTotal), chave = "aparar"},
                {n = "DefEsquiva", campo = "defesaEsquiva", base = 9,
                 atr = "Des", val = n(sheet.destrezaTotal), chave = "esquiva"},
                {n = "DefEmpatica", campo = "defesaEmpatica", base = 10,
                 atr = "Man", val = n(sheet.manipulacaoTotal), chave = "empatica"},
                {n = "DefTelepatica", campo = "defesaTelepatica", base = 10,
                 atr = "Sab", val = n(sheet.sabedoriaTotal), chave = "telepatica"},
            }
            local extrasTexto = {}
            for _, d in ipairs(defs) do
                porValor(d.n, n(sheet[d.campo]))
                porTexto(d.n, CONTAS[d.n])
                local extra = bonusTotalDefesa(d.chave)
                if extra ~= 0 then
                    table.insert(extrasTexto, ROTULO_DEFESA[d.chave] .. " +" .. extra)
                end
            end
            -- FERIDO: o nivel em algarismo romano, a penalidade por extenso
            -- e os LIMIARES em pontos - que e a conta que ninguem quer fazer
            -- na mesa, e a unica parte disto que a ficha pode calcular
            -- sozinha, ja que ela nao ve golpes.
            do
                local nv = nivelFerido()
                local pen = penalidadeFerido()
                local ajuste = n(sheet.ajusteFerido)
                porValor("Ferido", (nv > 0) and FERIDO[nv].romano or "—")
                local linha
                if nv > 0 and ajuste == 0 then
                    linha = "Ferido " .. FERIDO[nv].romano .. ": −" .. pen ..
                            " em todos os testes"
                elseif nv > 0 then
                    linha = "Ferido " .. FERIDO[nv].romano .. ": −" .. pen ..
                            " em todos os testes [" .. FERIDO[nv].penalidade ..
                            (ajuste > 0 and " + ajuste " .. ajuste
                                         or " − ajuste " .. -ajuste) .. "]"
                elseif pen ~= 0 then
                    linha = "ajuste do mestre: −" .. pen .. " em todos os testes"
                else
                    linha = "sem ferimento"
                end
                if self.cmb_contaFerido ~= nil then
                    self.cmb_contaFerido:setText(linha)
                end
                if self.cmb_limiaresFerido ~= nil then
                    self.cmb_limiaresFerido:setText(
                        "num golpe: I ≥ " .. limiarFerido(1) ..
                        " · II ≥ " .. limiarFerido(2) ..
                        " · III ≥ " .. limiarFerido(3))
                end
            end

            if self.cmb_lblNotaDefesas ~= nil then
                if #extrasTexto > 0 then
                    self.cmb_lblNotaDefesas:setText("Bônus vindos de poderes, raça ou escudo psíquico: " ..
                        table.concat(extrasTexto, "   ·   "))
                else
                    self.cmb_lblNotaDefesas:setText("")
                end
            end

            -- seletor do Escudo psiquico: so aparece com o poder adquirido
            local nivelEscudo = 0
            pcall(function() nivelEscudo = nivelDoPoder("Escudo psíquico") end)
            definirAlturaPod(self.cmb_secEscudo, (nivelEscudo >= 3) and 74 or 0)
            if nivelEscudo >= 3 then
                local escolhida = tostring(sheet.escudoPsiquicoDefesa or "")
                local valor = (nivelEscudo >= 5) and 2 or 1
                if self.cmb_lblEscudoTit ~= nil then
                    self.cmb_lblEscudoTit:setText("ESCUDO PSÍQUICO nível " .. nivelEscudo ..
                        " — escolha onde entra o +" .. valor)
                end
                for _, par in ipairs({{"Aparar","aparar"},{"Esquiva","esquiva"},
                                      {"Empatica","empatica"},{"Telepatica","telepatica"}}) do
                    local btn = self["cmb_btnEsc" .. par[1]]
                    local lbl = self["cmb_lblEsc" .. par[1]]
                    if btn ~= nil then
                        if par[2] == escolhida then
                            btn:setStrokeColor(COR.gold); btn:setStrokeSize(2)
                            if lbl ~= nil then lbl:setFontColor(COR.gold) end
                        else
                            btn:setStrokeColor(COR.line); btn:setStrokeSize(1)
                            if lbl ~= nil then lbl:setFontColor(COR.muted) end
                        end
                    end
                end
            end

            -- ---------- MOVIMENTO ----------
            porValor("Deslocamento", n(sheet.deslocamento) .. "m")
            porTexto("Deslocamento", CONTAS.Deslocamento)

            porValor("Corrida", n(sheet.corrida) .. "m")
            if temCaracRacial("Maratonista") then
                porTexto("Corrida", "triplo (Maratonista)")
            else
                porTexto("Corrida", "o dobro do deslocamento")
            end

            -- Metade de deslocamento impar da meio metro, e a mesa decidiu
            -- MOSTRAR o meio metro em vez de arredondar. Em Lua, 6.5 vira
            -- "6.5" com PONTO; aqui a ficha escreve em portugues.
            local function metros(v)
                v = n(v)
                if v == math.floor(v) then return tostring(math.floor(v)) end
                return (string.format("%.1f", v):gsub("%.", ","))
            end

            -- Voo, nado e escalada: mesma conta, com a disparada na propria
            -- linha em vez de um card so para ela.
            -- Card fixo: quem não tem o modo vê "—" e a conta explica.
            local function porModo(nome, campoValor, campoBase, campoCorrida, semOModo)
                local base = n(sheet[campoBase])
                local valor = n(sheet[campoValor])
                if base <= 0 and valor <= 0 then
                    porValor(nome, "—")
                    porTexto(nome, semOModo)
                    return
                end
                porValor(nome, metros(valor) .. "m")
                local origem
                if base > 0 then
                    origem = "raça " .. base .. " + Des " .. n(sheet.destrezaTotal) ..
                        " + rank " .. rankNum
                else
                    -- padrao da mesa: metade do deslocamento. A conta mostra
                    -- DE ONDE veio a metade, senao o numero parece sair do nada.
                    origem = "metade de " .. metros(sheet.deslocamentoMetadeBase)
                end
                porTexto(nome, origem ..
                    "  ·  disparada " .. metros(sheet[campoCorrida]) .. "m")
            end

            porModo("Voo", "deslocamentoVoo", "deslocamentoBaseVoo", "corridaVoo",
                "esta raça não voa  ·  use o ajuste")
            porModo("Nado", "deslocamentoNado", "deslocamentoBaseNado", "corridaNado",
                "esta raça não nada  ·  use o ajuste")
            porModo("Escalada", "deslocamentoEscalada", "deslocamentoBaseEscalada", "corridaEscalada",
                "sem escalada  ·  use o ajuste")

            -- MONTADO: só quando há montaria montada na aba Criaturas.
            --
            -- Um card só para os três modos (pedido da mesa, 22/08/2026):
            --   TÍTULO   "MONTADO · VOO"          — qual modo é o número grande
            --   NÚMERO   116m                     — o MAIOR modo da montaria
            --   CONTA    Wyverna voo 100 + bônus 3 + seu 13 (Montador ○○)
            --   MODOS    terrestre 46  ·  nado 56 — os outros, se houver
            --
            -- Modo com base 0 não aparece em lugar nenhum: era a primeira das
            -- duas ideias da mesa, e ela cabe junto com a segunda em vez de
            -- concorrer com ela.
            do
                local m = montariaMontada()
                if m ~= nil then
                    local topo = tostring(sheet.montariaModoTopo or "")
                    porValor("Montado", n(sheet.deslocamentoMontado) .. "m")
                    porTexto("Montado", tostring(sheet.montariaResumo or ""))
                    porTituloMontado((topo ~= "" and topo ~= "terrestre")
                        and ("MONTADO · " .. string.upper(topo)) or "MONTADO")
                    porModosMontado(tostring(sheet.montariaModos or ""))
                else
                    porValor("Montado", "—")
                    porTexto("Montado", "")
                    porTituloMontado("MONTADO")
                    porModosMontado("")
                end
            end

            -- TAMANHO: campo indicativo, sem conta. A linha de baixo diz onde
            -- ele está na escala e quem pode mexer, que é a única informação
            -- que o jogador precisa antes de clicar.
            porValor("Tamanho", tamanhoDoPersonagem())
            do
                local i = indiceDoTamanho()
                porTexto("Tamanho", (podeEditarCriacao()
                    and "livre na criação" or "só o mestre altera"))
                if self.cmb_lblTamEscala ~= nil then
                    self.cmb_lblTamEscala:setText(i .. " de " .. #TAMANHOS)
                end
            end

            -- Interruptor de forma: so existe para quem tem raça com forma
            -- alternativa (Lobisomens, Ursaris). Para todo o resto ele fica
            -- com altura zero e nem ocupa espaço.
            atualizarInterruptorDeForma()
            atualizarCardLua()

            porValor("Iniciativa", "+" .. n(sheet.iniciativa))
            porTexto("Iniciativa", CONTAS.Iniciativa)

            porValor("Prof", "+" .. prof)
            porTexto("Prof", "nível " .. nivel .. "  ·  rank " .. rank)

            -- ---------- ACOES ----------
            -- O numero grande conta so o que e sempre usavel. As restritas
            -- aparecem na nota de rodape, com o para-que-serve de cada uma.
            local function contaDeAcao(rotuloNivel, temNivel, fontesLivres)
                local partes = {"1 base"}
                if temNivel then table.insert(partes, "1 (" .. rotuloNivel .. ")") end
                for _, r in ipairs(fontesLivres or {}) do
                    table.insert(partes, "1 (" .. r .. ")")
                end
                return table.concat(partes, " + ")
            end

            local lPadrao, rPadrao, fPadrao, tPadrao = 0, 0, {}, {}
            local lBonus, rBonus, fBonus, tBonus = 0, 0, {}, {}
            local lReacao, rReacao, fReacao, tReacao = 0, 0, {}, {}
            pcall(function()
                lPadrao, rPadrao, fPadrao, tPadrao = extrasDeAcao("padrao")
                lBonus, rBonus, fBonus, tBonus = extrasDeAcao("bonus")
                lReacao, rReacao, fReacao, tReacao = extrasDeAcao("reacao")
            end)

            porValor("AcoesPadrao", n(sheet.acoesPadrao))
            porTexto("AcoesPadrao", contaDeAcao("nível 19", nivel >= 19, fPadrao))
            porValor("AcoesBonus", n(sheet.acoesBonus))
            porTexto("AcoesBonus", contaDeAcao("nível 10", nivel >= 10, fBonus))
            porValor("AcoesReacao", n(sheet.acoesReacao))
            porTexto("AcoesReacao", contaDeAcao("nível 15", nivel >= 15, fReacao))

            -- Inspiracao: comeca em 3 e o teto e 3.
            if sheet.pontosInspiracao == nil then sheet.pontosInspiracao = 3 end
            if n(sheet.pontosInspiracao) > 3 then sheet.pontosInspiracao = 3 end
            if n(sheet.pontosInspiracao) < 0 then sheet.pontosInspiracao = 0 end
            porValor("Inspiracao", n(sheet.pontosInspiracao))
            porTexto("Inspiracao", "de 3  ·  gaste e recupere no campo ATUAL")

            -- O numero grande e a capacidade REAL (base + ajuste do mestre +
            -- espacos extras de itens), que e a que a mochila usa para
            -- recusar item. Ate a v0.41.1 o card mostrava so a base.
            porValor("Mochila", capacidadeMochila())
            porTexto("Mochila", CONTAS.Mochila)

            -- Nota de rodape das acoes, em tres camadas:
            --   1. as RESTRITAS que o personagem ja tem (existem, mas so
            --      servem para uma coisa);
            --   2. o que ainda vai destravar por nivel;
            --   3. as CONDICIONAIS, que dependem da situacao e por isso nunca
            --      entram na conta.
            if self.cmb_lblNotaAcoes ~= nil then
                local linhas = {}

                -- TETO DE ACOES POR TURNO ("Limite de ações", Sistema e
                -- Evolucao). Conta padrao + bonus SOMADAS. A ficha nao corta
                -- o valor: mostra o total e avisa, por decisao da mesa.
                local teto = DadosSistema.limiteAcoesPorNivel(nivel)
                local somadas = n(sheet.acoesPadrao) + n(sheet.acoesBonus)
                if somadas > teto then
                    table.insert(linhas, "⚠ Teto de ações do nível " .. nivel ..
                        ": " .. teto .. " por turno (padrão + bônus somadas). " ..
                        "Suas fontes dão " .. somadas .. " — o livro não deixa usar todas no mesmo turno.")
                else
                    table.insert(linhas, "Teto de ações do nível " .. nivel ..
                        ": " .. teto .. " por turno (padrão + bônus somadas). Você usa " ..
                        somadas .. ".")
                end

                local restritas = {}
                for _, t in ipairs(tPadrao) do table.insert(restritas, "1 ação padrão " .. t) end
                for _, t in ipairs(tBonus) do table.insert(restritas, "1 ação bônus " .. t) end
                for _, t in ipairs(tReacao) do table.insert(restritas, "1 reação " .. t) end
                if #restritas > 0 then
                    table.insert(linhas, "Restritas (fora do número acima): " ..
                        table.concat(restritas, "   ·   "))
                end

                local faltam = {}
                if nivel < 10 then table.insert(faltam, "ação bônus no 10") end
                if nivel < 15 then table.insert(faltam, "reação no 15") end
                if nivel < 19 then table.insert(faltam, "ação padrão no 19") end
                if #faltam > 0 then
                    table.insert(linhas, "Ainda por vir: +1 " .. table.concat(faltam, "   ·   +1 "))
                else
                    table.insert(linhas, "Todas as ações de nível já foram destravadas.")
                end

                local condicionais = {}
                pcall(function() condicionais = avisosDeAcaoCondicionais() end)
                for _, t in ipairs(condicionais) do
                    table.insert(linhas, "Condicional: " .. t)
                end

                self.cmb_lblNotaAcoes:setText(table.concat(linhas, "\n"))

                -- A nota deixou de ser uma linha so. Com wordWrap ligado, o
                -- label quebra sozinho, entao a altura precisa contar as
                -- quebras REAIS estimadas, e nao so o numero de linhas
                -- logicas - senao o texto some cortado embaixo.
                local CHARS_POR_LINHA = 150
                local visuais = 0
                for _, l in ipairs(linhas) do
                    local q = math.ceil(contarCaracteres(l) / CHARS_POR_LINHA)
                    if q < 1 then q = 1 end
                    visuais = visuais + q
                end
                definirAltura(self.cmb_lblNotaAcoes, 14 * visuais + 6)
            end
        end

        -- =================================================================
        -- FAVORES DIVINOS
        --
        -- Ganho: 1/2 favor por feito, ou 1 inteiro para humanos (passiva
        -- "Favorecimento divino") e para filhos/legados quando a missao e da
        -- propria divindade. Por isso a contagem trabalha com MEIOS.
        --
        -- Teto de 3 POR DIVINDADE (regra da mesa): da para ter 3 com Ditrys e
        -- 3 com Kaern ao mesmo tempo.
        --
        -- Quem registra e gasta e o MESTRE - "somente e possivel ganhar
        -- favores atraves de narrativas oficiais". O jogador so consulta.
        --
        -- FORMATO: "Deus|valor;Deus|valor" (valor com meio ponto: 0.5, 1, 1.5...)
        -- Nenhum nome de divindade contem ";" ou "|".
        -- =================================================================

        local FAVOR_MAXIMO = 3

        function lerFavores()
            local lista = {}
            if sheet == nil then return lista end
            for _, reg in ipairs(partirTexto(sheet.favoresDados, ";")) do
                local nome, valor = reg:match("^(.-)|([%d%.]+)$")
                if nome ~= nil and nome ~= "" then
                    table.insert(lista, {deus = nome, valor = tonumber(valor) or 0})
                end
            end
            table.sort(lista, function(a, b)
                if a.valor ~= b.valor then return a.valor > b.valor end
                return a.deus < b.deus
            end)
            return lista
        end

        function gravarFavores(lista)
            if sheet == nil then return end
            local partes = {}
            for _, f in ipairs(lista) do
                if f.valor > 0 then
                    table.insert(partes, f.deus .. "|" .. tostring(f.valor))
                end
            end
            sheet.favoresDados = table.concat(partes, ";")
        end

        -- Lua guarda 2 como 2.0; na tela isso vira "2.0", que polui. Meio
        -- ponto continua aparecendo como "½", que e como a mesa fala.
        function formatarFavor(v)
            v = tonumber(v) or 0
            local inteiro = math.floor(v)
            if v == inteiro then return tostring(inteiro) end
            if inteiro == 0 then return "½" end
            return tostring(inteiro) .. "½"
        end

        function favorDoDeus(nomeDeus)
            for _, f in ipairs(lerFavores()) do
                if f.deus == nomeDeus then return f.valor end
            end
            return 0
        end

        function totalDeFavores()
            local t = 0
            for _, f in ipairs(lerFavores()) do t = t + f.valor end
            return t
        end

        -- "Macula divina": o mestre escolhe uma divindade da qual o
        -- personagem nunca ganha favor. Guardada em campo proprio.
        function deusEhMacula(nomeDeus)
            if sheet == nil then return false end
            return tostring(sheet.maculaDivina or "") == nomeDeus
        end

        function ajustarFavor(nomeDeus, delta)
            if sheet == nil or nomeDeus == nil or nomeDeus == "" then return end
            if not usuarioEhMestre() then
                avisarFavores("Somente o MESTRE registra favores: eles só vêm de narrativas oficiais.", COR.wine)
                return
            end
            if delta > 0 and deusEhMacula(nomeDeus) then
                avisarFavores(nomeDeus .. " é a sua Mácula divina — você nunca ganha favores dela.", COR.wine)
                return
            end

            local lista = lerFavores()
            local alvo = nil
            for _, f in ipairs(lista) do
                if f.deus == nomeDeus then alvo = f end
            end
            if alvo == nil then
                alvo = {deus = nomeDeus, valor = 0}
                table.insert(lista, alvo)
            end

            local novo = alvo.valor + delta
            if novo > FAVOR_MAXIMO then
                avisarFavores("Teto de " .. FAVOR_MAXIMO .. " favores por divindade atingido em " .. nomeDeus .. ".", COR.muted)
                novo = FAVOR_MAXIMO
            end
            if novo < 0 then novo = 0 end
            if novo == alvo.valor then return end
            alvo.valor = novo

            gravarFavores(lista)
            local verbo = (delta > 0) and "concedeu" or "retirou"
            local preposicao = (delta > 0) and " para " or " de "
            -- A acao que deu certo substitui o aviso anterior: a recusa da
            -- macula nao pode continuar na tela em cima do card de Aslot
            -- recem-registrado (v0.42.1).
            if novo < FAVOR_MAXIMO or delta < 0 then
                avisarFavores(nomeDeus .. ": " .. formatarFavor(novo) .. " favor(es).", COR.moss)
            end
            publicarNoChat(anuncio("favor", "FAVOR DIVINO",
                     nickDoUsuario() .. " " .. verbo ..
                " " .. formatarFavor(math.abs(delta)) .. " favor de **" .. nomeDeus .. "**" .. preposicao ..
                tostring(sheet.nome or "personagem") .. ". Total: " .. formatarFavor(novo) .. "."), COR.gold)
            atualizarAbaFavores()
        end

        -- ---------------------------------------------------------------
        -- BENEFICIOS PASSIVOS
        -- O bonus social vale pelo patamar ja alcancado, sem gastar nada.
        -- ---------------------------------------------------------------
        function bonusSocialDoFavor(valor)
            if valor >= 3 then return 5, "sacerdotes, seguidores, filhos e abençoados"
            elseif valor >= 2 then return 3, "sacerdotes e seguidores"
            elseif valor >= 1 then return 1, "sacerdotes"
            end
            return 0, ""
        end

        -- ---------------------------------------------------------------
        -- TROCAS QUE MEXEM NA FICHA
        --
        -- Das trocas do livro, so estas alteram valores: as demais (milagre,
        -- auxilio narrativo, conversa com a divindade, ressurreicao) sao
        -- resolvidas na mesa e nao tem o que automatizar.
        --   2 favores -> 1 ponto de poder
        --   3 favores -> bencao (libera o kit do deus)
        --   3 favores -> 3 pontos de poder
        --   3 favores -> 1 favor com um deus primordial
        -- ---------------------------------------------------------------
        -- ---------------------------------------------------------------
        -- HIERARQUIA DAS TROCAS
        --
        -- Trocar 3 favores por 1 favor sobe UM degrau na hierarquia divina:
        --   Menor      -> Grande
        --   Grande     -> Primordial
        --   Primordial -> a Mãe (a Mãe Celestial, acima dos primordiais;
        --                nao consta no catalogo de deuses, por isso entra
        --                como destino proprio)
        -- Antes a troca sempre oferecia primordiais, o que so vale para os
        -- deuses grandes.
        MAE_CELESTIAL = "A Mãe"
        PAI_SUPREMO = "O Pai"

        -- O PAI E A MAE NA LISTA DE REGISTRAR FAVOR  (v0.35.4)
        --
        -- Deuses, "Panteão", lista o topo do panteao acima dos primordiais:
        --     "~> Pai, pai dos seres primordiais
        --      ~> Mãe, mãe dos seres primordiais
        --      ~~> Asta, deus primordial do Céu e senhor dos Dragões"
        -- (o "~>" e um degrau acima do "~~>" dos primordiais).
        --
        -- Eles NAO estao em CatalogoDeuses.itens, e continuam fora de
        -- proposito: o catalogo guarda os deuses que tem kit de poderes e
        -- podem ser Aspecto Divino, e o livro e explicito sobre nao haver
        -- semideus do Supremo ("em contrapartida à ausência de semideuses
        -- entre os seguidores do Supremo, os Paladinos emergem como os
        -- verdadeiros heróis desta religião").
        --
        -- Entram so aqui, na lista de REGISTRAR FAVOR, porque a ficha tambem
        -- serve para NPC: os paladinos oponentes da mesa tem favores com o
        -- Pai (pedido da mesa, 22/08/2026).
        --
        -- A categoria "Suprema" e propria: mantem os dois FORA da lista de
        -- escolha de primordial, que filtra por categoria == "Primordial".
        DEUSES_SUPREMOS = {
            {nome = "O Pai", categoria = "Suprema"},
            {nome = "A Mãe", categoria = "Suprema"},
        }

        -- Todo mundo que pode receber favor: o catalogo mais o Pai e a Mae.
        -- O nome de "A Mãe" e o MESMO que a troca de 3 favores primordiais ja
        -- gravava (MAE_CELESTIAL), entao favor ganho pelos dois caminhos cai
        -- no mesmo registro em vez de virar duas linhas.
        function deusesRegistraveis()
            local lista = {}
            for _, d in ipairs(CatalogoDeuses.itens) do table.insert(lista, d) end
            for _, d in ipairs(DEUSES_SUPREMOS) do table.insert(lista, d) end
            return lista
        end

        function categoriaDoDeus(nomeDeus)
            if nomeDeus == MAE_CELESTIAL or nomeDeus == PAI_SUPREMO then
                return "Suprema"
            end
            local d = CatalogoDeuses.buscarPorNome(nomeDeus)
            if d == nil then return "" end
            return tostring(d.categoria or "")
        end

        -- Devolve a categoria de destino e um rotulo para o botao.
        function degrauAcima(nomeDeus)
            local cat = categoriaDoDeus(nomeDeus)
            if cat == "Menor" then return "Grande", "1 FAVOR DE UM GRANDE"
            elseif cat == "Grande" then return "Primordial", "1 FAVOR PRIMORDIAL"
            elseif cat == "Primordial" then return "Mãe", "1 FAVOR COM A MÃE"
            end
            return nil, nil
        end

        function trocarFavor(nomeDeus, tipo)
            if sheet == nil then return end
            if not usuarioEhMestre() then
                avisarFavores("Somente o MESTRE executa trocas de favor.", COR.wine)
                return
            end
            local atual = favorDoDeus(nomeDeus)
            local custo = (tipo == "poder1") and 2 or 3
            if atual < custo then
                avisarFavores("São necessários " .. custo .. " favores com " .. nomeDeus ..
                    " para esta troca (você tem " .. formatarFavor(atual) .. ").", COR.muted)
                return
            end

            local descricao = ""
            if tipo == "poder1" then
                sheet.poderPontosConcedidos = n(sheet.poderPontosConcedidos) + 1
                descricao = "1 ponto de poder"
            elseif tipo == "poder3" then
                sheet.poderPontosConcedidos = n(sheet.poderPontosConcedidos) + 3
                descricao = "3 pontos de poder"
            elseif tipo == "bencao" then
                if deusEhAcessivel(nomeDeus) then
                    avisarFavores("Você já tem acesso ao kit de " .. nomeDeus .. ".", COR.muted)
                    return
                end
                local atualB = tostring(sheet.deusesAbencoados or "")
                if atualB == "" then sheet.deusesAbencoados = nomeDeus
                else sheet.deusesAbencoados = atualB .. ";" .. nomeDeus end
                descricao = "a bênção de " .. nomeDeus .. ", liberando o kit de poderes"
            elseif tipo == "proclamar" then
                -- So faz sentido com a propria divindade: o aspecto proclama
                -- o semideus como campeao ou profeta. Com um deus que nao e o
                -- seu, o equivalente e a bencao.
                if tostring(sheet.aspectoDivino or "") ~= nomeDeus then
                    avisarFavores("A proclamação só vem do seu próprio Aspecto Divino.", COR.wine)
                    return
                end
                if tostring(sheet.proclamadoPor or "") ~= "" then
                    avisarFavores("Você já foi proclamado por " .. tostring(sheet.proclamadoPor) .. ".", COR.muted)
                    return
                end
                sheet.proclamadoPor = nomeDeus
                sheet.proclamadoData = carimboDeTempo()
                descricao = "a PROCLAMAÇÃO de " .. nomeDeus ..
                    ", que o reconhece publicamente como seu campeão"

            elseif tipo == "primordial" then
                local destino = degrauAcima(nomeDeus)
                if destino == nil then
                    avisarFavores("Não há degrau acima desta divindade.", COR.muted)
                    return
                end
                if destino == "Mãe" then
                    -- destino unico: nao ha o que escolher
                    local lista = lerFavores()
                    for _, f in ipairs(lista) do
                        if f.deus == nomeDeus then f.valor = f.valor - 3 end
                    end
                    local alvo = nil
                    for _, f in ipairs(lista) do if f.deus == MAE_CELESTIAL then alvo = f end end
                    if alvo == nil then
                        alvo = {deus = MAE_CELESTIAL, valor = 0}
                        table.insert(lista, alvo)
                    end
                    alvo.valor = math.min(alvo.valor + 1, FAVOR_MAXIMO)
                    gravarFavores(lista)
                    publicarNoChat(anuncio("troca", "TROCA DE FAVORES",
                     tostring(sheet.nome or "Personagem") ..
                        " trocou 3 favores de **" .. nomeDeus .. "** por 1 favor com **" ..
                        MAE_CELESTIAL .. "**, acima dos primordiais."), COR.aura)
                    atualizarAbaFavores()
                    return
                end
                favorPendentePrimordial = nomeDeus
                categoriaDestinoFavor = destino
                abrirPopupFavores(true)
                return
            else
                return
            end

            -- desconta os favores gastos
            local lista = lerFavores()
            for _, f in ipairs(lista) do
                if f.deus == nomeDeus then f.valor = f.valor - custo end
            end
            gravarFavores(lista)

            -- A proclamação é o topo da hierarquia e ganha emblema próprio.
            local ehProclamacao = (tipo == "proclamar")
            publicarNoChat(anuncio(
                ehProclamacao and "proclamacao" or "troca",
                ehProclamacao and "PROCLAMAÇÃO" or "TROCA DE FAVORES",
                nomeDoPersonagem() .. " ofereceu " .. custo .. " favores de " ..
                neg(nomeDeus) .. " e recebeu " .. descricao .. "."), COR.aura)
            avisarFavores("Troca concluída: " .. descricao .. ".", COR.gold)
            atualizarAbaFavores()
            atualizarBlocoPoderes()
        end

        -- ---------------------------------------------------------------
        -- REVOGAÇÃO — desabençoar e desproclamar
        --
        -- Nao estava previsto: a ficha so sabia CONCEDER. Os deuses de
        -- Petrichor sentem ciume, inveja e cobica ("os deuses do Circulo
        -- apresentam uma gama complexa de tracos e comportamentos", Deuses),
        -- entao retirar o que deram e narrativa possivel.
        --
        -- REGRA DA MESA (21/08/2026): ao revogar, os 3 favores gastos NAO
        -- voltam — e mais: a relacao com aquela divindade ZERA. E o castigo
        -- duro, escolhido de proposito.
        --
        -- So o MESTRE executa, como toda a aba de Favores. Fica registrado no
        -- historico da ficha e anunciado no chat, porque a mesa inteira
        -- precisa saber.
        -- ---------------------------------------------------------------
        function registrarNoHistoricoDivino(linha)
            if sheet == nil then return end
            local antes = tostring(sheet.historicoDivino or "")
            local nova = carimboDeTempo() .. "  ·  " .. tostring(linha or "")
            if antes == "" then sheet.historicoDivino = nova
            else sheet.historicoDivino = antes .. "\n" .. nova end
        end

        -- Zera a relacao com a divindade: os favores acumulados somem junto
        -- com o que foi revogado.
        local function zerarFavoresDe(nomeDeus)
            local lista = lerFavores()
            local sobrou = {}
            for _, f in ipairs(lista) do
                if f.deus ~= nomeDeus then table.insert(sobrou, f) end
            end
            gravarFavores(sobrou)
        end

        -- A linha da aba nao sabe o nome do deus: sabe o indice. Como a lista
        -- e reordenada a cada desenho, o nome tem de ser lido na hora do
        -- clique, e nunca guardado no widget.
        function revogarBencaoDaLinha(indice)
            local lista = lerFavores()
            local item = lista[indice]
            if item == nil then return end
            revogarBencao(item.deus)
        end

        -- ---------------------------------------------------------------
        -- POPUP DE BENCAOS  (v0.35.4)
        --
        -- O card BENCAOS mostrava so a contagem: "3" nao diz QUAIS. Para
        -- descobrir, era preciso varrer a lista de relacoes divinas atras das
        -- linhas com o botao de retirar bencao ligado - o dado existia, mas
        -- espalhado. Agora o card abre a lista fechada, com o botao do mestre
        -- dentro dela.
        --
        -- CONSULTA ABRE SEMPRE, mesmo para o jogador: e a regra da ficha, e
        -- aqui ela pesa mais que o normal - saber de quem se e abencoado
        -- define que kit de poder esta aberto. Quem trava e o botao de
        -- revogar, nao o de abrir.
        --
        -- O popup e deliberadamente magro: doze linhas de rotulo e um botao,
        -- sem scrollBox, sem imagem, sem editor. Depois do crash da v0.35.1
        -- ficou a regra de nao pendurar widget caro dentro de popup.
        -- ---------------------------------------------------------------
        MAX_LINHAS_BENCAO = 12

        function abrirPopupBencaos()
            if self.popBencaos == nil then return end
            atualizarPopupBencaos()
            abrirPopupAjustado(self.popBencaos, 760, 620)
            -- DE NOVO, depois do show: e a segunda passada que consegue mexer
            -- em largura, porque agora os widgets existem de fato. A primeira
            -- passada serve para o popup ja abrir preenchido, sem piscar.
            atualizarPopupBencaos()
        end

        function fecharPopupBencaos()
            if self.popBencaos ~= nil then self.popBencaos:close() end
        end

        -- favores atuais com um deus. lerFavores devolve a lista ja ordenada;
        -- aqui so interessa o valor de um nome.
        function favoresComDeus(nomeDeus)
            for _, f in ipairs(lerFavores()) do
                if f.deus == nomeDeus then return f.valor end
            end
            return 0
        end

        function atualizarPopupBencaos()
            if sheet == nil then return end
            local lista = deusesAbencoados()
            local mestre = usuarioEhMestre()
            local aspecto = tostring(sheet.aspectoDivino or "")
            local proclamado = tostring(sheet.proclamadoPor or "")

            definirAlturaPod(self.popBen_wrapVazio, (#lista == 0) and 70 or 0)

            if self.popBen_lblResumo ~= nil then
                if #lista == 0 then
                    self.popBen_lblResumo:setText("Nenhuma divindade abençoou este personagem ainda.")
                else
                    self.popBen_lblResumo:setText(#lista ..
                        ((#lista == 1) and " divindade abençoou" or " divindades abençoaram") ..
                        " este personagem. Cada bênção mantém aberto o kit de poderes daquela divindade.")
                end
            end

            for i = 1, MAX_LINHAS_BENCAO do
                local nome = lista[i]
                definirAlturaPod(self["popBen_wrap" .. i], (nome ~= nil) and 46 or 0)
                if nome ~= nil then
                    local d = CatalogoDeuses.buscarPorNome(nome)

                    local lbl = self["popBen_lblNome" .. i]
                    if lbl ~= nil then
                        local txt = nome
                        if nome == aspecto then txt = txt .. "   ✦ SEU ASPECTO" end
                        if nome == proclamado then txt = txt .. "   ✦ PROCLAMOU VOCÊ" end
                        lbl:setText(txt)
                        lbl:setFontColor((nome == proclamado) and COR.gold or COR.text)
                    end

                    local lblDet = self["popBen_lblDet" .. i]
                    if lblDet ~= nil then
                        local partes = {}
                        if d ~= nil then
                            table.insert(partes, "deus " .. tostring(d.categoria or ""):lower())
                        end
                        local fav = favoresComDeus(nome)
                        table.insert(partes, fav .. (fav == 1 and " favor" or " favores") .. " em aberto")
                        lblDet:setText(table.concat(partes, "  ·  "))
                    end

                    -- O BOTAO DE REVOGAR NAO E MEXIDO POR SCRIPT. Ele esta no
                    -- XML, com largura fixa, e aparece para todo mundo; a
                    -- recusa ao jogador vem no clique.
                    --
                    -- DUAS TENTATIVAS ERRADAS ANTES DESTA, e as duas valem
                    -- como aviso para o proximo popup:
                    --
                    -- v0.35.4 - o botao nascia com width="0" e o script mandava
                    --   190 para o mestre. Nao apareceu para ninguem.
                    -- v0.35.5 - inverti (190 no XML, script so encolhendo).
                    --   CONTINUOU nao aparecendo, o que derrubou a minha teoria
                    --   de que o problema era a largura vinda do script.
                    --
                    -- A causa real e ESTRUTURAL, e estava no proprio print: a
                    -- barrinha colorida da esquerda de cada linha SEMPRE
                    -- apareceu. Ela e um <rectangle align="left"> filho DIRETO
                    -- do retangulo da linha. O botao, nao: eu o tinha posto
                    -- dentro de um <layout> extra, aninhado no layout
                    -- align="client". Esse nivel a mais e que nao era
                    -- desenhado numa linha que nasce com height="0" e so ganha
                    -- altura depois, por script.
                    --
                    -- Agora o botao e irmao da barrinha - mesmo nivel, mesmo
                    -- tipo de ancoragem, o padrao que ja funcionava na tela.
                    --
                    -- REGRA PARA A PROXIMA VEZ: dentro de linha de altura
                    -- variavel, ancore o widget como filho DIRETO do retangulo
                    -- da linha. Nao empilhe layout dentro de layout.
                end
            end

            if self.popBen_lblRodape ~= nil then
                if #lista > MAX_LINHAS_BENCAO then
                    self.popBen_lblRodape:setText("Mostrando as " .. MAX_LINHAS_BENCAO ..
                        " primeiras de " .. #lista ..
                        ". As demais continuam na lista de relações da aba.")
                    self.popBen_lblRodape:setFontColor(COR.gold)
                elseif not mestre then
                    self.popBen_lblRodape:setText("Retirar uma bênção é ato do mestre — o botão está aí, mas só responde na ficha dele. A lista você pode consultar sempre.")
                    self.popBen_lblRodape:setFontColor(COR.muted)
                else
                    self.popBen_lblRodape:setText("Retirar uma bênção fecha o kit daquela divindade e ZERA os favores com ela. Os poderes já comprados ficam.")
                    self.popBen_lblRodape:setFontColor(COR.muted)
                end
            end
        end

        -- Mesmo cuidado de revogarBencaoDaLinha: o widget guarda o INDICE, e o
        -- nome e lido na hora do clique. Revogar a linha 1 reordena a lista;
        -- um nome guardado no botao apontaria para o deus errado no clique
        -- seguinte.
        function revogarBencaoDoPopup(indice)
            local lista = deusesAbencoados()
            local nome = lista[n(indice)]
            if nome == nil then return end

            -- O botao aparece para todo mundo (ver o comentario em
            -- atualizarPopupBencaos). A recusa mora aqui, e diz de quem e o
            -- ato - avisarFavores escreveria no rotulo da ABA, que esta atras
            -- do popup, e o jogador clicaria sem ver resposta nenhuma.
            if not usuarioEhMestre() then
                if self.popBen_lblRodape ~= nil then
                    self.popBen_lblRodape:setText("Somente o MESTRE retira uma bênção. Peça a ele — a bênção de " ..
                        nome .. " continua valendo.")
                    self.popBen_lblRodape:setFontColor(COR.wine)
                end
                return
            end

            revogarBencao(nome)
            atualizarPopupBencaos()
            -- o aviso de revogarBencao vai para o rotulo da ABA, que esta
            -- atras do popup. Sem repetir aqui, o mestre clicaria e veria
            -- so a linha sumir, sem confirmacao de que algo foi registrado.
            if self.popBen_lblRodape ~= nil then
                self.popBen_lblRodape:setText("Bênção de " .. nome ..
                    " retirada. Os favores com " .. nome ..
                    " foram zerados e o kit dela está fechado; os poderes já comprados ficam na ficha.")
                self.popBen_lblRodape:setFontColor(COR.wine)
            end
        end

        function revogarBencao(nomeDeus)
            if sheet == nil then return end
            if not usuarioEhMestre() then
                avisarFavores("Somente o MESTRE retira uma bênção.", COR.wine)
                return
            end
            local restantes = {}
            local achou = false
            for _, d in ipairs(deusesAbencoados()) do
                if d == nomeDeus then achou = true else table.insert(restantes, d) end
            end
            if not achou then
                avisarFavores(nomeDeus .. " não abençoou este personagem — não há bênção a retirar.", COR.muted)
                return
            end

            sheet.deusesAbencoados = table.concat(restantes, ";")
            zerarFavoresDe(nomeDeus)
            registrarNoHistoricoDivino("Bênção de " .. nomeDeus ..
                " RETIRADA pelo mestre. Os favores com esta divindade foram zerados.")

            publicarNoChat(anuncio("revogacao", "BÊNÇÃO RETIRADA",
                neg(nomeDeus) .. " retirou sua bênção de " .. nomeDoPersonagem() ..
                ". O kit de poderes daquela divindade está fechado, e a relação com " ..
                neg(nomeDeus) .. " voltou ao zero."), COR.wine)

            avisarFavores("Bênção de " .. nomeDeus .. " retirada. Os poderes já " ..
                "adquiridos continuam na ficha — o que fecha é o acesso a novos.", COR.wine)
            atualizarAbaFavores()
            atualizarBlocoPoderes()
            recalcularTudo()
        end

        function revogarProclamacao()
            if sheet == nil then return end
            if not usuarioEhMestre() then
                avisarFavores("Somente o MESTRE retira uma proclamação.", COR.wine)
                return
            end
            local deus = tostring(sheet.proclamadoPor or "")
            if deus == "" then
                avisarFavores("Este personagem não foi proclamado por ninguém.", COR.muted)
                return
            end

            sheet.proclamadoPor = ""
            sheet.proclamadoData = ""
            zerarFavoresDe(deus)
            registrarNoHistoricoDivino("Proclamação de " .. deus ..
                " REVOGADA pelo mestre. Os favores com esta divindade foram zerados.")

            publicarNoChat(anuncio("revogacao", "PROCLAMAÇÃO REVOGADA",
                neg(deus) .. " retirou publicamente a proclamação de " ..
                nomeDoPersonagem() .. ". O título de campeão foi desfeito, e a relação com " ..
                neg(deus) .. " voltou ao zero."), COR.wine)

            avisarFavores("Proclamação de " .. deus .. " revogada.", COR.wine)
            atualizarAbaFavores()
            atualizarBlocoPoderes()
            recalcularTudo()
        end

        -- ---------------------------------------------------------------
        -- SELETOR DE DIVINDADE
        -- ---------------------------------------------------------------
        favorPendentePrimordial = nil
        modoPrimordialFavor = false
        modoMaculaFavor = false
        categoriaDestinoFavor = "Primordial"

        function abrirPopupFavores(soPrimordiais)
            if self.popFavores == nil then return end
            modoPrimordialFavor = (soPrimordiais == true)
            if self.popFav_lblAviso ~= nil then
                self.popFav_lblAviso:setText("")
                pcall(function() self.popFav_lblAviso:setHeight(0) end)
            end
            atualizarListaFavoresPopup()
            abrirPopupAjustado(self.popFavores, 720, 620)
        end

        function fecharPopupFavores()
            if self.popFavores ~= nil then self.popFavores:close() end
            favorPendentePrimordial = nil
            modoPrimordialFavor = false
            modoMaculaFavor = false
        end

        function atualizarListaFavoresPopup()
            if self.popFav_lblTitulo == nil then return end
            if modoMaculaFavor then
                self.popFav_lblTitulo:setText("DEFINIR A MÁCULA DIVINA")
                self.popFav_lblAjuda:setText("A divindade escolhida nunca concederá favores a este personagem.")
            elseif modoPrimordialFavor then
                local dest = tostring(categoriaDestinoFavor or "Primordial")
                self.popFav_lblTitulo:setText("ESCOLHA A DIVINDADE — " .. string.upper(dest))
                self.popFav_lblAjuda:setText("Os 3 favores de " .. tostring(favorPendentePrimordial or "?") ..
                    " viram 1 favor com a divindade escolhida, um degrau acima na hierarquia.")
            else
                self.popFav_lblTitulo:setText("REGISTRAR FAVOR")
                self.popFav_lblAjuda:setText("Escolha a divindade que concedeu o favor. Meio ponto é o padrão; humanos, filhos e legados recebem 1 inteiro.")
            end
            for _, d in ipairs(deusesRegistraveis()) do
                local card = self["rectFav_" .. chavePoder(d.nome)]
                if card ~= nil then
                    local mostra = true
                    if modoPrimordialFavor then
                        mostra = (d.categoria == tostring(categoriaDestinoFavor or "Primordial"))
                    end
                    definirAlturaPod(card, mostra and 26 or 0)
                    if mostra then
                        local lbl = self["lblFav_" .. chavePoder(d.nome)]
                        if lbl ~= nil then
                            local v = favorDoDeus(d.nome)
                            local txt = d.nome
                            if v > 0 then txt = txt .. "   ·   " .. formatarFavor(v) end
                            if deusEhMacula(d.nome) then txt = txt .. "   ·   MÁCULA" end
                            lbl:setText(txt)
                            if deusEhMacula(d.nome) then lbl:setFontColor(COR.wine)
                            elseif v > 0 then lbl:setFontColor(COR.gold)
                            else lbl:setFontColor(COR.text) end
                        end
                    end
                end
            end
        end

        -- Clique numa divindade do popup.
        function escolherDeusFavor(nomeDeus)
            -- o mesmo popup serve para tres coisas; o modo diz qual
            if modoMaculaFavor then
                if not usuarioEhMestre() then return end
                sheet.maculaDivina = nomeDeus
                publicarNoChat(anuncio("macula", "MÁCULA DIVINA",
                     nickDoUsuario() ..
                    " marcou **" .. nomeDeus .. "** como mácula de " ..
                    tostring(sheet.nome or "personagem") .. ". Favores dessa divindade não serão mais concedidos."), COR.wine)
                modoMaculaFavor = false
                fecharPopupFavores()
                atualizarAbaFavores()
                return
            end
            if modoPrimordialFavor then
                -- conclui a troca: tira 3 do deus de origem, da 1 ao primordial
                local origem = favorPendentePrimordial
                if origem == nil then return end
                local lista = lerFavores()
                for _, f in ipairs(lista) do
                    if f.deus == origem then f.valor = f.valor - 3 end
                end
                local alvo = nil
                for _, f in ipairs(lista) do if f.deus == nomeDeus then alvo = f end end
                if alvo == nil then
                    alvo = {deus = nomeDeus, valor = 0}
                    table.insert(lista, alvo)
                end
                alvo.valor = math.min(alvo.valor + 1, FAVOR_MAXIMO)
                gravarFavores(lista)
                publicarNoChat(anuncio("troca", "TROCA DE FAVORES",
                     tostring(sheet.nome or "Personagem") ..
                    " trocou 3 favores de **" .. origem .. "** por 1 favor com o primordial **" ..
                    nomeDeus .. "**."), COR.aura)
                fecharPopupFavores()
                atualizarAbaFavores()
                return
            end
            ajustarFavor(nomeDeus, 0.5)
            atualizarListaFavoresPopup()
        end

        function escolherDeusFavorInteiro(nomeDeus)
            if modoPrimordialFavor then return end
            ajustarFavor(nomeDeus, 1)
            atualizarListaFavoresPopup()
        end

        -- ---------------------------------------------------------------
        -- RENDER
        -- ---------------------------------------------------------------
        local MAX_SLOTS_FAVOR = 12

        function avisarFavores(texto, cor)
            if self.abaFav_lblAviso ~= nil then
                self.abaFav_lblAviso:setText(tostring(texto or ""))
                self.abaFav_lblAviso:setFontColor(cor or COR.muted)
            end
            -- e dentro do popup, se ele estiver aberto (altura 0 = nada)
            if self.popFav_lblAviso ~= nil then
                local t = tostring(texto or "")
                self.popFav_lblAviso:setText(t)
                self.popFav_lblAviso:setFontColor(cor or COR.muted)
                pcall(function() self.popFav_lblAviso:setHeight((t ~= "") and 34 or 0) end)
            end
        end

        -- Os tres cards de patamar dividem a linha: dois com largura
        -- calculada e o terceiro em align="client", que absorve a sobra.
        -- Percentual nao existe no SDK, entao a conta e feita aqui.
        function ajustarPatamaresFavor()
            local total = 0
            pcall(function()
                local v = self.abaFav_linhaPatamares.width
                if type(v) == "number" and v > 320 then total = v end
            end)
            if total <= 0 then total = 1180 end
            local largura = math.floor((total - 20) / 3)
            if largura < 200 then largura = 200 end
            pcall(function() self.abaFav_pat1:setWidth(largura) end)
            pcall(function() self.abaFav_pat2:setWidth(largura) end)
        end

        function atualizarAbaFavores()
            if sheet == nil then return end
            ajustarPatamaresFavor()
            local lista = lerFavores()

            if self.abaFav_lblDivindades ~= nil then
                self.abaFav_lblDivindades:setText(tostring(#lista))
            end
            if self.abaFav_lblTotal ~= nil then
                self.abaFav_lblTotal:setText(formatarFavor(totalDeFavores()))
            end
            if self.abaFav_lblBencaos ~= nil then
                local q = 0
                for _, _d in ipairs(deusesAbencoados()) do q = q + 1 end
                self.abaFav_lblBencaos:setText(tostring(q))
            end
            if self.abaFav_lblAspecto ~= nil then
                local a = tostring(sheet.aspectoDivino or "")
                self.abaFav_lblAspecto:setText((a ~= "") and a or "—")
            end

            -- Selo de PROCLAMADO: marco raro, merece destaque proprio.
            local proclamado = tostring(sheet.proclamadoPor or "")
            definirAlturaPod(self.abaFav_wrapProclamado, (proclamado ~= "") and 54 or 0)
            if proclamado ~= "" and self.abaFav_lblProclamado ~= nil then
                self.abaFav_lblProclamado:setText("PROCLAMADO POR " .. string.upper(proclamado))
                if self.abaFav_lblProclamadoSub ~= nil then
                    self.abaFav_lblProclamadoSub:setText(
                        "Reconhecido publicamente como campeão da divindade em " ..
                        tostring(sheet.proclamadoData or "?") ..
                        ".  Poucos semideuses recebem este título em toda a vida.")
                end
            end

            definirAlturaPod(self.abaFav_wrapVazio, (#lista == 0) and 60 or 0)

            -- Histórico divino: só existe depois da primeira revogação. Numa
            -- ficha onde nunca se retirou nada, um painel vazio só ocupa
            -- espaço — por isso a altura sai do número de linhas gravadas.
            do
                local hist = tostring(sheet.historicoDivino or "")
                local qtd = 0
                for _ in string.gmatch(hist, "[^\n]+") do qtd = qtd + 1 end
                definirAlturaPod(self.abaFav_wrapHistorico,
                    (qtd > 0) and (36 + qtd * 17) or 0)
                if qtd > 0 and self.abaFav_lblHistorico ~= nil then
                    self.abaFav_lblHistorico:setText(hist)
                end
            end

            local ehMestre = usuarioEhMestre()
            definirLarguraPod(self.abaFav_wrapRegistrar, ehMestre and 240 or 0)
            definirLarguraPod(self.abaFav_wrapMacula, ehMestre and 240 or 0)
            -- revogar a proclamação: só o mestre, e só se houver proclamação
            definirLarguraPod(self.abaFav_wrapRevProc,
                (ehMestre and proclamado ~= "") and 96 or 0)

            for i = 1, MAX_SLOTS_FAVOR do
                local item = lista[i]
                definirAlturaPod(self["abaFav_wrap" .. i], (item ~= nil) and 96 or 0)
                if item ~= nil then
                    local lbl = self["abaFav_lblDeus" .. i]
                    if lbl ~= nil then lbl:setText(item.deus) end

                    local lblQtd = self["abaFav_lblQtd" .. i]
                    if lblQtd ~= nil then lblQtd:setText(formatarFavor(item.valor)) end

                    -- pips de meio ponto: 6 metades ate 3
                    for j = 1, 6 do
                        local pip = self["abaFav_pip" .. i .. "_" .. j]
                        if pip ~= nil then
                            if item.valor >= j * 0.5 then
                                pip:setColor(COR.gold); pip:setStrokeColor(COR.gold)
                            else
                                pip:setColor("#12181C"); pip:setStrokeColor("#3A4750")
                            end
                        end
                    end

                    local bonus, alvo = bonusSocialDoFavor(item.valor)
                    local lblBen = self["abaFav_lblBeneficio" .. i]
                    if lblBen ~= nil then
                        if bonus > 0 then
                            lblBen:setText("+" .. bonus .. " em testes sociais com " .. alvo)
                            lblBen:setFontColor(COR.moss)
                        else
                            lblBen:setText("meio favor — ainda sem benefício passivo")
                            lblBen:setFontColor(COR.faint)
                        end
                    end

                    local lblEstado = self["abaFav_lblEstado" .. i]
                    if lblEstado ~= nil then
                        local partes = {}
                        if tostring(sheet.aspectoDivino or "") == item.deus then
                            table.insert(partes, "seu Aspecto Divino")
                        end
                        if deusEhAcessivel(item.deus) and tostring(sheet.aspectoDivino or "") ~= item.deus then
                            table.insert(partes, "já abençoou você")
                        end
                        if deusEhMacula(item.deus) then table.insert(partes, "MÁCULA") end
                        lblEstado:setText(table.concat(partes, "  ·  "))
                    end

                    -- botoes: so o mestre, e so quando ha favores bastantes
                    definirLarguraPod(self["abaFav_wrapMais" .. i], ehMestre and 30 or 0)
                    definirLarguraPod(self["abaFav_wrapMeio" .. i], ehMestre and 38 or 0)
                    definirLarguraPod(self["abaFav_wrapMenos" .. i], ehMestre and 30 or 0)
                    definirLarguraPod(self["abaFav_wrapTroca1" .. i], (ehMestre and item.valor >= 2) and 150 or 0)
                    definirLarguraPod(self["abaFav_wrapTroca3" .. i], (ehMestre and item.valor >= 3) and 150 or 0)
                    definirLarguraPod(self["abaFav_wrapTrocaB" .. i], (ehMestre and item.valor >= 3
                        and not deusEhAcessivel(item.deus)) and 160 or 0)
                    -- degrau acima: o rotulo muda conforme a hierarquia
                    local destino, rotulo = degrauAcima(item.deus)
                    definirLarguraPod(self["abaFav_wrapTrocaP" .. i],
                        (ehMestre and item.valor >= 3 and destino ~= nil) and 180 or 0)
                    local lblP = self["abaFav_lblTrocaP" .. i]
                    if lblP ~= nil and rotulo ~= nil then
                        lblP:setText("3 › " .. rotulo)
                    end

                    -- PROCLAMAÇÃO: so com o proprio Aspecto Divino, e uma vez
                    local ehAspecto = (tostring(sheet.aspectoDivino or "") == item.deus)
                    local jaProclamado = (tostring(sheet.proclamadoPor or "") ~= "")
                    definirLarguraPod(self["abaFav_wrapProclamar" .. i],
                        (ehMestre and item.valor >= 3 and ehAspecto and not jaProclamado) and 190 or 0)

                    -- a bencao nao se aplica ao proprio aspecto
                    if ehAspecto then
                        definirLarguraPod(self["abaFav_wrapTrocaB" .. i], 0)
                    end

                    -- RETIRAR A BÊNÇÃO: só o mestre, e só onde existe uma
                    -- bênção para retirar. O botão de conceder e o de retirar
                    -- nunca aparecem juntos na mesma linha — um é o inverso do
                    -- outro, e ver os dois lado a lado convida ao clique errado.
                    local temBencao = false
                    for _, d in ipairs(deusesAbencoados()) do
                        if d == item.deus then temBencao = true end
                    end
                    definirLarguraPod(self["abaFav_wrapRevBencao" .. i],
                        (ehMestre and temBencao) and 150 or 0)
                end
            end
        end

        -- Botoes das linhas (indice fixo no XML).
        function favorMais(i)
            local item = lerFavores()[i]
            if item ~= nil then ajustarFavor(item.deus, 1) end
        end
        function favorMeio(i)
            local item = lerFavores()[i]
            if item ~= nil then ajustarFavor(item.deus, 0.5) end
        end
        function favorMenos(i)
            local item = lerFavores()[i]
            if item ~= nil then ajustarFavor(item.deus, -0.5) end
        end
        function favorTroca(i, tipo)
            local item = lerFavores()[i]
            if item ~= nil then trocarFavor(item.deus, tipo) end
        end

        -- Mácula: o mestre escolhe a divindade no mesmo popup.
        function definirMaculaDivina()
            if not usuarioEhMestre() then
                avisarFavores("Somente o MESTRE define a Mácula divina.", COR.wine)
                return
            end
            modoMaculaFavor = true
            abrirPopupFavores(false)
        end

        -- =================================================================
        -- INVENTARIO - modelo de dados
        --
        -- Cada item guarda os PROPRIOS valores. Ao vir do catalogo, os campos
        -- sao copiados uma vez; dali em diante o jogador edita o item e a
        -- ficha usa o que esta gravado nele. E o que permite uma armadura
        -- forjada, encantada ou danificada divergir do modelo do livro.
        --
        -- FORMATO: itens separados por ";", campos por "&", chave e valor
        -- por "=". Formato de chave e valor porque a lista de campos cresce
        -- (encantamentos, material, durabilidade atual...) e uma serializacao
        -- por posicao quebraria a cada campo novo.
        --
        -- Os separadores sao removidos de qualquer texto digitado.
        -- =================================================================

        -- Declarado ANTES de tudo: varias funcoes abaixo percorrem esta
        -- tabela, e em Lua uma local so existe a partir da linha em que
        -- aparece. Declarada no fim, "itemEstaEquipado" enxergava nil e
        -- nenhum item contava como equipado.
        -- ===============================================================
        -- SLOTS DE ENCANTAMENTO — dois eixos, os dois no livro 2.8
        --
        -- QUALIDADE (tabela "Qualidade"): o slot vem junto das Propriedades,
        --   automatico. Ruim, Comum e Otimo NAO tem linha de slot.
        --     "-> Excepcional  Propriedades: +3 de Durabilidade; 1 slot de
        --      encantamento; +2 de bonus total ou 2d6 de dano base ..."
        --     "-> Lendario ... 1 slot"  "-> Mitico ... 2 slots"
        --     "-> Divino ... 3 slots"
        --
        -- MATERIAL (tabela "Materiais"; o 2.9:201 chama a escala dela de
        --   RARIDADE): aqui o slot e UMA ESCOLHA entre varias, nao um
        --   automatico:
        --     "-> Raro  Propriedades: uma propriedade adicional: +2
        --      durabilidade ou 1d6 dano base ou +1 slot encantamento ou
        --      +1 de bonus total"
        --   Logo o numero abaixo e TETO, nao valor: quem forjou escolheu, e
        --   a ficha nao tem como saber qual. E por isso que o campo SLOTS
        --   MAXIMOS e editavel — a valvula de escape ja existia, faltava a
        --   conta certa por tras dela.
        --
        -- ITEM DE LOJA da para saber, porque o 2.9 diz onde a propriedade do
        --   material foi gasta: todo [Otima] e "Material incomum; Qualidade
        --   otima; 03/03 de durabilidade; +04" contra "02/02; +02" do Comum.
        --   Foi para durabilidade e bonus, nao para slot. Entao 0 — e por
        --   isso o item de catalogo deriva so da qualidade.
        --
        -- TETO, 2.8 "Regras e restricoes": "Nenhum item, com excecao de
        --   Artefatos Divinos ou daqueles que possuem efeitos negativos,
        --   pode possuir mais de 3 encantamentos."
        --
        -- CORRIGIDO na v0.41.0: ate a v0.40.2 a regra era
        --   `it.slotsEnc = (d.qualidade == "Otima") and 1 or 0`, que dava um
        --   slot aos 37 itens "Otima" da loja — que pela tabela tem ZERO — e
        --   zero a Granada Excepcional, que pela tabela tem UM. A regra
        --   estava invertida exatamente na fronteira.
        -- ===============================================================
        SLOTS_POR_QUALIDADE = {
            ["Ruim"] = 0, ["Comum"] = 0, ["Ótima"] = 0, ["Ótimo"] = 0,
            ["Excepcional"] = 1, ["Lendária"] = 1, ["Lendário"] = 1,
            ["Mítica"] = 2, ["Mítico"] = 2,
            ["Divina"] = 3, ["Divino"] = 3,
        }
        SLOTS_MAX_POR_MATERIAL = {
            ["Comum"] = 0, ["Incomum"] = 0, ["Raro"] = 1, ["Épico"] = 2,
            ["Lendário"] = 2, ["Mítico"] = 2, ["Divino"] = 3,
        }
        TETO_ENCANTAMENTOS = 3

        -- Uma propriedade, um dono: esta e a UNICA funcao que decide quantos
        -- slots um item tem. O popup de detalhe e a criacao do item chamam
        -- ela; nenhum dos dois repete a conta.
        function slotsDeEncantamento(qualidade, material)
            local q = SLOTS_POR_QUALIDADE[tostring(qualidade or "")] or 0
            local m = SLOTS_MAX_POR_MATERIAL[tostring(material or "")] or 0
            local total = q + m
            if total > TETO_ENCANTAMENTOS then total = TETO_ENCANTAMENTOS end
            return total, q, m
        end

        -- O material dos itens de loja: o 2.9 escreve, item por item,
        -- "[Comum]: Material comum" e "[Otima]: Material incomum".
        function materialDeCatalogo(qualidade)
            return (qualidade == "Ótima") and "Incomum" or "Comum"
        end

        local SLOTS_EQUIPADOS = {
            {chave = "armadura",   rotulo = "ARMADURA",     aceita = "armadura"},
            {chave = "acessorio1", rotulo = "ACESSÓRIO 1",  aceita = "acessorio"},
            {chave = "acessorio2", rotulo = "ACESSÓRIO 2",  aceita = "acessorio"},
            {chave = "primario",   rotulo = "PRIMÁRIO",     aceita = "maos"},
            {chave = "secundario", rotulo = "SECUNDÁRIO",   aceita = "maos"},
            {chave = "saque",      rotulo = "SAQUE RÁPIDO", aceita = "qualquer"},
            {chave = "bolso1",     rotulo = "BOLSO 1",      aceita = "qualquer"},
            {chave = "bolso2",     rotulo = "BOLSO 2",      aceita = "qualquer"},
        }

        function slotsEquipados() return SLOTS_EQUIPADOS end

        local CAMPOS_ITEM = {
            "nome", "categoria", "qualidade", "material", "onde", "qtd",
            "durMax", "durAtual", "dado", "danoExtra", "alcance",
            "reqAtributo", "reqValor",
            "absorcao", "deslocamento", "espacos",
            "aparar", "esquiva", "empatica", "telepatica",
            "periciaNome", "periciaBonus",
            "municoes", "slotsEnc", "encantamentos", "descricao",
            "visaoEscuro", "capacidade", "capacidadeTipo", "alcanceExtra",
            "imagem",
        }

        local NUMERICOS_ITEM = {
            qtd = true, durMax = true, durAtual = true, danoExtra = true,
            alcance = true, reqValor = true, absorcao = true, deslocamento = true,
            espacos = true, aparar = true, esquiva = true, empatica = true,
            telepatica = true, periciaBonus = true, municoes = true, slotsEnc = true,
            visaoEscuro = true, capacidade = true, alcanceExtra = true,
        }

        function limparTextoItem(s)
            return tostring(s or ""):gsub("[;&=|]", " ")
        end

        -- ---------------------------------------------------------------
        -- CAMPOS QUE GUARDAM URL
        --
        -- limparTextoItem troca ";&=|" por espaco, o que e certo para texto
        -- digitado e FATAL para um endereco: "?b=1&c=2" viraria "?b 1 c 2".
        -- Estes campos passam por escape percentual na hora de serializar, e
        -- voltam ao normal na leitura. Sem isso, colar a URL de uma imagem
        -- quebrava a lista inteira de itens no primeiro "&".
        -- ---------------------------------------------------------------
        local CAMPOS_URL_ITEM = {imagem = true}

        local function codificarURL(s)
            s = tostring(s or "")
            s = s:gsub("%%", "%%25")   -- o % vem primeiro, sempre
            s = s:gsub(";", "%%3B"):gsub("&", "%%26")
            s = s:gsub("=", "%%3D"):gsub("|", "%%7C")
            return s
        end

        local function decodificarURL(s)
            s = tostring(s or "")
            s = s:gsub("%%3B", ";"):gsub("%%26", "&")
            s = s:gsub("%%3D", "="):gsub("%%7C", "|")
            s = s:gsub("%%25", "%%")   -- o % volta por ultimo
            return s
        end

        function lerItens()
            local lista = {}
            if sheet == nil then return lista end
            for _, reg in ipairs(partirTexto(sheet.itensDados, ";")) do
                local it = {}
                for parte in string.gmatch(reg .. "&", "([^&]*)&") do
                    local chave, valor = parte:match("^([^=]+)=(.*)$")
                    if chave ~= nil then
                        if NUMERICOS_ITEM[chave] then it[chave] = tonumber(valor) or 0
                        elseif CAMPOS_URL_ITEM[chave] then it[chave] = decodificarURL(valor)
                        else it[chave] = valor end
                    end
                end
                if it.nome ~= nil and it.nome ~= "" then
                    it.onde = it.onde or "mochila"
                    it.qtd = it.qtd or 1
                    table.insert(lista, it)
                end
            end
            return lista
        end

        function gravarItens(lista)
            if sheet == nil then return end
            local partes = {}
            for _, it in ipairs(lista) do
                if it.nome ~= nil and it.nome ~= "" then
                    local campos = {}
                    for _, chave in ipairs(CAMPOS_ITEM) do
                        local v = it[chave]
                        if v ~= nil and v ~= "" and v ~= 0 then
                            if CAMPOS_URL_ITEM[chave] then v = codificarURL(v) end
                            table.insert(campos, chave .. "=" .. tostring(v))
                        end
                    end
                    table.insert(partes, table.concat(campos, "&"))
                end
            end
            sheet.itensDados = table.concat(partes, ";")
        end

        -- Copia os valores do catalogo para um item novo. Dali em diante o
        -- item vive por conta propria.
        function itemDoCatalogo(nome, qualidade)
            local d = CatalogoItens.buscar(nome, qualidade)
            if d == nil then return nil end
            local it = {
                nome = d.nome, categoria = d.categoria, qualidade = d.qualidade,
                material = (d.qualidade == "Ótima") and "Incomum" or "Comum",
                onde = "mochila", qtd = 1,
                durMax = n(d.durabilidade), durAtual = n(d.durabilidade),
                dado = d.dado or "", danoExtra = n(d.danoExtra),
                -- alcance da arma e alcance EXTRA da municao sao coisas
                -- diferentes: os Virotes dao +4m ao alcance de quem atira.
                alcance = n(d.alcance), alcanceExtra = n(d.alcanceExtra),
                reqAtributo = d.reqAtributo or "", reqValor = n(d.reqValor),
                absorcao = n(d.absorcao), deslocamento = n(d.deslocamento),
                aparar = n(d.defesaAparar), esquiva = 0, empatica = 0, telepatica = 0,
                periciaNome = d.periciaNome or "", periciaBonus = n(d.periciaBonus),
                municoes = n(d.municoes), encantamentos = "", descricao = "",
                espacos = n(d.espacos), visaoEscuro = n(d.visaoEscuro),
                capacidade = n(d.capacidade), capacidadeTipo = d.capacidadeTipo or "",
            }
            -- "+N em duas defesas a escolha": o valor fica guardado e o
            -- jogador diz onde aplicar no editor
            -- O que o livro descreve mas a ficha nao tem como aplicar sozinha
            -- (escolhas, receitas de forja) vira texto na descricao, para o
            -- jogador ver e decidir onde lancar.
            local obs = {}
            if d.defesaEscolha ~= nil then
                -- Cinto e Colar nomeiam AS DUAS defesas; armaduras deixam livre.
                if d.defesaLista ~= nil then
                    table.insert(obs, "Distribua +" .. d.defesaEscolha .. " entre " ..
                        d.defesaLista .. " — apenas essas duas.")
                else
                    table.insert(obs, "Distribua +" .. d.defesaEscolha ..
                        " entre duas defesas, à sua escolha, nos campos acima.")
                end
            end
            -- consumiveis e itens narrativos: o efeito vai inteiro na descricao
            if d.efeito ~= nil and d.efeito ~= "" then
                table.insert(obs, d.efeito)
            end
            if d.curaDado ~= nil then
                table.insert(obs, "Restaura " .. d.curaDado .. "+(" .. tostring(d.curaFormula) ..
                    ") de " .. tostring(d.curaTipo) .. ".")
            end
            if d.periciaOpcoes ~= nil then
                local quanto = n(d.periciaBonus) + n(d.periciaDistribuir)
                table.insert(obs, "Escolha onde entram os +" .. quanto ..
                    ": " .. d.periciaOpcoes .. ".")
            end
            if d.danoArea ~= nil then
                table.insert(obs, "Aplica " .. d.danoArea .. " de dano [" ..
                    tostring(d.areaElemento) .. "] num raio de " .. n(d.areaRaio) .. " metros.")
            end
            if d.notas ~= nil and d.notas ~= "" then
                table.insert(obs, "Forja: " .. d.notas .. ".")
            end
            it.descricao = capitalizar(table.concat(obs, " "))
            -- Slots de encantamento: ver SLOTS_POR_QUALIDADE, com o texto
            -- do livro. O material entra no dado do item (ate a v0.40.2 ele
            -- so existia na tela do popup, e o item ia para a mochila sem).
            it.material = materialDeCatalogo(d.qualidade)
            it.slotsEnc = slotsDeEncantamento(d.qualidade, it.material)
            return it
        end

        -- ---------------------------------------------------------------
        -- ENCANTAMENTOS DO ITEM
        -- Guardados como nomes separados por vírgula dentro do campo.
        -- ---------------------------------------------------------------
        function encantamentosDoItem(it)
            local r = {}
            for _, nome in ipairs(partirTexto((it or {}).encantamentos, ",")) do
                if nome ~= "" then table.insert(r, nome) end
            end
            return r
        end

        function gravarEncantamentos(it, lista)
            it.encantamentos = table.concat(lista, ",")
        end

        -- Efeitos numericos que os encantamentos somam ao item.
        function efeitosDosEncantamentos(it)
            local r = {absorcao = 0, espacos = 0, aparar = 0, esquiva = 0,
                       empatica = 0, telepatica = 0}
            for _, nome in ipairs(encantamentosDoItem(it)) do
                local e = CatalogoEncantamentos.buscar(nome)
                if e ~= nil and e.efeitos ~= nil then
                    for chave, valor in pairs(e.efeitos) do
                        r[chave] = (r[chave] or 0) + valor
                    end
                end
            end
            return r
        end

        -- =================================================================
        -- EFEITOS DO EQUIPADO
        -- Le os valores GRAVADOS no item, e nao o catalogo: e o que faz a
        -- edicao valer na hora.
        -- =================================================================
        function itemEstaEquipado(it)
            for _, s in ipairs(SLOTS_EQUIPADOS) do
                if s.chave == it.onde then return true end
            end
            return false
        end

        -- ---------------------------------------------------------------
        -- DURABILIDADE
        --
        -- REGRA DA MESA (21/08/2026): item com durabilidade ZERADA fica
        -- QUEBRADO — continua equipado e visivel, mas para de entrar nos
        -- calculos ate ser consertado. Nao desequipa sozinho: mexer no
        -- equipamento do jogador no meio do turno gera confusao.
        --
        -- O livro nao diz o que acontece ao zerar (fala em perder
        -- durabilidade em varios lugares — manobra defensiva, arremesso,
        -- forja — mas nunca no efeito de chegar a zero). Isto e ACORDO DE
        -- MESA, nao texto do livro.
        --
        -- Item SEM durabilidade (durMax = 0) nunca quebra: e o caso de
        -- projeteis, consumiveis e de tudo que a categoria nao cobre.
        -- ---------------------------------------------------------------
        function itemTemDurabilidade(it)
            return it ~= nil and n(it.durMax) > 0
        end

        function itemQuebrado(it)
            return itemTemDurabilidade(it) and n(it.durAtual) <= 0
        end

        -- Gastar e consertar durabilidade e acao de JOGO: fica livre mesmo
        -- com a ficha finalizada, como equipar e gastar municao.
        function ajustarDurItem(indice, delta)
            local lista = lerItens()
            local it = lista[indice]
            if not itemTemDurabilidade(it) then return end
            local novo = n(it.durAtual) + delta
            if novo < 0 then novo = 0 end
            if novo > n(it.durMax) then novo = n(it.durMax) end
            if novo == n(it.durAtual) then return end

            local quebrouAgora = (novo <= 0) and (n(it.durAtual) > 0)
            local consertouAgora = (novo > 0) and (n(it.durAtual) <= 0)
            it.durAtual = novo
            gravarItens(lista)

            if quebrouAgora then
                avisarInventario("\"" .. tostring(it.nome or "item") ..
                    "\" QUEBROU. Continua equipado, mas os bônus dele saíram dos cálculos até ser consertado.", COR.wine)
            elseif consertouAgora then
                avisarInventario("\"" .. tostring(it.nome or "item") ..
                    "\" foi consertado. Os bônus voltaram para os cálculos.", COR.moss)
            end
            recalcularTudo()
        end

        function efeitosEquipados()
            local r = {aparar = 0, esquiva = 0, empatica = 0, telepatica = 0,
                       absorcao = 0, deslocamento = 0, espacos = 0, pericias = {}}
            for _, it in ipairs(lerItens()) do
                -- item quebrado continua equipado e NAO entra na conta
                if itemEstaEquipado(it) and not itemQuebrado(it) then
                    for _, chave in ipairs({"aparar", "esquiva", "empatica", "telepatica"}) do
                        r[chave] = r[chave] + n(it[chave])
                    end
                    r.absorcao = r.absorcao + n(it.absorcao)
                    r.deslocamento = r.deslocamento + n(it.deslocamento)
                    r.espacos = r.espacos + n(it.espacos)
                    if it.periciaNome ~= nil and it.periciaNome ~= "" then
                        r.pericias[it.periciaNome] = (r.pericias[it.periciaNome] or 0) + n(it.periciaBonus)
                    end
                    -- encantamentos somam por cima
                    local ef = efeitosDosEncantamentos(it)
                    for chave, valor in pairs(ef) do
                        if r[chave] ~= nil then r[chave] = r[chave] + valor end
                    end
                end
            end
            return r
        end

        function bonusItemDefesa(qual)
            local ok, e = pcall(efeitosEquipados)
            if not ok or e == nil then return 0 end
            return n(e[qual])
        end

        function bonusItemPericia(nomePericia)
            local ok, e = pcall(efeitosEquipados)
            if not ok or e == nil then return 0 end
            return n(e.pericias[nomePericia])
        end

        -- "Contrabando" e afins dao espaco extra de mochila.
        function espacosExtrasDeItens()
            local ok, e = pcall(efeitosEquipados)
            if not ok or e == nil then return 0 end
            return n(e.espacos)
        end

        -- =================================================================
        -- EDITOR DE ITEM
        -- =================================================================
        itemEmEdicao = nil

        -- Campos que aparecem no editor, por categoria. Um consumivel nao
        -- precisa de campo de defesa, e uma armadura nao precisa de alcance.
        local CAMPOS_POR_CATEGORIA = {
            ["Armadura"]  = {"durabilidade", "requisito", "defesas", "absorcao", "deslocamento", "encantamento"},
            ["Armas"]     = {"durabilidade", "requisito", "dano", "alcance", "defesas", "encantamento"},
            ["Projéteis"] = {"dano", "alcance", "municoes"},
            ["Acessórios e Ferramentas"] = {"durabilidade", "pericia", "espacos", "encantamento"},
            ["Consumíveis"] = {"municoes"},
            -- As quatro categorias recuperadas da Loja em 21/08/2026.
            -- Nenhuma equipa no personagem: sela equipa na MONTARIA, e kits,
            -- utilidades e espólios vivem na mochila. Por isso nenhuma delas
            -- tem "defesas", "absorcao" nem "requisito".
            ["Montarias"]  = {"durabilidade", "espacos"},
            ["Kits"]       = {"municoes"},       -- "cada kit possuí por padrão 5 usos"
            ["Utilidades"] = {},
            ["Espólios"]   = {},
            ["Livre"]     = {"durabilidade", "requisito", "dano", "alcance", "defesas",
                             "absorcao", "deslocamento", "pericia", "espacos", "encantamento"},
        }

        function camposDoEditor(categoria)
            return CAMPOS_POR_CATEGORIA[categoria or ""] or CAMPOS_POR_CATEGORIA["Livre"]
        end

        function abrirEditorItem(indice)
            local lista = lerItens()
            local it = lista[indice]
            if it == nil or self.popEditarItem == nil then return end
            itemEmEdicao = indice
            preencherEditorItem(it)
            abrirPopupAjustado(self.popEditarItem, 860, 700)
        end

        function fecharEditorItem()
            if self.popEditarItem ~= nil then self.popEditarItem:close() end
            itemEmEdicao = nil
        end

        local function porEdit(nome, valor)
            local w = self["edIt_" .. nome]
            if w ~= nil then w:setText(tostring(valor or "")) end
        end

        local function lerEdit(nome)
            local w = self["edIt_" .. nome]
            if w == nil then return "" end
            return tostring(w:getText() or "")
        end

        function preencherEditorItem(it)
            -- IMAGEM: o widget <image> e o campo de URL apontam os dois para
            -- sheet.imagemItemEdicao, um campo de RASCUNHO na raiz da ficha.
            --
            -- Isso e de proposito, e resolve a armadilha do SDK: dentro de um
            -- popup, "field=" resolve contra a raiz da ficha e nao contra o
            -- item da lista. Em vez de brigar com isso, usamos a raiz como
            -- rascunho: copia-se o valor do item para ela ao abrir, e de volta
            -- ao salvar. Os dois controles editam o MESMO valor — quem sobe um
            -- arquivo grava a URL do blob ali, quem prefere colar um link
            -- escreve no mesmo lugar.
            sheet.imagemItemEdicao = tostring(it.imagem or "")
            porEdit("nome", it.nome)
            porEdit("material", it.material)
            porEdit("qualidade", it.qualidade)
            porEdit("durAtual", n(it.durAtual))
            porEdit("durMax", n(it.durMax))
            porEdit("dado", it.dado)
            porEdit("danoExtra", n(it.danoExtra))
            porEdit("alcance", n(it.alcance))
            -- estes dois sao SELETORES: mostram "—" quando vazios
            if self.edIt_reqAtributo ~= nil then
                local v = tostring(it.reqAtributo or "")
                self.edIt_reqAtributo:setText((v ~= "") and v or "—")
                self.edIt_reqAtributo:setFontColor((v ~= "") and COR.text or COR.faint)
            end
            porEdit("reqValor", n(it.reqValor))
            porEdit("absorcao", n(it.absorcao))
            porEdit("deslocamento", n(it.deslocamento))
            porEdit("espacos", n(it.espacos))
            porEdit("aparar", n(it.aparar))
            porEdit("esquiva", n(it.esquiva))
            porEdit("empatica", n(it.empatica))
            porEdit("telepatica", n(it.telepatica))
            if self.edIt_periciaNome ~= nil then
                local v = tostring(it.periciaNome or "")
                self.edIt_periciaNome:setText((v ~= "") and v or "—")
                self.edIt_periciaNome:setFontColor((v ~= "") and COR.text or COR.faint)
            end
            porEdit("periciaBonus", n(it.periciaBonus))
            porEdit("municoes", n(it.municoes))
            porEdit("visaoEscuro", n(it.visaoEscuro))
            porEdit("slotsEnc", n(it.slotsEnc))
            porEdit("descricao", it.descricao)

            if self.edIt_lblTitulo ~= nil then
                self.edIt_lblTitulo:setText(string.upper(it.nome or "ITEM"))
            end
            if self.edIt_lblCategoria ~= nil then
                self.edIt_lblCategoria:setText((it.categoria or "Livre") ..
                    "   ·   " .. (it.qualidade or "") ..
                    "   ·   " .. (it.material or ""))
            end

            -- so mostra os grupos que fazem sentido para a categoria
            local ativos = {identidade = true}
            for _, g in ipairs(camposDoEditor(it.categoria)) do ativos[g] = true end
            -- Alturas iguais as do XML. Com 56 a caixa de texto virava uma
            -- linha fina: nao cabia titulo (16) + rotulo (15) + campo.
            local alturas = {identidade = 80, durabilidade = 80, requisito = 80,
                             dano = 80, alcance = 0, defesas = 88, absorcao = 80,
                             deslocamento = 0, pericia = 80, espacos = 0,
                             municoes = 80, encantamento = 128}
            for grupo, altura in pairs(alturas) do
                local w = self["edIt_grupo" .. grupo]
                if w ~= nil then
                    definirAlturaPod(w, ativos[grupo] and altura or 0)
                end
            end

            atualizarListaEncantamentosItem(it)
        end

        -- Atributo e pericia sao ESCOLHIDOS numa lista, e nao digitados: o
        -- nome precisa bater exatamente com o do catalogo para a automacao
        -- funcionar, e digitar dava margem a erro de grafia.
        function abrirSeletorAtributoItem()
            if itemEmEdicao == nil or self.popSelAtributo == nil then return end
            abrirPopupAjustado(self.popSelAtributo, 420, 420)
        end

        function escolherAtributoItem(nome)
            if itemEmEdicao == nil then return end
            if not podeEditarCriacao() then
                if self.popSelAtributo ~= nil then self.popSelAtributo:close() end
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            local it = lista[itemEmEdicao]
            if it ~= nil then
                it.reqAtributo = nome
                gravarItens(lista)
                if self.edIt_reqAtributo ~= nil then
                    self.edIt_reqAtributo:setText((nome ~= "") and nome or "—")
                    self.edIt_reqAtributo:setFontColor((nome ~= "") and COR.text or COR.faint)
                end
            end
            if self.popSelAtributo ~= nil then self.popSelAtributo:close() end
        end

        function abrirSeletorPericiaItem()
            if itemEmEdicao == nil or self.popSelPericia == nil then return end
            abrirPopupAjustado(self.popSelPericia, 520, 620)
        end

        function escolherPericiaItem(nome)
            if itemEmEdicao == nil then return end
            if not podeEditarCriacao() then
                if self.popSelPericia ~= nil then self.popSelPericia:close() end
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            local it = lista[itemEmEdicao]
            if it ~= nil then
                it.periciaNome = nome
                gravarItens(lista)
                if self.edIt_periciaNome ~= nil then
                    self.edIt_periciaNome:setText((nome ~= "") and nome or "—")
                    self.edIt_periciaNome:setFontColor((nome ~= "") and COR.text or COR.faint)
                end
            end
            if self.popSelPericia ~= nil then self.popSelPericia:close() end
        end

        function salvarEditorItem()
            if itemEmEdicao == nil then return end
            -- editar os atributos do item e criacao: o que ele FAZ nao muda
            -- no meio da campanha sem o mestre saber
            if not podeEditarCriacao() then
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            local it = lista[itemEmEdicao]
            if it == nil then return end

            local nome = limparTextoItem(lerEdit("nome")):gsub("^%s+",""):gsub("%s+$","")
            if nome == "" then
                avisarInventario("O item precisa de um nome.", COR.wine); return
            end
            it.nome = nome
            -- a imagem NAO passa por limparTextoItem: ela e uma URL, e a
            -- limpeza trocaria "&" e "=" por espaco. Ver CAMPOS_URL_ITEM.
            it.imagem = tostring(sheet.imagemItemEdicao or "")
            it.material = limparTextoItem(lerEdit("material"))
            it.qualidade = limparTextoItem(lerEdit("qualidade"))
            it.durAtual = n(lerEdit("durAtual"))
            it.durMax = n(lerEdit("durMax"))
            it.dado = limparTextoItem(lerEdit("dado"))
            it.danoExtra = n(lerEdit("danoExtra"))
            it.alcance = n(lerEdit("alcance"))
            it.reqValor = n(lerEdit("reqValor"))
            it.absorcao = n(lerEdit("absorcao"))
            it.deslocamento = n(lerEdit("deslocamento"))
            it.espacos = n(lerEdit("espacos"))
            it.aparar = n(lerEdit("aparar"))
            it.esquiva = n(lerEdit("esquiva"))
            it.empatica = n(lerEdit("empatica"))
            it.telepatica = n(lerEdit("telepatica"))
            it.periciaBonus = n(lerEdit("periciaBonus"))
            it.municoes = n(lerEdit("municoes"))
            it.visaoEscuro = n(lerEdit("visaoEscuro"))
            it.slotsEnc = n(lerEdit("slotsEnc"))
            it.descricao = limparTextoItem(lerEdit("descricao"))

            gravarItens(lista)
            avisarInventario(it.nome .. " atualizado." ..
                (itemEstaEquipado(it) and " Os valores já entraram na ficha." or ""), COR.moss)
            fecharEditorItem()
            recalcularTudo()
        end

        -- ---------------------------------------------------------------
        -- ENCANTAMENTOS NO EDITOR
        -- ---------------------------------------------------------------
        function atualizarListaEncantamentosItem(it)
            local lista = encantamentosDoItem(it)
            if self.edIt_lblEncantados ~= nil then
                if #lista > 0 then
                    self.edIt_lblEncantados:setText(table.concat(lista, "   ·   "))
                    self.edIt_lblEncantados:setFontColor(COR.aura)
                else
                    self.edIt_lblEncantados:setText("nenhum encantamento aplicado")
                    self.edIt_lblEncantados:setFontColor(COR.faint)
                end
            end
            if self.edIt_lblSlotsInfo ~= nil then
                local usados, total = #lista, n(it.slotsEnc)
                self.edIt_lblSlotsInfo:setText(usados .. " de " .. total .. " slots usados")
                if usados > total then
                    self.edIt_lblSlotsInfo:setFontColor(COR.wine)
                else
                    self.edIt_lblSlotsInfo:setFontColor(COR.muted)
                end
            end
        end

        function abrirPopupEncantamentos()
            if itemEmEdicao == nil or self.popEncantamentos == nil then return end
            atualizarListaEncPopup()
            abrirPopupAjustado(self.popEncantamentos, 800, 640)
        end

        function fecharPopupEncantamentos()
            if self.popEncantamentos ~= nil then self.popEncantamentos:close() end
        end

        function atualizarListaEncPopup()
            local lista = lerItens()
            local it = lista[itemEmEdicao]
            if it == nil then return end
            local aplicados = {}
            for _, nome in ipairs(encantamentosDoItem(it)) do aplicados[nome] = true end
            for _, e in ipairs(CatalogoEncantamentos.itens) do
                local lbl = self["lblEnc_" .. chavePoder(e.nome)]
                local rect = self["rectEnc_" .. chavePoder(e.nome)]
                if lbl ~= nil then
                    if aplicados[e.nome] then
                        lbl:setFontColor(COR.gold)
                    else
                        lbl:setFontColor(COR.text)
                    end
                end
                if rect ~= nil then
                    rect:setStrokeColor(aplicados[e.nome] and COR.gold or COR.line)
                end
            end
        end

        function alternarEncantamento(nome)
            if itemEmEdicao == nil then return end
            if not podeEditarCriacao() then
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            local it = lista[itemEmEdicao]
            if it == nil then return end
            local atuais = encantamentosDoItem(it)
            local achou = nil
            for i, x in ipairs(atuais) do if x == nome then achou = i end end
            if achou ~= nil then
                table.remove(atuais, achou)
            else
                if #atuais >= n(it.slotsEnc) then
                    avisarInventario("Este item tem " .. n(it.slotsEnc) ..
                        " slot(s) de encantamento. Aumente os slots no editor se ele foi forjado com mais.", COR.muted)
                    return
                end
                table.insert(atuais, nome)
            end
            gravarEncantamentos(it, atuais)
            gravarItens(lista)
            atualizarListaEncantamentosItem(it)
            atualizarListaEncPopup()
            recalcularTudo()
        end

        -- =================================================================
        -- INVENTARIO - estrutura
        --
        -- Tirada da ficha oficial do livro:
        --   Bolsa de moedas  Drams, Florins, Lunaris e Aureus, em campos
        --                    separados (a mesa nao converte automaticamente)
        --   Equipados        8 slots fixos
        --   Mochila          limitada por [2 + Forca + Rank]; cada lote de
        --                    2 consumiveis iguais ocupa 1 espaco
        --   Bau              sem limite, exige residencia
        -- =================================================================


        -- Resumo dos efeitos GRAVADOS no item (nao os do catalogo).
        -- omitirDur: a LINHA do inventario ja mostra a durabilidade no
        -- proprio controle de + e −, entao repeti-la no resumo so polui.
        -- O subtitulo do slot equipado continua mostrando, porque la nao ha
        -- controle nenhum.
        function resumoDoItem(it, omitirDur)
            if it == nil then return "" end
            local p = {}
            -- DURABILIDADE PRIMEIRO no slot equipado (v0.42.1, M-08): o slot
            -- tem um quarto da linha e o resumo e truncado com reticencias;
            -- a durabilidade e o unico numero que MUDA em jogo, e ficava por
            -- ultimo — justamente a parte que sumia. Na linha do inventario
            -- (omitirDur) o controle de +/− ja a mostra.
            if n(it.durMax) ~= 0 and not omitirDur then
                table.insert(p, "dur. " .. n(it.durAtual) .. "/" .. n(it.durMax))
            end
            if it.dado ~= nil and it.dado ~= "" then table.insert(p, it.dado) end
            if n(it.danoExtra) ~= 0 then table.insert(p, "+" .. n(it.danoExtra) .. " de dano") end
            if n(it.alcance) ~= 0 then table.insert(p, n(it.alcance) .. "m de alcance") end
            if n(it.alcanceExtra) ~= 0 then table.insert(p, "+" .. n(it.alcanceExtra) .. "m ao alcance da arma") end
            for chave, rot in pairs({aparar = "Aparar", esquiva = "Esquiva",
                                     empatica = "Empática", telepatica = "Telepática"}) do
                if n(it[chave]) ~= 0 then table.insert(p, "+" .. n(it[chave]) .. " " .. rot) end
            end
            if n(it.absorcao) ~= 0 then table.insert(p, n(it.absorcao) .. "% absorção") end
            if n(it.deslocamento) ~= 0 then table.insert(p, n(it.deslocamento) .. "m deslocamento") end
            if n(it.espacos) ~= 0 then table.insert(p, "+" .. n(it.espacos) .. " espaços") end
            if it.periciaNome ~= nil and it.periciaNome ~= "" then
                table.insert(p, "+" .. n(it.periciaBonus) .. " em " .. it.periciaNome)
            end
            if n(it.municoes) ~= 0 then table.insert(p, n(it.municoes) .. " munições") end
            if it.reqAtributo ~= nil and it.reqAtributo ~= "" then
                table.insert(p, "requer " .. n(it.reqValor) .. " de " .. it.reqAtributo)
            end
            local enc = encantamentosDoItem(it)
            if #enc > 0 then table.insert(p, "✦ " .. table.concat(enc, ", ")) end
            if #p == 0 then return "sem efeitos" end
            return table.concat(p, "  ·  ")
        end

        function itemNoSlot(chaveSlot)
            for _, it in ipairs(lerItens()) do
                if it.onde == chaveSlot then return it end
            end
            return nil
        end

        -- ---------------------------------------------------------------
        -- CAPACIDADE DA MOCHILA
        -- "Cada lote de 2 consumiveis iguais consome 1 espaco" - por isso a
        -- conta nao e simplesmente o numero de linhas.
        -- ---------------------------------------------------------------
        function espacosOcupados()
            local total = 0
            for _, it in ipairs(lerItens()) do
                if it.onde == "mochila" then
                    local ehConsumivel = (it.categoria == "Consumíveis") or (n(it.municoes) > 0)
                    local q = math.max(1, n(it.qtd))
                    if ehConsumivel then
                        total = total + math.ceil(q / 2)
                    else
                        total = total + q
                    end
                end
            end
            return total
        end

        function capacidadeMochila()
            if sheet == nil then return 0 end
            return n(sheet.capacidadeMochila) + n(sheet.mochilaBonus) + espacosExtrasDeItens()
        end

        -- ---------------------------------------------------------------
        -- REQUISITOS
        -- ---------------------------------------------------------------
        function valorDoAtributo(nomeAtributo)
            if sheet == nil then return 0 end
            local mapa = {["Força"]="forca", ["Destreza"]="destreza",
                ["Constituição"]="constituicao", ["Inteligência"]="inteligencia",
                ["Sabedoria"]="sabedoria", ["Carisma"]="carisma", ["Manipulação"]="manipulacao"}
            local campo = mapa[nomeAtributo]
            if campo == nil then return 0 end
            return n(sheet[campo .. "Total"])
        end

        -- Devolve false e o motivo quando o item nao pode ser equipado.
        -- Le o requisito GRAVADO no item: uma arma forjada pode exigir mais
        -- ou menos que o modelo do catalogo.
        function podeEquipar(it, chaveSlot)
            if it == nil then return false, "" end
            if it.reqAtributo ~= nil and it.reqAtributo ~= "" and n(it.reqValor) > 0 then
                local tem = valorDoAtributo(it.reqAtributo)
                if tem < n(it.reqValor) then
                    -- As tres partes da recusa (Lei 2): por que, o que a ficha
                    -- ve, e QUEM libera — esta ultima faltava (M-07). O caminho
                    -- de liberacao e o proprio requisito gravado no item, que
                    -- e criacao e, com a ficha finalizada, so o mestre edita.
                    return false, "Requer " .. n(it.reqValor) .. " de " .. it.reqAtributo ..
                        " e você tem " .. tem .. " [a ficha vê " .. it.reqAtributo .. " total = " .. tem ..
                        "]. Quem libera: o MESTRE, editando o requisito do item (o que um item exige é criação)."
                end
            end
            local d = CatalogoItens.buscar(it.nome, it.qualidade)
            local slotItem = (d ~= nil) and d.slot or "qualquer"
            for _, s in ipairs(SLOTS_EQUIPADOS) do
                if s.chave == chaveSlot then
                    if s.aceita ~= "qualquer" and slotItem ~= "qualquer" and slotItem ~= s.aceita then
                        return false, "Este slot não aceita " .. string.lower(tostring(it.categoria or "isso")) .. "."
                    end
                end
            end
            return true, ""
        end

        -- LIVRE: trocar de arma ou vestir armadura e acao de jogo. Travar
        -- isso obrigaria a chamar o mestre a cada combate.
        function equiparItem(indice, chaveSlot)
            if sheet == nil then return end
            local lista = lerItens()
            local it = lista[indice]
            if it == nil then return end

            local ok, motivo = podeEquipar(it, chaveSlot)
            if not ok then
                avisarInventario(motivo, COR.wine)
                -- A recusa fica "viva": o proximo recalculo a reescreve com
                -- o estado atual (L-05). Ate a v0.41.1 o jogador subia a
                -- Forca para 4, a mochila reagia, e o aviso continuava
                -- dizendo "voce tem 0".
                recusaEquiparPendente = {indice = indice, slot = chaveSlot}
                return
            end
            recusaEquiparPendente = nil

            -- o slot e de ocupacao unica: o que estava la volta para a mochila
            for _, outro in ipairs(lista) do
                if outro.onde == chaveSlot then outro.onde = "mochila" end
            end
            it.onde = chaveSlot
            gravarItens(lista)
            avisarInventario(it.nome .. " equipado.", COR.moss)
            recalcularTudo()
        end

        -- Clicar num slot equipado abre o editor daquele item.
        function editarOuDesequipar(chaveSlot)
            local lista = lerItens()
            for i, it in ipairs(lista) do
                if it.onde == chaveSlot then abrirEditorItem(i); return end
            end
        end

        function desequiparItem(chaveSlot)
            local lista = lerItens()
            for _, it in ipairs(lista) do
                if it.onde == chaveSlot then it.onde = "mochila" end
            end
            gravarItens(lista)
            recalcularTudo()
        end

        -- LIVRE mesmo com a ficha finalizada: guardar e tirar coisas da
        -- mochila acontece o tempo todo em jogo.
        function moverItem(indice, destino)
            local lista = lerItens()
            local it = lista[indice]
            if it == nil then return end
            if destino == "mochila" and it.onde ~= "mochila" then
                -- volta para a mochila: confere espaco
                if espacosOcupados() >= capacidadeMochila() then
                    avisarInventario("Mochila cheia (" .. espacosOcupados() .. "/" ..
                        capacidadeMochila() .. " espaços).", COR.wine)
                    return
                end
            end
            it.onde = destino
            gravarItens(lista)
            recalcularTudo()
        end

        function removerItem(indice)
            if not podeEditarCriacao() then
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            if lista[indice] == nil then return end
            local nome = lista[indice].nome
            table.remove(lista, indice)
            gravarItens(lista)
            avisarInventario(nome .. " removido.", COR.muted)
            recalcularTudo()
        end

        -- LIVRE: gastar municao e consumir pocao sao acoes de jogo.
        function ajustarQtdItem(indice, delta)
            local lista = lerItens()
            local it = lista[indice]
            if it == nil then return end
            it.qtd = math.max(1, n(it.qtd) + delta)
            gravarItens(lista)
            recalcularTudo()
        end

        -- ---------------------------------------------------------------
        -- EFEITOS DO QUE ESTA EQUIPADO
        --
        -- So conta o que esta nos slots: item na mochila ou no bau nao
        -- bonifica nada.
        -- ---------------------------------------------------------------
        -- ---------------------------------------------------------------
        -- ADICIONAR
        -- ---------------------------------------------------------------
        function adicionarItemCatalogo(nome, qualidade)
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            if #lista >= 40 then
                avisarInventario("Limite de 40 itens na ficha.", COR.wine); return
            end
            local it = itemDoCatalogo(nome, qualidade)
            if it == nil then
                avisarInventario("Item não encontrado no catálogo.", COR.wine); return
            end
            table.insert(lista, it)
            gravarItens(lista)
            avisarInventario(nome .. " (" .. qualidade .. ") foi para a mochila.", COR.moss)
            recalcularTudo()
        end

        -- Cria um item em branco e ja abre o editor: e la que o jogador
        -- define nome e efeitos, sem precisar digitar antes.
        function adicionarItemLivre()
            if sheet == nil then return end
            if not podeEditarCriacao() then
                avisarInventario(motivoTravaCriacao(), COR.wine); return
            end
            local lista = lerItens()
            if #lista >= 40 then
                avisarInventario("Limite de 40 itens na ficha.", COR.wine); return
            end
            table.insert(lista, {nome = "Item novo", categoria = "Livre", qualidade = "Livre",
                                 material = "", onde = "mochila", qtd = 1, slotsEnc = 0})
            gravarItens(lista)
            recalcularTudo()
            abrirEditorItem(#lista)
        end

        -- ---------------------------------------------------------------
        -- RENDER
        -- ---------------------------------------------------------------
        local MAX_LINHAS_ITEM = 40

        function avisarInventario(texto, cor)
            if self.abaInv_lblAviso == nil then return end
            self.abaInv_lblAviso:setText(tostring(texto or ""))
            self.abaInv_lblAviso:setFontColor(cor or COR.muted)
        end

        local ROTULO_DEF_ITEM = {aparar = "Aparar", esquiva = "Esquiva",
                                 empatica = "Empática", telepatica = "Telepática"}

        recusaEquiparPendente = nil

        -- Reavalia a ultima recusa de equipar com os numeros de AGORA. Se o
        -- jogador corrigiu o que a ficha pediu, o aviso diz isso; se nao, o
        -- aviso e reescrito com o valor atual em vez de ficar congelado.
        function reavaliarRecusaEquipar(lista)
            local r = recusaEquiparPendente
            if r == nil then return end
            local it = lista[r.indice]
            if it == nil or itemEstaEquipado(it) then recusaEquiparPendente = nil; return end
            local ok, motivo = podeEquipar(it, r.slot)
            if ok then
                avisarInventario("Agora dá: " .. tostring(it.nome or "o item") ..
                    " cumpre o requisito. Clique de novo para equipar.", COR.moss)
                recusaEquiparPendente = nil
            else
                avisarInventario(motivo, COR.wine)
            end
        end

        function atualizarAbaInventario()
            if sheet == nil then return end
            local lista = lerItens()
            local efeitos = efeitosEquipados()
            pcall(function() reavaliarRecusaEquipar(lista) end)

            -- ----- topo: capacidade e efeitos -----
            local usados, capacidade = espacosOcupados(), capacidadeMochila()
            if self.abaInv_lblMochila ~= nil then
                self.abaInv_lblMochila:setText(usados .. " / " .. capacidade)
                if usados > capacidade then
                    self.abaInv_lblMochila:setFontColor(COR.wine)
                else
                    self.abaInv_lblMochila:setFontColor(COR.gold)
                end
            end
            if self.abaInv_lblMochilaConta ~= nil then
                self.abaInv_lblMochilaConta:setText("2 + For " .. valorDoAtributo("Força") ..
                    " + rank " .. (DadosSistema.ordemRank[tostring(sheet.rank or "E")] or 1))
            end
            if self.abaInv_lblAbsorcao ~= nil then
                -- A absorcao da FORMA BESTIAL entra aqui, e o teto da fase da
                -- lua (Cheia e Eclipse: 80%) limita o total. Sem teto
                -- declarado nao ha corte: a ficha nao inventa limite que o
                -- texto nao deu.
                local abs = n(efeitos.absorcao) + n(sheet.bonusBestaAbsorcao)
                local teto = n(sheet.bonusBestaTetoAbs)
                if teto > 0 and abs > teto then abs = teto end
                self.abaInv_lblAbsorcao:setText(abs .. "%")
                if n(sheet.bonusBestaAbsorcao) > 0 then
                    self.abaInv_lblAbsorcao:setFontColor(COR.gold)
                else
                    self.abaInv_lblAbsorcao:setFontColor(COR.moss)
                end
            end
            if self.abaInv_lblPeso ~= nil then
                local d = n(efeitos.deslocamento)
                self.abaInv_lblPeso:setText((d ~= 0) and (d .. "m") or "—")
                self.abaInv_lblPeso:setFontColor((d ~= 0) and COR.wine or COR.faint)
            end
            if self.abaInv_lblEfeitos ~= nil then
                local p = {}
                for _, chave in ipairs({"aparar", "esquiva", "empatica", "telepatica"}) do
                    if n(efeitos[chave]) ~= 0 then
                        table.insert(p, ROTULO_DEF_ITEM[chave] .. " +" .. n(efeitos[chave]))
                    end
                end
                for nomePer, v in pairs(efeitos.pericias) do
                    table.insert(p, nomePer .. " +" .. v)
                end
                if #p > 0 then
                    self.abaInv_lblEfeitos:setText("Do que está equipado: " .. table.concat(p, "   ·   "))
                else
                    self.abaInv_lblEfeitos:setText("")
                end
            end

            -- ----- slots equipados -----
            for i, s in ipairs(SLOTS_EQUIPADOS) do
                local it = itemNoSlot(s.chave)
                local lbl = self["abaInv_lblSlot" .. i]
                local sub = self["abaInv_subSlot" .. i]
                local rect = self["abaInv_rectSlot" .. i]
                if lbl ~= nil then
                    if it ~= nil then
                        lbl:setText(it.nome)
                        lbl:setFontColor(COR.text)
                    else
                        lbl:setText("vazio")
                        lbl:setFontColor(COR.faint)
                    end
                end
                if sub ~= nil then
                    if it ~= nil then
                        local txt = resumoDoItem(it)
                        sub:setText(txt)
                    else
                        sub:setText(s.rotulo)
                    end
                end
                if rect ~= nil then
                    rect:setStrokeColor((it ~= nil) and COR.gold or COR.borda)
                end
            end

            -- ----- lista de itens -----
            definirAlturaPod(self.abaInv_wrapVazio, (#lista == 0) and 56 or 0)
            for i = 1, MAX_LINHAS_ITEM do
                local it = lista[i]
                definirAlturaPod(self["abaInv_wrapItem" .. i], (it ~= nil) and 52 or 0)
                if it ~= nil then
                    local lbl = self["abaInv_lblItem" .. i]
                    if lbl ~= nil then
                        local txt = it.nome
                        if n(it.qtd) > 1 then txt = txt .. "  ×" .. n(it.qtd) end
                        -- QUEBRADO no nome, e nao so no numero da
                        -- durabilidade: um item que parou de bonificar precisa
                        -- ser visto sem ninguem ir procurar.
                        if itemQuebrado(it) then
                            txt = txt .. "   ⚔ QUEBRADO"
                            lbl:setFontColor(COR.wine)
                        else
                            lbl:setFontColor(COR.text)
                        end
                        lbl:setText(txt)
                    end
                    local lblQual = self["abaInv_lblQual" .. i]
                    if lblQual ~= nil then
                        lblQual:setText(string.upper(it.qualidade or ""))
                        if it.qualidade == "Ótima" then lblQual:setFontColor(COR.gold)
                        elseif it.qualidade == "Livre" then lblQual:setFontColor(COR.rain)
                        else lblQual:setFontColor(COR.muted) end
                    end
                    local lblRes = self["abaInv_lblResumo" .. i]
                    if lblRes ~= nil then
                        lblRes:setText(capitalizar(resumoDoItem(it, true)))
                    end

                    -- DURABILIDADE direto na linha, com + e −. Antes so dava
                    -- para mexer abrindo o popup do item, e e uma das coisas
                    -- que mais se faz no meio de um combate.
                    -- Item sem durabilidade (projetil, consumivel) some com o
                    -- bloco inteiro: LARGURA zero, e nao visibilidade, senao o
                    -- elemento align="left" reordena ao voltar.
                    local wrapDur = self["abaInv_wrapDur" .. i]
                    local lblDur = self["abaInv_lblDur" .. i]
                    local temDur = itemTemDurabilidade(it)
                    definirLarguraPod(wrapDur, temDur and 118 or 0)
                    if temDur and lblDur ~= nil then
                        lblDur:setText(n(it.durAtual) .. " / " .. n(it.durMax))
                        if itemQuebrado(it) then
                            lblDur:setFontColor(COR.wine)
                        elseif n(it.durAtual) * 2 <= n(it.durMax) then
                            lblDur:setFontColor(COR.gold)     -- metade ou menos
                        else
                            lblDur:setFontColor(COR.text)
                        end
                    end

                    local lblOnde = self["abaInv_lblOnde" .. i]
                    if lblOnde ~= nil then
                        local onde = it.onde
                        for _, s in ipairs(SLOTS_EQUIPADOS) do
                            if s.chave == onde then onde = s.rotulo end
                        end
                        if onde == "mochila" then onde = "MOCHILA"
                        elseif onde == "bau" then onde = "BAÚ" end
                        lblOnde:setText(onde)
                        if it.onde == "mochila" then lblOnde:setFontColor(COR.muted)
                        elseif it.onde == "bau" then lblOnde:setFontColor(COR.faint)
                        else lblOnde:setFontColor(COR.gold) end
                    end
                end
            end

        end

        -- ---------------------------------------------------------------
        -- POPUPS
        -- ---------------------------------------------------------------
        itemParaEquipar = nil

        -- Nomes das linhas do painel de detalhe do catalogo de itens. So
        -- existe para o estado VAZIO: ate a v0.41.1 o popup abria com os 14
        -- rotulos (PRECO, CATEGORIA, ..., SLOTS DE ENCANTAMENTO) todos sem
        -- valor, porque porDet() so os esconde quando um item e escolhido.
        -- O catalogo de racas resolve isso com "SELECIONE UMA RACA NA LISTA
        -- AO LADO" e nada mais (M-09); aqui e igual.
        local LINHAS_DETALHE_ITEM = {
            "absorcao", "alcance", "area", "capacidade", "categoria", "dano",
            "defesas", "deslocamento", "durabilidade", "efeito", "espacos",
            "forja", "material", "municoes", "pericia", "preco", "qualidade",
            "requisito", "slots", "visao",
        }
        local detalheItemMostrado = false

        function esvaziarDetalheItem()
            if detalheItemMostrado then return end
            for _, nome in ipairs(LINHAS_DETALHE_ITEM) do
                definirAlturaPod(self["det_wrap" .. nome], 0)
            end
            if self.det_nome ~= nil then
                self.det_nome:setText("Selecione um item na lista ao lado")
            end
            if self.det_obs ~= nil then
                self.det_obs:setText("Clique num item para ver preço, categoria, efeitos e requisitos. O botão de adicionar aparece embaixo.")
            end
            pcall(function() self.det_conteudo:setHeight(120) end)
        end

        function abrirPopupItens()
            if self.popItens == nil then return end
            esvaziarDetalheItem()
            -- Zera o filtro a cada abertura, pelo mesmo motivo dos
            -- catalogos de Qualidades e Defeitos: reabrir mostrando 3 de
            -- 250 por causa de um filtro esquecido parece catalogo
            -- quebrado, e nao ha erro nenhum na tela para desmentir.
            zerarEstadoCatalogo()
            if self.lblLaudoItens ~= nil then
                pcall(function() self.lblLaudoItens:setHeight(0) end)
            end
            if self.edBuscaItens ~= nil then
                pcall(function() self.edBuscaItens:setText("") end)
            end
            filtrarCatalogoItens("")
            abrirPopupAjustado(self.popItens, 900, 640)
        end

        function fecharPopupItens()
            if self.popItens ~= nil then self.popItens:close() end
        end

        function abrirEscolhaSlot(indice)
            local lista = lerItens()
            local it = lista[indice]
            if it == nil or self.popSlotItem == nil then return end
            itemParaEquipar = indice

            if self.popSlot_lblTitulo ~= nil then
                self.popSlot_lblTitulo:setText("EQUIPAR " .. string.upper(it.nome))
            end
            if self.popSlot_lblAjuda ~= nil then
                self.popSlot_lblAjuda:setText(resumoDoItem(it))
            end

            -- marca em cinza os slots que este item nao aceita, dizendo o motivo
            for _, s in ipairs(SLOTS_EQUIPADOS) do
                local ok, motivo = podeEquipar(it, s.chave)
                local btn = self["popSlot_btn" .. s.chave]
                local lbl = self["popSlot_lbl" .. s.chave]
                local ocupado = itemNoSlot(s.chave)
                local texto = s.rotulo
                if ocupado ~= nil then texto = texto .. "   ·   ocupado por " .. ocupado.nome end
                if not ok then texto = texto .. "   ·   " .. motivo end
                if lbl ~= nil then
                    lbl:setText(texto)
                    lbl:setFontColor(ok and COR.text or COR.faint)
                end
                if btn ~= nil then
                    btn:setStrokeColor(ok and COR.gold or COR.line)
                end
            end
            abrirPopupAjustado(self.popSlotItem, 620, 380)
        end

        function fecharPopupSlot()
            if self.popSlotItem ~= nil then self.popSlotItem:close() end
            itemParaEquipar = nil
        end

        function confirmarSlot(chaveSlot)
            if itemParaEquipar == nil then return end
            equiparItem(itemParaEquipar, chaveSlot)
            fecharPopupSlot()
        end

        -- ---------------------------------------------------------------
        -- CATALOGO: lista a esquerda, detalhe a direita
        -- ---------------------------------------------------------------
        itemDetalheCatalogo = nil

        -- Largura util do painel de detalhe, em caracteres aproximados por
        -- linha no corpo 12 do EB Garamond. Serve para estimar quantas linhas
        -- um texto vai ocupar.
        local CHARS_POR_LINHA_DET = 74

        local function alturaDeTexto(txt, base, porLinha, maxLinhas)
            local n = #tostring(txt or "")
            local linhas = math.ceil(n / (porLinha or CHARS_POR_LINHA_DET))
            if linhas < 1 then linhas = 1 end
            if maxLinhas ~= nil and linhas > maxLinhas then linhas = maxLinhas end
            return base + (linhas - 1) * 17
        end

        -- Guarda o que foi aplicado: reler ".height" logo depois de gravar
        -- pode devolver o valor antigo, porque o layout ainda nao redesenhou.
        alturaDetalheAcumulada = 0

        -- Primeira letra maiuscula. O texto do livro vem em minuscula ("ao ser
        -- consumido...") e a ficha monta frases proprias; capitalizar aqui
        -- cobre os dois casos, inclusive acentuadas.
        function capitalizar(s)
            s = tostring(s or "")
            if s == "" then return s end
            local primeira = s:sub(1, 1)
            local resto = s:sub(2)
            -- letras acentuadas ocupam 2 bytes em UTF-8
            if primeira:byte() ~= nil and primeira:byte() >= 194 then
                primeira = s:sub(1, 2)
                resto = s:sub(3)
                local MAI = {["á"]="Á",["à"]="À",["ã"]="Ã",["â"]="Â",["é"]="É",["ê"]="Ê",
                             ["í"]="Í",["ó"]="Ó",["ô"]="Ô",["õ"]="Õ",["ú"]="Ú",["ç"]="Ç"}
                return (MAI[primeira] or primeira) .. resto
            end
            return primeira:upper() .. resto
        end

        local function porDet(nome, valor)
            local lbl = self["det_" .. nome]
            local wrap = self["det_wrap" .. nome]
            local tem = (valor ~= nil and valor ~= "" and valor ~= "0")
            if lbl ~= nil then lbl:setText(capitalizar(valor)) end
            if wrap == nil then return end
            if not tem then definirAlturaPod(wrap, 0); return end
            -- Blocos de texto corrido (rotulo em cima) crescem conforme o
            -- conteudo; as linhas de rotulo-a-esquerda tem altura fixa.
            local h = 26
            if nome == "efeito" then
                h = alturaDeTexto(valor, 40, CHARS_POR_LINHA_DET, 24)
            elseif nome == "forja" then
                h = alturaDeTexto(valor, 38, 80, 6)
            elseif nome == "defesas" then
                h = alturaDeTexto(valor, 26, 52, 3)
            end
            definirAlturaPod(wrap, h)
            alturaDetalheAcumulada = alturaDetalheAcumulada + h
        end

        function verDetalheItem(indice)
            local d = CatalogoItens.itens[indice]
            detalheItemMostrado = true
            if d == nil then return end
            itemDetalheCatalogo = indice

            alturaDetalheAcumulada = 0
            if self.det_nome ~= nil then self.det_nome:setText(d.nome) end
            porDet("preco", CatalogoItens.precoTexto(d.preco))
            porDet("categoria", d.categoria)
            porDet("qualidade", d.qualidade)
            porDet("material", (d.qualidade == "Ótima") and "Incomum" or "Comum")
            if d.durabilidade ~= nil then
                porDet("durabilidade", d.durabilidade .. " / " .. d.durabilidade)
            else porDet("durabilidade", nil) end
            local dano = d.dado or ""
            if d.danoExtra ~= nil then
                if dano ~= "" then dano = dano .. " e +" .. d.danoExtra
                else dano = "+" .. d.danoExtra end
            end
            porDet("dano", (dano ~= "") and dano or nil)
            -- "Nm de alcance" e o alcance da arma; "+Nm de alcance" e um
            -- EXTRA que a municao concede a quem atira. Somar os dois fazia
            -- os Virotes aparecerem como arma de 4 metros.
            if n(d.alcance) > 0 then
                porDet("alcance", n(d.alcance) .. " metros")
            elseif n(d.alcanceExtra) > 0 then
                porDet("alcance", "+" .. n(d.alcanceExtra) .. " metros ao alcance da arma")
            else
                porDet("alcance", nil)
            end
            if d.reqAtributo ~= nil then
                porDet("requisito", d.reqValor .. " de " .. d.reqAtributo)
            else porDet("requisito", nil) end
            if d.defesaAparar ~= nil then
                porDet("defesas", "+" .. d.defesaAparar .. " em Defesa - Aparar")
            elseif d.defesaEscolha ~= nil then
                -- Cinto do Gladiador e Colar do Resiliente nomeiam QUAIS duas
                -- defesas recebem; as armaduras deixam o jogador escolher.
                if d.defesaLista ~= nil then
                    porDet("defesas", "+" .. d.defesaEscolha .. " distribuído entre " .. d.defesaLista)
                else
                    porDet("defesas", "+" .. d.defesaEscolha .. " distribuído entre duas defesas, à sua escolha")
                end
            else porDet("defesas", nil) end
            porDet("absorcao", (d.absorcao ~= nil) and (d.absorcao .. "%") or nil)
            porDet("deslocamento", (d.deslocamento ~= nil) and (d.deslocamento .. " metros") or nil)
            if d.periciaNome ~= nil then
                porDet("pericia", "+" .. d.periciaBonus .. " em " .. d.periciaNome)
            elseif d.periciaDistribuir ~= nil then
                porDet("pericia", "+" .. d.periciaDistribuir .. " a distribuir entre perícias de ofício")
            else porDet("pericia", nil) end
            porDet("municoes", (d.municoes ~= nil) and tostring(d.municoes) or nil)
            porDet("espacos", (d.espacos ~= nil) and ("+" .. d.espacos .. " no espaço da mochila") or nil)
            porDet("visao", (d.visaoEscuro ~= nil) and ("+" .. d.visaoEscuro .. " metros de raio") or nil)
            porDet("capacidade", (d.capacidade ~= nil)
                and ("carrega " .. d.capacidade .. " " .. tostring(d.capacidadeTipo or "")) or nil)
            porDet("area", (d.danoArea ~= nil)
                and (d.danoArea .. " [" .. tostring(d.areaElemento) .. "] num raio de " ..
                     n(d.areaRaio) .. " metros") or nil)
            porDet("efeito", d.efeito)
            porDet("forja", d.notas)
            local mat = materialDeCatalogo(d.qualidade)
            local slots, sq, sm = slotsDeEncantamento(d.qualidade, mat)
            porDet("slots", slots .. "   = qualidade " .. tostring(d.qualidade) ..
                " " .. sq .. " + material " .. mat .. " " .. sm)

            if self.det_obs ~= nil then
                if d.defesaEscolha ~= nil then
                    if d.defesaLista ~= nil then
                        self.det_obs:setText("No editor, distribua o bônus entre " .. d.defesaLista ..
                            " — apenas essas duas.")
                    else
                        self.det_obs:setText("No editor, distribua o bônus entre as duas defesas que preferir.")
                    end
                elseif d.periciaDistribuir ~= nil then
                    self.det_obs:setText("O bônus é distribuído entre Ofícios, Forja, Alfaiataria ou Mecânica — defina no editor do item.")
                else
                    self.det_obs:setText("")
                end
            end
            if self.det_lblAdicionar ~= nil then
                self.det_lblAdicionar:setText("+  ADICIONAR " .. string.upper(d.nome) .. " À MOCHILA")
            end

            -- O container cresce com o conteudo: soma a altura de cada linha
            -- visivel mais a observacao. Assim o scroll do painel funciona e
            -- nenhum texto fica escondido.
            do
                local total = alturaDetalheAcumulada + 90   -- observacao e folga
                if total < 300 then total = 300 end
                pcall(function() self.det_conteudo:setHeight(total) end)
            end

            -- destaca o selecionado na lista
            for i, item in ipairs(CatalogoItens.itens) do
                local rect = self["itmL_" .. chavePoder(item.nome) .. chavePoder(item.qualidade)]
                if rect ~= nil then
                    rect:setStrokeColor((i == indice) and COR.gold or COR.line)
                end
            end
        end

        function adicionarDetalheItem()
            if itemDetalheCatalogo == nil then
                avisarInventario("Escolha um item na lista à esquerda.", COR.muted); return
            end
            local d = CatalogoItens.itens[itemDetalheCatalogo]
            if d == nil then return end
            adicionarItemCatalogo(d.nome, d.qualidade)
        end

        -- =================================================================
        -- BACKGROUND & ANOTACOES
        --
        -- Um campo unico, ocupando a aba inteira: historia do personagem e
        -- anotacoes de mesa no mesmo lugar. Sem validacao de tamanho nem
        -- roteiro de perguntas - as historias da mesa ja estao escritas, e a
        -- ficha nao precisa cobrar nada.
        --
        -- O link continua porque muita gente escreve fora da ficha.
        -- =================================================================

        -- #texto conta BYTES, e cada acentuada ocupa dois. Como o contador e
        -- so informativo, o desconto dos bytes de continuacao UTF-8 evita
        -- mostrar uns 10% a mais numa historia em portugues.
        function contarCaracteres(texto)
            local s = tostring(texto or "")
            local total = 0
            for i = 1, #s do
                local b = s:byte(i)
                if b < 128 or b >= 192 then total = total + 1 end
            end
            return total
        end

        -- O richEdit guarda texto formatado e nao dispara onChange como o
        -- textEditor, entao nao ha contador de caracteres nesta aba.
        function atualizarAbaBackground()
        end

        function publicarLinkBackground()
            if sheet == nil then return end
            local link = tostring(sheet.bgLink or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if link == "" then return end
            publicarNoChat(anuncio("background", "BACKGROUND",
                     tostring(sheet.nome or "Personagem") ..
                ": " .. link), COR.gold)
            atualizarAbaBackground()
        end


        -- =================================================================
        -- CRIATURAS
        --
        -- Familiares, montarias, aliados e o que mais a mesa inventar.
        --
        -- O livro nao deixa isto solto como se pensava: o Bestiario tem o
        -- sistema inteiro, e a secao "Criando a ficha de uma criatura" diz
        -- que ele "vale tanto para a criacao de inimigos, quanto para criacao
        -- de pets, montarias e criaturas auxiliares". Por isso existe o botao
        -- que aplica as regras - e por isso ele SUGERE em vez de impor: a
        -- mesma frase termina com "o narrador podera personalizar a mesma da
        -- forma como bem entender".
        --
        -- MODELO DE DADOS - recordList de verdade, e nao texto serializado
        -- como o inventario. Sao tres motivos:
        --   * a quantidade e livre (um corvo aqui, uma wyvern e duas
        --     montarias ali);
        --   * ha texto longo (habilidades, descricao), que num campo plano
        --     obrigaria a sanitizar separador o tempo todo;
        --   * cada criatura tem imagem propria, e URL em campo serializado
        --     exige escape - foi o que a v0.33.0 teve de fazer para os itens.
        --
        -- PERMISSAO: livre sempre, por decisao da mesa (21/08/2026). Nao ha
        -- trava de criacao aqui: a aba e do mestre por natureza, e travar
        -- obrigaria a destravar a ficha inteira para mexer num familiar.
        -- =================================================================
        MAX_CRIATURAS = 12

        PAPEIS_CRIATURA = {"Familiar", "Montaria", "Aliado", "Outro"}

        -- Cada classificacao e um campo que ANDA de uma em uma no popup, com
        -- setas. Sem popup dentro de popup, e sem digitar um nome que precisa
        -- bater com o catalogo.
        CLASSIFICACOES_CRIATURA = {
            {campo = "tamanho",  rotulo = "TAMANHO",  lista = function() return CatalogoBestiario.tamanhos end},
            {campo = "natureza", rotulo = "NATUREZA", lista = function() return CatalogoBestiario.naturezas end},
            {campo = "intelecto", rotulo = "INTELECTO", lista = function() return CatalogoBestiario.intelectos end},
            {campo = "dieta",    rotulo = "DIETA",    lista = function() return CatalogoBestiario.dietas end},
            {campo = "tipo",     rotulo = "TIPO",     lista = function() return CatalogoBestiario.tipos end},
            {campo = "raridade", rotulo = "RARIDADE", lista = function() return CatalogoBestiario.raridades end},
            {campo = "rank",     rotulo = "RANK",     lista = function() return CatalogoBestiario.ranks end},
        }

        criaturaEmEdicao = nil

        function todasCriaturas()
            if sheet == nil then return {} end
            return NDB.getChildNodes(sheet.listaCriaturas) or {}
        end

        function criaturaPorIndice(i)
            local lista = todasCriaturas()
            return lista[n(i)]
        end

        function criarCriatura()
            if sheet == nil or self.listaCriaturas == nil then return end
            if #todasCriaturas() >= MAX_CRIATURAS then
                avisarCriaturas("Limite de " .. MAX_CRIATURAS ..
                    " criaturas nesta ficha. Apague uma para criar outra.", COR.wine)
                return
            end
            local no = self.listaCriaturas:append()
            if no == nil then return end
            no.nome = "Criatura sem nome"
            no.papel = "Familiar"
            no.tamanho = "Médio"
            no.natureza = "Neutro"
            no.intelecto = "Instintivo"
            no.dieta = "Onívoro"
            no.tipo = "Besta"
            no.raridade = "Comum"
            no.rank = "E"
            no.montada = false
            atualizarAbaCriaturas()
            -- abre direto no editor: criatura recem-criada nao serve para nada
            -- ate ser preenchida
            local lista = todasCriaturas()
            abrirEditorCriatura(#lista)
        end

        function removerCriatura(i)
            local c = criaturaPorIndice(i)
            if c == nil then return end
            local nome = tostring(c.nome or "criatura")
            if c.montada == true then desmontar() end
            NDB.deleteNode(c)
            avisarCriaturas("\"" .. nome .. "\" foi removida da ficha.", COR.muted)
            atualizarAbaCriaturas()
            recalcularTudo()
        end

        function avisarCriaturas(texto, cor)
            if self.abaCri_lblAviso == nil then return end
            self.abaCri_lblAviso:setText(tostring(texto or ""))
            self.abaCri_lblAviso:setFontColor(cor or COR.muted)
        end

        -- ---------------------------------------------------------------
        -- VIDA - a unica coisa da ficha com "atual / maximo"
        --
        -- No personagem os campos de valor atual foram REMOVIDOS na v0.31.3,
        -- porque os mestres contam vida e energia em outro programa e duas
        -- fontes divergem. Aqui e diferente por decisao da mesa: a criatura e
        -- do JOGADOR, e quem acompanha o corvo dele no meio do turno e ele.
        -- ---------------------------------------------------------------
        function ajustarVidaCriatura(i, delta)
            local c = criaturaPorIndice(i)
            if c == nil then return end
            local maxima = n(c.vidaMax)
            local novo = n(c.vidaAtual) + n(delta)
            if novo < 0 then novo = 0 end
            if maxima > 0 and novo > maxima then novo = maxima end
            c.vidaAtual = novo
            if maxima > 0 and novo <= 0 then
                avisarCriaturas("\"" .. tostring(c.nome or "A criatura") ..
                    "\" chegou a 0 de vida.", COR.wine)
            end
            atualizarAbaCriaturas()
        end

        -- ---------------------------------------------------------------
        -- MONTARIA
        --
        -- So uma montaria montada por vez: montar a segunda desmonta a
        -- primeira, em vez de recusar. Recusar obrigaria a dois cliques para
        -- trocar de montaria no meio de uma perseguicao.
        --
        -- Montar e DESMONTAR sao acao de jogo: livres sempre.
        -- ---------------------------------------------------------------
        function montariaMontada()
            for _, c in ipairs(todasCriaturas()) do
                if c.montada == true then return c end
            end
            return nil
        end

        function montar(i)
            local c = criaturaPorIndice(i)
            if c == nil then return end
            if tostring(c.papel or "") ~= "Montaria" then
                avisarCriaturas("\"" .. tostring(c.nome or "Esta criatura") ..
                    "\" não está marcada como MONTARIA. Abra o editor dela e troque o papel.", COR.wine)
                return
            end
            for _, outra in ipairs(todasCriaturas()) do
                if outra.montada == true then outra.montada = false end
            end
            c.montada = true
            avisarCriaturas("Montado em \"" .. tostring(c.nome or "?") ..
                "\". O card MONTADO apareceu na aba de Combate.", COR.gold)
            atualizarAbaCriaturas()
            recalcularTudo()
        end

        function desmontar()
            local m = montariaMontada()
            if m == nil then return end
            m.montada = false
            avisarCriaturas("Desmontou de \"" .. tostring(m.nome or "?") .. "\".", COR.muted)
            atualizarAbaCriaturas()
            recalcularTudo()
        end

        function alternarMontaria(i)
            local c = criaturaPorIndice(i)
            if c == nil then return end
            if c.montada == true then desmontar() else montar(i) end
        end

        -- Deslocamento montado.
        --
        -- REGRA DA MESA (21/08/2026), porque o livro cobra o campo e nunca o
        -- explica: "bonus de montaria" e lido como METROS somados ao
        -- deslocamento de quem esta montado. A Loja escreve
        -- "0+(Bônus de proficiência)m de bônus de montaria" na montaria comum
        -- e "1+(Bônus de proficiência)m" na incomum, e a Sela de corrida
        -- soma "+02 metros de deslocamento adicional da montaria OU +02
        -- metros de bônus de montaria".
        --
        -- Ao contrario disso, o que E escrito com todas as letras:
        --   Domador / Montador selvagem ○○: "Adicione o seu deslocamento ao
        --   da sua montaria, quando montado nela."
        -- Os tres modos que uma montaria pode ter, na ordem em que aparecem
        -- no resumo do card. O campo e o nome do dado na criatura.
        MODOS_MONTARIA = {
            {chave = "desloc",     nome = "terrestre", curto = "terr"},
            {chave = "deslocVoo",  nome = "voo",       curto = "voo"},
            {chave = "deslocNado", nome = "nado",      curto = "nado"},
        }

        -- ---------------------------------------------------------------
        -- DESLOCAMENTO MONTADO — os TRES modos
        --
        -- Ate a v0.35.2 este calculo so olhava para o deslocamento terrestre
        -- da montaria. Uma wyverna com 100 de voo aparecia no card com os 30
        -- do chao, e o numero que o jogador ia usar no turno simplesmente nao
        -- existia na ficha.
        --
        -- O LIVRO NAO COBRE O CASO. A Loja define o bonus de montaria como
        -- caracteristica da montaria ("0+(Bônus de proficiência)m de bônus de
        -- montaria"; acessorios somam "+02 metros de deslocamento adicional
        -- da montaria") e o Domador ○○ Montador selvagem diz "Adicione o seu
        -- deslocamento ao da sua montaria, quando montado nela". Nenhum dos
        -- dois fala de voo ou de nado: o livro escreve montaria como se so
        -- existisse chao.
        --
        -- DECISAO DA MESA (22/08/2026): os dois bonus valem em TODOS os modos.
        -- Wyverna com 100 de voo, bonus 3, cavaleiro com 13 de deslocamento
        -- => voo montado 116.
        --
        -- Modo com base 0 NAO vira card nem entra no resumo: montaria que nao
        -- voa nao ganha "voo 3" so porque tem bonus.
        -- ---------------------------------------------------------------
        function calcularDeslocamentoMontado()
            if sheet == nil then return end
            local m = montariaMontada()
            if m == nil then
                sheet.deslocamentoMontado = 0
                sheet.montariaResumo = ""
                sheet.montariaModos = ""
                sheet.montariaModoTopo = ""
                return
            end

            local bonus = n(m.bonusMontaria)
            local seu = 0
            local temSelvagem = nivelDaSubclasse("Domador", "Montador selvagem") >= 2
            if temSelvagem then seu = n(sheet.deslocamento) end

            local topoNome, topoValor, topoBase = "", -1, 0
            local outros = {}

            for _, modo in ipairs(MODOS_MONTARIA) do
                local base = n(m[modo.chave])
                if base > 0 then
                    local total = base + bonus + seu
                    if total < 0 then total = 0 end
                    if total > topoValor then
                        -- o modo que ficou para tras vira "outro"; o novo topo
                        -- entra no lugar dele
                        if topoNome ~= "" then
                            table.insert(outros, topoNome .. " " .. topoValor)
                        end
                        topoNome, topoValor, topoBase = modo.nome, total, base
                    else
                        table.insert(outros, modo.nome .. " " .. total)
                    end
                end
            end

            -- montaria sem nenhum modo declarado: o card mostra tracinho
            if topoValor < 0 then
                sheet.deslocamentoMontado = 0
                sheet.montariaResumo = "esta montaria não tem deslocamento — preencha na aba Criaturas"
                sheet.montariaModos = ""
                sheet.montariaModoTopo = ""
                return
            end

            -- O NUMERO GRANDE e o MAIOR modo, e nao o terrestre: e o que o
            -- jogador vai usar no turno. O nome do modo vai para o titulo do
            -- card para ninguem confundir 116 de voo com 116 de chao.
            local partes = {tostring(m.nome or "montaria") .. " " .. topoNome .. " " .. topoBase}
            if bonus ~= 0 then table.insert(partes, "bônus " .. bonus) end
            if temSelvagem then
                table.insert(partes, "seu " .. seu .. " (Montador selvagem ○○)")
            end

            sheet.deslocamentoMontado = topoValor
            sheet.montariaModoTopo = topoNome
            sheet.montariaResumo = table.concat(partes, " + ")
            sheet.montariaModos = table.concat(outros, "  ·  ")
        end

        -- ---------------------------------------------------------------
        -- EDITOR
        -- ---------------------------------------------------------------
        function abrirEditorCriatura(i)
            local c = criaturaPorIndice(i)
            if c == nil or self.popCriatura == nil then return end
            criaturaEmEdicao = i
            -- imagem: mesmo padrao dos outros popups. field= dentro de popup
            -- resolve contra a raiz, entao a raiz vira rascunho.
            sheet.imagemCriaturaEdicao = tostring(c.imagem or "")
            preencherEditorCriatura(c)
            abrirPopupAjustado(self.popCriatura, 1000, 760)
        end

        function fecharEditorCriatura()
            if self.popCriatura ~= nil then self.popCriatura:close() end
            criaturaEmEdicao = nil
        end

        local function porEditCri(nome, valor)
            local w = self["edCri_" .. nome]
            if w ~= nil then w:setText(tostring(valor or "")) end
        end

        local function lerEditCri(nome)
            local w = self["edCri_" .. nome]
            if w == nil then return "" end
            return tostring(w:getText() or "")
        end

        CAMPOS_NUMERICOS_CRIATURA = {
            "vidaAtual", "vidaMax", "cd", "prof", "xp",
            "desloc", "deslocVoo", "deslocNado", "bonusMontaria",
            "forca", "destreza", "constituicao", "inteligencia",
            "sabedoria", "carisma", "manipulacao",
            "defAparar", "defEsquiva", "defEmpatica", "defTelepatica",
        }

        function preencherEditorCriatura(c)
            porEditCri("nome", c.nome)
            for _, campo in ipairs(CAMPOS_NUMERICOS_CRIATURA) do
                porEditCri(campo, n(c[campo]))
            end
            -- MIGRACAO DO CAMPO ESPOLIOS (removido na v0.35.1). Criatura
            -- salva antes disso tem texto em c.espolios que nao teria mais
            -- onde aparecer. Em vez de deixar o dado orfao no no, ele entra
            -- no fim das habilidades - na TELA, para o mestre ver antes de
            -- confirmar. So vira permanente quando ele salvar.
            local texto = tostring(c.habilidades or "")
            local velho = tostring(c.espolios or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if velho ~= "" then
                texto = texto .. ((texto ~= "") and "\n\n" or "") .. "Espólios: " .. velho
            end
            porEditCri("habilidades", texto)
            porEditCri("descricao", c.descricao)

            atualizarSeletoresCriatura(c)

            -- AS INSTRUCOES VOLTAM TODA VEZ QUE O EDITOR ABRE (v0.42.1, C-02).
            -- Ate a v0.41.1 elas so existiam depois de clicar em APLICAR:
            -- reabrir a criatura na sessao seguinte mostrava FORCA 0 e nada
            -- dizendo que o mestre ainda devia "+3 de FORCA ou CONSTITUICAO".
            -- Para reler era preciso clicar em APLICAR - que re-sorteava a
            -- vida. O gerador e puro e devolve (valores, instrucoes) no mesmo
            -- passo: aqui se usa SO as instrucoes, e nenhum numero muda.
            -- (Abrir outra criatura tambem nao herda mais as da anterior.)
            instrucoesCriatura = instrucoesParaAbertura(c)
            instrucoesAbertas = false
            atualizarBotaoInstrucoes()
            atualizarNotaAtributosCriatura()
            atualizarNotaDefesasCriatura(c)
            if velho ~= "" then
                avisarEditorCriatura("O campo ESPÓLIOS deixou de existir; o texto que estava nele foi para o fim das habilidades. Salve para manter.", COR.gold)
            else
                avisarEditorCriatura("", COR.muted)
            end
        end

        function atualizarSeletoresCriatura(c)
            if c == nil then return end
            if self.edCri_lblPapel ~= nil then
                self.edCri_lblPapel:setText(string.upper(tostring(c.papel or "Familiar")))
            end
            for _, d in ipairs(CLASSIFICACOES_CRIATURA) do
                local lbl = self["edCri_lbl" .. d.campo]
                if lbl ~= nil then lbl:setText(tostring(c[d.campo] or "—")) end
            end
            -- linha de contexto: o que a classificacao escolhida significa
            if self.edCri_lblContexto ~= nil then
                local partes = {}
                local rk = CatalogoBestiario.rank(c.rank)
                if rk ~= nil then
                    table.insert(partes, "Rank " .. rk.nome .. " — " .. rk.descricao ..
                        " (" .. rk.percentual .. " das criaturas chegam lá)")
                end
                local tp = CatalogoBestiario.tipo(c.tipo)
                if tp ~= nil then table.insert(partes, tp.descricao) end
                self.edCri_lblContexto:setText(table.concat(partes, "\n"))
            end
        end

        -- Anda uma posicao na lista da classificacao. Circula, ao contrario
        -- do tamanho do personagem: aqui as listas sao curtas e a pessoa esta
        -- montando a criatura, nao usando em combate.
        function ciclarClassificacaoCriatura(campo, passo)
            local c = criaturaPorIndice(criaturaEmEdicao)
            if c == nil then return end
            local def = nil
            for _, d in ipairs(CLASSIFICACOES_CRIATURA) do
                if d.campo == campo then def = d end
            end
            if def == nil then return end
            local lista = def.lista()
            local atual = tostring(c[campo] or "")
            local idx = 1
            for i, e in ipairs(lista) do
                if e.nome == atual then idx = i end
            end
            idx = idx + n(passo)
            if idx < 1 then idx = #lista end
            if idx > #lista then idx = 1 end
            c[campo] = lista[idx].nome
            atualizarSeletoresCriatura(c)
            -- a classificacao mudou: o painel de instrucoes, a nota de
            -- atributos e as marcas do tipo acompanham na hora (v0.42.1)
            instrucoesCriatura = instrucoesParaAbertura(c)
            atualizarBotaoInstrucoes()
            atualizarNotaAtributosCriatura()
            atualizarNotaDefesasCriatura(c)
        end

        function ciclarPapelCriatura(passo)
            local c = criaturaPorIndice(criaturaEmEdicao)
            if c == nil then return end
            local atual = tostring(c.papel or "Familiar")
            local idx = 1
            for i, p in ipairs(PAPEIS_CRIATURA) do
                if p == atual then idx = i end
            end
            idx = idx + n(passo)
            if idx < 1 then idx = #PAPEIS_CRIATURA end
            if idx > #PAPEIS_CRIATURA then idx = 1 end
            c.papel = PAPEIS_CRIATURA[idx]
            -- deixou de ser montaria: nao pode continuar montada
            if c.papel ~= "Montaria" and c.montada == true then
                c.montada = false
                recalcularTudo()
            end
            atualizarSeletoresCriatura(c)
        end

        -- ---------------------------------------------------------------
        -- O GERADOR DO LIVRO
        --
        -- Escreve nos campos da TELA, e nao no no: o mestre ve o que mudou e
        -- so vira dado ao clicar em salvar. Se ele odiar o resultado, fecha
        -- no cancelar e nada aconteceu.
        -- ---------------------------------------------------------------

        -- Os campos que aplicarRegrasDoLivro() ESCREVE - e, por consequencia,
        -- os unicos que limparRegrasDoLivro() apaga. Lista unica de proposito:
        -- no dia em que o gerador aprender a preencher mais um campo, o botao
        -- de limpar aprende junto, sem ninguem lembrar de mexer nos dois.
        --
        -- A checagem 23 do verifica.py falha o build se aparecer um
        -- porEditCri("x", ...) dentro de aplicarRegrasDoLivro cujo campo nao
        -- esteja aqui. E o tipo de esquecimento que nao da erro nenhum: o
        -- limpar simplesmente deixa um numero velho para tras.
        CAMPOS_DO_GERADOR = {
            {campo = "vidaMax",   vazio = "0", rotulo = "vida"},
            {campo = "vidaAtual", vazio = "0", rotulo = "vida atual"},
            {campo = "cd",        vazio = "0", rotulo = "CD"},
            {campo = "prof",      vazio = "0", rotulo = "proficiência"},
            {campo = "xp",        vazio = "0", rotulo = "XP"},
            {campo = "carisma",   vazio = "0", rotulo = "Carisma"},
            {campo = "sabedoria", vazio = "0", rotulo = "Sabedoria"},
        }

        instrucoesCriatura = {}
        instrucoesAbertas = false

        -- As instrucoes da criatura como ela ESTA, sem sortear nada: a linha
        -- "sorteado dentro das faixas" (que so faz sentido logo apos um
        -- sorteio) e trocada pelas faixas do livro, e os numeros salvos
        -- continuam nos campos.
        function instrucoesParaAbertura(c)
            local saida = {}
            if c == nil then return saida end
            local ok, _, instr = pcall(function()
                return CatalogoBestiario.gerar({
                    tamanho = c.tamanho, natureza = c.natureza, intelecto = c.intelecto,
                    dieta = c.dieta, tipo = c.tipo, raridade = c.raridade, rank = c.rank,
                }, function(mn, mx) return mn end)
            end)
            if not ok or instr == nil then return saida end
            local rk = CatalogoBestiario.rank(c.rank)
            if rk ~= nil then
                table.insert(saida, "Rank " .. rk.nome .. " — faixas do livro: vida " ..
                    CatalogoBestiario.faixa(rk.hpMin, rk.hpMax) .. "  ·  CD " ..
                    CatalogoBestiario.faixa(rk.cdMin, rk.cdMax) .. "  ·  proficiência " ..
                    CatalogoBestiario.faixa(rk.profMin, rk.profMax) .. "  ·  XP " ..
                    CatalogoBestiario.faixa(rk.xpMin, rk.xpMax) ..
                    ". Os campos mostram o que está SALVO; APLICAR sorteia de novo dentro dessas faixas.")
            end
            for _, t in ipairs(instr) do
                if not tostring(t):find("sorteado dentro das faixas", 1, true) then
                    table.insert(saida, t)
                end
            end
            return saida
        end

        function aplicarRegrasDoLivro()
            local c = criaturaPorIndice(criaturaEmEdicao)
            if c == nil then return end
            -- SEMENTE DO SORTEIO. Sem isto, o Lua comeca toda sessao com a
            -- mesma semente e a "primeira criatura do dia" sairia sempre com
            -- os mesmos numeros - erro que so apareceria depois de semanas de
            -- uso, quando alguem reparasse na coincidencia. Mesmo padrao
            -- guardado que o sorteio de caracteristicas de mesticos usa: no
            -- Firecast o os pode nao estar exposto.
            if math.randomseed ~= nil and os ~= nil and os.time ~= nil then
                math.randomseed(os.time())
            end

            local valores, instrucoes = CatalogoBestiario.gerar({
                tamanho = c.tamanho, natureza = c.natureza, intelecto = c.intelecto,
                dieta = c.dieta, tipo = c.tipo, raridade = c.raridade, rank = c.rank,
            })

            if valores.vida ~= nil then
                porEditCri("vidaMax", valores.vida)
                porEditCri("vidaAtual", valores.vida)
            end
            if valores.cd ~= nil then porEditCri("cd", valores.cd) end
            if valores.prof ~= nil then porEditCri("prof", valores.prof) end
            if valores.xp ~= nil then porEditCri("xp", valores.xp) end
            -- ATRIBUTO JA LANCADO PELO MESTRE NAO E SOBRESCRITO (v0.42.1,
            -- C-01). Carisma e Sabedoria entravam aqui por setText, junto do
            -- sorteio: reclicar em APLICAR para sortear a vida de novo
            -- apagava o Carisma 5 que o mestre tinha digitado e punha o 1
            -- da Natureza. Agora a concessao fixa so entra em campo ZERADO;
            -- se ja ha valor, fica o do mestre e o painel diz isso.
            for _, par in ipairs({{campo = "carisma", rotulo = "Carisma"},
                                  {campo = "sabedoria", rotulo = "Sabedoria"}}) do
                local v = valores[par.campo]
                if v ~= nil then
                    local atual = n(lerEditCri(par.campo))
                    if atual == 0 or atual == v then
                        porEditCri(par.campo, v)
                    else
                        table.insert(instrucoes, par.rotulo .. " já está em " .. atual ..
                            " (a classificação daria " .. v .. ") — mantive o seu. Digite " ..
                            v .. " no campo se quiser o valor do livro.")
                    end
                end
            end

            -- A CAIXA DE INSTRUCOES NASCE FECHADA (pedido do mestre,
            -- 22/08/2026): aberta, ela tomava meia tela toda vez que alguem
            -- clicava em aplicar, e quem cria criatura ja sabe o que ajustar.
            --
            -- Mas ela NAO foi apagada, e a diferenca importa: parte dessas
            -- linhas nao e lembrete, e regra que o gerador nao pode cumprir
            -- sozinho - "Tamanho Medio: +3 de FORCA ou CONSTITUICAO (escolha
            -- uma)". Se o texto sumisse, um mestre que nao decorou o
            -- Bestiario simplesmente nao aplicaria o +3, e o erro seria
            -- invisivel. Entao ela vira um botao com contador, fechado por
            -- padrao: some da tela, continua a um clique.
            instrucoesCriatura = instrucoes or {}
            instrucoesAbertas = false
            atualizarBotaoInstrucoes()

            -- O rodape fala de ESCOLHAS, nao de "pontos" (v0.42.1, C-03):
            -- "9 pontos ficaram para voce decidir" contava as LINHAS do
            -- painel — 7 delas eram informacao ("ja somado", dieta, raridade)
            -- e so 2 eram escolha. "Ponto" e unidade de atributo neste
            -- sistema; o mestre ia procurar nove pontos para distribuir.
            local escolhas = contarEscolhasCriatura()
            local recado = "Sorteei dentro das faixas do livro — clique de novo para outro sorteio. Nada foi salvo ainda."
            if escolhas > 0 then
                recado = recado .. "  " .. escolhas ..
                    (escolhas == 1 and " escolha ficou" or " escolhas ficaram") ..
                    " para você (" .. #instrucoesCriatura .. " observações no botão ao lado)."
            elseif #instrucoesCriatura > 0 then
                recado = recado .. "  " .. #instrucoesCriatura .. " observações no botão ao lado."
            end
            avisarEditorCriatura(recado, COR.gold)
            atualizarNotaAtributosCriatura()
        end

        -- Linhas do painel que sao ESCOLHA do mestre (o livro escreve "ou",
        -- ou o gerador se recusou a decidir), e nao informacao.
        function contarEscolhasCriatura()
            local q = 0
            for _, t in ipairs(instrucoesCriatura or {}) do
                local baixo = string.lower(tostring(t))
                if baixo:find("lance no atributo", 1, true) or baixo:find("escolha uma", 1, true)
                   or baixo:find("mantive o seu", 1, true) then
                    q = q + 1
                end
            end
            return q
        end

        -- NOTA DE ATRIBUTOS DO EDITOR (v0.42.1, C-06). O gerador NAO sorteia
        -- atributos: a linha "Atributos: 1 a 2" do rank e ambigua (por
        -- atributo? total?) e a propria Loja contradiz a leitura de "total"
        -- (Montaria rank E: 14 pontos). DECISAO DA MESA (05/09/2026): so
        -- avisar. Aqui a ficha mostra o que ESTA lancado ao lado da faixa
        -- do livro, para o mestre comparar sem abrir o painel.
        function atualizarNotaAtributosCriatura()
            if self.edCri_lblAtribNota == nil then return end
            local soma = 0
            for _, a in ipairs({"forca", "destreza", "constituicao", "inteligencia",
                                "sabedoria", "carisma", "manipulacao"}) do
                soma = soma + n(lerEditCri(a))
            end
            local c = criaturaPorIndice(criaturaEmEdicao)
            local rk = (c ~= nil) and CatalogoBestiario.rank(c.rank) or nil
            local txt = "lançados: " .. soma .. " pontos"
            if rk ~= nil then
                txt = txt .. "   ·   livro, rank " .. rk.nome .. ": atributos " ..
                    CatalogoBestiario.faixa(rk.atribMin, rk.atribMax) ..
                    " — a ficha não sorteia atributos; distribua na mão"
            end
            self.edCri_lblAtribNota:setText(txt)
        end

        -- NOTA DE DEFESAS DO EDITOR (v0.42.1, C-04): o Tipo Constructo e
        -- IMUNE a telepatia e empatia, o Necromorfo e imune a empatia e
        -- resistente a telepatia e dano fisico. Os campos EMPATICA e
        -- TELEPATICA guardavam 0, que na mesa se le como "sem defesa" - o
        -- oposto de imune. A marca vem do CATALOGO a cada pintura, nao e
        -- gravada: trocar o Tipo troca a marca, sem dado orfao.
        function atualizarNotaDefesasCriatura(c)
            if self.edCri_lblDefesasNota == nil then return end
            self.edCri_lblDefesasNota:setText(CatalogoBestiario.marcasDoTipo(c and c.tipo))
        end

        -- Mostra/esconde a caixa e mantem o rotulo do botao coerente com o
        -- estado. Largura 0 esconde o botao: setVisible(false) num filho
        -- align="left" reordena a linha quando volta.
        LARGURA_COLUNA_INSTRUCOES = 300

        function atualizarBotaoInstrucoes()
            local quantas = #(instrucoesCriatura or {})
            definirLarguraPod(self.edCri_wrapBtnInstrucoes, (quantas > 0) and 290 or 0)

            if self.edCri_lblBtnInstrucoes ~= nil then
                -- caractere UTF-8 literal, e nao "\u{25BE}": o Lua do Firecast
                -- nao garante o escape \u{...}, e o resto da ficha ja escreve
                -- os simbolos direto na string.
                self.edCri_lblBtnInstrucoes:setText(
                    (instrucoesAbertas and "▴  ESCONDER O QUE FICOU PARA VOCÊ"
                                        or "▾  O QUE FICOU PARA VOCÊ  (" .. quantas .. ")"))
            end

            if instrucoesAbertas and quantas > 0 then
                if self.edCri_lblInstrucoes ~= nil then
                    self.edCri_lblInstrucoes:setText("O QUE FICOU PARA VOCÊ DECIDIR:\n\n· " ..
                        table.concat(instrucoesCriatura, "\n\n· "))
                    -- Altura pelo texto: a coluna tem ~300px, uns 46
                    -- caracteres por linha em corpo 12. Rotulo com wordWrap
                    -- nao cresce sozinho; curto demais, corta em silencio.
                    local linhas = 2
                    for _, t in ipairs(instrucoesCriatura) do
                        linhas = linhas + math.ceil(contarCaracteres(t) / 46) + 1
                    end
                    pcall(function() self.edCri_lblInstrucoes:setHeight(linhas * 16 + 20) end)
                end
                definirLarguraPod(self.edCri_colInstrucoes, LARGURA_COLUNA_INSTRUCOES)
            else
                definirLarguraPod(self.edCri_colInstrucoes, 0)
            end
            -- O popup alarga para a coluna nao roubar espaco dos campos
            -- (a linha das classificacoes precisa de ~830px). Em 1366 o teto
            -- de 94% da janela segura tudo dentro da tela.
            pcall(function()
                local w = larguraDe(self)
                local desejada = 1000 + ((instrucoesAbertas and quantas > 0) and LARGURA_COLUNA_INSTRUCOES or 0)
                if w > 0 then desejada = math.min(desejada, math.floor(w * 0.94)) end
                definirLarguraPod(self.popCriatura, desejada)
            end)
        end

        function alternarInstrucoesCriatura()
            instrucoesAbertas = not instrucoesAbertas
            atualizarBotaoInstrucoes()
        end

        -- ---------------------------------------------------------------
        -- LIMPAR O QUE O LIVRO PREENCHEU
        --
        -- Apaga EXATAMENTE os campos de CAMPOS_DO_GERADOR - nem um a mais.
        -- Nome, deslocamentos, defesas, os atributos que o mestre digitou e
        -- os textos ficam onde estao: o botao existe para poder rodar o
        -- gerador de novo depois de trocar uma classificacao, e nao para
        -- zerar a criatura.
        --
        -- O aviso lista o que foi apagado. Botao que apaga em silencio e a
        -- forma mais rapida de perder confianca numa ficha.
        -- ---------------------------------------------------------------
        function limparRegrasDoLivro()
            if criaturaPorIndice(criaturaEmEdicao) == nil then return end
            local nomes = {}
            for _, d in ipairs(CAMPOS_DO_GERADOR) do
                porEditCri(d.campo, d.vazio)
                table.insert(nomes, d.rotulo)
            end
            instrucoesCriatura = {}
            instrucoesAbertas = false
            atualizarBotaoInstrucoes()
            avisarEditorCriatura("Limpei só o que o botão do livro preenche: " ..
                table.concat(nomes, ", ") ..
                ". Troque as classificações e aplique de novo. Nada foi salvo ainda.", COR.gold)
        end

        function avisarEditorCriatura(texto, cor)
            if self.edCri_lblAviso == nil then return end
            self.edCri_lblAviso:setText(tostring(texto or ""))
            self.edCri_lblAviso:setFontColor(cor or COR.muted)
        end

        function salvarEditorCriatura()
            local c = criaturaPorIndice(criaturaEmEdicao)
            if c == nil then return end
            local nome = lerEditCri("nome"):gsub("^%s+", ""):gsub("%s+$", "")
            if nome == "" then
                avisarEditorCriatura("A criatura precisa de um nome.", COR.wine)
                return
            end
            c.nome = nome
            for _, campo in ipairs(CAMPOS_NUMERICOS_CRIATURA) do
                c[campo] = n(lerEditCri(campo))
            end
            c.habilidades = lerEditCri("habilidades")
            c.descricao = lerEditCri("descricao")
            -- o campo ESPOLIOS nao existe mais; o texto antigo ja foi levado
            -- para as habilidades ao abrir. Zerar aqui e o que fecha a
            -- migracao - senao ele voltaria a ser anexado a cada abertura.
            c.espolios = ""
            c.imagem = tostring(sheet.imagemCriaturaEdicao or "")
            fecharEditorCriatura()
            atualizarAbaCriaturas()
            recalcularTudo()
        end

        -- ---------------------------------------------------------------
        -- A ABA
        -- ---------------------------------------------------------------
        function resumoDaCriatura(c)
            local p = {}
            local rk = tostring(c.rank or "")
            if rk ~= "" then table.insert(p, "rank " .. rk) end
            if n(c.desloc) > 0 then table.insert(p, n(c.desloc) .. "m") end
            if n(c.deslocVoo) > 0 then table.insert(p, "voo " .. n(c.deslocVoo) .. "m") end
            if n(c.deslocNado) > 0 then table.insert(p, "nado " .. n(c.deslocNado) .. "m") end
            if n(c.cd) > 0 then table.insert(p, "CD " .. n(c.cd)) end
            if n(c.prof) > 0 then table.insert(p, "prof +" .. n(c.prof)) end
            local tp = tostring(c.tipo or "")
            if tp ~= "" then table.insert(p, tp) end
            -- imunidades e resistencias do TIPO (v0.42.1, C-04): vem do
            -- catalogo a cada pintura, nunca do dado salvo
            local marcas = CatalogoBestiario.marcasDoTipo(tp)
            if marcas ~= "" then table.insert(p, marcas) end
            if #p == 0 then return "sem números ainda — abra o editor" end
            return table.concat(p, "  ·  ")
        end

        -- Primeira(s) linha(s) das habilidades especiais, para o card
        -- (v0.42.1, C-05): e o que se consulta no turno da criatura, e
        -- ficava so dentro do editor.
        function habilidadesParaCard(c)
            local t = tostring(c.habilidades or ""):gsub("^%s+", ""):gsub("%s+$", "")
            return t
        end

        -- Verdadeiro enquanto a aba esta sendo repintada. A caixa de vida
        -- atual dispara onChange tambem quando o SCRIPT escreve nela, entao
        -- sem esta trava a repintura chamaria definirVidaCriatura, que
        -- chamaria a repintura de novo: recursao infinita e a ficha travada.
        pintandoAbaCriaturas = false

        function atualizarAbaCriaturas()
            if sheet == nil then return end
            pintandoAbaCriaturas = true
            local lista = todasCriaturas()
            definirAlturaPod(self.abaCri_wrapVazio, (#lista == 0) and 76 or 0)

            for i = 1, MAX_CRIATURAS do
                local c = lista[i]
                -- altura pelo conteudo: 64 sem habilidades; com elas, ate 3
                -- linhas de 15px a mais (o resto fica no editor)
                local altura = 0
                local habTxt = ""
                if c ~= nil then
                    habTxt = habilidadesParaCard(c)
                    altura = 64
                    if habTxt ~= "" then
                        local linhas = math.ceil(contarCaracteres(habTxt) / 150)
                        if linhas < 1 then linhas = 1 end
                        if linhas > 3 then linhas = 3 end
                        altura = altura + linhas * 15
                    end
                end
                definirAlturaPod(self["abaCri_wrap" .. i], altura)
                if c ~= nil then
                    local lblHab = self["abaCri_lblHab" .. i]
                    if lblHab ~= nil then lblHab:setText(habTxt) end
                    local lbl = self["abaCri_lblNome" .. i]
                    if lbl ~= nil then
                        local txt = tostring(c.nome or "")
                        if c.montada == true then txt = txt .. "   ✦ MONTADO" end
                        lbl:setText(txt)
                        lbl:setFontColor((c.montada == true) and COR.gold or COR.text)
                    end

                    local lblPapel = self["abaCri_lblPapel" .. i]
                    if lblPapel ~= nil then
                        lblPapel:setText(string.upper(tostring(c.papel or "")))
                        if c.papel == "Montaria" then lblPapel:setFontColor(COR.gold)
                        elseif c.papel == "Familiar" then lblPapel:setFontColor(COR.aura)
                        else lblPapel:setFontColor(COR.muted) end
                    end

                    local lblRes = self["abaCri_lblResumo" .. i]
                    if lblRes ~= nil then lblRes:setText(resumoDaCriatura(c)) end

                    -- VIDA ATUAL: caixa digitavel desde a v0.35.1. As setas
                    -- continuam para o dano de 1 em 1, mas criatura de 500 de
                    -- vida nao se edita clicando 137 vezes.
                    local edVida = self["abaCri_edVida" .. i]
                    local lblMax = self["abaCri_lblVidaMax" .. i]
                    local maxima = n(c.vidaMax)
                    if edVida ~= nil then
                        edVida:setText(tostring(n(c.vidaAtual)))
                        if maxima > 0 and n(c.vidaAtual) <= 0 then edVida:setFontColor(COR.wine)
                        elseif maxima > 0 and n(c.vidaAtual) * 2 <= maxima then edVida:setFontColor(COR.gold)
                        else edVida:setFontColor(COR.text) end
                    end
                    if lblMax ~= nil then
                        lblMax:setText((maxima > 0) and ("/ " .. maxima) or "/ —")
                        lblMax:setFontColor((maxima > 0) and COR.muted or COR.faint)
                    end

                    -- botao de montar: so em quem e montaria
                    local ehMontaria = (tostring(c.papel or "") == "Montaria")
                    definirLarguraPod(self["abaCri_wrapMontar" .. i], ehMontaria and 104 or 0)
                    local lblM = self["abaCri_lblMontar" .. i]
                    if lblM ~= nil then
                        lblM:setText((c.montada == true) and "DESMONTAR" or "MONTAR")
                        lblM:setFontColor((c.montada == true) and COR.gold or COR.muted)
                    end
                end
            end

            -- resumo do topo
            if self.abaCri_lblContador ~= nil then
                self.abaCri_lblContador:setText(#lista .. " / " .. MAX_CRIATURAS)
            end
            pintandoAbaCriaturas = false
        end

        -- ---------------------------------------------------------------
        -- VIDA ATUAL DIGITADA NA LINHA
        --
        -- Nao chama atualizarAbaCriaturas(): a repintura escreveria na propria
        -- caixa que acabou de disparar este onChange. Quem precisa do resto da
        -- aba atualizado sao as setas, e elas ja fazem isso.
        --
        -- O valor e preso na faixa [0, vidaMax], e a caixa so e reescrita
        -- quando o numero digitado FOI corrigido - reescrever a cada tecla
        -- jogaria o cursor para o inicio e ninguem conseguiria digitar "150".
        -- ---------------------------------------------------------------
        function definirVidaCriatura(i)
            if pintandoAbaCriaturas then return end
            local c = criaturaPorIndice(i)
            if c == nil then return end
            local ed = self["abaCri_edVida" .. i]
            if ed == nil then return end

            local digitado = n(ed:getText())
            local preso = digitado
            local maxima = n(c.vidaMax)
            if preso < 0 then preso = 0 end
            if maxima > 0 and preso > maxima then preso = maxima end
            c.vidaAtual = preso

            if preso ~= digitado then
                pintandoAbaCriaturas = true
                ed:setText(tostring(preso))
                pintandoAbaCriaturas = false
            end

            if maxima > 0 and preso <= 0 then ed:setFontColor(COR.wine)
            elseif maxima > 0 and preso * 2 <= maxima then ed:setFontColor(COR.gold)
            else ed:setFontColor(COR.text) end
        end

        function inicializarFicha()

            repararNosAntigos()

            -- v0.32.1: limpa "limiteAcoesPadrao" e "limiteAcoesBonus" das
            -- fichas antigas. Os dois campos manuais foram removidos da aba
            -- de Perfil porque os cards de Ações na aba de Combate ja calculam
            -- o mesmo numero. Deixar o no gravado faria a checagem de campos
            -- NDB orfaos apontar para sempre, e um dia alguem tentaria "usar"
            -- de novo um dado que nao significa mais nada.
            if sheet ~= nil then
                sheet.limiteAcoesPadrao = nil
                sheet.limiteAcoesBonus = nil
            end

            atualizarNavegacao()
            atualizarSeloFinalizada()
            atualizarRotuloTraco()
            atualizarRotuloAspecto()
            atualizarBlocoRaca()
            atualizarBlocoClasse()
            atualizarBlocoPoderes()
            atualizarBlocoHabilidades()
            atualizarAbaCriaturas()
            aplicarConcessoes()
            recalcularTudo()
            pcall(function() ajustarGradeCombate() end)
            -- O SELO DO CABECALHO, DE NOVO E DEPOIS.
            -- Ao abrir a ficha, o recalculo la de cima ja chamou
            -- atualizarSeloCabecalho — e mesmo assim o cabecalho aparecia com
            -- o brasao do XML numa ficha PROCLAMADA (visto na tela em
            -- 05/09/2026). O seletor, aberto em seguida, ja marcava a
            -- divindade certa: o Lua estava certo e a tela, atrasada. Nao
            -- isolei o mecanismo — parece que o src do XML e aplicado depois
            -- do onNodeReady. Entao, em vez de apostar numa tese, a ficha
            -- reaplica: aqui no fim, e mais uma vez alguns milissegundos
            -- adiante. Custa duas atribuicoes e funciona mesmo se a
            -- explicacao estiver errada.
            pcall(function() atualizarSeloCabecalho() end)
            pcall(function()
                setTimeout(function() atualizarSeloCabecalho() end, 80)
            end)
        end
    ]]></script>

    <event name="onNodeReady"><![CDATA[
        inicializarFicha();
    ]]></event>

    <rectangle align="client" color="#070A0C" hitTest="false">

        <!-- ============ CABECALHO ============
             Para o titulo ficar OPTICAMENTE CENTRADO em relacao a ficha inteira,
             as duas laterais precisam reservar a MESMA largura (300px cada):
             a esquerda leva a secao atual, a direita leva o contador alinhado a
             direita dentro do mesmo espaco. O titulo entao usa align="client" e
             sobra exatamente no meio.
             ================================================================= -->
        <rectangle align="top" height="46" color="#0D1317" hitTest="false">
            <rectangle align="bottom" height="1" color="#C9A24B" hitTest="false"/>
            <layout align="client" margins="{left=16,right=16,top=0,bottom=0}">

                <layout align="left" width="300">
                    <!-- SELO DE VERSAO. Existe por um motivo pratico: mais de
                         uma vez a mesa reportou um bug que ja estava corrigido
                         numa versao que ainda nao tinha sido instalada, e nao
                         havia como saber isso olhando a ficha. Agora da.
                         O numero e ESCRITO A MAO aqui e conferido pela
                         checagem 27 contra o module.xml - se alguem esquecer
                         de subir um dos dois, o build para. -->
                    <label name="lblVersaoFicha" align="left" width="46" text="v0.49.2" fontFamily="Marcellus SC" fontColor="#3A4750" fontSize="11" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                    <label name="lblSecaoAtual" align="client" text="SEÇÃO 01  •  DADOS PESSOAIS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="12" vertTextAlign="center" margins="{left=8}"/>
                </layout>

                <layout align="right" width="300">
                    <rectangle align="right" width="62" color="#111A1E" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{top=11,bottom=11}" hitTest="false">
                        <label name="lblSecaoContador" align="client" text="1 / 9" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" horzTextAlign="center" vertTextAlign="center"/>
                    </rectangle>
                    <rectangle name="rectSeloFinalizada" align="right" width="170" color="#111A1E" strokeColor="#4E8C74" strokeSize="1" xradius="3" yradius="3" margins="{top=9,bottom=9,right=8}" cursor="handPoint" hint="Clique para finalizar a ficha (trava Qualidades, Raça e Favores). Só o mestre pode destravar depois.">
                        <event name="onClick"><![CDATA[alternarFichaFinalizada();]]></event>
                        <label name="lblSeloFinalizada" align="client" text="EM CRIAÇÃO" fontFamily="Marcellus SC" fontColor="#4E8C74" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                </layout>

                <!-- BRASAO DE PETRICHOR, um de cada lado do titulo (v0.43.0).
                     Sao DOIS de proposito: o titulo e o align="client" desta
                     fileira e so fica centrado se o que sobra dele for igual
                     dos dois lados — um brasao so empurraria o titulo 38px
                     para a direita e desfaria a conta que o comentario acima
                     explica. align="none" com posicao explicita porque o
                     titulo ja e o client daqui, e dois client no mesmo pai
                     fazem o segundo sumir (a checagem 9b pegou isso uma vez).
                     A arte: gota de chuva caindo sobre ardosia rachada, lua
                     crescente e coroa de louros — o proprio petrichor.

                     O CLIQUE FICA NUM <rectangle>, e nao num <layout>. A
                     v0.45.0 usou layout e nem o clique funcionava nem o Lua
                     achava a <image> de dentro para trocar o src — os dois
                     sintomas, uma causa so. A ficha tem 1751 rectangles
                     clicaveis e nao tinha UM layout clicavel: era o codigo
                     instalado dizendo qual e o padrao, e eu inventei outro.
                     A checagem 47 passa a proibir. -->
                <rectangle name="rectSeloCabE" align="left" width="38" color="#0D1317" strokeSize="0" margins="{left=6,right=6}" cursor="handPoint" hint="Clique para escolher o selo do cabeçalho: o brasão da mesa, o seu Aspecto Divino ou uma divindade que o abençoou.">
                    <event name="onClick"><![CDATA[abrirPopupSeloCabecalho();]]></event>
                    <image name="imgSeloCabE" align="none" left="0" top="4" width="38" height="38" style="originalSize" src="imagens/brasao_petrichor.png" hitTest="false"/>
                </rectangle>
                <rectangle name="rectSeloCabD" align="right" width="38" color="#0D1317" strokeSize="0" margins="{left=6,right=6}" cursor="handPoint" hint="Clique para escolher o selo do cabeçalho: o brasão da mesa, o seu Aspecto Divino ou uma divindade que o abençoou.">
                    <event name="onClick"><![CDATA[abrirPopupSeloCabecalho();]]></event>
                    <image name="imgSeloCabD" align="none" left="0" top="4" width="38" height="38" style="originalSize" src="imagens/brasao_petrichor.png" hitTest="false"/>
                </rectangle>
                <label align="client" text="CRÔNICAS DE PETRICHOR" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" horzTextAlign="center" vertTextAlign="center"/>
            </layout>
        </rectangle>

        <!-- ============ BARRA DE ABAS ============ -->
        <rectangle align="top" height="52" color="#070A0C" hitTest="false">
            <rectangle align="bottom" height="1" color="#1A262C" hitTest="false"/>
            <layout name="layBarraAbas" align="client" margins="{left=12,right=12,top=6,bottom=6}">
                    <event name="onResize"><![CDATA[ajustarBarraDeAbas(); ajustarGradeCombate();]]></event>
                    <rectangle name="btnAba1" align="left" width="131" color="#111A1E" strokeColor="#C9A24B" strokeSize="2" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo I — Perfil">
                        <event name="onClick"><![CDATA[ativarAba(1);]]></event>
                        <rectangle name="marcAba1" align="bottom" height="3" color="#C9A24B" visible="true" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba1" align="right" width="24" style="originalSize" src="imagens/aba_01_inativa.png" hitTest="false"/>
                            <label name="lblNumAba1" align="top" height="14" text="01" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba1" align="client" text="PERFIL" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba2" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo II — Atributos &amp; Perícias">
                        <event name="onClick"><![CDATA[ativarAba(2);]]></event>
                        <rectangle name="marcAba2" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba2" align="right" width="24" style="originalSize" src="imagens/aba_02_inativa.png" hitTest="false"/>
                            <label name="lblNumAba2" align="top" height="14" text="02" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba2" align="client" text="ATRIBUTOS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba3" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo III — Qualidades &amp; Defeitos">
                        <event name="onClick"><![CDATA[ativarAba(3);]]></event>
                        <rectangle name="marcAba3" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba3" align="right" width="24" style="originalSize" src="imagens/aba_03_inativa.png" hitTest="false"/>
                            <label name="lblNumAba3" align="top" height="14" text="03" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba3" align="client" text="QUAL. &amp; DEF." fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba4" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo IV — Raça &amp; Classe">
                        <event name="onClick"><![CDATA[ativarAba(4);]]></event>
                        <rectangle name="marcAba4" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba4" align="right" width="24" style="originalSize" src="imagens/aba_04_inativa.png" hitTest="false"/>
                            <label name="lblNumAba4" align="top" height="14" text="04" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba4" align="client" text="RAÇA &amp; CLASSE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba5" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo V — Poderes &amp; Habilidades">
                        <event name="onClick"><![CDATA[ativarAba(5);]]></event>
                        <rectangle name="marcAba5" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba5" align="right" width="24" style="originalSize" src="imagens/aba_05_inativa.png" hitTest="false"/>
                            <label name="lblNumAba5" align="top" height="14" text="05" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba5" align="client" text="PODERES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba6" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo VI — Cálculos &amp; Combate">
                        <event name="onClick"><![CDATA[ativarAba(6);]]></event>
                        <rectangle name="marcAba6" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba6" align="right" width="24" style="originalSize" src="imagens/aba_06_inativa.png" hitTest="false"/>
                            <label name="lblNumAba6" align="top" height="14" text="06" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba6" align="client" text="COMBATE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba7" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo VII — Favores Divinos">
                        <event name="onClick"><![CDATA[ativarAba(7);]]></event>
                        <rectangle name="marcAba7" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba7" align="right" width="24" style="originalSize" src="imagens/aba_07_inativa.png" hitTest="false"/>
                            <label name="lblNumAba7" align="top" height="14" text="07" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba7" align="client" text="INVENTÁRIO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba8" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo VIII — Inventário">
                        <event name="onClick"><![CDATA[ativarAba(8);]]></event>
                        <rectangle name="marcAba8" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba8" align="right" width="24" style="originalSize" src="imagens/aba_08_inativa.png" hitTest="false"/>
                            <label name="lblNumAba8" align="top" height="14" text="08" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba8" align="client" text="CRIATURAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
                    <rectangle name="btnAba9" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo IX — Background">
                        <event name="onClick"><![CDATA[ativarAba(9);]]></event>
                        <rectangle name="marcAba9" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba9" align="right" width="24" style="originalSize" src="imagens/aba_09_inativa.png" hitTest="false"/>
                            <label name="lblNumAba9" align="top" height="14" text="09" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba9" align="client" text="FAVORES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>

                    <rectangle name="btnAba10" align="left" width="131" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{right=4}" cursor="handPoint" hint="Abrir capítulo X — Criaturas: familiares, montarias e aliados">
                        <event name="onClick"><![CDATA[ativarAba(10);]]></event>
                        <rectangle name="marcAba10" align="bottom" height="3" color="#C9A24B" visible="false" hitTest="false"/>
                        <layout align="client" margins="{left=9,right=6,top=5,bottom=4}">
                            <image name="icoAba10" align="right" width="24" style="originalSize" src="imagens/aba_10_inativa.png" hitTest="false"/>
                            <label name="lblNumAba10" align="top" height="14" text="10" fontFamily="Cinzel" fontColor="#5F7078" fontSize="11" fontStyle="bold"/>
                            <label name="lblTitAba10" align="client" text="BACKGROUND" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" fontStyle="bold"/>
                        </layout>
                    </rectangle>
            </layout>
        </rectangle>

        <!-- ============ PAINEIS DAS ABAS ============ -->
        <layout align="client">

            <layout name="pnlAba1" align="client" visible="true">
                <scrollBox align="client" margins="{left=16,right=16,top=14,bottom=14}">

                    <layout align="top" height="34" margins="{bottom=2}">
                        <label align="left" width="26" text="◆" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center"/>
                        <label align="client" text="IDENTIFICAÇÃO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=14}" hitTest="false"/>

                    <layout align="top" height="312" margins="{bottom=16}">

                        <!-- 234 x 312: com as margens de 3px a imagem interna
                             fica 228x306, exatamente 3:4 - a proporcao de
                             retrato mais comum, que e onde o autoFit corta
                             menos da arte. Era 190 (0,61), estreita demais.
                             NOME / RACA / PHOTOPLAYER / LOCAL DE ORIGEM sao
                             align="client": cedem os 44px sozinhos, nao ha o
                             que mexer neles. Se mudar esta largura, mude junto
                             a altura do layout acima para manter 3:4. -->
                        <rectangle align="left" width="234" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" margins="{right=16}" hitTest="false">
                            <!-- style="autoFit": PREENCHE a moldura mantendo a
                                 proporcao, cortando o que sobra. E o valor
                                 usado na ficha de Night City Noir
                                 (<image field="imagemPerfil" animate="true"
                                 style="autoFit"/>), que foi a comparacao que a
                                 mesa pediu.
                                 NAO e "proportional", que encaixa a imagem
                                 inteira e deixa faixa preta quando a proporcao
                                 nao bate — era a reclamacao. E NAO e "stretch",
                                 que preenche DEFORMANDO: foi o que a v0.33.1
                                 tentou, e a imagem saiu esticada.
                                 animate="true" faz GIF animado rodar. -->
                            <image align="client" field="imagemPersonagem" editable="true" animate="true" style="autoFit" showProgress="true" margins="{left=3,right=3,top=3,bottom=3}" hint="Clique para escolher o retrato do personagem — de um endereço da internet ou do seu FireDrive."/>
                            <!-- Moldura em ouro por CIMA do retrato (irmao posterior
                                 desenha por cima). hitTest="false" deixa o clique passar
                                 para o campo de imagem. align="none" com posicao
                                 explicita: o retrato ja e o align="client" deste
                                 retangulo, e dois client no mesmo pai fazem o segundo
                                 sumir (checagem 9b pegou na primeira tentativa). -->
                            <image align="none" left="0" top="0" width="234" height="312" style="originalSize" src="imagens/moldura_retrato.png" hitTest="false"/>
                        </rectangle>

                        <layout align="client">

                            <layout align="top" height="64" margins="{bottom=24}">
                                <layout align="right" width="226" margins="{left=14}">
                                    <label align="top" height="17" text="ANIVERSÁRIO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="34" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit name="edAniversario" align="client" transparent="true" margins="{left=8,right=8}" field="aniversario" type="text" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14" hint="Ex.: 16 da Primavera"/></rectangle>
                                </layout>
                                <layout align="right" width="160" margins="{left=14}">
                                    <label align="top" height="17" text="IDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="34" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit name="edIdade" align="client" transparent="true" margins="{left=8,right=8}" field="idade" type="text" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14" hint="Pode escrever livremente, ex.: '18 anos'. Só o número no início conta para os cálculos (a mana por idade).">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit></rectangle>
                                </layout>
                                <layout align="client">
                                    <label align="top" height="17" text="NOME" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="34" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit align="client" transparent="true" margins="{left=8,right=8}" field="nome" type="text" fontColor="#E6E9E4" fontFamily="Cinzel" fontSize="15"/></rectangle>
                                </layout>
                            </layout>

                            <layout align="top" height="58" margins="{bottom=24}">
                                <layout align="right" width="400" margins="{left=14}">
                                    <label align="top" height="17" text="CLASSE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="32" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit name="edClasse" align="client" transparent="true" margins="{left=8,right=8}" field="classe" type="text" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14" hint="Preenchido pela escolha de classe e subclasse na aba 04 · RAÇA &amp; CLASSE. Não se digita aqui."/></rectangle>
                                </layout>
                                <layout align="client">
                                    <label align="top" height="17" text="RAÇA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="32" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit name="edRaca" align="client" transparent="true" margins="{left=8,right=8}" field="raca" type="text" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14" hint="Preenchido pelo catálogo de raças na aba 04 · RAÇA &amp; CLASSE (mestiçagem inclusive). Não se digita aqui: é a chave que liga as concessões raciais."/></rectangle>
                                </layout>
                            </layout>

                            <layout align="top" height="58" margins="{bottom=24}">
                                <layout align="right" width="400" margins="{left=14}">
                                    <label align="top" height="17" text="ASPECTO DIVINO" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11"/>
                                    <rectangle align="top" height="32" color="#0A0C10" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Abrir o catálogo de divindades — o kit de poderes do deus escolhido libera a aba de Poderes">
                                        <event name="onClick"><![CDATA[abrirPopupDeuses();]]></event>
                                        <layout align="client" margins="{left=8,right=8}">
                                            <label align="right" width="14" text="&#9662;" fontFamily="Petrichor Simbolos" fontColor="#8A63C9" fontSize="12" vertTextAlign="center" hitTest="false"/>
                                            <label name="lblAspectoAtual" align="client" text="Clique para escolher a divindade" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="14" vertTextAlign="center" hitTest="false"/>
                                        </layout>
                                    </rectangle>
                                </layout>
                                <layout align="client">
                                    <label align="top" height="17" text="PHOTOPLAYER" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="32" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit align="client" transparent="true" margins="{left=8,right=8}" field="photoplayer" type="text" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14"/></rectangle>
                                </layout>
                            </layout>

                            <layout align="top" height="66">
                                <layout align="right" width="400" margins="{left=14}">
                                    <label align="top" height="17" text="TRAÇO DE PERSONALIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="32" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Abrir o catálogo de Traços de Personalidade">
                                        <event name="onClick"><![CDATA[abrirPopupTracos();]]></event>
                                        <layout align="client" margins="{left=10,right=8,top=0,bottom=0}">
                                            <label name="lblTracoAtual" align="client" text="Clique para escolher" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="13" vertTextAlign="center" wordWrap="false" hint="Traços de personalidade. Um personagem pode acumular mais de um; só o mestre concede ou remove."/>
                                            <label align="right" width="18" text="&#9662;" fontFamily="Petrichor Simbolos" fontColor="#8A63C9" fontSize="14" horzTextAlign="center" vertTextAlign="center"/>
                                        </layout>
                                    </rectangle>
                                </layout>
                                <layout align="client">
                                    <label align="top" height="17" text="LOCAL DE ORIGEM" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                    <rectangle align="top" height="32" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit align="client" transparent="true" margins="{left=8,right=8}" field="localOrigem" type="text" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14" hint="Cidade/vila, Reino de X. Vetado ser de Sindhoria."/></rectangle>
                                </layout>
                            </layout>
                        </layout>
                    </layout>

                    <layout align="top" height="30" margins="{bottom=2}">
                        <label align="left" width="24" text="&#9670;" fontFamily="EB Garamond" fontColor="#4E8C74" fontSize="14" vertTextAlign="center" horzTextAlign="center"/>
                        <label align="client" text="PROGRESSÃO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" margins="{left=4}"/>
                    </layout>
                    <rectangle align="top" height="1" color="#4E8C74" margins="{bottom=12}" hitTest="false"/>

                    <rectangle align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" margins="{bottom=10}" hitTest="false">
                        <rectangle align="left" width="3" color="#C9A24B" hitTest="false"/>
                        <layout align="client" margins="{left=14,right=14,top=10,bottom=10}">
                            <layout align="left" width="110" margins="{right=12}">
                                <label align="top" height="17" text="NÍVEL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                <rectangle align="top" height="36" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit name="edNivel" align="client" transparent="true" margins="{left=8,right=8}" field="nivel" type="number" fontColor="#C9A24B" fontFamily="Cinzel" fontSize="20" horzTextAlign="center" hint="De 1 a 20. Sobe sozinho pela experiência; o mestre pode ajustar na mão.">
                                    <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                </edit></rectangle>
                            </layout>
                            <layout align="left" width="170" margins="{right=12}">
                                <label align="top" height="17" text="EXPERIÊNCIA (XP)" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                                <rectangle align="top" height="36" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><edit name="edExperiencia" align="client" transparent="true" margins="{left=8,right=8}" field="experiencia" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="16" horzTextAlign="center" hint="Ao atingir o XP do próximo nível, o nível sobe sozinho.">
                                    <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                </edit></rectangle>
                            </layout>
                            <layout align="left" width="180" margins="{right=12}">
                                <label align="top" height="17" text="XP P/ PRÓX. NÍVEL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblXpProximoValor" align="top" height="22" text="-" fontFamily="Cinzel" fontColor="#7FA8B8" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
                                <label name="lblXpFaltaValor" align="top" height="14" text="" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" horzTextAlign="center"/>
                            </layout>
                            <layout align="left" width="80" margins="{right=12}">
                                <label align="top" height="17" text="RANK" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblRankValor" align="top" height="36" text="E" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="26" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                            <layout align="left" width="80" margins="{right=12}">
                                <label align="top" height="17" text="PROF." fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblProfValor" align="top" height="36" text="+2" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" horzTextAlign="center"/>
                            </layout>
                            <layout align="left" width="90" margins="{right=12}">
                                <label align="top" height="17" text="LIM. ATRIB." fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblLimiteAtributoValor" align="top" height="36" text="4" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" horzTextAlign="center"/>
                            </layout>
                            <!-- Aviso de nivel corrigido (v0.42.1): quando o valor
                                 digitado sai de 1..20, recalcularTudo() grava o
                                 valor limitado no campo e explica aqui. Sem isto
                                 o "201" ficava no campo e nas contas. -->
                            <label name="lblAvisoNivel" align="client" text="" fontFamily="EB Garamond" fontColor="#E2AEB6" fontSize="12" wordWrap="true" vertTextAlign="center" hitTest="false"/>
                            <!-- "LIM. AÇÕES" e "LIM. AÇÕES BÔNUS" sairam na
                                 v0.32.1. Eram campos MANUAIS de antes de
                                 existirem os cards de Ações padrão / bônus /
                                 reação na aba de Combate. Depois que os cards
                                 passaram a calcular sozinhos, os dois viraram
                                 uma segunda fonte de verdade para o mesmo
                                 numero — e mostravam "1" e "0" enquanto os
                                 cards mostravam 1, 2 e 2. Duas fontes divergem,
                                 sempre. -->
                        </layout>
                    </rectangle>

                    <layout align="top" height="30" margins="{top=6,bottom=2}">
                        <label align="left" width="24" text="&#9670;" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="14" vertTextAlign="center" horzTextAlign="center"/>
                        <label align="client" text="DESCRIÇÃO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" margins="{left=4}"/>
                    </layout>
                    <rectangle align="top" height="1" color="#7FA8B8" margins="{bottom=12}" hitTest="false"/>

                    <label align="top" height="17" text="APARÊNCIA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                    <rectangle align="top" height="92" margins="{bottom=12}" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><textEditor align="client" transparent="true" margins="{left=8,right=8,top=6,bottom=6}" field="aparencia" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14"/></rectangle>

                    <label align="top" height="17" text="PERSONALIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                    <rectangle align="top" height="92" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3"><textEditor align="client" transparent="true" margins="{left=8,right=8,top=6,bottom=6}" field="personalidade" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="14"/></rectangle>
                </scrollBox>
            </layout>

            <layout name="pnlAba2" align="client" visible="false" enabled="false">
                <scrollBox align="client" margins="{left=16,right=16,top=14,bottom=14}">
                    <layout align="top" height="34" margins="{bottom=2}">
                        <label align="left" width="26" text="⚝" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center"/>
                        <label align="client" text="ATRIBUTOS &amp; PERÍCIAS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=14}" hitTest="false"/>

                    <!-- ===== PAINEL DE PONTOS =====
                         Altura = soma dos filhos align="top": 56 + 48 + 16 + 16 = 136.
                         Era 98 (B-05): os dois rotulos de baixo — o aviso de
                         limite de atributo e a nota da Linhagem de Unaris —
                         ficavam inteiros fora do card, e o Firecast nao avisa:
                         simplesmente nao desenha. A checagem 43 cobra esta
                         conta para todo container de altura fixa. -->
                    <rectangle align="top" height="136" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}">
                        <layout align="top" height="52" margins="{left=10,right=10,top=4}">
                            <label align="left" width="96" text="ATRIBUTOS" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="TOTAL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="15 pontos iniciais mais os ganhos por nível (2, 6, 8, 11, 13, 15, 17 e 18)."/>
                                <label name="abaAtr_lblPontosTotal" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="GASTOS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <label name="abaAtr_lblPontosGastos" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="20" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="SALDO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <label name="abaAtr_lblPontosSaldo" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="EXTRAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Soma dos bônus de raça e poderes (o campo '+' de cada atributo). Não sai do seu bolso."/>
                                <label name="abaAtr_lblPontosExtras" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#4E8C74" fontSize="20" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <rectangle align="left" width="1" color="#22323A" margins="{left=10,right=10,top=6,bottom=6}" hitTest="false"/>
                            <label align="left" width="88" text="PERÍCIAS" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="TOTAL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="6 perícias iniciais mais as ganhas por nível, somadas às vagas concedidas por poderes."/>
                                <label name="abaAtr_lblPerTotal" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="ESCOLHIDAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <label name="abaAtr_lblPerUsadas" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="20" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="92">
                                <label align="top" height="14" text="SALDO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <label name="abaAtr_lblPerSaldo" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="client">
                                <label align="top" height="14" text="EXTRAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Perícias concedidas por raça, poder ou qualidade — não ocupam vaga."/>
                                <label name="abaAtr_lblPerExtras" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#4E8C74" fontSize="20" horzTextAlign="center" hitTest="false"/>
                            </layout>
                        </layout>
                    <!-- AJUSTE DO MESTRE: estes dois campos eram lidos pelo
                         cálculo mas não existiam na tela — o mestre não tinha
                         como usar a válvula de escape. Achado pela verificação
                         de campos NDB órfãos. -->
                    <layout align="top" height="42" margins="{top=4,bottom=2}">
                        <label align="left" width="150" text="AJUSTE DO MESTRE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hint="Pontos concedidos fora da progressão normal — recompensa de narrativa, correção de mesa."/>
                        <layout align="left" width="180" margins="{right=10}">
                            <label align="top" height="14" text="PONTOS DE ATRIBUTO" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" hitTest="false"/>
                            <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                <edit name="abaAtr_edAjustePontos" align="client" field="pontosAtributoAjuste" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Soma ou subtrai pontos de atributo. Use negativo para retirar.">
                                    <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                </edit>
                            </rectangle>
                        </layout>
                        <layout align="left" width="180">
                            <label align="top" height="14" text="VAGAS DE PERÍCIA" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" hitTest="false"/>
                            <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                <edit name="abaAtr_edAjustePericias" align="client" field="periciasAjuste" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Soma ou subtrai vagas de perícia. Use negativo para retirar.">
                                    <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                </edit>
                            </rectangle>
                        </layout>
                        <label align="client" text="" hitTest="false"/>
                    </layout>

                        <label name="abaAtr_lblAvisoLimite" align="top" height="16" text="" fontFamily="EB Garamond" fontColor="#E2AEB6" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                        <label name="abaAtr_lblNota" align="top" height="16" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                    </rectangle>

                    <!-- ESCOLA COM VANTAGEM da Linhagem de Unaris (v0.42.1, B-02).
                         O livro [2.2]: "escolha rolar dados com vantagem em uma
                         escola de magia". A ficha lia sheet.periciaMagiaEscolhida
                         em dois lugares e NINGUEM a escrevia: a bruxa via o aviso
                         "escolha no detalhe da qualidade" para sempre e nunca
                         recebia a vantagem. Altura 0 esconde; abre so com a
                         qualidade na ficha. -->
                    <layout name="abaAtr_wrapEscola" align="top" height="0">
                        <rectangle align="client" color="#0D1317" strokeColor="#8A63C9" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}">
                            <label name="abaAtr_lblEscolaTit" align="left" width="230" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" vertTextAlign="center" wordWrap="true" margins="{left=10,right=6}" hitTest="false"/>
                            <rectangle name="abaAtr_btnEscola1" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com VANTAGEM em Encantamentos (magia/forja) (Linhagem de Unaris)">
                                <label name="abaAtr_lblEscola1" align="client" text="Encantamentos" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherEscolaDeMagia("Encantamentos (magia/forja)");]]></event>
                            </rectangle>
                            <rectangle name="abaAtr_btnEscola2" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com VANTAGEM em Transmutação (magia) (Linhagem de Unaris)">
                                <label name="abaAtr_lblEscola2" align="client" text="Transmutação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherEscolaDeMagia("Transmutação (magia)");]]></event>
                            </rectangle>
                            <rectangle name="abaAtr_btnEscola3" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com VANTAGEM em Evocação (magia) (Linhagem de Unaris)">
                                <label name="abaAtr_lblEscola3" align="client" text="Evocação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherEscolaDeMagia("Evocação (magia)");]]></event>
                            </rectangle>
                            <rectangle name="abaAtr_btnEscola4" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com VANTAGEM em Invocação (Linhagem de Unaris)">
                                <label name="abaAtr_lblEscola4" align="client" text="Invocação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherEscolaDeMagia("Invocação");]]></event>
                            </rectangle>
                            <rectangle name="abaAtr_btnEscola5" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com VANTAGEM em Clarividência (magia/oráculos) (Linhagem de Unaris)">
                                <label name="abaAtr_lblEscola5" align="client" text="Clarividência" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <event name="onClick"><![CDATA[escolherEscolaDeMagia("Clarividência (magia/oráculos)");]]></event>
                            </rectangle>
                        </rectangle>
                    </layout>

                    <rectangle name="abaAtr_blocoCarisma" align="top" height="260" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="6" yradius="6" margins="{bottom=10}">
                        <layout align="client" margins="{left=10,right=10,top=8,bottom=8}">
                            <layout align="top" height="34" margins="{bottom=6}">
                                <label align="left" width="190" text="CARISMA" fontFamily="Cinzel Decorative" fontColor="#E6E9E4" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
                                <rectangle align="left" width="78" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3">
