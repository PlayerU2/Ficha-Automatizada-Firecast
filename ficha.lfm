                                <edit align="client" field="dadoVida" type="number" text="0" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="13" horzTextAlign="center" transparent="true" hint="Valor máximo do dado de vida da sua raça.">
                                    <event name="onChange"><![CDATA[recalcularTudo();]]></event>
