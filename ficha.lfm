                                        <rectangle align="left" width="84" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{left=6,top=3,bottom=3}" cursor="handPoint" hint="Escolher em qual slot equipar">
                                            <label align="client" text="EQUIPAR" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                            <event name="onClick"><![CDATA[abrirEscolhaSlot(40);]]></event>
                                        </rectangle>
                                        <rectangle align="left" width="78" color="#12181C" strokeColor="#8C9AA0" strokeSize="1" xradius="3" yradius="3" margins="{left=6,top=3,bottom=3}" cursor="handPoint" hint="Devolver para a mochila">
                                            <label align="client" text="MOCHILA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                            <event name="onClick"><![CDATA[moverItem(40,"mochila");]]></event>
                                        </rectangle>
                                        <rectangle align="left" width="50" color="#12181C" strokeColor="#54636B" strokeSize="1" xradius="3" yradius="3" margins="{left=6,top=3,bottom=3}" cursor="handPoint" hint="Guardar no baú: fica na residência, fora da campanha">
                                            <label align="client" text="BAÚ" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                            <event name="onClick"><![CDATA[moverItem(40,"bau");]]></event>
                                        </rectangle>
                                    <rectangle align="left" width="26" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=10,top=3,bottom=3}" cursor="handPoint" hint="Remover este item da ficha">
                                        <label align="client" text="x" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="12" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[removerItem(40);]]></event>
                                    </rectangle>
                                </layout>

                                <layout align="client">
                                    <layout align="top" height="22">
                                        <rectangle align="left" width="300" color="#0D1317" strokeSize="0" cursor="handPoint" hint="Clique para editar este item">
                                            <label name="abaInv_lblItem40" align="client" text="" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="13" fontStyle="bold" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                            <event name="onClick"><![CDATA[abrirEditorItem(40);]]></event>
                                        </rectangle>
                                        <label name="abaInv_lblQual40" align="left" width="70" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="abaInv_lblOnde40" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <label name="abaInv_lblResumo40" align="client" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>>

                </scrollBox>
            </layout>

            <layout name="pnlAba9" align="client" visible="false" enabled="false">
                <layout align="client" margins="{left=14,right=14,top=8,bottom=10}">

                    <!-- Cabeçalho enxuto e link numa linha só: tudo que sobra
                         de altura vai para a área de escrita. -->
                    <layout align="top" height="26">
                        <label align="left" width="26" text="❧" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                        <label align="left" width="330" text="BACKGROUND &amp; ANOTAÇÕES" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                        <label align="client" text="Selecione o texto para abrir as opções de formatação" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="trailing" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=6}" hitTest="false"/>

                    <!-- LINK: o livro permite entregar a história por documento
                         externo, e muita gente escreve fora da ficha. -->
                    <layout align="top" height="30" margins="{bottom=6}">
                        <label align="left" width="130" text="LINK DO DOCUMENTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hint="Se a história estiver num Google Docs ou similar, guarde o endereço aqui."/>
                        <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{top=2,bottom=2}">
                            <edit name="abaBg_edLink" align="client" field="bgLink" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" transparent="true" margins="{left=10,right=10}" hint="Cole aqui o endereço da história, se ela estiver fora da ficha"/>
                        </rectangle>
                        <rectangle align="right" width="170" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{left=10,top=2,bottom=2}" cursor="handPoint" hint="Publicar o link no chat, para o mestre abrir">
                            <label align="client" text="ENVIAR LINK NO CHAT" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[publicarLinkBackground();]]></event>
                        </rectangle>
                    </layout>

                    <!-- Campo único, ocupando toda a altura restante: a aba
                         inteira é a área de escrita. -->
                    <!-- richEdit, e nao textEditor: traz a barra de formatação
                         do próprio Firecast (negrito, itálico, tamanho, cor,
                         alinhamento, listas e imagens coladas). O textEditor
                         só guarda texto puro. -->
                    <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5">
                        <richEdit name="abaBg_edTexto" align="client" field="background" defaultFontColor="#E6E9E4" backgroundColor="#080B0E" margins="{left=8,right=8,top=6,bottom=6}" hint="História do personagem, anotações de sessão, pistas — com formatação e imagens."/>
                    </rectangle>

                </layout>
            </layout>

        <layout name="pnlAba10" align="client" visible="false" enabled="false">
            <scrollBox align="client" margins="{left=18,right=18,top=10,bottom=10}">

                <layout align="top" height="30" margins="{bottom=2}">
                    <label align="left" width="26" text="☽" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                    <label align="left" width="300" text="CRIATURAS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                    <label name="abaCri_lblContador" align="right" width="80" text="0 / 12" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="14" horzTextAlign="trailing" vertTextAlign="center" hint="12 é o limite desta FICHA (são 12 cards), não uma regra do livro — o Bestiário não limita criaturas por personagem."/>
                    <rectangle align="client" height="1" color="#C9A24B" margins="{left=6,right=10,top=15,bottom=14}" hitTest="false"/>
                </layout>

                <label align="top" height="30" text="Familiares, montarias, aliados e o que mais a mesa inventar. O Bestiário do livro define Tamanho, Natureza, Intelecto, Dieta, Tipo, Raridade e Rank — o botão dentro do editor preenche o que essas sete classificações determinam, e o resto é seu." fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{bottom=4}" hitTest="false"/>

                <layout align="top" height="34" margins="{bottom=6}">
                    <rectangle align="left" width="220" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{right=12,top=2,bottom=2}" cursor="handPoint" hint="Criar uma criatura em branco e abrir o editor dela">
                        <label align="client" text="+  NOVA CRIATURA" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        <event name="onClick"><![CDATA[criarCriatura();]]></event>
                    </rectangle>
                    <label name="abaCri_lblAviso" align="client" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" wordWrap="true" hitTest="false"/>
                </layout>

                <!-- A lista de verdade. Fica com 4px porque quem desenha as
                     linhas sao os doze slots abaixo, escritos por script; o
                     recordList existe para guardar os nos e dar o :append().
                     Mesmo padrao ja usado em listaHabilidades. -->
                <recordList name="listaCriaturas" align="top" height="4" field="listaCriaturas" templateForm="frmItemCriatura" itemHeight="4" selectable="false"/>

                <layout name="abaCri_wrapVazio" align="top" height="76">
                    <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{bottom=8}" hitTest="false">
                        <label align="client" text="Nenhuma criatura cadastrada. Um familiar, uma montaria, um aliado que anda com o grupo — tudo o que tem ficha própria e não é um item entra aqui. Comece pelo botão acima; o editor abre sozinho." fontFamily="EB Garamond" fontColor="#54636B" fontSize="12" wordWrap="true" vertTextAlign="center" margins="{left=16,right=16}" hitTest="false"/>
                    </rectangle>
                </layout>

                    <layout name="abaCri_wrap1" align="top" height="0">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" margins="{bottom=6}">
                            <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
