                                </rectangle>
                                <label align="top" height="20" text="ARTÍFICIE" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{top=8,bottom=3}"/>
                                <rectangle name="rectCls_Artificie_1" align="top" height="28" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Ver a árvore de Mestre da forja (Artíficie)">
