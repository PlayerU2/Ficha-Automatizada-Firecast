                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Honesto" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Honesto' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Honesto");]]></event>
