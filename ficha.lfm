                    <rectangle name="popSlot_btnacessorio2" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblacessorio2" align="client" text="ACESSÓRIO 2" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
