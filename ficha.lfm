                            </layout>
                            <label align="client" text="Personagens pacientes possuem vantagem em quaisquer testes que envolvam uma preparação longa (maior que 10 dias), sendo igualmente válido para tarefas prolongadas. Você terá desvantagem em testes sociais contra personagens Impacientes." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Impaciente" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Impaciente' para o personagem">
