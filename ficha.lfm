                    <layout align="client">
                        <label name="popCls_lblTitulo" align="top" height="26" text="Escolha uma subclasse na lista ao lado" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold"/>
                        <label name="popCls_lblSubtitulo" align="top" height="18" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11"/>
                        <label name="popCls_lblDescricao" align="top" height="36" text="" fontFamily="EB Garamond" fontColor="#C9CFCE" fontSize="12" wordWrap="true" vertTextAlign="leading" margins="{top=4}"/>

                        <rectangle align="top" height="46" color="#0B1014" strokeColor="#C9A24B" strokeSize="1" xradius="4" yradius="4" margins="{top=6,bottom=6}" hitTest="false">
                            <layout align="client" margins="{left=10,right=10,top=4,bottom=4}">
                                <label align="top" height="14" text="OBSERVAÇÃO DA SUBCLASSE" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11"/>
                                <label name="popCls_lblNota" align="client" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" wordWrap="true" vertTextAlign="leading"/>
                            </layout>
                        </rectangle>

                        <rectangle align="top" height="26" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=6}" hitTest="false">
