                                    <label name="popHab_lblPoder2" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                    <label name="popHab_lblPoderNv2" align="right" width="90" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[popHabEscolherPoder(2);]]></event>
                                </rectangle>
                            </layout>
                            <layout name="popHab_wrapPoder3" align="top" height="0">
                                <rectangle name="popHab_rectPoder3" align="client" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Usar este poder como origem da habilidade">
                                    <label name="popHab_lblPoder3" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                    <label name="popHab_lblPoderNv3" align="right" width="90" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[popHabEscolherPoder(3);]]></event>
