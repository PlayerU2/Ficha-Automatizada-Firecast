                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=4}" hitTest="false"/>
                    <label align="top" height="18" text="Tudo aqui vem das outras seções. Cada valor mostra a conta que o gerou, e todo campo de ajuste é seu para corrigir o que o sistema não cobre." fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" hitTest="false"/>
                    <!-- Linha de recusa/aviso da aba. Vive vazia; só ganha
                         texto quando a ficha precisa explicar por que não fez
                         alguma coisa (ex.: trocar o tamanho com a ficha
                         finalizada). -->
                    <label name="cmb_lblAviso" align="top" height="16" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>

                <layout align="top" height="28" margins="{top=10,bottom=4}">
