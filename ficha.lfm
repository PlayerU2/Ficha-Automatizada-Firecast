                            <label align="left" width="16" text="◆" fontFamily="Petrichor Simbolos" fontColor="#8A63C9" fontSize="11" vertTextAlign="center" hitTest="false"/>
                            <label name="abaPod_lblGrupo24" align="left" width="420" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" vertTextAlign="center" hitTest="false"/>
                            <rectangle align="client" height="1" color="#22323A" margins="{left=8,top=12,bottom=12}" hitTest="false"/>
                        </layout>
                    </layout>
                    <layout name="abaPod_wrapSlot24" align="top" height="0">
                        <rectangle name="abaPod_secSlot24" align="client" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}">
                            <layout align="top" height="34" margins="{left=10,right=8,top=4}">
                                <rectangle align="left" width="240" color="#0D1317" strokeSize="0" cursor="handPoint" hint="Abrir este poder no catálogo">
                                    <label name="abaPod_lblNome24" align="client" text="" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="13" fontStyle="bold" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    <event name="onClick"><![CDATA[ slotPoderDetalhe(24); ]]></event>
                                </rectangle>
                                <label name="abaPod_lblTipo24" align="left" width="70" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <rectangle name="abaPod_secOrigem24" align="left" width="170" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="8" yradius="8" margins="{top=7,bottom=7,right=8}" hitTest="false">
                                    <label name="abaPod_lblOrigem24" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                </rectangle>
                                <!-- COLUNA DIREITA: container unico com filhos align="left".
                                     Ordem de declaracao = ordem na tela, e o botao que
                                     REMOVE fica por ultimo, a direita de tudo. -->
                                <layout align="right" width="200">
                                    <layout align="left" width="96">
                                        <rectangle name="abaPod_pip24_1" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=8,bottom=8}" hitTest="false"/>
                                        <rectangle name="abaPod_pip24_2" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=8,bottom=8}" hitTest="false"/>
                                        <rectangle name="abaPod_pip24_3" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=8,bottom=8}" hitTest="false"/>
                                        <rectangle name="abaPod_pip24_4" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=8,bottom=8}" hitTest="false"/>
                                        <rectangle name="abaPod_pip24_5" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=8,bottom=8}" hitTest="false"/>
                                    </layout>
                                    <label name="abaPod_lblCont24" align="left" width="46" text="0 / 5" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="12" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <rectangle name="abaPod_btnMais24" align="left" width="26" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{top=5,bottom=5}" cursor="handPoint" hint="Gastar 1 ponto de poder para subir um nível">
                                        <label align="client" text="+" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="14" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[ slotPoderMais(24); ]]></event>
                                    </rectangle>
                                    <rectangle name="abaPod_btnMenos24" align="left" width="26" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{left=6,top=5,bottom=5}" cursor="handPoint" hint="Devolver um nível e recuperar o ponto (no nível 1, remove o poder)">
                                        <label align="client" text="–" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="14" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[ slotPoderMenos(24); ]]></event>
                                    </rectangle>
                                </layout>
                            </layout>
                            <label name="abaPod_lblEfeito24" align="top" height="32" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="12" wordWrap="true" margins="{left=10,right=10,bottom=4}" hitTest="false"/>
                        </rectangle>
                    </layout>

                    <!-- ===================== HABILIDADES ===================== -->
                    <layout align="top" height="34" margins="{top=18,bottom=2}">
                        <label align="left" width="26" text="✦" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                        <label align="client" text="HABILIDADES" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}" hitTest="false"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=12}" hitTest="false"/>

                    <rectangle align="top" height="56" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}">
                        <layout align="top" height="50" margins="{left=10,right=10,top=3}">
                            <layout align="left" width="90">
                                <label align="top" height="14" text="CRIADAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <label name="abaHab_lblQtd" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="110">
                                <label align="top" height="14" text="PONTOS GASTOS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Habilidades gastam do mesmo pool de pontos dos poderes."/>
                                <label name="abaHab_lblGastos" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="20" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <label name="abaHab_lblCreditos" align="client" text="" fontFamily="EB Garamond" fontColor="#C9A24B" fontSize="11" wordWrap="true" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        </layout>
                    </rectangle>

                    <layout align="top" height="34" margins="{bottom=6}">
                        <rectangle align="left" width="220" color="#12181C" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{right=8,top=2,bottom=2}" cursor="handPoint" hint="Criar uma habilidade vinculada a um dos seus poderes ativos">
                            <label align="client" text="+  HABILIDADE DE PODER" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[ abrirConstrutorHabilidade("poder"); ]]></event>
                        </rectangle>
                        <rectangle align="left" width="220" color="#12181C" strokeColor="#4E8C74" strokeSize="1" xradius="3" yradius="3" margins="{right=8,top=2,bottom=2}" cursor="handPoint" hint="Criar habilidade de classe: não exige poder e chega ao rank EX, mas com efeitos mais fracos">
                            <label align="client" text="+  HABILIDADE DE CLASSE" fontFamily="Marcellus SC" fontColor="#4E8C74" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[ abrirConstrutorHabilidade("classe"); ]]></event>
                        </rectangle>
                        <layout name="abaHab_wrapRacial" align="left" width="0" margins="{right=8}">
                            <rectangle align="client" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{top=2,bottom=2}" cursor="handPoint" hint="Criar uma habilidade racial. Marque PROGRESSIVA para efeitos que evoluem com o rank.">
                                <label align="client" text="+  HABILIDADE DE RAÇA" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[ abrirConstrutorHabilidade("racial"); ]]></event>
                            </rectangle>
                        </layout>
                        <layout name="abaHab_wrapFeitico" align="left" width="0">
                            <rectangle align="client" color="#12181C" strokeColor="#7FA8B8" strokeSize="1" xradius="3" yradius="3" margins="{top=2,bottom=2}" cursor="handPoint" hint="Criar um feitiço (poder Magia + Coração de Mana). Gasta Mana.">
                                <label align="client" text="+  FEITIÇO" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[ abrirConstrutorHabilidade("feitico"); ]]></event>
                            </rectangle>
                        </layout>
                    </layout>

                    <label name="abaHab_lblAviso" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="12" wordWrap="false" margins="{bottom=4}" hitTest="false"/>

                    <layout name="abaHab_wrapVazio" align="top" height="56">
                        <rectangle align="client" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" hitTest="false">
                            <label align="client" text="Nenhuma habilidade criada. Cada poder ativo que você desbloqueia dá direito a uma habilidade Rank E gratuita." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="13" wordWrap="true" vertTextAlign="center" margins="{left=14,right=14}" hitTest="false"/>
                        </rectangle>
                    </layout>

                    <recordList name="listaHabilidades" align="top" height="4" field="listaHabilidades" templateForm="frmItemHabilidade" itemHeight="64" selectable="false"/>

                </scrollBox>
            </layout>

                        <layout name="pnlAba7" align="client" visible="false" enabled="false">
                <scrollBox align="client" margins="{left=18,right=18,top=12,bottom=14}">

                    <layout align="top" height="32">
                        <label align="left" width="26" text="☀" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                        <label align="client" text="FAVORES DIVINOS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=4}" hitTest="false"/>
                    <label align="top" height="18" text="Favores só vêm de narrativas oficiais, e por isso apenas o mestre os registra. Meio ponto é o padrão; humanos, filhos e legados recebem 1 inteiro." fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>

                    <layout align="top" height="86" margins="{bottom=8}">
                        <rectangle align="left" width="170" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#C9A24B" hitTest="false"/>
                            <label align="top" height="24" text="DIVINDADES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Com quantas divindades você tem favores registrados."/>
                            <label name="abaFav_lblDivindades" align="client" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="26" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" margins="{bottom=6}" hitTest="false"/>
                        </rectangle>
                        <rectangle align="left" width="170" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8A63C9" hitTest="false"/>
                            <label align="top" height="24" text="FAVORES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Soma de todos os favores, de todas as divindades."/>
                            <label name="abaFav_lblTotal" align="client" text="0" fontFamily="Cinzel" fontColor="#8A63C9" fontSize="26" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" margins="{bottom=6}" hitTest="false"/>
                        </rectangle>
                        <!-- Card CLICAVEL (v0.35.4): abre a lista de quem
                             abencoou. O hint e o cursor ficam no retangulo, e
                             os dois rotulos levam hitTest="false" - sem isso o
                             clique morre no rotulo do titulo e o card so abre
                             quando a pessoa acerta a borda. -->
                        <rectangle align="left" width="170" color="#0D1317" strokeColor="#4E8C74" strokeSize="1" xradius="6" yradius="6" margins="{right=10}" cursor="handPoint" hint="Clique para ver QUAIS divindades abençoaram este personagem — e, se você for o mestre, retirar uma bênção por ali.">
                            <rectangle align="top" height="3" color="#4E8C74" hitTest="false"/>
                            <label align="top" height="24" text="BÊNÇÃOS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hitTest="false"/>
                            <label name="abaFav_lblBencaos" align="client" text="0" fontFamily="Cinzel" fontColor="#4E8C74" fontSize="26" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" margins="{bottom=6}" hitTest="false"/>
                            <event name="onClick"><![CDATA[abrirPopupBencaos();]]></event>
                        </rectangle>
                        <rectangle align="left" width="170" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#7FA8B8" hitTest="false"/>
                            <label align="top" height="24" text="ASPECTO DIVINO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Sua divindade de origem — pai, mãe ou legado."/>
                            <label name="abaFav_lblAspecto" align="client" text="0" fontFamily="Cinzel" fontColor="#7FA8B8" fontSize="26" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" margins="{bottom=6}" hitTest="false"/>
                        </rectangle>
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6">
                            <rectangle align="top" height="3" color="#7FA8B8" hitTest="false"/>
                            <label align="top" height="24" text="HIERARQUIA DIVINA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Trocar 3 favores por 1 sobe um degrau: Menor vira Grande, Grande vira Primordial, Primordial vira a Mãe."/>
                            <label align="client" text="Menor › Grande › Primordial › a Mãe" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" vertTextAlign="center" wordWrap="true" margins="{left=8,right=8,bottom=8}" hitTest="false"/>
                        </rectangle>
                    </layout>

                    <!-- PATAMARES: cada um com o bonus passivo e o que da para
                         trocar. Ficava espremido numa coluna lateral com fonte
                         de 10px; em largura cheia cabe em corpo legivel. -->
                    <layout name="abaFav_linhaPatamares" align="top" height="96" margins="{bottom=8}">
                        <rectangle name="abaFav_pat1" align="left" width="300" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}" hitTest="false">
                            <rectangle align="top" height="3" color="#4E8C74" hitTest="false"/>
                            <layout align="client" margins="{left=12,right=12,top=6,bottom=8}">
                                <label align="top" height="20" text="1 FAVOR" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="13" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                                <label align="top" height="16" text="+1 em testes sociais com sacerdotes" fontFamily="EB Garamond" fontColor="#4E8C74" fontSize="11" wordWrap="false" hitTest="false"/>
                                <label align="client" text="Auxílio numa narrativa, objeto útil, encontro com aliado, ou a cura completa de quem está em Coma." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" hitTest="false"/>
                            </layout>
                        </rectangle>
                        <rectangle name="abaFav_pat2" align="left" width="300" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}" hitTest="false">
                            <rectangle align="top" height="3" color="#4E8C74" hitTest="false"/>
                            <layout align="client" margins="{left=12,right=12,top=6,bottom=8}">
                                <label align="top" height="20" text="2 FAVORES" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="13" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                                <label align="top" height="16" text="+3 com sacerdotes e seguidores" fontFamily="EB Garamond" fontColor="#4E8C74" fontSize="11" wordWrap="false" hitTest="false"/>
                                <label align="client" text="Pequeno milagre, conversa com a divindade, 1 ponto de poder, ou ressurreição de quem morreu há até 1 hora." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" hitTest="false"/>
                            </layout>
                        </rectangle>
                        <rectangle align="client" color="#0D1317" strokeColor="#C9A24B" strokeSize="1" xradius="6" yradius="6" hitTest="false">
                            <rectangle align="top" height="3" color="#C9A24B" hitTest="false"/>
                            <layout align="client" margins="{left=12,right=12,top=6,bottom=8}">
                                <label align="top" height="20" text="3 FAVORES" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="13" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                                <label align="top" height="16" text="+5 com sacerdotes, seguidores, filhos e abençoados" fontFamily="EB Garamond" fontColor="#4E8C74" fontSize="11" wordWrap="false" hitTest="false"/>
                                <label align="client" text="Milagre de grande magnitude, ser abençoado ou proclamado, 3 pontos de poder, ou 1 favor um degrau acima." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" hitTest="false"/>
                            </layout>
                        </rectangle>
                    </layout>

                    <!-- SELO DE PROCLAMADO -->
                    <layout name="abaFav_wrapProclamado" align="top" height="0">
                        <rectangle align="client" color="#1A1206" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" margins="{bottom=8}">
                            <!-- O botão de revogar fica DENTRO do selo dourado,
                                 à direita de tudo: é destrutivo e raro, e não
                                 pode competir com nada de uso frequente. -->
                            <layout name="abaFav_wrapRevProc" align="right" width="0">
                                <rectangle align="client" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=12,right=8,top=8,bottom=8}" cursor="handPoint" hint="MESTRE: a divindade retira publicamente a proclamação. Os favores com ela são zerados.">
                                    <label align="client" text="REVOGAR" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    <event name="onClick"><![CDATA[revogarProclamacao();]]></event>
                                </rectangle>
                            </layout>
                            <layout align="client" margins="{left=16,right=16,top=4,bottom=4}">
                                <label name="abaFav_lblProclamado" align="top" height="24" text="" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                                <label name="abaFav_lblProclamadoSub" align="client" text="" fontFamily="EB Garamond" fontColor="#B79A5E" fontSize="11" wordWrap="false" hitTest="false"/>
                            </layout>
                        </rectangle>
                    </layout>

                    <layout align="top" height="34" margins="{bottom=6}">
                        <layout name="abaFav_wrapRegistrar" align="left" width="0">
                            <rectangle align="client" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{right=10,top=2,bottom=2}" cursor="handPoint" hint="MESTRE: registrar um favor concedido por uma divindade">
                                <label align="client" text="+  REGISTRAR FAVOR" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[abrirPopupFavores(false);]]></event>
                            </rectangle>
                        </layout>
                        <layout name="abaFav_wrapMacula" align="left" width="0">
                            <rectangle align="client" color="#12181C" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{top=2,bottom=2}" cursor="handPoint" hint="MESTRE: definir a divindade que nunca concederá favores a este personagem">
                                <label align="client" text="DEFINIR MÁCULA DIVINA" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[definirMaculaDivina();]]></event>
                            </rectangle>
                        </layout>
                    </layout>

                    <label name="abaFav_lblAviso" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" margins="{bottom=4}" hitTest="false"/>

                    <layout name="abaFav_wrapVazio" align="top" height="60">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{bottom=8}" hitTest="false">
                            <label align="client" text="Nenhum favor registrado ainda. Favores nascem de missões cumpridas, feitos grandiosos e itens recuperados para uma divindade — sempre em narrativa oficial." fontFamily="EB Garamond" fontColor="#54636B" fontSize="12" wordWrap="true" vertTextAlign="center" margins="{left=16,right=16}" hitTest="false"/>
                        </rectangle>
                    </layout>

                    <!-- Histórico das revogações. Nasce com altura 0 e só
                         aparece quando existe alguma: numa ficha em que nunca
                         se retirou nada, um painel vazio só ocupa espaço. -->
                    <layout name="abaFav_wrapHistorico" align="top" height="0">
                        <rectangle align="client" color="#12181C" strokeColor="#8B2332" strokeSize="1" xradius="6" yradius="6" margins="{bottom=10}" hitTest="false">
                            <layout align="client" margins="{left=16,right=16,top=8,bottom=8}">
                                <label align="top" height="18" text="HIST&#211;RICO DIVINO" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <label name="abaFav_lblHistorico" align="client" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" hitTest="false"/>
                            </layout>
                        </rectangle>
                    </layout>

                    <layout name="abaFav_wrap1" align="top" height="0">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{bottom=8}">
                            <rectangle align="left" width="3" color="#C9A24B" hitTest="false"/>
                            <layout align="client" margins="{left=12,right=12,top=6,bottom=6}">

                                <layout align="top" height="28">
                                    <label name="abaFav_lblDeus1" align="left" width="220" text="" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="15" fontStyle="bold" vertTextAlign="center" wordWrap="false" hitTest="false"/>
