                        <scrollBox align="client" margins="{bottom=8}">
                            <rectangle name="popCatalogoQualidades_secDescricao" align="top" height="210" color="#0B1014" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                    <label align="top" height="20" text="DESCRIÇÃO" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="12" margins="{bottom=4}"/>
                                    <label name="popCatalogoQualidades_lblDescricao" align="client" text="" fontFamily="EB Garamond" fontColor="#C9CFCE" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
