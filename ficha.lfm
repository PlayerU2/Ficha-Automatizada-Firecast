                    <!-- Painel direito: o scrollBox envolve TUDO (nome, kit e
                         história), como na aba de Raças. Antes só a história
                         rolava, dentro de uma sobra de espaço que em tela
                         pequena virava três linhas visíveis. O botão de
                         escolher fica fora do scroll, sempre alcançável. -->
                    <layout align="client">
                        <rectangle align="bottom" height="38" color="#16202A" strokeColor="#C9A24B" strokeSize="1" xradius="4" yradius="4" margins="{top=10}" cursor="handPoint" hint="Definir esta divindade como o Aspecto Divino do personagem">
                            <event name="onClick"><![CDATA[escolherDeusEmDetalhe();]]></event>
                            <label name="popDeus_lblBtnEscolher" align="client" text="ESCOLHER COMO ASPECTO DIVINO" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="12" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        </rectangle>

                        <scrollBox align="client">
                        <!-- SELO DA DIVINDADE (v0.44.0), 64px ao lado do nome.
                             So AQUI, e nao na lista da esquerda: a 22px da
                             linha da lista os 18 selos viram o mesmo borrao
                             dourado — foi medido numa folha de contato antes
                             de entrar. Selo que nao identifica e peso morto
                             fingindo de informacao.
                             O src e trocado pelo Lua (ico.src = ...), o mesmo
                             mecanismo dos icones de aba; os caminhos vivem em
                             SELO_DO_DEUS, com literal, para a checagem 33
                             conseguir cobrar que cada arquivo existe. -->
                        <layout align="top" height="64" margins="{bottom=8}">
                            <layout align="left" width="64" margins="{right=12}">
                                <image name="popDeus_imgSelo" align="none" left="0" top="0" width="64" height="64" style="originalSize" src="imagens/selo_aslot.png" hitTest="false"/>
                            </layout>
                            <layout align="client">
                                <label name="popDeus_lblNome" align="top" height="30" text="Escolha uma divindade na lista" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold"/>
                                <label name="popDeus_lblCategoria" align="top" height="18" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11"/>
                            </layout>
                        </layout>

                        <rectangle name="popDeus_secKit" align="top" height="188" color="#0A0C10" strokeColor="#8A63C9" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                            <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                <label align="top" height="16" text="KIT DE PODERES" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{bottom=6}"/>
                                <label name="popDeus_lblKitVazio" align="bottom" height="16" text="Kit não informado no livro da mesa." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11"/>
                                <rectangle name="popDeus_secSlot1" align="top" height="26" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" hitTest="false">
                                    <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                                    <label name="popDeus_lblSlot1" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="12" vertTextAlign="center" margins="{left=10,right=8}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popDeus_secSlot2" align="top" height="26" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" hitTest="false">
                                    <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                                    <label name="popDeus_lblSlot2" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="12" vertTextAlign="center" margins="{left=10,right=8}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popDeus_secSlot3" align="top" height="26" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" hitTest="false">
                                    <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                                    <label name="popDeus_lblSlot3" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="12" vertTextAlign="center" margins="{left=10,right=8}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popDeus_secSlot4" align="top" height="26" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" hitTest="false">
                                    <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                                    <label name="popDeus_lblSlot4" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="12" vertTextAlign="center" margins="{left=10,right=8}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="popDeus_secSlot5" align="top" height="26" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" hitTest="false">
                                    <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                                    <label name="popDeus_lblSlot5" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="12" vertTextAlign="center" margins="{left=10,right=8}" hitTest="false"/>
                                </rectangle>
                            </layout>
                        </rectangle>

                        <label align="top" height="16" text="HISTÓRIA" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11" margins="{bottom=6}"/>
                            <rectangle name="popDeus_secLore" align="top" height="1200" color="#0B1014" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                    <label name="popDeus_lblLore" align="client" text="" fontFamily="EB Garamond" fontColor="#B9C2C6" fontSize="13" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                        </scrollBox>
                    </layout>
                </layout>

                <layout align="bottom" height="32" margins="{top=10}">
                    <rectangle align="left" width="200" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Deixar o Aspecto Divino em branco">
                        <event name="onClick"><![CDATA[limparAspectoDivino();]]></event>
                        <label align="client" text="LIMPAR ASPECTO DIVINO" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                    <rectangle align="right" width="120" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fechar sem alterar">
                        <event name="onClick"><![CDATA[fecharPopupDeuses();]]></event>
                        <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                </layout>
            </layout>
        </rectangle>
    </popup>



    <!-- ESCOLHA DO SELO DO CABECALHO (v0.45.0).
         SLOTS FIXOS, e nao recordList: o LEIA-ME registra que componente
         rico dentro de popup ja derrubou o VTT inteiro, e aqui a lista tem
         teto conhecido (1 padrao + 1 aspecto + as bencaos). Doze cobre com
         folga; o que passar disso simplesmente nao abre slot, e a checagem
         43 continua valendo porque cada wrap nasce com altura 0. -->
    <popup name="popSeloCab" width="460" height="460" backOpacity="0.8" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="24" text="SELO DO CABEÇALHO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>
                <label align="top" height="30" text="Aparece nos dois lados do título, em todas as seções. Sem escolha, ele segue a sua proclamação." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" margins="{bottom=6}" hitTest="false"/>

                <rectangle align="bottom" height="30" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{top=8}" cursor="handPoint" hint="Fechar">
                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[fecharPopupSeloCabecalho();]]></event>
                </rectangle>

                <scrollBox align="client">
                    <label name="popSel_lblVazio" align="top" height="60" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" wordWrap="true" vertTextAlign="leading" hitTest="false"/>
                    <layout name="popSel_wrap1" align="top" height="0" margins="{bottom=6}">
