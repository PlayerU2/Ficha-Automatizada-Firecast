                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_esquiva" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Bônus em Defesa - Esquiva"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="EMPÁTICA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Bônus em Defesa empática"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_empatica" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Bônus em Defesa empática"/>
                                        </rectangle>
