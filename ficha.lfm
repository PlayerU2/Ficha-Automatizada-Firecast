                                <rectangle name="rectLinhaRaca_SereiaseTritoes" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Sereias e Tritões">
