                                        </rectangle>
                                    </layout>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="edIt_grupodano" align="top" height="76">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" margins="{bottom=8}">
                            <layout align="client" margins="{left=14,right=14,top=4,bottom=6}">
                                <label align="top" height="18" text="DANO E ALCANCE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="46">
                                    <layout align="left" width="140" margins="{right=10}">
                                        <label align="top" height="14" text="DADO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Ex: 2d6, 4d6"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_dado" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Ex: 2d6, 4d6"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="DANO EXTRA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Bônus fixo somado ao dado"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_danoExtra" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Bônus fixo somado ao dado"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="ALCANCE (m)" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Distância que a arma alcança"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_alcance" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Distância que a arma alcança"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="MUNIÇÕES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Quantas unidades ou cargas restam"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_municoes" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Quantas unidades ou cargas restam"/>
                                        </rectangle>
                                    </layout>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="edIt_grupodefesas" align="top" height="76">
                        <rectangle align="client" color="#0D1317" strokeColor="#C9A24B" strokeSize="1" xradius="5" yradius="5" margins="{bottom=8}">
                            <layout align="client" margins="{left=14,right=14,top=4,bottom=6}">
                                <label align="top" height="18" text="BÔNUS DE DEFESA — entram ao equipar" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="46">
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="APARAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Escudos e armaduras somam aqui"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_aparar" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Escudos e armaduras somam aqui"/>
                                        </rectangle>
