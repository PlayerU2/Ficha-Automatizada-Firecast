                <!-- DETALHE -->
                <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5">
                    <layout align="client" margins="{left=18,right=18,top=12,bottom=12}">
                        <label name="det_nome" align="top" height="30" text="Escolha um item na lista" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" hitTest="false"/>
                        <rectangle align="top" height="1" color="#22323A" margins="{bottom=10}" hitTest="false"/>

                        <rectangle align="bottom" height="34" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{top=10}" cursor="handPoint" hint="Adicionar este item à mochila">
                            <label name="det_lblAdicionar" align="client" text="+  ADICIONAR À MOCHILA" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[adicionarDetalheItem();]]></event>
                        </rectangle>

                        <scrollBox align="client">
                            <!-- A altura e recalculada a cada item: a soma das
                                 linhas visiveis. Fixar um numero grande faria o
                                 scroll sobrar em item curto e ainda assim cortar
                                 um efeito muito longo. -->
                            <layout name="det_conteudo" align="top" height="420">
                                    <layout name="det_wrappreco" align="top" height="26">
                                        <label align="left" width="180" text="PREÇO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_preco" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapcategoria" align="top" height="26">
                                        <label align="left" width="180" text="CATEGORIA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_categoria" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapqualidade" align="top" height="26">
                                        <label align="left" width="180" text="QUALIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_qualidade" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapmaterial" align="top" height="26">
                                        <label align="left" width="180" text="MATERIAL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_material" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapdurabilidade" align="top" height="26">
                                        <label align="left" width="180" text="DURABILIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_durabilidade" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapdano" align="top" height="26">
                                        <label align="left" width="180" text="DANO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_dano" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapalcance" align="top" height="26">
                                        <label align="left" width="180" text="ALCANCE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_alcance" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wraprequisito" align="top" height="26">
                                        <label align="left" width="180" text="REQUISITO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
