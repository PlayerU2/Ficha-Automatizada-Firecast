                            <rectangle name="rectEnc_Dominiodaleitura" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Domínio da leitura");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Dominiodaleitura" align="top" height="16" text="Domínio da leitura" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="acessórios com este encantamento dão ao portador capacidade de ler e escrever sem a necessidade da perícia &quot;Acadêmicos&quot;, desde que seja um idioma que " fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Figadodemendigo" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Fígado de mendigo");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Figadodemendigo" align="top" height="16" text="Fígado de mendigo" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="o portador do objeto com este encantamento se torna imune a efeitos de [Embriagado], [Ébrio] e [Dopado]." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Golpearcano" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Golpe arcano");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Golpearcano" align="top" height="16" text="Golpe arcano" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="aumenta o passo de dano da arma em 1. Em canalizadores energéticos, apenas funciona com habilidades ou feitiços de" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Heroiarcano" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Herói arcano");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Heroiarcano" align="top" height="16" text="Herói arcano" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="escolha um poder ativo, e toda vez que o portador usar uma habilidade de tal poder receberá +3 de acerto ou" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_IncorporacaoTotal" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Incorporação Total");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_IncorporacaoTotal" align="top" height="16" text="Incorporação Total" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="acrescenta +15% de Absorção de Danos ao portador, respeitando os limites de Absorção de Dano." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Nemesis" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Nemesis");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Nemesis" align="top" height="16" text="Nemesis" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="durante o encantamento de uma armadura ou escudo, o portador escolhe um tipo de [" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_RemoverEncantamentoIII" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Remover Encantamento III");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_RemoverEncantamentoIII" align="top" height="16" text="Remover Encantamento III" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="o artíficie remove um encantamento de Classe III de um objeto, desde que seja um encantamento presente nesta loja." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Tenacidademultipla" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Tenacidade múltipla");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Tenacidademultipla" align="top" height="16" text="Tenacidade múltipla" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="escolha dois elementos não-neutros para ganhar resistência aos mesmos." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                            <rectangle name="rectEnc_Tesourodoaventureiro" align="top" height="40" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=4}" cursor="handPoint" hint="Aplicar ou remover este encantamento">
                                <event name="onClick"><![CDATA[alternarEncantamento("Tesouro do aventureiro");]]></event>
                                <layout align="client" margins="{left=10,right=10,top=3,bottom=3}">
                                    <label name="lblEnc_Tesourodoaventureiro" align="top" height="16" text="Tesouro do aventureiro" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" fontStyle="bold" wordWrap="false" hitTest="false"/>
                                    <label align="client" text="permite ao portador do objeto com este encantamento rolar todos os seus testes de" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="false" hitTest="false"/>
                                </layout>
                            </rectangle>
                    </scrollBox>
                </rectangle>
            </layout>
        </rectangle>
    </popup>

    <popup name="popSlotItem" width="620" height="380" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label name="popSlot_lblTitulo" align="top" height="26" text="EQUIPAR" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>
                <label name="popSlot_lblAjuda" align="top" height="30" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{bottom=6}" hitTest="false"/>

                <rectangle align="bottom" height="28" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{top=8}" cursor="handPoint" hint="Fechar">
                    <label align="client" text="CANCELAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[fecharPopupSlot();]]></event>
                </rectangle>

                <scrollBox align="client">
                    <rectangle name="popSlot_btnarmadura" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblarmadura" align="client" text="ARMADURA" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        <event name="onClick"><![CDATA[confirmarSlot("armadura");]]></event>
                    </rectangle>
                    <rectangle name="popSlot_btnacessorio1" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblacessorio1" align="client" text="ACESSÓRIO 1" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
