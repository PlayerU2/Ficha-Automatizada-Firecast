                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Medroso" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Medroso' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Medroso");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
