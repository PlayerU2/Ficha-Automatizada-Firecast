                                    <edit name="cmb_edAtualPrana" align="client" field="pranaAtual" type="number" text="0" transparent="true" fontFamily="Cinzel" fontColor="#8A63C9" fontSize="22" fontStyle="bold" horzTextAlign="center" hint="Quanto o personagem tem AGORA. Campo de jogo: continua livre com a ficha finalizada. Pode ficar negativo (decisão da mesa) e nunca passa do máximo.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                                <label name="cmb_lblPrana" align="client" text="/ 0" fontFamily="Cinzel" fontColor="#8A63C9" fontSize="22" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            </layout>
                            <label name="cmb_contaPrana" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
