                                    <label align="client" field="carismaTotalRolagem" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold" horzTextAlign="center" vertTextAlign="center"/>
                                </layout>
                            </layout>

                            <layout align="top" height="30" margins="{bottom=6}">
                                <rectangle align="left" width="150" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Abrir o catálogo de perícias deste atributo">
                                    <event name="onClick"><![CDATA[abrirPopupAjustado(self.popPericiaCarisma, 760, 560);]]></event>
                                    <label align="client" text="+ Adicionar Perícia" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <label name="lblContadorCarisma" align="left" width="90" text="0 / 0" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{left=8}"/>
                                <rectangle align="right" width="76" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{left=6}" cursor="handPoint" hint="Remover TODAS as perícias deste atributo">
                                    <event name="onClick"><![CDATA[limparListaPericias("listaPericiasCarisma");]]></event>
                                    <label align="client" text="Limpar" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                
                            </layout>

                                                        <label name="abaAtr_vazioCarisma" align="top" height="0" text="Nenhuma perícia neste atributo ainda — use  + Adicionar Perícia.  Só o número que couber nas vagas conta." fontFamily="EB Garamond" fontColor="#54636B" fontSize="12" vertTextAlign="center" hitTest="false"/>
<recordList name="listaPericiasCarisma" align="client" field="listaPericiasCarisma" templateForm="frmItemPericia" itemHeight="76" selectable="true"/>
                        </layout>
                    </rectangle>

                    <rectangle align="top" height="60" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="6" yradius="6" margins="{bottom=10}">
                        <layout align="client" margins="{left=10,right=10,top=8,bottom=8}">
                            <label align="left" width="190" text="CONSTITUIÇÃO" fontFamily="Cinzel Decorative" fontColor="#E6E9E4" fontSize="15" fontStyle="bold" vertTextAlign="center"/>
