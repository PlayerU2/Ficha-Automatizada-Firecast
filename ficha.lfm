                            </layout>
                            <label align="client" text="Aumente em 20% o tempo necessário para fazer qualquer viagem, você irá receber um bônus de +2 em todos os embates sociais enquanto estiver perfeitamente descansado e -2 caso não esteja." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Diligente" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Diligente' para o personagem">
                        <event name="onClick"><![CDATA[selecionarTraco("Diligente");]]></event>
                        <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
