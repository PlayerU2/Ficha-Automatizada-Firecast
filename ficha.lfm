                            <rectangle name="rectFav_Din" align="top" height="26" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Clique para meio favor; use o botão + 1 INTEIRO para um favor cheio">
