                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>

                    <!-- FERIDO (v0.48.0). Mora na linha das DEFESAS, e nao na
                         de recursos, porque e ali que a penalidade aterrissa:
                         a conta de cada defesa ganha "− Ferido II 4", e o
                         jogador ve o numero descer ao lado do motivo.

                         O NIVEL nao e <edit field=>: e escrito pelas setas,
                         via mudarNivelFerido(). Marcar Ferido e JOGO, entao a
                         trava de finalizar nao pode ter o que desabilitar -
                         e nao tem, porque nao ha widget ligado ao NDB aqui.
                         O AJUSTE, esse sim, e campo do NDB, e por isso esta
                         declarado em CAMPOS_LIVRES_EM_JOGO. -->
                    <layout name="cmb_wrapFerido" align="left" width="196">
                        <rectangle name="cmb_secFerido" align="client" color="#0D1317" strokeColor="#8B2332" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8B2332" hitTest="false"/>
                            <label align="top" height="24" text="FERIDO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="[2.3] Ferimentos: um GOLPE ÚNICO que aplique 30%, 60% ou 90% da vida máxima. Substitui, não acumula. A recuperação diária própria (30/20/10%) fica nos botões de descanso."/>
                            <label name="cmb_lblFerido" align="top" height="30" text="—" fontFamily="Cinzel" fontColor="#8B2332" fontSize="24" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaFerido" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <label name="cmb_limiaresFerido" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=2,left=10,right=10,bottom=6}">
                                <rectangle name="cmb_btnFeridoMenos" align="left" width="28" color="#080B0E" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Baixar um nível de Ferido">
                                    <label align="client" text="&#9664;" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[mudarNivelFerido(-1);]]></event>
                                </rectangle>
                                <rectangle name="cmb_btnFeridoMais" align="right" width="28" color="#080B0E" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Subir um nível de Ferido">
                                    <label align="client" text="&#9654;" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[mudarNivelFerido(1);]]></event>
                                </rectangle>
                                <rectangle align="client" color="#080B0E" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=4,right=4}">
                                    <edit name="cmb_edAjusteFerido" align="client" field="ajusteFerido" type="number" text="0" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="12" horzTextAlign="center" transparent="true" hint="AJUSTE DO MESTRE: soma na penalidade de todos os testes. Vale mesmo sem nível de Ferido, e aparece separado na linha do card.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    </layout>
                    <label name="cmb_lblNotaDefesas" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#4E8C74" fontSize="11" wordWrap="false" margins="{top=2}" hitTest="false"/>

                    <layout name="cmb_secEscudo" align="top" height="0">
                        <rectangle align="client" color="#0D1317" strokeColor="#8A63C9" strokeSize="1" xradius="6" yradius="6" margins="{top=6}">
                            <layout align="client" margins="{left=14,right=14,top=8,bottom=8}">
                                <label name="cmb_lblEscudoTit" align="top" height="16" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" hitTest="false"/>
                                <layout name="cmb_linhaEscudo" align="top" height="28" margins="{top=4}">
                                    <rectangle name="cmb_btnEscAparar" align="left" width="150" color="#12181C" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{right=8}" cursor="handPoint" hint="O bônus do Escudo psíquico recai em Aparar">
                                        <label name="cmb_lblEscAparar" align="client" text="APARAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[escolherDefesaEscudo("aparar");]]></event>
                                    </rectangle>
                                    <rectangle name="cmb_btnEscEsquiva" align="left" width="150" color="#12181C" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{right=8}" cursor="handPoint" hint="O bônus do Escudo psíquico recai em Esquiva">
                                        <label name="cmb_lblEscEsquiva" align="client" text="ESQUIVA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[escolherDefesaEscudo("esquiva");]]></event>
                                    </rectangle>
                                    <rectangle name="cmb_btnEscEmpatica" align="left" width="150" color="#12181C" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{right=8}" cursor="handPoint" hint="O bônus do Escudo psíquico recai em Empática">
                                        <label name="cmb_lblEscEmpatica" align="client" text="EMPÁTICA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[escolherDefesaEscudo("empatica");]]></event>
                                    </rectangle>
                                    <rectangle name="cmb_btnEscTelepatica" align="left" width="150" color="#12181C" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{right=8}" cursor="handPoint" hint="O bônus do Escudo psíquico recai em Telepática">
                                        <label name="cmb_lblEscTelepatica" align="client" text="TELEPÁTICA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[escolherDefesaEscudo("telepatica");]]></event>
                                    </rectangle>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>

                <layout align="top" height="28" margins="{top=10,bottom=4}">
                    <label align="left" width="22" text="◆" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="14" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                    <label align="left" width="300" text="MOVIMENTO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                    <rectangle align="client" height="1" color="#1E2A31" margins="{left=4,right=4,top=13,bottom=13}" hitTest="false"/>
                </layout>
                    <layout name="cmb_linhaMovimento" align="top" height="126">
                    <layout name="cmb_wrapDeslocamento" align="left" width="196">
                        <rectangle name="cmb_secDeslocamento" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#E6E9E4" hitTest="false"/>
                            <label align="top" height="26" text="DESLOCAMENTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Base da raça + Destreza + Rank. É o quanto você anda por ação."/>
                            <label name="cmb_lblDeslocamento" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaDeslocamento" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteDeslocamento" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapCorrida" align="left" width="196">
                        <rectangle name="cmb_secCorrida" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#E6E9E4" hitTest="false"/>
                            <label align="top" height="26" text="CORRIDA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="O dobro do deslocamento — o triplo para Sátiros."/>
                            <label name="cmb_lblCorrida" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaCorrida" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <rectangle align="bottom" height="26" color="#0D1317" strokeSize="0" margins="{top=4,left=10,right=10,bottom=6}" hitTest="false"/>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapVoo" align="left" width="196">
                        <rectangle name="cmb_secVoo" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#7FA8B8" hitTest="false"/>
                            <label align="top" height="26" text="VOO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Deslocamento aéreo da raça + Destreza + Rank. Só aparece para raças que voam."/>
                            <label name="cmb_lblVoo" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaVoo" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteDeslocamentoVoo" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapNado" align="left" width="196">
                        <rectangle name="cmb_secNado" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#7FA8B8" hitTest="false"/>
                            <label align="top" height="26" text="NADO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Deslocamento aquático da raça + Destreza + Rank. Só aparece para raças que nadam."/>
                            <label name="cmb_lblNado" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaNado" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteDeslocamentoNado" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>

                    <!-- ESCALADA (v0.37.0). Card fixo, como Voo e Nado.
                         Nenhuma raça do livro declara base de escalada hoje,
                         entao ele sempre cai no padrao da mesa (metade do
                         deslocamento). O campo deslocamentoBaseEscalada ja
                         existe no calculo: no dia em que uma raça declarar,
                         a base substitui o padrao sem mexer em codigo. -->
                    <layout name="cmb_wrapEscalada" align="left" width="196">
                        <rectangle name="cmb_secEscalada" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#7FA8B8" hitTest="false"/>
                            <label align="top" height="26" text="ESCALADA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Metade do deslocamento, por padrão da mesa. Se a raça declarar uma base de escalada, ela substitui o padrão."/>
                            <label name="cmb_lblEscalada" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaEscalada" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteDeslocamentoEscalada" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <!-- TAMANHO: card sem "AJUSTE" e sem conta. Toda ficha
                         nasce Médio; as setas andam uma categoria por clique.
                         Não circula de propósito — ver mudarTamanho. -->
                                                                                <!-- MONTADO: só existe enquanto há uma montaria montada
                         na aba Criaturas. Nasce com largura 0; a pé continua
                         visível ao lado, porque o número de que você precisa
                         no instante em que desmonta é aquele. -->
                    <layout name="cmb_wrapMontado" align="left" width="0">
                        <rectangle name="cmb_secMontado" align="client" color="#0D1317" strokeColor="#8A63C9" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8A63C9" hitTest="false"/>
                            <!-- O titulo e escrito por script (porTituloMontado):
                                 vira "MONTADO · VOO" quando o numero grande nao
                                 e o deslocamento de chao. Sem isso, 116 de voo e
                                 116 de chao ficam identicos na tela. -->
                            <label name="cmb_tituloMontado" align="top" height="26" text="MONTADO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" margins="{top=4}" hint="Deslocamento enquanto montado. O número grande é o MAIOR modo da montaria; os outros modos aparecem na linha de baixo. Modo com 0 na ficha da criatura não aparece."/>
                            <label name="cmb_lblMontado" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaMontado" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <!-- Segunda linha de conta, no espaco que nos outros
                                 cards e ocupado pela caixa de AJUSTE. O MONTADO
                                 nao tem ajuste proprio (o ajuste mora na ficha
                                 da criatura), entao o espaco estava sobrando. -->
                            <label name="cmb_modosMontado" align="bottom" height="26" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="true" margins="{top=2,left=6,right=6,bottom=6}" hitTest="false"/>
                        </rectangle>
                    </layout>
                    </layout>

                <!-- Interruptor de FORMA ALTERNATIVA. Nasce com altura 0 e só
                     ganha altura quando a raça tem forma (Lobisomens, Ursaris).
                     Altura, e não visibilidade: align="top" escondido e
                     mostrado de novo pula para o topo da pilha. -->
                <layout name="cmb_wrapForma" align="top" height="0">
                    <rectangle name="cmb_secForma" align="client" color="#12181C" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{top=2,bottom=6,right=10}" cursor="handPoint" hint="Alterna entre as duas formas da sua raça. Muda só o deslocamento terrestre — as duas nunca valem ao mesmo tempo.">
                        <event name="onClick"><![CDATA[alternarFormaAlternativa();]]></event>
                        <label name="cmb_lblForma" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                </layout>

                <layout align="top" height="28" margins="{top=10,bottom=4}">
                    <label align="left" width="22" text="◆" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="14" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                    <label align="left" width="380" text="TAMANHO, INICIATIVA &amp; PROFICI&#202;NCIA" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                    <rectangle align="client" height="1" color="#1E2A31" margins="{left=4,right=4,top=13,bottom=13}" hitTest="false"/>
                </layout>
                    <layout name="cmb_linhaPerfil" align="top" height="126">
<layout name="cmb_wrapTamanho" align="left" width="196">
                        <rectangle name="cmb_secTamanho" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8A63C9" hitTest="false"/>
                            <label align="top" height="26" text="TAMANHO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Categoria de tamanho do personagem. Livre durante a criação; depois de finalizada a ficha, só o mestre muda."/>
                            <label name="cmb_lblTamanho" align="top" height="34" text="Médio" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaTamanho" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <rectangle name="cmb_btnTamMenor" align="left" width="30" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Uma categoria menor">
                                    <label align="client" text="&#9664;" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[mudarTamanho(-1);]]></event>
                                </rectangle>
                                <rectangle name="cmb_btnTamMaior" align="right" width="30" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Uma categoria maior">
                                    <label align="client" text="&#9654;" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[mudarTamanho(1);]]></event>
                                </rectangle>
                                <label name="cmb_lblTamEscala" align="client" text="" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            </layout>
                        </rectangle>
                    </layout>
<layout name="cmb_wrapIniciativa" align="left" width="196">
                        <rectangle name="cmb_secIniciativa" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#E6E9E4" hitTest="false"/>
                            <label align="top" height="26" text="INICIATIVA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Destreza + Rank, somado ao dado no início do combate."/>
                            <label name="cmb_lblIniciativa" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaIniciativa" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteIniciativa" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
<layout name="cmb_wrapProf" align="left" width="196">
                        <rectangle name="cmb_secProf" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#C9A24B" hitTest="false"/>
                            <label align="top" height="26" text="PROFICIÊNCIA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Bônus do nível atual, somado nos testes das perícias que você tem."/>
                            <label name="cmb_lblProf" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaProf" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <rectangle align="bottom" height="26" color="#0D1317" strokeSize="0" margins="{top=4,left=10,right=10,bottom=6}" hitTest="false"/>
                        </rectangle>
                    </layout>
                    </layout>

                <layout align="top" height="28" margins="{top=10,bottom=4}">
                    <label align="left" width="22" text="◆" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="14" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                    <label align="left" width="300" text="AÇÕES, INSPIRAÇÃO &amp; CARGA" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                    <rectangle align="client" height="1" color="#1E2A31" margins="{left=4,right=4,top=13,bottom=13}" hitTest="false"/>
                </layout>
                    <layout name="cmb_linhaAcoes" align="top" height="126">
                    <layout name="cmb_wrapAcoesPadrao" align="left" width="196">
                        <rectangle name="cmb_secAcoesPadrao" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#C9A24B" hitTest="false"/>
                            <label align="top" height="26" text="AÇÕES PADRÃO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Atacar, defender, usar poderes e feitiços complexos. +1 no nível 19."/>
                            <label name="cmb_lblAcoesPadrao" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaAcoesPadrao" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteAcoesPadrao" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapAcoesBonus" align="left" width="196">
                        <rectangle name="cmb_secAcoesBonus" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#C9A24B" hitTest="false"/>
                            <label align="top" height="26" text="AÇÕES BÔNUS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Abrir portas, sacar objetos, habilidades simples. +1 no nível 10."/>
                            <label name="cmb_lblAcoesBonus" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaAcoesBonus" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteAcoesBonus" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapAcoesReacao" align="left" width="196">
                        <rectangle name="cmb_secAcoesReacao" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#C9A24B" hitTest="false"/>
                            <label align="top" height="26" text="REAÇÕES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Respostas no turno alheio, como ataque de oportunidade. +1 no nível 15."/>
                            <label name="cmb_lblAcoesReacao" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaAcoesReacao" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="ajusteAcoesReacao" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Correção manual — some ou subtraia o que o sistema não cobre.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapInspiracao" align="left" width="196">
                        <rectangle name="cmb_secInspiracao" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8A63C9" hitTest="false"/>
                            <label align="top" height="26" text="INSPIRAÇÃO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="Gaste para refazer um teste de qualquer natureza. Começa em 3 e o máximo é 3."/>
                            <label name="cmb_lblInspiracao" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#8A63C9" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaInspiracao" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="ATUAL" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false" hint="Este campo É o seu saldo de inspiração — não é um ajuste. Gaste aqui, recupere aqui."/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit align="client" field="pontosInspiracao" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Seus pontos de inspiração AGORA (0 a 3). Este é o valor, não um ajuste: 2 aqui significa que você tem 2.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="cmb_wrapMochila" align="left" width="196">
                        <rectangle name="cmb_secMochila" align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="6" yradius="6" margins="{right=10}">
                            <rectangle align="top" height="3" color="#8C9AA0" hitTest="false"/>
                            <label align="top" height="26" text="CARGA DA MOCHILA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" margins="{top=4}" hint="2 + Força + Rank. Quantos espaços a mochila comporta."/>
                            <label name="cmb_lblMochila" align="top" height="34" text="0" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="26" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            <label name="cmb_contaMochila" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" horzTextAlign="center" wordWrap="false" hitTest="false"/>
                            <layout align="bottom" height="26" margins="{top=4,left=10,right=10,bottom=6}">
                                <label align="left" width="40" text="AJUSTE" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="client" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                    <edit name="cmb_edMochilaBonus" align="client" field="mochilaBonus" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" transparent="true" hint="Espaços extras de mochila que a conta não cobre: bolsa de contenção, montaria de carga, concessão do mestre. Use negativo para retirar.">
                                        <event name="onChange"><![CDATA[recalcularTudo();]]></event>
                                    </edit>
                                </rectangle>
                            </layout>
                        </rectangle>
                    </layout>
                    </layout>
                    <label name="cmb_lblNotaAcoes" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{top=2,bottom=6}" hitTest="false"/>

                </scrollBox>
            </layout>

            <layout name="pnlAba4" align="client" visible="false" enabled="false">
                <layout align="client" margins="{left=16,right=16,top=14,bottom=14}">
                    <layout align="top" height="34" margins="{bottom=2}">
                        <label align="left" width="26" text="⚖" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center"/>
                        <label align="client" text="QUALIDADES &amp; DEFEITOS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=12}" hitTest="false"/>

                    <!-- PAINEL DE ECONOMIA DE PONTOS -->
                    <rectangle align="top" height="74" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" margins="{bottom=12}" hitTest="false">
                        <rectangle align="left" width="3" color="#C9A24B" hitTest="false"/>
                        <layout align="client" margins="{left=14,right=14,top=8,bottom=8}">
                            <layout align="left" width="150" margins="{right=10}">
                                <label align="top" height="16" text="PQ BASE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label align="client" text="3" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                            <layout align="left" width="180" margins="{right=10}">
                                <label align="top" height="16" text="PD GANHOS (DEFEITOS)" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblPontosDefeitos" align="client" text="0" fontFamily="Cinzel" fontColor="#D4838F" fontSize="20" fontStyle="bold" horzTextAlign="center"/>
                                <label name="lblPontosDefeitosAviso" align="bottom" height="14" text="" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" horzTextAlign="center"/>
                            </layout>
                            <layout align="left" width="170" margins="{right=10}">
                                <label align="top" height="16" text="PQ DISPONÍVEL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblPontosDisponiveis" align="client" text="3" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                            <layout align="left" width="170" margins="{right=10}">
                                <label align="top" height="16" text="PQ GASTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblPontosGastos" align="client" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                            <layout align="client">
                                <label align="top" height="16" text="SALDO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center"/>
                                <label name="lblPontosSaldo" align="client" text="3" fontFamily="Cinzel" fontColor="#4E8C74" fontSize="20" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                        </layout>
                    </rectangle>

                    <!-- DUAS COLUNAS. O Grid System (g="row"/g="col") nao deve ser
                         misturado com atributo align= no mesmo elemento - quando fiz
                         isso aqui o layout quebrou (coluna sumiu, cliques pararam de
                         funcionar). Voltando ao padrao align="left" width=X / "client",
                         que e o testado e confiavel neste container sem scrollBox. -->
                    <layout name="pnlColunasQD" align="client">
                        <event name="onResize"><![CDATA[ajustarColunasQD();]]></event>
                        <layout name="colQualidades" align="left" width="895" margins="{right=6}">
                            <rectangle align="client" color="#0D1317" strokeColor="#8A63C9" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                                <layout align="client" margins="{left=10,right=10,top=8,bottom=8}">
                                    <label align="top" height="24" text="QUALIDADES" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold"/>
                                    <label align="top" height="16" text="Vantagens compradas com pontos." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" margins="{bottom=4}"/>
                                    <rectangle align="top" height="30" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{bottom=6}" cursor="handPoint" hint="Abrir o catálogo de Qualidades">
                                        <event name="onClick"><![CDATA[abrirCatalogoQualidades();]]></event>
                                        <label align="client" text="+ ABRIR CATÁLOGO" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    </rectangle>
                                    <recordList name="listaQualidades" align="client" field="listaQualidades" templateForm="frmItemQualidadeDefeito" itemHeight="58" selectable="true"/>
                                </layout>
                            </rectangle>
                        </layout>
                        <layout align="client" margins="{left=6}">
                            <rectangle align="client" color="#0D1317" strokeColor="#8B2332" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                                <layout align="client" margins="{left=10,right=10,top=8,bottom=8}">
                                    <label align="top" height="24" text="DEFEITOS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold"/>
                                    <label align="top" height="16" text="Limitações que devolvem pontos (máx. 7)." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" margins="{bottom=4}"/>
                                    <rectangle align="top" height="30" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{bottom=6}" cursor="handPoint" hint="Abrir o catálogo de Defeitos">
                                        <event name="onClick"><![CDATA[abrirCatalogoDefeitos();]]></event>
                                        <label align="client" text="+ ABRIR CATÁLOGO" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    </rectangle>
                                    <recordList name="listaDefeitos" align="client" field="listaDefeitos" templateForm="frmItemQualidadeDefeito" itemHeight="58" selectable="true"/>
                                </layout>
                            </rectangle>
                        </layout>
                    </layout>
                </layout>
            </layout>

            <layout name="pnlAba5" align="client" visible="false" enabled="false">
                <!-- A aba tem conteudo demais para caber numa altura fixa, entao
                     ela ROLA, como as abas de Atributos e Combate ja fazem.
                     Todo o conteudo e align="top" com altura natural: dentro de
                     um scrollBox nao existe align="client" (nao ha altura de
                     referencia), entao a recordList de caracteristicas leva
                     height explicito, calculado em ajustarAlturaListaCaracs().
                     Isso elimina de vez a acrobacia de align="bottom" e o
                     sistema de compactacao que espremia a aba. -->
                <scrollBox align="client" margins="{left=16,right=16,top=14,bottom=14}">
                    <layout name="abaRaca_secTitulo" align="top" height="34" margins="{bottom=2}">
                        <label align="left" width="26" text="⚜" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center"/>
                        <label align="client" text="RAÇAS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=12}" hitTest="false"/>

                    <!-- ===== SELETOR DE RACA ===== -->
                    <layout name="abaRaca_secSeletor" align="top" height="52" margins="{bottom=10}">
                        <rectangle align="right" width="150" color="#0A0C10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=8,top=17}" cursor="handPoint" hint="Somente o MESTRE: libera raças não-jogáveis e primordiais">
                            <layout align="client" margins="{left=8,right=6}">
                                <checkBox name="chkAutorizacaoMestre" align="left" width="24" field="autorizacaoMestreRaca" cursor="handPoint" hint="Somente o MESTRE da mesa pode marcar">
                                    <event name="onChange"><![CDATA[aoMudarAutorizacaoMestre();]]></event>
                                </checkBox>
                                <label align="client" text="Autoriz. do mestre" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="11" vertTextAlign="center" margins="{left=2}"/>
                            </layout>
                        </rectangle>
                        <rectangle align="right" width="110" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=8,top=17}" cursor="handPoint" hint="Apaga a raça, a herança mestiça e os valores preenchidos (Deslocamento/Dado de Vida)">
                            <event name="onClick"><![CDATA[resetarRacaCompleta();]]></event>
                            <label align="client" text="LIMPAR" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        </rectangle>
                        <layout align="client">
                            <label align="top" height="16" text="RAÇA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11"/>
                            <rectangle align="client" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Abrir o catálogo de raças">
                                <event name="onClick"><![CDATA[abrirPopupAjustado(self.popCatalogoRacas, 980, 660);]]></event>
                                <layout align="client" margins="{left=12,right=10}">
                                    <label name="lblRacaAtual" align="client" text="Clique para escolher uma raça" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="14" vertTextAlign="center" hitTest="false"/>
                                    <label align="right" width="18" text="&#9656;" fontFamily="Petrichor Simbolos" fontColor="#8A63C9" fontSize="13" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </layout>
                            </rectangle>
                        </layout>
                    </layout>

                    <!-- ===== FICHA RESUMIDA DA RACA (sempre visivel: nunca
                         alternamos visible= em align="top", porque isso
                         reordena o layout) ===== -->
                    <!-- O BRASAO DA RACA fica A ESQUERDA dos dois cards, como
                         um escudo ao lado da ficha. Largura 0 quando a raca
                         nao tem brasao (as nao-jogaveis): o card so encosta na
                         esquerda, e nao sobra buraco. Nao e "visible", que em
                         align="top" reordena o layout — aqui e align="left",
                         mas a regra da casa e mexer em tamanho, nao em
                         visibilidade. -->
                    <layout align="top" height="112" margins="{bottom=8}">
                        <layout name="abaRaca_wrapBrasao" align="left" width="0" margins="{right=12}">
                            <image name="abaRaca_imgBrasao" align="none" left="0" top="8" width="96" height="96" style="originalSize" src="imagens/brasao_raca_humanos.png" hitTest="false"/>
                        </layout>
                        <!-- SEGUNDO escudo, na ponta DIREITA: a outra metade da
                             heranca de um mestico. Declarado ANTES do
                             align="client" de proposito - neste SDK os irmaos
                             sao posicionados na ordem em que aparecem, entao um
                             client declarado primeiro come a linha inteira e o
                             pod da direita nasce com zero de largura para
                             sempre. Largura 0 quando nao ha mestico: o texto
                             reocupa o espaco sozinho, sem mexer em visible= (que
                             REORDENA layout align, o bug que bagunçou esta aba
                             na v0.30). Quem escreve a largura dos dois pods e
                             SO atualizarBrasaoRaca. -->
                        <layout name="abaRaca_wrapBrasao2" align="right" width="0" margins="{left=12}">
                            <image name="abaRaca_imgBrasao2" align="none" left="0" top="8" width="96" height="96" style="originalSize" src="imagens/brasao_raca_humanos.png" hitTest="false"/>
                        </layout>
                        <layout align="client">
                            <rectangle name="abaRaca_secSituacao" align="top" height="54" color="#0B1014" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=5,bottom=5}">
                                    <label align="top" height="15" text="SITUAÇÃO" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11"/>
                                    <label name="abaRaca_lblStatus" align="client" text="Nenhuma raça selecionada ainda." fontFamily="EB Garamond" fontColor="#B9D3DD" fontSize="12" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>

                            <rectangle name="abaRaca_secBase" align="top" height="50" color="#0B1014" strokeColor="#2A4652" strokeSize="1" xradius="4" yradius="4" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=4,bottom=4}">
                                    <label align="top" height="15" text="ATRIBUTOS BASE (preenchidos automaticamente na aba 06 · COMBATE)" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11"/>
                                    <label name="abaRaca_lblBase" align="client" text="—" fontFamily="EB Garamond" fontColor="#B9D3DD" fontSize="13" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                        </layout>
                    </layout>

                    <!-- O "OU" DO LIVRO (v0.42.1, B-04): raca cujo texto da duas
                         caracteristicas em alternativa ("Magia inata OU Conexao
                         com a Natureza", Elfos). Altura 0 = a raca nao tem "ou". -->
                    <layout name="abaRaca_wrapEscolhaTraco" align="top" height="0">
                        <rectangle align="client" color="#0B1014" strokeColor="#8A63C9" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}">
                            <layout align="client" margins="{left=12,right=12,top=4,bottom=4}">
                                <label name="abaRaca_lblEscolhaTraco" align="top" height="30" text="" fontFamily="EB Garamond" fontColor="#C9A24B" fontSize="12" wordWrap="true" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="28">
                                    <rectangle name="abaRaca_btnTraco1" align="left" width="260" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=8}" cursor="handPoint" hint="Ficar com esta alternativa">
                                        <label name="abaRaca_lblTraco1" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                        <event name="onClick"><![CDATA[escolherTracoRacialPorIndice(1);]]></event>
                                    </rectangle>
                                    <rectangle name="abaRaca_btnTraco2" align="left" width="260" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=8}" cursor="handPoint" hint="Ficar com esta alternativa">
                                        <label name="abaRaca_lblTraco2" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                        <event name="onClick"><![CDATA[escolherTracoRacialPorIndice(2);]]></event>
                                    </rectangle>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>

                    <!-- ===== MESTICAGEM =====
                         O painel inteiro abre a janela de mestiçagem. Os dois
                         botões da linha de título têm onClick próprio e por
                         isso não disparam o clique do painel. -->
                    <rectangle name="abaRaca_secMestico" align="top" height="124" color="#0B1014" strokeColor="#C9A24B" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" cursor="handPoint" hint="Abrir a janela de mestiçagem para definir Humanos + outra raça e as características">
                        <event name="onClick"><![CDATA[abrirPopupMestico();]]></event>
                        <layout align="client" margins="{left=12,right=12,top=6,bottom=6}">
                            <layout align="top" height="18">
                                <label align="left" width="100" text="MESTIÇAGEM" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <label name="abaRaca_lblLacre" align="client" text="" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <rectangle align="right" width="130" color="#0A0C10" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{left=6}" cursor="handPoint" hint="Autorizações do MESTRE: quebrar o lacre do sorteio ou aplicar um novo tier de Mestiço">
                                    <event name="onClick"><![CDATA[abrirPopupMestreMestico();]]></event>
                                    <label align="client" text="LACRE / MESTRE" fontFamily="Marcellus SC" fontColor="#A98BD6" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle align="right" width="140" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Apaga a herança mestiça para refazer do zero. Só funciona ENQUANTO o sorteio não foi feito.">
                                    <event name="onClick"><![CDATA[resetarMesticagem();]]></event>
                                    <label name="abaRaca_lblBtnRefazer" align="client" text="REFAZER HERANÇA" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                            </layout>
                            <label name="abaRaca_lblAvisoMestico" align="bottom" height="26" text="" fontFamily="EB Garamond" fontColor="#8B2332" fontSize="11" wordWrap="true" vertTextAlign="leading" hitTest="false"/>
                            <label name="abaRaca_lblMestico" align="client" text="" fontFamily="EB Garamond" fontColor="#E8DCBE" fontSize="12" wordWrap="true" vertTextAlign="leading" hitTest="false"/>
                        </layout>
                    </rectangle>

                    <!-- ===== CARACTERISTICAS RACIAIS =====
                         height calculado pela quantidade de itens: uma lista com
                         scroll proprio dentro de uma area com scroll e horrivel
                         de usar, entao a lista cresce e quem rola e a aba. -->
                    <label name="abaRaca_lblTituloCaracs" align="top" height="20" text="CARACTERÍSTICAS RACIAIS" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="12" margins="{bottom=4}"/>
                    <recordList name="listaCaracsRaciais" align="top" height="240" field="listaCaracsRaciais" templateForm="frmItemCaracRacial" itemHeight="78" selectable="false"/>

                    <!-- Divisor visual entre a secao de Racas e a de Classe. -->
                    <layout name="abaRaca_secTituloClasse" align="top" height="34" margins="{top=18}">
                        <label align="left" width="26" text="⚜" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                        <label align="client" text="CLASSE &amp; SUBCLASSE" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}" hitTest="false"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=10}" hitTest="false"/>

                    <!-- ===== CLASSE & SUBCLASSE ===== -->
                    <rectangle name="abaRaca_secClasse" align="top" height="186" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5">
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                            <layout align="top" height="24" margins="{bottom=4}">
                                <label align="left" width="132" text="PONTOS DE CLASSE" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <label name="abaRaca_lblPontosClasse" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>

                                <rectangle align="right" width="150" color="#0A0C10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=6}" cursor="handPoint" hint="Somente o MESTRE: ignora os pré-requisitos da segunda subclasse">
                                    <layout align="client" margins="{left=8,right=6}">
                                        <checkBox name="chkAutorizacaoMestreClasse" align="left" width="24" field="autorizacaoMestreClasse" cursor="handPoint" hint="Somente o MESTRE da mesa pode marcar">
                                            <event name="onChange"><![CDATA[aoMudarAutorizacaoMestreClasse();]]></event>
                                        </checkBox>
                                        <label align="client" text="Autoriz. do mestre" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="11" vertTextAlign="center" margins="{left=2}" hitTest="false"/>
                                    </layout>
                                </rectangle>

                                <rectangle align="right" width="88" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{left=6}" hint="Válvula de escape: some (ou subtraia) pontos de classe à mão, para acordos de mesa que a tabela de níveis não cobre">
                                    <layout align="client" margins="{left=4,right=4}">
                                        <label align="left" width="34" text="AJU." fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <edit align="client" transparent="true" field="pontosClasseAjuste" type="number" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="12" horzTextAlign="center" hint="Pontos de classe extras concedidos (ou removidos) pelo narrador">
                                            <event name="onChange"><![CDATA[atualizarBlocoClasse();]]></event>
                                        </edit>
                                    </layout>
                                </rectangle>

                                <rectangle align="right" width="140" color="#16202A" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Abrir o catálogo de Classes e Subclasses">
                                    <event name="onClick"><![CDATA[abrirCatalogoClasses();]]></event>
                                    <label align="client" text="+ ABRIR CATÁLOGO" fontFamily="Marcellus SC" fontColor="#A98BD6" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                            </layout>

                            <label name="abaRaca_lblAvisoClasse" align="bottom" height="16" text="Zerar o nível de uma subclasse a remove da ficha e devolve os pontos ao saldo." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" hitTest="false"/>

                            <rectangle name="abaRaca_secSlot1" align="top" height="58" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Abrir o catálogo já nesta subclasse, com a descrição de todos os níveis">
                                <event name="onClick"><![CDATA[abrirCatalogoClasses(1);]]></event>
                                <rectangle align="left" width="3" color="#8A63C9" hitTest="false"/>
                                <layout align="client" margins="{left=12,right=12,top=3,bottom=3}">
                                    <label align="left" width="30" text="1ª" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                                    <label name="abaRaca_lblNivelSlot1" align="right" width="86" text="" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="13" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <layout name="abaRaca_pips1" align="right" width="156" margins="{right=8}">
                                        <rectangle name="abaRaca_pip1_1" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_2" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_3" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_4" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_5" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_6" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_7" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip1_8" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                    </layout>
                                    <label name="abaRaca_lblClasse1" align="client" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="13" wordWrap="false" vertTextAlign="center" margins="{right=10}" hitTest="false"/>
                                </layout>
                            </rectangle>

                            <rectangle name="abaRaca_secSlot2" align="top" height="58" color="#0B1014" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Abrir o catálogo já nesta subclasse, com a descrição de todos os níveis">
                                <event name="onClick"><![CDATA[abrirCatalogoClasses(2);]]></event>
                                <rectangle align="left" width="3" color="#4E8C74" hitTest="false"/>
                                <layout align="client" margins="{left=12,right=12,top=3,bottom=3}">
                                    <label align="left" width="30" text="2ª" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
                                    <label name="abaRaca_lblNivelSlot2" align="right" width="86" text="" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="13" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <layout name="abaRaca_pips2" align="right" width="156" margins="{right=8}">
                                        <rectangle name="abaRaca_pip2_1" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_2" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_3" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_4" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_5" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_6" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_7" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                        <rectangle name="abaRaca_pip2_8" align="left" width="14" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="7" yradius="7" margins="{right=5,top=19,bottom=19}" hitTest="false"/>
                                    </layout>
                                    <label name="abaRaca_lblClasse2" align="client" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="13" wordWrap="false" vertTextAlign="center" margins="{right=10}" hitTest="false"/>
                                </layout>
                            </rectangle>
                        </layout>
                    </rectangle>
                </scrollBox>
            </layout>

                                                            <layout name="pnlAba6" align="client" visible="false" enabled="false">
                <scrollBox align="client" margins="{left=16,right=16,top=14,bottom=14}">

                    <layout align="top" height="34" margins="{bottom=2}">
                        <label align="left" width="26" text="✦" fontFamily="Petrichor Simbolos" fontColor="#C9A24B" fontSize="18" vertTextAlign="center" horzTextAlign="center" hitTest="false"/>
                        <label align="client" text="PODERES" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold" vertTextAlign="center" margins="{left=4}" hitTest="false"/>
                    </layout>
                    <rectangle align="top" height="1" color="#C9A24B" margins="{bottom=12}" hitTest="false"/>

                    <!-- ===== CARTEIRA DE PONTOS ===== -->
                    <rectangle align="top" height="70" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}">
                        <layout align="top" height="64" margins="{left=10,right=10,top=3}">
                            <layout align="left" width="110">
                                <label align="top" height="16" text="TOTAL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Pontos ganhos pela tabela de evolução, mais os concedidos."/>
                                <label name="abaPod_lblTotal" align="top" height="26" text="0" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="130">
                                <label align="top" height="16" text="GASTOS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Poderes e habilidades saem do mesmo bolso de pontos."/>
                                <label name="abaPod_lblGastos" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="20" horzTextAlign="center" hitTest="false"/>
                                <label name="abaPod_lblGastosDetalhe" align="top" height="14" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="110">
                                <label align="top" height="16" text="SALDO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hitTest="false"/>
                                <label name="abaPod_lblSaldo" align="top" height="26" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <!-- CONCEDIDOS e a unica celula EDITAVEL da linha
                                 (L-02): sem text="0", transparente e com corpo
                                 menor, parecia coluna morta e ninguem clicava.
                                 Agora tem valor inicial, caixa e o mesmo corpo
                                 dos irmaos — e um rodape dizendo que se digita. -->
                            <layout align="left" width="120">
                                <label align="top" height="16" text="CONCEDIDOS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Pontos vindos de Favores (2 favores = 1 ponto, 3 favores = 3 pontos) ou concedidos pelo mestre. Digite aqui."/>
                                <rectangle align="top" height="26" color="#080B0E" strokeColor="#2A3A44" strokeSize="1" xradius="3" yradius="3" margins="{left=14,right=14}">
                                    <edit name="abaPod_edConcedidos" field="poderPontosConcedidos" align="client" type="number" text="0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" horzTextAlign="center" transparent="true" hint="Editável: registre aqui os pontos ganhos por Favores ou por decisão do mestre.">
                                        <event name="onChange"><![CDATA[ atualizarBlocoPoderes(); ]]></event>
                                    </edit>
                                </rectangle>
                                <label align="top" height="14" text="digite aqui" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <layout align="left" width="110">
                                <label align="top" height="16" text="EXTRAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" hint="Pontos que o próprio sistema concedeu: habilidades de subclasse, EX dos níveis 15 e 20, o Rank E grátis de cada poder e o ponto de skill do nível 19. Calculado, não editável."/>
                                <label name="abaPod_lblExtras" align="top" height="24" text="0" fontFamily="Cinzel" fontColor="#4E8C74" fontSize="20" horzTextAlign="center" hitTest="false"/>
                                <label name="abaPod_lblExtrasNota" align="top" height="14" text="do sistema" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" horzTextAlign="center" hitTest="false"/>
                            </layout>
                            <label name="abaPod_lblLimites" align="client" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        </layout>
                    </rectangle>

                    <!-- ===== BARRA DE ACOES =====
                         Os botoes do mestre usam LARGURA controlada pelo mesmo
                         motivo dos wrappers de altura: nada de setVisible. -->
                    <layout align="top" height="34" margins="{bottom=6}">
                        <rectangle align="left" width="256" color="#12181C" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{right=8,top=2,bottom=2}" cursor="handPoint" hint="Abrir o catálogo de poderes das divindades">
                            <label align="client" text="+  ADICIONAR PODER" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[ abrirPopupPoderes(); ]]></event>
                        </rectangle>
                        <layout name="abaPod_wrapAutorizar" align="left" width="0">
                            <rectangle align="client" color="#12181C" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{right=8,top=2,bottom=2}" cursor="handPoint" hint="MESTRE: autoriza uma segunda subida de poder neste mesmo nível (uso único)">
                                <label align="client" text="AUTORIZAR SUBIDA EXTRA NESTE NÍVEL" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[ autorizarUpDuploPoder(); ]]></event>
                            </rectangle>
                        </layout>
                        <layout name="abaPod_wrapRomper" align="left" width="0">
                            <rectangle align="client" color="#12181C" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{top=2,bottom=2}" cursor="handPoint" hint="MESTRE: libera a próxima troca de Aspecto Divino (uso único)">
                                <label align="client" text="ROMPER LACRE DO ASPECTO" fontFamily="Marcellus SC" fontColor="#8B2332" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                <event name="onClick"><![CDATA[ romperLacreAspecto(); ]]></event>
                            </rectangle>
                        </layout>
                    </layout>

                    <rectangle align="top" height="26" color="#0A0F13" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{bottom=8}" hitTest="false">
                        <label name="abaPod_lblLacre" align="client" text="" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" wordWrap="false" vertTextAlign="center" margins="{left=10,right=10}" hitTest="false"/>
                    </rectangle>

                    <label name="abaPod_lblAviso" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="12" wordWrap="false" margins="{bottom=6}" hitTest="false"/>

                    <layout name="abaPod_wrapVazio" align="top" height="70">
                        <rectangle align="client" color="#0D1317" strokeColor="#1A262C" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Abrir o catálogo de poderes">
                            <label align="client" text="Nenhum poder adquirido ainda. O kit da sua divindade é opcional: você pode comprar um único poder e investir todo o resto em habilidades e feitiços. Clique aqui para abrir o catálogo." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="13" wordWrap="true" vertTextAlign="center" margins="{left=14,right=14}" hitTest="false"/>
                            <event name="onClick"><![CDATA[ abrirPopupPoderes(); ]]></event>
                        </rectangle>
                    </layout>

                    <!-- ===== linha 1 ===== -->
                    <!-- Wrappers de ALTURA: nunca use setVisible aqui. No Firecast,
                         tornar visivel em runtime um elemento align="top" que estava
                         invisivel o joga para o TOPO da pilha. Altura 0 mantem a
                         ordem cravada pela declaracao. -->
