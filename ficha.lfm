    <!-- =================================================================
         POPUP - AUTORIZACOES DO MESTRE SOBRE A MESTICAGEM

         Concentra as duas excecoes possiveis ao lacre. Ambas sao de USO
         UNICO: sao consumidas na proxima acao do jogador e a ficha volta a
         ficar lacrada, para nao esquecer uma ficha destravada para sempre.
         ================================================================= -->
    <popup name="popMestreMest" width="720" height="420" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=20,right=20,top=16,bottom=16}">
                <label align="top" height="26" text="LACRE DA MESTIÇAGEM  •  AUTORIZAÇÕES DO MESTRE" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=10}" hitTest="false"/>

                <rectangle align="top" height="96" color="#0B1014" strokeColor="#2A4652" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" hitTest="false">
                    <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                        <label align="top" height="16" text="ESTADO ATUAL" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11"/>
                        <label name="popMestreMest_lblEstado" align="client" text="" fontFamily="EB Garamond" fontColor="#B9D3DD" fontSize="12" wordWrap="true" vertTextAlign="leading"/>
                    </layout>
                </rectangle>

                <label name="popMestreMest_lblAviso" align="top" height="20" text="" fontFamily="Marcellus SC" fontColor="#8B2332" fontSize="11" margins="{bottom=8}"/>

                <rectangle align="bottom" height="36" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=10}" cursor="handPoint" hint="Fechar esta janela">
                    <event name="onClick"><![CDATA[self.popMestreMest:close();]]></event>
                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                </rectangle>

                <layout align="client">
                    <rectangle align="top" height="52" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" cursor="handPoint" hint="Quebra o lacre e libera UM novo sorteio completo. A ação é publicada no chat da mesa.">
                        <event name="onClick"><![CDATA[mestreQuebrarLacre();]]></event>
                        <layout align="client" margins="{left=12,right=12,top=5,bottom=5}">
                            <label align="top" height="18" text="QUEBRAR O LACRE &#8226; LIBERAR UM NOVO SORTEIO" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="12" hitTest="false"/>
                            <label align="client" text="Apaga o lacre e permite refazer o sorteio uma única vez. Use quando houve erro de regra ou acordo de mesa." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" vertTextAlign="leading" hitTest="false"/>
                        </layout>
                    </rectangle>

                    <rectangle align="top" height="52" color="#0B1014" strokeColor="#C9A24B" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" cursor="handPoint" hint="Permite aplicar o tier ATUAL de Mestiço às escolhas, uma vez, convertendo sorteadas em escolhidas.">
                        <event name="onClick"><![CDATA[mestreAutorizarReajusteTier();]]></event>
                        <layout align="client" margins="{left=12,right=12,top=5,bottom=5}">
                            <label align="top" height="18" text="AUTORIZAR REAJUSTE DE TIER" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="12" hitTest="false"/>
                            <label align="client" text="Depois de um upgrade de Mestiço (1 PQ &#8594; 2 PQ), libera a conversão de sorteadas em escolhidas. Sem esta autorização, o tier do sorteio continua valendo." fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" vertTextAlign="leading" hitTest="false"/>
                        </layout>
                    </rectangle>

                    <rectangle align="top" height="34" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" cursor="handPoint" hint="Cancela autorizações que ainda não foram usadas e volta a lacrar a herança existente">
                        <event name="onClick"><![CDATA[mestreCancelarAutorizacoes();]]></event>
                        <label align="client" text="CANCELAR AUTORIZAÇÕES PENDENTES E RELACRAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                </layout>
            </layout>
        </rectangle>
    </popup>


    <!-- =================================================================
         POPUP - CATALOGO DE CLASSES E SUBCLASSES

         Mestre-detalhe, mesmo padrao de Racas e Qualidades: lista estatica a
         esquerda (nunca recordList com nos NDB, por causa do bug de funcao
         global sobrescrita), detalhe com a arvore de 8 niveis a direita.
         O simbolo de aviso na lista marca as subclasses cujos niveis 6-8 nao
         estao escritos no documento da mesa.
         ================================================================= -->
    <popup name="popClasses" width="1080" height="700" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="CLASSES &amp; SUBCLASSES" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>
                <label align="top" height="30" text="Pontos de classe chegam nos níveis 1, 3, 5, 8, 11, 14, 17 e 20 — cada ponto sobe um nível na árvore. Máximo de duas subclasses; a segunda abre no nível 11, com a primeira já no nível 4." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" wordWrap="true" margins="{bottom=8}" hitTest="false"/>

                <layout align="client">
                    <rectangle align="left" width="280" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" margins="{right=12}" hitTest="false">
                        <layout align="client" margins="{left=8,right=8,top=8,bottom=8}">
                            <label align="top" height="18" text="Escolha uma subclasse:" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="11" margins="{bottom=4}" hitTest="false"/>
                            <scrollBox align="client">
                                <label align="top" height="20" text="ARCANISTA" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{top=8,bottom=3}"/>
                                <rectangle name="rectCls_Arcanista_1" align="top" height="28" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Ver a árvore de Alquimista (Arcanista)">
                                    <event name="onClick"><![CDATA[selecionarDetalheSubclasse("Arcanista", "Alquimista");]]></event>
                                    <label align="client" text="Alquimista" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectCls_Arcanista_2" align="top" height="28" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Ver a árvore de Especialista arcano (Arcanista)">
                                    <event name="onClick"><![CDATA[selecionarDetalheSubclasse("Arcanista", "Especialista arcano");]]></event>
