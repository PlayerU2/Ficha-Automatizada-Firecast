                    <layout align="top" height="36" margins="{bottom=8}">
                        <rectangle align="left" width="330" color="#1A1206" strokeColor="#C9A24B" strokeSize="2" xradius="3" yradius="3" margins="{right=10,top=2,bottom=2}" cursor="handPoint" hint="Preenche vida, CD, proficiência, XP e o que mais as sete classificações determinam. Sugere: nada é salvo até você clicar em salvar.">
                            <label align="client" text="• APLICAR AS REGRAS DO LIVRO" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[aplicarRegrasDoLivro();]]></event>
                        </rectangle>
                        <!-- LIMPAR: apaga so os campos de CAMPOS_DO_GERADOR,
                             para o mestre trocar uma classificacao e aplicar
                             de novo sem ter que apagar numero por numero. -->
                        <rectangle align="left" width="160" color="#12181C" strokeColor="#6E5A2E" strokeSize="1" xradius="3" yradius="3" margins="{right=10,top=2,bottom=2}" cursor="handPoint" hint="Zera vida, CD, proficiência, XP, Carisma, Sabedoria e espólios — só o que o botão do livro preenche. Nome, deslocamentos, defesas e os textos ficam.">
                            <label align="client" text="LIMPAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                            <event name="onClick"><![CDATA[limparRegrasDoLivro();]]></event>
                        </rectangle>
                        <!-- Nasce com largura 0 (escondido). So aparece quando
                             o gerador deixou algo para o mestre decidir, e o
                             numero de pendencias vai no proprio rotulo. -->
                        <layout name="edCri_wrapBtnInstrucoes" align="left" width="0" margins="{right=10}">
                            <rectangle align="client" color="#12181C" strokeColor="#8A63C9" strokeSize="1" xradius="3" yradius="3" margins="{top=2,bottom=2}" cursor="handPoint" hint="O que o livro deixou em aberto nesta criatura — escolhas que o gerador não pode fazer por você.">
                                <label name="edCri_lblBtnInstrucoes" align="client" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                <event name="onClick"><![CDATA[alternarInstrucoesCriatura();]]></event>
                            </rectangle>
                        </layout>
                    </layout>

                    <!-- A LINHA DE CONTEXTO TEM A LINHA INTEIRA (v0.42.1).
                         ACHADO NA TELA em 05/09/2026: ela era o align="client"
                         da fileira dos botoes e sobrava com ~124px, entao o
                         "Rank E — força de um mortal jovem comum..." chegava
                         cortado com reticencias. Ninguem media porque a
                         checagem 35 so ve rotulo com text= ESTATICO, e este e
                         escrito pelo Lua; e o vizinho que o espremeu tem
                         largura definida pelo Lua tambem, entao no XML a
                         fileira parecia folgada. A checagem 45 passa a proibir
                         a forma: client escrito pelo Lua ao lado de irmao cuja
                         largura o Lua muda. -->
                    <label name="edCri_lblContexto" align="top" height="32" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" vertTextAlign="leading" margins="{bottom=6}" hitTest="false"/>

