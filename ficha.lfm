                                    </layout>
                                    <layout name="det_wrapdefesas" align="top" height="26">
                                        <label align="left" width="180" text="DEFESAS" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_defesas" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="true" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapabsorcao" align="top" height="26">
                                        <label align="left" width="180" text="ABSORÇÃO DE DANO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_absorcao" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapdeslocamento" align="top" height="26">
                                        <label align="left" width="180" text="DESLOCAMENTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_deslocamento" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrappericia" align="top" height="26">
                                        <label align="left" width="180" text="BÔNUS DE PERÍCIA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_pericia" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapmunicoes" align="top" height="26">
                                        <label align="left" width="180" text="MUNIÇÕES" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_municoes" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapespacos" align="top" height="0">
                                        <label align="left" width="180" text="ESPAÇOS DE MOCHILA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_espacos" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapvisao" align="top" height="0">
                                        <label align="left" width="180" text="VISÃO NO ESCURO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_visao" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapcapacidade" align="top" height="0">
                                        <label align="left" width="180" text="CAPACIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_capacidade" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wraparea" align="top" height="0">
                                        <label align="left" width="180" text="DANO EM ÁREA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_area" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                    <!-- EFEITO em BLOCO: o texto do livro chega a mil
                                         caracteres. Numa linha de 26px sem quebra ele
                                         era cortado com reticências; aqui o rótulo fica
                                         em cima e o texto ocupa a largura inteira, com
                                         a altura calculada pelo tamanho do conteúdo. -->
                                    <layout name="det_wrapefeito" align="top" height="0">
                                        <label align="top" height="18" text="EFEITO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                                        <label name="det_efeito" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" wordWrap="true" margins="{left=4,right=4,bottom=6}" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapforja" align="top" height="0">
                                        <label align="top" height="18" text="FORJA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                                        <label name="det_forja" align="client" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{left=4,right=4,bottom=6}" hitTest="false"/>
                                    </layout>
                                    <layout name="det_wrapslots" align="top" height="26">
                                        <label align="left" width="180" text="SLOTS DE ENCANTAMENTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                        <label name="det_slots" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                    </layout>
                                <label name="det_obs" align="top" height="60" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="true" margins="{top=10}" hitTest="false"/>
                            </layout>
                        </scrollBox>
                    </layout>
                </rectangle>
            </layout>
        </rectangle>
    </popup>

    <popup name="popEditarItem" width="900" height="720" backOpacity="0.8" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=20,right=20,top=16,bottom=16}">
                <label name="edIt_lblTitulo" align="top" height="26" text="ITEM" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <label name="edIt_lblCategoria" align="top" height="18" text="" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=10}" hitTest="false"/>

                <layout align="bottom" height="34" margins="{top=12}">
                    <rectangle align="left" width="190" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{right=12}" cursor="handPoint" hint="Fechar sem salvar">
                        <label align="client" text="CANCELAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        <event name="onClick"><![CDATA[fecharEditorItem();]]></event>
                    </rectangle>
                    <rectangle align="client" color="#12181C" strokeColor="#C9A24B" strokeSize="2" xradius="3" yradius="3" cursor="handPoint" hint="Salvar: se o item estiver equipado, os valores entram na ficha na hora">
                        <label align="client" text="SALVAR E FECHAR" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                        <event name="onClick"><![CDATA[salvarEditorItem();]]></event>
                    </rectangle>
                </layout>

                <scrollBox align="client">
                    <layout name="edIt_grupoidentidade" align="top" height="76">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" margins="{bottom=8}">
                            <layout align="client" margins="{left=14,right=14,top=4,bottom=6}">
                                <label align="top" height="18" text="IDENTIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="46">
                                    <layout align="left" width="300" margins="{right=10}">
                                        <label align="top" height="14" text="NOME" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Nome do item"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_nome" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Nome do item"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="150" margins="{right=10}">
                                        <label align="top" height="14" text="QUALIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Comum, Ótima, ou o que a forja produziu"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_qualidade" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Comum, Ótima, ou o que a forja produziu"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="190" margins="{right=10}">
                                        <label align="top" height="14" text="MATERIAL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Material da forja. Com a qualidade, define os slots de encantamento"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_material" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Material da forja. Com a qualidade, define os slots de encantamento"/>
                                        </rectangle>
                                    </layout>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="edIt_grupodurabilidade" align="top" height="76">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" margins="{bottom=8}">
                            <layout align="client" margins="{left=14,right=14,top=4,bottom=6}">
                                <label align="top" height="18" text="DURABILIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="46">
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="ATUAL" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Quanto resta antes de quebrar"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_durAtual" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Quanto resta antes de quebrar"/>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="130" margins="{right=10}">
                                        <label align="top" height="14" text="MÁXIMA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Durabilidade total do item"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
                                            <edit name="edIt_durMax" align="client" text="" type="number" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" horzTextAlign="center" transparent="true" margins="{left=6,right=6}" hint="Durabilidade total do item"/>
                                        </rectangle>
                                    </layout>
                                </layout>
                            </layout>
                        </rectangle>
                    </layout>
                    <layout name="edIt_gruporequisito" align="top" height="76">
                        <rectangle align="client" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="5" yradius="5" margins="{bottom=8}">
                            <layout align="client" margins="{left=14,right=14,top=4,bottom=6}">
                                <label align="top" height="18" text="REQUISITO PARA EQUIPAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                <layout align="top" height="46">
                                    <layout align="left" width="220" margins="{right=10}">
                                        <label align="top" height="14" text="ATRIBUTO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="Clique para escolher o atributo exigido"/>
                                        <rectangle name="edIt_btnreqAtributo" align="top" height="28" color="#080B0E" strokeColor="#7FA8B8" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Clique para escolher o atributo exigido">
                                            <label name="edIt_reqAtributo" align="client" text="—" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="12" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                            <event name="onClick"><![CDATA[abrirSeletorAtributoItem();]]></event>
                                        </rectangle>
                                    </layout>
                                    <layout align="left" width="140" margins="{right=10}">
                                        <label align="top" height="14" text="VALOR MÍNIMO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hint="A ficha recusa equipar se o personagem não alcançar"/>
                                        <rectangle align="top" height="28" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3">
