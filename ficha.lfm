                                <label align="client" text="oposto: Calmo" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="11" vertTextAlign="center"/>
                            </layout>
                            <label align="client" text="Você possui vantagem em quaisquer testes que envolvam entrar em estado de fúria ou perda de controle por conta da raiva e quando neste estado você terá um bônus de +2 para causar medo. Você sempre irá buscar a penalidade máxima para aqueles que considera criminosos. (Ex: caso a punição máxima seja a pena de morte, você não irá aceitar menos que isso)" fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Calmo" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Calmo' para o personagem">
