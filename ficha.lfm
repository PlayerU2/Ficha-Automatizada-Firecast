                    <!-- textEditor, e NAO richEdit. Leia antes de tentar de novo.

                         A v0.35.1 colocou dois <richEdit> aqui, pela barra de
                         formatacao. O Firecast passou a CRASHAR ao abrir este
                         popup em maquina modesta - duas vezes seguidas, na
                         mesma maquina. Revertido na v0.35.2.

                         POR QUE aqui quebra e na aba de Background nao:
                           - Background tem UM richEdit, align="client", direto
                             no painel da aba, sem area rolavel em volta.
                           - Aqui eram DOIS, com altura fixa (360 e 210), dentro
                             de um <scrollBox> que ja carrega ~90 widgets.
                         Editor de texto rico e um controle pesado: ele mede e
                         redesenha o proprio conteudo. Dentro de scrollBox, com
                         altura fixa, isso vira medicao aninhada - e nao ha
                         motivo para pagar esse preco no meio de uma sessao.

                         Se um dia valer a pena tentar de novo, o caminho menos
                         arriscado e UM SO richEdit, para habilidades, FORA do
                         scrollBox - e testando primeiro na maquina mais fraca
                         da mesa, nao na melhor. A checagem 24 do verifica.py
                         recusa o build se um richEdit voltar para dentro de um
                         popup sem que alguem decida isso de novo.

                         O campo ESPOLIOS saiu daqui (v0.35.1): a mesa preferiu
                         o espaco nas habilidades, e o que o livro da sobre
                         espolio e enunciado ("3 espolios: um Raro, os outros
                         Comuns ou Incomuns"), nao valor - foi para a lista de
                         instrucoes. Texto ja salvo migra para o fim das
                         habilidades ao abrir a criatura. -->
                    <label align="top" height="16" text="HABILIDADES ESPECIAIS — uma por linha; o rank diz quantas ela deveria ter" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" margins="{top=2,bottom=2}" hitTest="false"/>
                    <rectangle align="top" height="360" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{bottom=8}">
                        <textEditor name="edCri_habilidades" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" transparent="true" margins="{left=10,right=10,top=6,bottom=6}"/>
                    </rectangle>
                    <label align="top" height="16" text="DESCRIÇÃO — aparência, comportamento, história" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" margins="{top=2,bottom=2}" hitTest="false"/>
                    <rectangle align="top" height="210" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{bottom=8}">
                        <textEditor name="edCri_descricao" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" transparent="true" margins="{left=10,right=10,top=6,bottom=6}"/>
                    </rectangle>
                    <label align="top" height="16" text="ARTE DA CRIATURA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" margins="{top=2,bottom=2}" hitTest="false"/>
                    <rectangle align="top" height="320" color="#080B0E" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{left=270,right=270,bottom=10}">
                        <!-- style="proportional" e DECISAO DE MESA, nao sobra: aqui a peca
                                     inteira importa mais que preencher a moldura. Uma arte
                                     de equipamento ou de criatura cortada perde justamente o
                                     que se quer ver. E o oposto do retrato do personagem
                                     (autoFit, linha ~11161), onde cortar nao importa e a
                                     estetica manda. NAO "uniformize" os dois. -->
                                <image align="client" field="imagemCriaturaEdicao" editable="true" style="proportional" showProgress="true" margins="{left=3,right=3,top=3,bottom=3}" hint="Clique para escolher a arte desta criatura — de um endereço da internet ou do seu FireDrive."/>
                    </rectangle>

                </scrollBox>
            </layout>
        </rectangle>
    </popup>

