                                </rectangle>
                                <rectangle name="rectLinhaRaca_Ursaris" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Ursaris">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Ursaris");]]></event>
                                    <label align="client" text="Ursaris" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle align="top" height="34" color="#0B1014" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{top=6,bottom=6}" hitTest="false">
                                    <layout align="client" margins="{left=8,right=8,top=2,bottom=2}">
                                        <label align="top" height="15" text="RAÇAS PRIMORDIAIS" fontFamily="Marcellus SC" fontColor="#8B2332" fontSize="11"/>
                                        <label align="client" text="Somente com autorização do mestre" fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11"/>
                                    </layout>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Banshees" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Banshees">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Banshees");]]></event>
                                    <label align="client" text="Banshees" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Criofenix" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Criofênix">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Criofênix");]]></event>
                                    <label align="client" text="Criofênix" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Dragoes" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Dragões">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Dragões");]]></event>
                                    <label align="client" text="Dragões" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Fenix" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Fênix">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Fênix");]]></event>
                                    <label align="client" text="Fênix" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Gigantes" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Gigantes">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Gigantes");]]></event>
                                    <label align="client" text="Gigantes" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Krakens" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Krakens">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Krakens");]]></event>
                                    <label align="client" text="Krakens" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                                <rectangle name="rectLinhaRaca_Unicornios" align="top" height="32" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=4}" cursor="handPoint" hint="Ver detalhes de Unicórnios">
                                    <event name="onClick"><![CDATA[selecionarDetalheRaca("Unicórnios");]]></event>
                                    <label align="client" text="Unicórnios" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="12" fontStyle="bold" vertTextAlign="center" margins="{left=10}" hitTest="false"/>
                                </rectangle>
                            </scrollBox>
                        </layout>
                    </rectangle>

                    <layout align="client">
                        <label name="popRaca_lblTitulo" align="top" height="26" text="Selecione uma raça na lista ao lado" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="20" fontStyle="bold"/>
                        <label name="popRaca_lblSubtitulo" align="top" height="18" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" margins="{bottom=6}"/>

                        <rectangle name="popRaca_secAviso" align="top" height="56" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" visible="false" hitTest="false">
                            <label name="popRaca_lblAviso" align="client" text="" fontFamily="EB Garamond" fontColor="#E2AEB6" fontSize="12" wordWrap="true" vertTextAlign="leading" margins="{left=10,right=10,top=6,bottom=6}"/>
                        </rectangle>

                        <rectangle align="bottom" height="42" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=8}">
                            <layout align="client" margins="{left=8,right=8}">
                                <rectangle name="popRaca_btnDefinir" align="client" color="#16202A" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" cursor="handPoint" hint="Define esta raça na ficha e preenche Deslocamento/Dado de Vida automaticamente">
                                    <event name="onClick"><![CDATA[confirmarDefinirRaca();]]></event>
                                    <label name="popRaca_lblBtnDefinir" align="client" text="DEFINIR COMO MINHA RAÇA" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                                <rectangle align="right" width="90" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Fechar esta janela">
                                    <event name="onClick"><![CDATA[self.popCatalogoRacas:close();]]></event>
                                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                </rectangle>
                            </layout>
                        </rectangle>

                        <scrollBox align="client">
                            <rectangle align="top" height="46" color="#0B1014" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=6,bottom=6}">
                                    <label align="top" height="16" text="ATRIBUTOS BASE" fontFamily="Marcellus SC" fontColor="#7FA8B8" fontSize="11"/>
                                    <label name="popRaca_lblBase" align="client" text="" fontFamily="EB Garamond" fontColor="#B9D3DD" fontSize="13" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>

                            <!-- ATRIBUTO DA RAÇA: aparece só quando a raça aberta
                                 no popup deixa ESCOLHER o atributo (hoje, apenas a
                                 Versatilidade humana). As raças que já definem qual
                                 atributo recebe o bônus não mostram nada aqui.
                                 Sete botões em uma linha só estouravam em tela
                                 menor; agora vão em duas linhas com largura
                                 elástica (align="client"), que se adapta sozinha. -->
                            <layout name="popRaca_secAtributo" align="top" height="0">
                                <rectangle align="client" color="#0B1014" strokeColor="#C9A24B" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}">
                                    <layout align="client" margins="{left=12,right=12,top=6,bottom=6}">
                                        <label align="top" height="16" text="ATRIBUTO FAVORECIDO — escolha onde entra o bônus" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                        <layout align="top" height="26" margins="{bottom=4}">
                                            <rectangle name="popRaca_btnAtrforca" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Força recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrforca" align="client" text="Força" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Força");]]></event>
                                            </rectangle>
                                            <rectangle name="popRaca_btnAtrdestreza" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Destreza recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrdestreza" align="client" text="Destreza" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Destreza");]]></event>
                                            </rectangle>
                                            <rectangle name="popRaca_btnAtrconstituicao" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Constituição recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrconstituicao" align="client" text="Constituição" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Constituição");]]></event>
                                            </rectangle>
                                            <rectangle name="popRaca_btnAtrinteligencia" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Inteligência recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrinteligencia" align="client" text="Inteligência" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Inteligência");]]></event>
                                            </rectangle>
                                        </layout>
                                        <layout align="top" height="26" margins="{bottom=4}">
                                            <rectangle name="popRaca_btnAtrsabedoria" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Sabedoria recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrsabedoria" align="client" text="Sabedoria" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Sabedoria");]]></event>
                                            </rectangle>
                                            <rectangle name="popRaca_btnAtrcarisma" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Carisma recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrcarisma" align="client" text="Carisma" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Carisma");]]></event>
                                            </rectangle>
                                            <rectangle name="popRaca_btnAtrmanipulacao" align="left" width="104" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=4}" cursor="handPoint" hint="Manipulação recebe o bônus e passa a ter o limite elevado">
                                                <label name="popRaca_lblAtrmanipulacao" align="client" text="Manipulação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherAtributoRacial("Manipulação");]]></event>
                                            </rectangle>
                                        </layout>
                                        <label name="popRaca_lblAtributoAtual" align="top" height="16" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="11" wordWrap="false" hitTest="false"/>
                                    </layout>
                                </rectangle>
                            </layout>

                            <!-- DEFESA MENTAL: so na raca com "Mente fechada".
                                 A mesa tem DUAS defesas mentais (telepática e
                                 empática) e o jogador escolhe onde recai o +2. -->
                            <layout name="popRaca_secDefesa" align="top" height="0">
                                <rectangle align="client" color="#0B1014" strokeColor="#C9A24B" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}">
                                    <layout align="client" margins="{left=12,right=12,top=6,bottom=6}">
                                        <label align="top" height="16" text="DEFESA MENTAL FAVORECIDA — onde entra o +2" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                        <layout align="top" height="26" margins="{bottom=4}">
                                            <rectangle name="popRaca_btnDefTele" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" cursor="handPoint" hint="O +2 recai na Defesa telepática">
                                                <label name="popRaca_lblDefTele" align="client" text="TELEPÁTICA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherDefesaMental("telepatica");]]></event>
                                            </rectangle>
                                            <rectangle name="popRaca_btnDefEmp" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="O +2 recai na Defesa empática">
                                                <label name="popRaca_lblDefEmp" align="client" text="EMPÁTICA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                                <event name="onClick"><![CDATA[escolherDefesaMental("empatica");]]></event>
                                            </rectangle>
                                        </layout>
                                        <label name="popRaca_lblDefesaAtual" align="top" height="16" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="11" wordWrap="false" hitTest="false"/>
                                    </layout>
                                </rectangle>
                            </layout>

                            <rectangle name="popRaca_secCarac1" align="top" height="86" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" visible="false" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=7,bottom=7}">
                                    <label name="popRaca_lblCaracNome1" align="top" height="20" text="" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="14" fontStyle="bold"/>
                                    <label name="popRaca_lblCaracDesc1" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="13" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                            <rectangle name="popRaca_secCarac2" align="top" height="86" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" visible="false" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=7,bottom=7}">
                                    <label name="popRaca_lblCaracNome2" align="top" height="20" text="" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="14" fontStyle="bold"/>
                                    <label name="popRaca_lblCaracDesc2" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="13" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                            <rectangle name="popRaca_secCarac3" align="top" height="86" color="#0B1014" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{bottom=8}" visible="false" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=7,bottom=7}">
                                    <label name="popRaca_lblCaracNome3" align="top" height="20" text="" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="14" fontStyle="bold"/>
                                    <label name="popRaca_lblCaracDesc3" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="13" wordWrap="true" vertTextAlign="leading"/>
