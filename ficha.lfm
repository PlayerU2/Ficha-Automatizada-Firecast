                            <rectangle name="rectFavInt_Ammis" align="top" height="0" color="#0D1317" strokeSize="0" hitTest="false"/>
                            <rectangle name="rectFav_Aslot" align="top" height="26" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Clique para meio favor; use o botão + 1 INTEIRO para um favor cheio">
                                <label name="lblFav_Aslot" align="client" text="Aslot" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                <label align="right" width="66" text="Grande" fontFamily="Marcellus SC" fontColor="#54636B" fontSize="11" vertTextAlign="center" hitTest="false"/>
