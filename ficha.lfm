    <popup name="popPoderes" width="1080" height="680" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="CATÁLOGO DE PODERES" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>
                <label align="top" height="18" text="Cada divindade oferece 5 SLOTS de poder (3 ativos e 2 passivos); onde o livro escreve OU, o slot aceita um dos dois. Só se adquire do kit da própria divindade ou de quem o abençoou." fontFamily="EB Garamond" fontColor="#5F7078" fontSize="11" margins="{bottom=8}" hitTest="false"/>

                <rectangle align="bottom" height="30" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{top=10}" cursor="handPoint" hint="Fechar o catálogo">
                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    <event name="onClick"><![CDATA[fecharPopupPoderes();]]></event>
                </rectangle>

                <layout align="client">
                    <rectangle align="left" width="300" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" margins="{right=14}" hitTest="false">
                        <rectangle name="rectBuscaPoderes" align="top" height="26" color="#080B0E" strokeColor="#1E2A31" strokeSize="1" xradius="3" yradius="3" margins="{left=8,right=8,top=6,bottom=2}">
                            <layout align="client" margins="{left=6,right=6}">
                                <edit name="edBuscaPoderes" align="client" text="" transparent="true" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" hint="Filtra a lista pelo nome do poder. Ignora acento e maiúscula, e zera ao reabrir o pop-up.">
                                    <event name="onChange"><![CDATA[filtrarCatalogoPoderes(self.edBuscaPoderes:getText());]]></event>
                                        <event name="onKeyUp"><![CDATA[filtrarCatalogoPoderes(self.edBuscaPoderes:getText());]]></event>
                                </edit>
                            </layout>
                        </rectangle>
                        <label name="lblLaudoPoderes" align="top" height="0" text="" fontFamily="EB Garamond" fontColor="#C9A24B" fontSize="11" wordWrap="true" hitTest="false"/>
                        <scrollBox name="sbListaPoderes" align="client" margins="{left=8,right=8,top=4,bottom=8}">
                                <label name="podCab_Ammis" align="top" height="20" text="AMMIS" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" margins="{top=10,bottom=4}" hitTest="false"/>
                                <rectangle name="rectPod_Ammis_Carismasobrenatural" align="top" height="26" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Ver Carisma sobrenatural — kit de Ammis">
                                    <event name="onClick"><![CDATA[mostrarDetalhePoder("Carisma sobrenatural", "Ammis");]]></event>
                                    <label align="client" text="Carisma sobrenatural" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                    <label align="right" width="52" text="passivo" fontFamily="Marcellus SC" fontColor="#4E8C74" fontSize="11" vertTextAlign="center" hitTest="false"/>
