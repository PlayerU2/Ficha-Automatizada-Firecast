                        <label name="popSlot_lblbolso2" align="client" text="BOLSO 2" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        <event name="onClick"><![CDATA[confirmarSlot("bolso2");]]></event>
