                    <!-- DIREITA -->
                    <rectangle align="client" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="5" yradius="5" hitTest="false">
                        <scrollBox align="client" margins="{left=14,right=14,top=10,bottom=8}">

                            <label align="top" height="16" text="NOME" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <rectangle align="top" height="28" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=8}">
                                <edit name="popHab_edNome" align="client" text="" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="13" transparent="true" margins="{left=8,right=8}" hint="Nome da habilidade"/>
                            </rectangle>

                            <label align="top" height="16" text="TIPO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <layout align="top" height="30" margins="{bottom=8}">
                                <rectangle name="popHab_btnTipoPoder" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" cursor="handPoint" hint="Habilidade vinculada a um poder ativo">
                                    <label name="popHab_lblTipoPoder" align="client" text="DE PODER" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[definirTipoHab("poder");]]></event>
                                </rectangle>
                                <rectangle name="popHab_btnTipoClasse" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" cursor="handPoint" hint="Habilidade de classe: sem poder, chega a EX, efeitos mais fracos">
                                    <label name="popHab_lblTipoClasse" align="client" text="DE CLASSE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[definirTipoHab("classe");]]></event>
                                </rectangle>
                                <rectangle name="popHab_btnTipoFeitico" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6}" cursor="handPoint" hint="Feitiço: exige o poder Magia, gasta Mana">
                                    <label name="popHab_lblTipoFeitico" align="client" text="FEITIÇO" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[definirTipoHab("feitico");]]></event>
                                </rectangle>
                                <rectangle name="popHab_btnTipoRacial" align="left" width="150" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Habilidade racial: vem da raça, não gasta pontos de poder. Pode ser progressiva.">
                                    <label name="popHab_lblTipoRacial" align="client" text="DE RAÇA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[definirTipoHab("racial");]]></event>
                                </rectangle>
                            </layout>

                            <!-- BLOCO PROGRESSIVO: altura 0 por padrao, cresce
                                 quando o tipo e "racial". Altura, e nao
                                 visible= - filho align="top" escondido e
                                 mostrado de novo vai para o topo da pilha. -->
                            <layout name="popHab_wrapProgressiva" align="top" height="0">
                                <layout align="top" height="30" margins="{bottom=6}">
                                    <rectangle name="popHab_btnProgressiva" align="left" width="230" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Habilidade PROGRESSIVA: o efeito muda sozinho conforme o rank do personagem sobe.">
                                        <label name="popHab_lblProgressiva" align="client" text="[  ]  PROGRESSIVA" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                                        <event name="onClick"><![CDATA[alternarProgressiva();]]></event>
                                    </rectangle>
                                    <label name="popHab_lblProgAjuda" align="client" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" vertTextAlign="center" wordWrap="false" margins="{left=10}" hitTest="false"/>
                                </layout>
                            </layout>

                            <label name="popHab_lblPoderTitulo" align="top" height="16" text="PODER DE ORIGEM" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <layout name="popHab_wrapListaPoderes" align="top" height="0">
                                <layout align="client">
                            <layout name="popHab_wrapPoder1" align="top" height="0">
                                <rectangle name="popHab_rectPoder1" align="client" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=3}" cursor="handPoint" hint="Usar este poder como origem da habilidade">
                                    <label name="popHab_lblPoder1" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" vertTextAlign="center" margins="{left=8}" hitTest="false"/>
                                    <label name="popHab_lblPoderNv1" align="right" width="90" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" hitTest="false"/>
                                    <event name="onClick"><![CDATA[popHabEscolherPoder(1);]]></event>
                                </rectangle>
                            </layout>
                            <layout name="popHab_wrapPoder2" align="top" height="0">
