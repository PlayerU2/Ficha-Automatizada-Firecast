                    <rectangle align="left" width="140" color="#111A1E" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{right=6}" cursor="handPoint" hint="Cancelar e não adicionar">
                        <event name="onClick"><![CDATA[cancelarPericiaAlemDoLimite();]]></event>
                        <label align="client" text="CANCELAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                    <rectangle align="client" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="4" yradius="4" margins="{left=6}" cursor="handPoint" hint="Adicionar mesmo ultrapassando o limite (autorização do mestre)">
                        <event name="onClick"><![CDATA[confirmarPericiaAlemDoLimite();]]></event>
                        <label align="client" text="MESTRE AUTORIZA - ADICIONAR MESMO ASSIM" fontFamily="Marcellus SC" fontColor="#D4838F" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                    </rectangle>
                </layout>
            </layout>
        </rectangle>
    </popup>

    <popup name="popCatalogoQualidades" width="920" height="600" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="QUALIDADES • CATÁLOGO" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center"/>
                <rectangle align="top" height="1" color="#8A63C9" margins="{top=4,bottom=10}" hitTest="false"/>

