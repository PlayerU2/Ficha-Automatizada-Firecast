                            </layout>
                            <label align="client" text="Você possui vantagem em quaisquer testes que envolvam resistir a fúria ou perda de controle por conta da raiva e enquanto se mantiver calmo você terá +2 de resistência bônus contra efeitos de medo. Você possui desvantagem em testes sociais contra personagens Coléricos." fontFamily="EB Garamond" fontColor="#A8B6BC" fontSize="12" wordWrap="true"/>
                        </layout>
                    </rectangle>
                    <rectangle name="rectTraco_Paciente" align="top" height="92" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=20}" cursor="handPoint" hint="Escolher o traço 'Paciente' para o personagem">
