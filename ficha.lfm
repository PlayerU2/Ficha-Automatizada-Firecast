                    </rectangle>
                    <rectangle name="popSlot_btnprimario" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblprimario" align="client" text="PRIMÁRIO" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        <event name="onClick"><![CDATA[confirmarSlot("primario");]]></event>
                    </rectangle>
                    <rectangle name="popSlot_btnsecundario" align="top" height="34" color="#0D1317" strokeColor="#1E2A31" strokeSize="1" xradius="4" yradius="4" margins="{bottom=6}" cursor="handPoint" hint="Equipar neste slot">
                        <label name="popSlot_lblsecundario" align="client" text="SECUNDÁRIO" fontFamily="Marcellus SC" fontColor="#E6E9E4" fontSize="11" vertTextAlign="center" margins="{left=12}" hitTest="false"/>
                        <event name="onClick"><![CDATA[confirmarSlot("secundario");]]></event>
