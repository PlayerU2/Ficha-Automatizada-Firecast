                            <label align="top" height="16" text="DESCRIÇÃO (o que se vê)" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <rectangle align="top" height="54" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=8}">
                                <textEditor name="popHab_edDescricao" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" transparent="true" margins="{left=6,right=6,top=4,bottom=4}"/>
                            </rectangle>

                            <label align="top" height="16" text="EFEITO (o que faz em regras)" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <rectangle align="top" height="54" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{bottom=8}">
                                <textEditor name="popHab_edEfeito" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="12" transparent="true" margins="{left=6,right=6,top=4,bottom=4}"/>
                            </rectangle>

                            <!-- OS SEIS BLOCOS DE RANK. Altura 0 fora do modo
                                 progressivo. O jogador COLA a linha do livro
                                 aqui ("Efeito - Rank C: +40 pontos de vida;
                                 ...") e a ficha extrai os numeros - o rotulo
                                 abaixo de cada campo diz o que ela entendeu, e
                                 o que nao foi reconhecido vale como texto. -->
                            <layout name="popHab_wrapRanks" align="top" height="0">
                                <label align="top" height="26" text="EFEITO POR RANK — a ficha usa o bloco do rank atual do personagem, e troca sozinha quando ele sobe" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" wordWrap="true" hitTest="false"/>
                                <label align="top" height="15" text="EFEITO — RANK E" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <rectangle align="top" height="46" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                                    <textEditor name="popHab_edRankE" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="11" transparent="true" margins="{left=6,right=6,top=3,bottom=3}"/>
                                </rectangle>
                                <label name="popHab_lblLeituraRankE" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>
                                <label align="top" height="15" text="EFEITO — RANK D" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <rectangle align="top" height="46" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                                    <textEditor name="popHab_edRankD" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="11" transparent="true" margins="{left=6,right=6,top=3,bottom=3}"/>
                                </rectangle>
                                <label name="popHab_lblLeituraRankD" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>
                                <label align="top" height="15" text="EFEITO — RANK C" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <rectangle align="top" height="46" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                                    <textEditor name="popHab_edRankC" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="11" transparent="true" margins="{left=6,right=6,top=3,bottom=3}"/>
                                </rectangle>
                                <label name="popHab_lblLeituraRankC" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>
                                <label align="top" height="15" text="EFEITO — RANK B" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <rectangle align="top" height="46" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                                    <textEditor name="popHab_edRankB" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="11" transparent="true" margins="{left=6,right=6,top=3,bottom=3}"/>
                                </rectangle>
                                <label name="popHab_lblLeituraRankB" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>
                                <label align="top" height="15" text="EFEITO — RANK A" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <rectangle align="top" height="46" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                                    <textEditor name="popHab_edRankA" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="11" transparent="true" margins="{left=6,right=6,top=3,bottom=3}"/>
                                </rectangle>
                                <label name="popHab_lblLeituraRankA" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>
                                <label align="top" height="15" text="EFEITO — RANK EX" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="11" hitTest="false"/>
                                <rectangle align="top" height="46" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                                    <textEditor name="popHab_edRankEX" align="client" text="" fontFamily="EB Garamond" fontColor="#E6E9E4" fontSize="11" transparent="true" margins="{left=6,right=6,top=3,bottom=3}"/>
                                </rectangle>
                                <label name="popHab_lblLeituraRankEX" align="top" height="15" text="" fontFamily="EB Garamond" fontColor="#54636B" fontSize="11" wordWrap="false" margins="{bottom=6}" hitTest="false"/>
                            </layout>

                            <!-- ARTE DA HABILIDADE, por último e grande.
                                 Clicar abre o seletor padrão do Firecast, que
                                 já oferece endereço de site OU arquivo do
                                 FireDrive — por isso não há campo de link.
                                 O "field" aponta para um rascunho na raiz
                                 (imagemHabEdicao); ver editarHabilidade. -->
                            <label align="top" height="16" text="ARTE DA HABILIDADE" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" hitTest="false"/>
                            <rectangle align="top" height="320" color="#0A0C10" strokeColor="#3A2E52" strokeSize="1" xradius="4" yradius="4" margins="{left=150,right=150,bottom=8}">
                                <!-- style="proportional" e DECISAO DE MESA, nao sobra: aqui a peca
                                     inteira importa mais que preencher a moldura. Uma arte
                                     de equipamento ou de criatura cortada perde justamente o
                                     que se quer ver. E o oposto do retrato do personagem
                                     (autoFit, linha ~11161), onde cortar nao importa e a
                                     estetica manda. NAO "uniformize" os dois. -->
                                <image align="client" field="imagemHabEdicao" editable="true" style="proportional" showProgress="true" margins="{left=3,right=3,top=3,bottom=3}" hint="Clique para escolher a arte desta habilidade — de um endereço da internet ou do seu FireDrive. Ela aparece sempre que alguém abrir a habilidade, inclusive no meio do turno."/>
                            </rectangle>

                        </scrollBox>
                    </rectangle>
                </layout>
            </layout>
        </rectangle>
    </popup>

    <popup name="popItens" width="1080" height="680" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#C9A24B" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=18,right=18,top=14,bottom=14}">
                <label align="top" height="26" text="CATÁLOGO DE EQUIPAMENTOS" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" hitTest="false"/>
                <rectangle align="top" height="1" color="#C9A24B" margins="{top=4,bottom=8}" hitTest="false"/>

                <rectangle align="bottom" height="30" color="#12181C" strokeColor="#3A4750" strokeSize="1" xradius="3" yradius="3" margins="{top=10}" cursor="handPoint" hint="Fechar">
