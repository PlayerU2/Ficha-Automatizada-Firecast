                                    <label name="popCatalogoDefeitos_lblEfeito" align="client" text="" fontFamily="EB Garamond" fontColor="#DCD3EC" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                            <rectangle name="popCatalogoDefeitos_secRestricao" align="top" height="140" color="#0B1014" strokeColor="#5A2028" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
                                    <label align="top" height="20" text="RESTRIÇÃO" fontFamily="Marcellus SC" fontColor="#9E3B4A" fontSize="12" margins="{bottom=4}"/>
                                    <label name="popCatalogoDefeitos_lblRestricao" align="client" text="" fontFamily="EB Garamond" fontColor="#E2AEB6" fontSize="15" wordWrap="true" vertTextAlign="leading"/>
                                </layout>
                            </rectangle>
                            <rectangle name="popCatalogoDefeitos_secAutomacao" align="top" height="110" color="#0B1014" strokeColor="#2A4652" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                                <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
