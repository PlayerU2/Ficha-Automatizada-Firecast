<?xml version="1.0" encoding="UTF-8"?>
<!--
  Item de recordList da secao HABILIDADES (aba V).

  Todo codigo e INLINE nos <event>: funcao nomeada no <script> de um template
  de item vira global, e a ultima linha criada sobrescreve as anteriores.

  Campos do item:
    tipo         "poder" | "classe" | "feitico"
    nome         nome dado pelo jogador
    rank         E D C B A EX
    poderVinculado  nome do poder de origem (vazio em habilidade de classe)
    tags         lista separada por virgula
    energia      custo de Aura (ou Mana, em feiticos)
    dadoBase     ex.: 3d8
    modificador  ex.: 6
    alcance      em metros
    duracao      texto
    elemento     tag elemental principal
    descricao    texto livre
    efeito       texto livre
    custoPago    pontos efetivamente gastos (0 quando gratuita)
    origemGratis de onde veio a gratuidade, quando custoPago = 0

  ARMADILHA: horzTextAlign/vertTextAlign NAO aceitam "left"/"right" - so
  "center", "leading" e "trailing". Sao propriedades diferentes de align=,
  que essa sim usa left/right. Confundir as duas derruba o rdk i.
-->
<form name="frmItemHabilidade" height="116" theme="dark">

    <event name="onNodeReady"><![CDATA[
        if sheet ~= nil then
            local rank = tostring(sheet.rank or "E");
            local tipo = tostring(sheet.tipo or "poder");

            local cor = "#8A63C9";                       -- poder: violeta
            if tipo == "classe" then cor = "#4E8C74";    -- classe: musgo
            elseif tipo == "feitico" then cor = "#7FA8B8";       -- feitico: chuva
            elseif tipo == "universal" then cor = "#C9A24B";     -- universal: ouro
            elseif tipo == "forma" then cor = "#8B2332"; end;    -- forma bestial: vinho
            if self.barraItemHab ~= nil then self.barraItemHab:setColor(cor); end;

            if self.lblRankHab ~= nil then self.lblRankHab:setText(rank); end;

            -- INTERRUPTOR. Largura zero quando nao ha o que ligar: `visible=`
            -- em align="left" reordena a linha, largura nao.
            local temGatilho = (sheet.progressiva == true) or (sheet.sustentacao == true);
            local ligada = (sheet.ativa == true) or (sheet.ativa == 1) or (sheet.ativa == "true");
            -- O tipo "forma" NAO guarda estado proprio: quem liga e o botao de
            -- transformacao, e ele mora na raiz da ficha. Guardar uma copia
            -- aqui daria dois donos para a mesma propriedade, e um lobisomem
            -- podia ficar com o bonus sem estar transformado.
            if tipo == "forma" then
                local raiz = NDB.getRoot(sheet);
                ligada = (raiz ~= nil and raiz.formaAlternativaLigada == true);
            end;
            if self.rectAtivarHab ~= nil then
                self.rectAtivarHab:setWidth(temGatilho and 148 or 0);
                self.rectAtivarHab:setStrokeColor(ligada and "#C9A24B" or "#1A262C");
                self.rectAtivarHab:setColor(ligada and "#171408" or "#0A0C10");
            end;
            if self.lblAtivarHab ~= nil then
                if tipo == "forma" then
                    -- estado, e nao botao: quem liga e a transformacao
                    self.lblAtivarHab:setText(ligada and "TRANSFORMADO" or "NA FORMA MORTAL");
                else
                    self.lblAtivarHab:setText(ligada and "ATIVA" or "DESATIVADA");
                end;
                self.lblAtivarHab:setFontColor(ligada and "#C9A24B" or "#5F7078");
            end;

            if self.lblOrigemHab ~= nil then
                local origem = tostring(sheet.poderVinculado or "");
                if origem == "" then
                    if tipo == "classe" then origem = "CLASSE";
                    elseif tipo == "universal" then origem = "UNIVERSAL";
                    elseif tipo == "forma" then origem = "FORMA BESTIAL";
                    else origem = "—"; end;
                else
                    origem = string.upper(origem);
                end;
                self.lblOrigemHab:setText(origem);
                self.lblOrigemHab:setFontColor(cor);
            end;
            if self.rectOrigemHab ~= nil then self.rectOrigemHab:setStrokeColor(cor); end;

            if self.lblResumoHab ~= nil then
                local energiaNome = "Aura";
                if tipo == "feitico" then energiaNome = "Mana"; end;
                local partes = {};
                table.insert(partes, energiaNome .. " " .. tostring(sheet.energia or 0));
                if tostring(sheet.dadoBase or "") ~= "" then
                    table.insert(partes, tostring(sheet.dadoBase));
                end;
                local mod = tonumber(sheet.modificador) or 0;
                if mod > 0 then table.insert(partes, "+" .. tostring(mod)); end;
                table.insert(partes, tostring(sheet.alcance or 0) .. "m");
                local dur = tostring(sheet.duracao or "");
                dur = dur:gsub("%.%s*$", "");
                if dur ~= "" then table.insert(partes, dur); end;
                self.lblResumoHab:setText(table.concat(partes, "   ·   "));
            end;

            if self.lblTagsHab ~= nil then
                local t = tostring(sheet.tags or "");
                if t == "" then
                    self.lblTagsHab:setText("sem tags");
                    self.lblTagsHab:setFontColor("#75858D");
                else
                    self.lblTagsHab:setText(t);
                    self.lblTagsHab:setFontColor("#8C9AA0");
                end;
            end;

            -- Slot concedido ainda sem nome: o jogador precisa batizar.
            local credito = tonumber(sheet.creditoEmbutido) or 0;
            local semNome = (tostring(sheet.nome or "") == "");
            if self.lblOrigemHab ~= nil and credito > 0 then
                local rot = tostring(sheet.rotuloGratis or "");
                if rot ~= "" then
                    self.lblOrigemHab:setText("◆ " .. string.upper(rot));
                    self.lblOrigemHab:setFontColor("#C9A24B");
                end;
                if self.rectOrigemHab ~= nil then self.rectOrigemHab:setStrokeColor("#C9A24B"); end;
            end;
            if semNome then
                if self.rectItemHab ~= nil then self.rectItemHab:setStrokeColor("#C9A24B"); end;
                if self.lblResumoHab ~= nil then
                    self.lblResumoHab:setText("Habilidade concedida — clique para dar um nome e definir tags e efeito.");
                    self.lblResumoHab:setFontColor("#C9A24B");
                end;
            end;

            local pago = tonumber(sheet.custoPago) or 0;
            if self.lblCustoHab ~= nil then
                if credito > 0 and pago <= 0 then
                    self.lblCustoHab:setText("GRÁTIS");
                    self.lblCustoHab:setFontColor("#C9A24B");
                    if self.rectCustoHab ~= nil then self.rectCustoHab:setStrokeColor("#C9A24B"); end;
                elseif credito > 0 then
                    self.lblCustoHab:setText(tostring(pago) .. " pt  (−" .. tostring(credito) .. ")");
                    self.lblCustoHab:setFontColor("#C9A24B");
                    if self.rectCustoHab ~= nil then self.rectCustoHab:setStrokeColor("#C9A24B"); end;
                elseif pago <= 0 then
                    self.lblCustoHab:setText("GRÁTIS");
                    self.lblCustoHab:setFontColor("#C9A24B");
                    if self.rectCustoHab ~= nil then self.rectCustoHab:setStrokeColor("#C9A24B"); end;
                else
                    self.lblCustoHab:setText(tostring(pago) .. " pt");
                    self.lblCustoHab:setFontColor("#8C9AA0");
                    if self.rectCustoHab ~= nil then self.rectCustoHab:setStrokeColor("#1A262C"); end;
                end;
            end;
        end;
    ]]></event>

    <rectangle name="rectItemHab" align="client" color="#101217" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=3,bottom=3}">
        <rectangle name="barraItemHab" align="left" width="3" color="#8A63C9" hitTest="false"/>

        <!-- Faixa inferior independente: não disputa largura com o nome. -->
        <layout align="bottom" height="28" margins="{left=12,right=12,top=6,bottom=8}">
            <rectangle align="right" width="30" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=8}" cursor="handPoint" hint="Remover esta habilidade da ficha">
                <event name="onClick"><![CDATA[
                    if sheet ~= nil then
                        local raiz = NDB.getRoot(sheet);
                        local travada = (raiz ~= nil and raiz.fichaFinalizada == true);
                        local ehMestreReal = function()
                            local ok, res = pcall(function()
                                local personagem = rrpg.getPersonagemDe(sheet);
                                if personagem == nil then return true end;
                                local mesa = personagem.mesa;
                                if mesa == nil or mesa.meuJogador == nil then return true end;
                                return mesa.meuJogador.isMestre == true;
                            end);
                            return (not ok) or res;
                        end;
                        local podeRemover = true;
                        if travada then podeRemover = ehMestreReal(); end;
                        if podeRemover then
                            NDB.deleteNode(sheet);
                            if atualizarBlocoHabilidades ~= nil then atualizarBlocoHabilidades(); end;
                        end;
                    end;
                ]]></event>
                <label align="client" text="x" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="13" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
            </rectangle>
            <!-- Slot sempre ocupa a mesma largura. O botão interno pode sumir,
                 mas os controles vizinhos não caminham quando o estado muda. -->
            <layout name="slotAtivarHab" align="right" width="156">
                <rectangle name="rectAtivarHab" align="right" width="0" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{left=8}" cursor="handPoint" hint="Ligar ou desligar esta habilidade. Enquanto ligada, os efeitos entram nos cards da aba de Combate.">
                    <event name="onClick"><![CDATA[
                        if sheet ~= nil and tostring(sheet.tipo or "") ~= "forma" then
                            if alternarHabilidadeAtiva ~= nil then alternarHabilidadeAtiva(sheet); end;
                        end;
                    ]]></event>
                    <label name="lblAtivarHab" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                </rectangle>
            </layout>
            <rectangle name="rectCustoHab" align="right" width="116" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{left=8}" hitTest="false">
                <label name="lblCustoHab" align="client" text="" fontFamily="Cinzel" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
            </rectangle>
            <rectangle name="rectOrigemHab" align="client" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="8" yradius="8" hitTest="false">
                <label name="lblOrigemHab" align="client" text="" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="leading" margins="{left=10,right=10}" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            </rectangle>
        </layout>

        <!-- RANK -->
        <rectangle align="left" width="44" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" margins="{left=12,top=8,bottom=6}" hitTest="false">
            <label name="lblRankHab" align="client" text="E" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="15" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
        </rectangle>

        <!-- Corpo de 54px: título 22 + resumo 18 + tags 14. -->
        <rectangle align="client" color="#101217" strokeSize="0" margins="{left=12,right=12,top=8,bottom=6}" cursor="handPoint" hint="Abrir esta habilidade no construtor para editar">
            <event name="onClick"><![CDATA[
                if editarHabilidade ~= nil then editarHabilidade(sheet); end;
            ]]></event>
            <label align="top" height="22" field="nome" text="(clique para nomear)" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="14" fontStyle="bold" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            <label name="lblResumoHab" align="top" height="18" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            <label name="lblTagsHab" align="top" height="14" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="11" vertTextAlign="center" wordWrap="false" hitTest="false"/>
        </rectangle>
    </rectangle>
</form>
