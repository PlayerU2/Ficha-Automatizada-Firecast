<?xml version="1.0" encoding="UTF-8"?>
<!--
  Item de recordList compartilhado pelas abas "Qualidades" e "Defeitos".

  O popup de descricao completa VIVE DENTRO DESTE TEMPLATE, entao cada linha
  tem sua propria instancia. Todo codigo e INLINE nos <event> - nenhuma
  funcao nomeada no <script>, porque funcao nomeada em template de item vira
  global e a ultima linha criada sobrescreve as anteriores (ver itemPericia).

  O texto detalhado e lido AO VIVO do catalogo (nao do no), ja separado em
  secoes: Descricao / Efeito / Restricao / Automacao.

  Campos do item:
    - tipo, nome, pontosTexto, pontosEscolhidos, pontosPagos, aprovadoMestre
    - origemConcessao: quando preenchido, o item foi dado de graca por uma
      raca, poder ou outra qualidade (ver CONCESSOES no ficha.lfm)
-->
<form name="frmItemQualidadeDefeito" height="58" theme="dark">

    <event name="onNodeReady"><![CDATA[
        if sheet ~= nil then
            local Cat = require("catalogoQualidadesDefeitos.lua");
            local dados = Cat.buscarPorNome(tostring(sheet.nome or ""));

            if sheet.tipo == "Defeito" then
                if self.barraItemQD ~= nil then self.barraItemQD:setColor("#8B2332"); end;
            end;

            local efetivo = tonumber(sheet.pontosEscolhidos) or 0;
            local pagos = tonumber(sheet.pontosPagos);
            if pagos == nil then pagos = efetivo; end; -- fichas antigas sem este campo: assume tudo pago
            local gratis = efetivo - pagos;

            if self.lblBadgeQD ~= nil then
                if gratis > 0 then
                    self.lblBadgeQD:setText(tostring(efetivo) .. "  (" .. tostring(pagos) .. " pago + " .. tostring(gratis) .. " grátis)");
                else
                    self.lblBadgeQD:setText(tostring(efetivo));
                end;
            end;
            if gratis > 0 then
                if self.rectItemQD ~= nil then self.rectItemQD:setStrokeColor("#C9A24B"); end;
            end;

            -- Concedida automaticamente por raca/poder/qualidade: diz de onde
            -- veio, para o jogador nao achar que pagou por isso.
            if self.lblOrigemQD ~= nil then
                local origem = tostring(sheet.origemConcessao or "");
                if origem ~= "" then
                    self.lblOrigemQD:setText("◆ GRÁTIS por " .. string.upper(origem));
                    if self.rectItemQD ~= nil then self.rectItemQD:setStrokeColor("#C9A24B"); end;
                else
                    self.lblOrigemQD:setText("");
                end;
            end;

            -- Seletor de escola de magia: exclusivo da Linhagem de Unaris.
            -- Altura 0 esconde sem usar setVisible (que reposiciona elementos
            -- align="top" ao voltarem a aparecer).
            if self.popQD_secEscola ~= nil then
                local ehUnaris = (tostring(sheet.nome or "") == "Linhagem de Unaris");
                pcall(function() self.popQD_secEscola:setHeight(ehUnaris and 92 or 0); end);
                if ehUnaris then
                    local raiz = NDB.getRoot(sheet);
                    local escolhida = "";
                    if raiz ~= nil then escolhida = tostring(raiz.periciaMagiaEscolhida or ""); end;
                    local marcados = {
                        {b = self.popQD_btnEscEnc, l = self.popQD_lblEscEnc, v = "Encantamentos (magia/forja)"},
                        {b = self.popQD_btnEscTra, l = self.popQD_lblEscTra, v = "Transmutação (magia)"},
                        {b = self.popQD_btnEscEvo, l = self.popQD_lblEscEvo, v = "Evocação (magia)"},
                        {b = self.popQD_btnEscInv, l = self.popQD_lblEscInv, v = "Invocação"},
                        {b = self.popQD_btnEscCla, l = self.popQD_lblEscCla, v = "Clarividência (magia/oráculos)"},
                    };
                    for _, m in ipairs(marcados) do
                        if m.b ~= nil then
                            if m.v == escolhida then
                                m.b:setStrokeColor("#C9A24B"); m.b:setStrokeSize(2);
                                if m.l ~= nil then m.l:setFontColor("#C9A24B"); end;
                            else
                                m.b:setStrokeColor("#22323A"); m.b:setStrokeSize(1);
                                if m.l ~= nil then m.l:setFontColor("#8C9AA0"); end;
                            end;
                        end;
                    end;
                    if self.popQD_lblEscolaAtual ~= nil then
                        if escolhida == "" then
                            self.popQD_lblEscolaAtual:setText("Nenhuma escolhida. O bônus de [Magia inata] já vale em todas as perícias mágicas; falta definir onde você rola com vantagem.");
                        else
                            self.popQD_lblEscolaAtual:setText("Vantagem em: " .. escolhida .. ".  [Magia inata] soma em todas as perícias mágicas.");
                        end;
                    end;
                end;
            end;

            if self.popQD_lblTitulo ~= nil then self.popQD_lblTitulo:setText(tostring(sheet.nome or "")); end;
            if self.popQD_lblPontos ~= nil then self.popQD_lblPontos:setText(tostring(sheet.pontosTexto or "")); end;

            if dados ~= nil then
                local secoes = {
                    {campo = "Descricao", texto = dados.descricao},
                    {campo = "Efeito",    texto = dados.efeito},
                    {campo = "Restricao", texto = dados.restricao},
                    {campo = "Automacao", texto = dados.automacao},
                };
                for _, sec in ipairs(secoes) do
                    local corpo = self["popQD_lbl" .. sec.campo];
                    if corpo ~= nil then
                        local temTexto = (sec.texto ~= nil and sec.texto ~= "");
                        corpo:setText(temTexto and sec.texto or "—  (não se aplica a este item)");
                    end;
                end;
            end;
        end;
    ]]></event>

    <rectangle name="rectItemQD" align="client" color="#101217" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=2,bottom=2}">
        <rectangle name="barraItemQD" align="left" width="3" color="#8A63C9"/>

        <!-- COLUNA DIREITA: pontos e "x" na mesma linha, com as mesmas
             margens. O "x" por ultimo, a direita de tudo. -->
        <layout align="right" width="168" margins="{right=4,top=11,bottom=11}">
            <rectangle align="left" width="130" color="#0A0C10" strokeColor="#1A262C" strokeSize="1" xradius="3" yradius="3" hitTest="false">
                <label name="lblBadgeQD" align="client" text="" fontFamily="EB Garamond" fontColor="#C9A24B" fontSize="12" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
            </rectangle>
            <rectangle align="left" width="26" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" margins="{left=8}" cursor="handPoint" hint="Remover este item da ficha">
                <event name="onClick"><![CDATA[
                -- Trava de criacao: com a ficha finalizada, so o mestre remove.
                if sheet ~= nil then
                    local raiz = NDB.getRoot(sheet);
                    local travada = (raiz ~= nil and raiz.fichaFinalizada == true);
                    -- Sem funcoes nomeadas no <script> deste template (viram
                    -- globais e a ultima linha criada sobrescreve as outras);
                    -- por isso a checagem de mestre e uma closure local.
                    local ehMestreReal = function()
                        local ok, res = pcall(function()
                            local personagem = rrpg.getPersonagemDe(sheet);
                            if personagem == nil then return true end;
                            local mesa = personagem.mesa;
                            if mesa == nil or mesa.meuJogador == nil then return true end;
                            return mesa.meuJogador.isMestre == true;
                        end);
                        return (not ok) or res;
                    end;
                    local ehMestre = true;
                    if travada then ehMestre = ehMestreReal(); end;
                    -- A qualidade "Mestico" nao pode ser removida enquanto a
                    -- heranca estiver lacrada: remover e recomprar era uma das
                    -- portas de re-sorteio. O mestre continua podendo remover.
                    local bloqueadoPeloLacre = false;
                    if tostring(sheet.nome or "") == "Mestiço"
                        and raiz ~= nil and raiz.mesticoLacre == true then
                        if not ehMestreReal() then
                            bloqueadoPeloLacre = true;
                            if avisarMestico ~= nil then
                                avisarMestico("A qualidade Mestiço não pode ser removida enquanto a herança estiver lacrada. Peça ao mestre para quebrar o lacre na aba Raça & Classe.", "#8B2332");
                            end;
                        end;
                    end;

                    if ((not travada) or ehMestre) and (not bloqueadoPeloLacre) then
                        NDB.deleteNode(sheet);
                        -- pede a ficha raiz para recalcular o painel de pontos
                        if atualizarPainelPontosQD ~= nil then atualizarPainelPontosQD(); end;
                        if recalcularTudo ~= nil then recalcularTudo(); end;
                    end;
                end;
            ]]></event>
                <label align="client" text="x" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="13" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
            </rectangle>
        </layout>

        <rectangle align="client" color="#101217" margins="{left=10,right=4,top=4,bottom=4}" cursor="handPoint" hint="Ler a descrição completa deste item">
            <event name="onClick"><![CDATA[
                -- Mesmo caminho dos outros popups: abrirPopupAjustado limita
                -- a 94% da tela. Com :show() direto o popup vazava em monitor
                -- menor - era o unico da ficha fora desse padrao.
                if self.popQDDetalhe ~= nil then
                    if abrirPopupAjustado ~= nil then
                        abrirPopupAjustado(self.popQDDetalhe, 760, 600);
                    else
                        self.popQDDetalhe:show();
                    end;
                end;
            ]]></event>
            <label align="top" height="20" field="nome" text="(sem nome)" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="13" fontStyle="bold" vertTextAlign="center" hitTest="false"/>
            <label name="lblOrigemQD" align="top" height="12" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="8" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            <label align="client" text="Clique para ler a descrição completa &#9656;" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="10" vertTextAlign="leading" hitTest="false"/>
        </rectangle>
    </rectangle>

    <popup name="popQDDetalhe" width="760" height="600" backOpacity="0.75" cancelable="true">
        <rectangle align="client" color="#070A0C" strokeColor="#8A63C9" strokeSize="2" xradius="6" yradius="6" hitTest="false">
            <layout align="client" margins="{left=22,right=22,top=16,bottom=16}">
                <label name="popQD_lblTitulo" align="top" height="28" text="" fontFamily="Cinzel Decorative" fontColor="#C9A24B" fontSize="19" fontStyle="bold"/>
                <label name="popQD_lblPontos" align="top" height="20" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="13" margins="{bottom=6}"/>
                <rectangle align="top" height="1" color="#22323A" margins="{bottom=12}" hitTest="false"/>

                <!-- ESCOLA DE MAGIA: so aparece na Linhagem de Unaris.
                     ATENCAO - sao DUAS coisas distintas no efeito da
                     qualidade:
                       * [Magia inata] da +1 (+2 do nivel 11) em TODAS as
                         pericias magicas - automatico, sem escolha;
                       * a escolha abaixo define em qual escola voce rola os
                         dados com VANTAGEM. -->
                <layout name="popQD_secEscola" align="top" height="0">
                    <label align="top" height="16" text="ESCOLA DE MAGIA — onde você rola com VANTAGEM" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="9" hitTest="false"/>
                    <layout align="top" height="34">
                        <rectangle name="popQD_btnEscEnc" align="left" width="136" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com vantagem em Encantamentos (magia/forja) (Carisma)">
                            <event name="onClick"><![CDATA[
                                if sheet ~= nil then
                                    local raiz = NDB.getRoot(sheet);
                                    if raiz ~= nil then
                                        raiz.periciaMagiaEscolhida = "Encantamentos (magia/forja)";
                                        raiz.periciaMagiaAtributo = "Carisma";
                                        if recalcularTudo ~= nil then recalcularTudo(); end;
                                    end;
                                    -- repinta os botoes sem funcao nomeada (template de item)
                                    local marcados = {
                                        {b = self.popQD_btnEscEnc, l = self.popQD_lblEscEnc, v = "Encantamentos (magia/forja)"},
                                        {b = self.popQD_btnEscTra, l = self.popQD_lblEscTra, v = "Transmutação (magia)"},
                                        {b = self.popQD_btnEscEvo, l = self.popQD_lblEscEvo, v = "Evocação (magia)"},
                                        {b = self.popQD_btnEscInv, l = self.popQD_lblEscInv, v = "Invocação"},
                                        {b = self.popQD_btnEscCla, l = self.popQD_lblEscCla, v = "Clarividência (magia/oráculos)"},
                                    };
                                    local escolhida = "Encantamentos (magia/forja)";
                                    for _, m in ipairs(marcados) do
                                        if m.b ~= nil then
                                            if m.v == escolhida then
                                                m.b:setStrokeColor("#C9A24B"); m.b:setStrokeSize(2);
                                                if m.l ~= nil then m.l:setFontColor("#C9A24B"); end;
                                            else
                                                m.b:setStrokeColor("#22323A"); m.b:setStrokeSize(1);
                                                if m.l ~= nil then m.l:setFontColor("#8C9AA0"); end;
                                            end;
                                        end;
                                    end;
                                end;
                            ]]></event>
                            <label name="popQD_lblEscEnc" align="client" text="Encantamentos" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="9" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                        </rectangle>
                        <rectangle name="popQD_btnEscTra" align="left" width="136" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com vantagem em Transmutação (magia) (Destreza)">
                            <event name="onClick"><![CDATA[
                                if sheet ~= nil then
                                    local raiz = NDB.getRoot(sheet);
                                    if raiz ~= nil then
                                        raiz.periciaMagiaEscolhida = "Transmutação (magia)";
                                        raiz.periciaMagiaAtributo = "Destreza";
                                        if recalcularTudo ~= nil then recalcularTudo(); end;
                                    end;
                                    -- repinta os botoes sem funcao nomeada (template de item)
                                    local marcados = {
                                        {b = self.popQD_btnEscEnc, l = self.popQD_lblEscEnc, v = "Encantamentos (magia/forja)"},
                                        {b = self.popQD_btnEscTra, l = self.popQD_lblEscTra, v = "Transmutação (magia)"},
                                        {b = self.popQD_btnEscEvo, l = self.popQD_lblEscEvo, v = "Evocação (magia)"},
                                        {b = self.popQD_btnEscInv, l = self.popQD_lblEscInv, v = "Invocação"},
                                        {b = self.popQD_btnEscCla, l = self.popQD_lblEscCla, v = "Clarividência (magia/oráculos)"},
                                    };
                                    local escolhida = "Transmutação (magia)";
                                    for _, m in ipairs(marcados) do
                                        if m.b ~= nil then
                                            if m.v == escolhida then
                                                m.b:setStrokeColor("#C9A24B"); m.b:setStrokeSize(2);
                                                if m.l ~= nil then m.l:setFontColor("#C9A24B"); end;
                                            else
                                                m.b:setStrokeColor("#22323A"); m.b:setStrokeSize(1);
                                                if m.l ~= nil then m.l:setFontColor("#8C9AA0"); end;
                                            end;
                                        end;
                                    end;
                                end;
                            ]]></event>
                            <label name="popQD_lblEscTra" align="client" text="Transmutação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="9" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                        </rectangle>
                        <rectangle name="popQD_btnEscEvo" align="left" width="136" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com vantagem em Evocação (magia) (Inteligência)">
                            <event name="onClick"><![CDATA[
                                if sheet ~= nil then
                                    local raiz = NDB.getRoot(sheet);
                                    if raiz ~= nil then
                                        raiz.periciaMagiaEscolhida = "Evocação (magia)";
                                        raiz.periciaMagiaAtributo = "Inteligência";
                                        if recalcularTudo ~= nil then recalcularTudo(); end;
                                    end;
                                    -- repinta os botoes sem funcao nomeada (template de item)
                                    local marcados = {
                                        {b = self.popQD_btnEscEnc, l = self.popQD_lblEscEnc, v = "Encantamentos (magia/forja)"},
                                        {b = self.popQD_btnEscTra, l = self.popQD_lblEscTra, v = "Transmutação (magia)"},
                                        {b = self.popQD_btnEscEvo, l = self.popQD_lblEscEvo, v = "Evocação (magia)"},
                                        {b = self.popQD_btnEscInv, l = self.popQD_lblEscInv, v = "Invocação"},
                                        {b = self.popQD_btnEscCla, l = self.popQD_lblEscCla, v = "Clarividência (magia/oráculos)"},
                                    };
                                    local escolhida = "Evocação (magia)";
                                    for _, m in ipairs(marcados) do
                                        if m.b ~= nil then
                                            if m.v == escolhida then
                                                m.b:setStrokeColor("#C9A24B"); m.b:setStrokeSize(2);
                                                if m.l ~= nil then m.l:setFontColor("#C9A24B"); end;
                                            else
                                                m.b:setStrokeColor("#22323A"); m.b:setStrokeSize(1);
                                                if m.l ~= nil then m.l:setFontColor("#8C9AA0"); end;
                                            end;
                                        end;
                                    end;
                                end;
                            ]]></event>
                            <label name="popQD_lblEscEvo" align="client" text="Evocação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="9" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                        </rectangle>
                        <rectangle name="popQD_btnEscInv" align="left" width="136" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com vantagem em Invocação (Manipulação)">
                            <event name="onClick"><![CDATA[
                                if sheet ~= nil then
                                    local raiz = NDB.getRoot(sheet);
                                    if raiz ~= nil then
                                        raiz.periciaMagiaEscolhida = "Invocação";
                                        raiz.periciaMagiaAtributo = "Manipulação";
                                        if recalcularTudo ~= nil then recalcularTudo(); end;
                                    end;
                                    -- repinta os botoes sem funcao nomeada (template de item)
                                    local marcados = {
                                        {b = self.popQD_btnEscEnc, l = self.popQD_lblEscEnc, v = "Encantamentos (magia/forja)"},
                                        {b = self.popQD_btnEscTra, l = self.popQD_lblEscTra, v = "Transmutação (magia)"},
                                        {b = self.popQD_btnEscEvo, l = self.popQD_lblEscEvo, v = "Evocação (magia)"},
                                        {b = self.popQD_btnEscInv, l = self.popQD_lblEscInv, v = "Invocação"},
                                        {b = self.popQD_btnEscCla, l = self.popQD_lblEscCla, v = "Clarividência (magia/oráculos)"},
                                    };
                                    local escolhida = "Invocação";
                                    for _, m in ipairs(marcados) do
                                        if m.b ~= nil then
                                            if m.v == escolhida then
                                                m.b:setStrokeColor("#C9A24B"); m.b:setStrokeSize(2);
                                                if m.l ~= nil then m.l:setFontColor("#C9A24B"); end;
                                            else
                                                m.b:setStrokeColor("#22323A"); m.b:setStrokeSize(1);
                                                if m.l ~= nil then m.l:setFontColor("#8C9AA0"); end;
                                            end;
                                        end;
                                    end;
                                end;
                            ]]></event>
                            <label name="popQD_lblEscInv" align="client" text="Invocação" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="9" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                        </rectangle>
                        <rectangle name="popQD_btnEscCla" align="left" width="136" color="#12181C" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3" margins="{right=6,top=4,bottom=4}" cursor="handPoint" hint="Rolar com vantagem em Clarividência (magia/oráculos) (Sabedoria)">
                            <event name="onClick"><![CDATA[
                                if sheet ~= nil then
                                    local raiz = NDB.getRoot(sheet);
                                    if raiz ~= nil then
                                        raiz.periciaMagiaEscolhida = "Clarividência (magia/oráculos)";
                                        raiz.periciaMagiaAtributo = "Sabedoria";
                                        if recalcularTudo ~= nil then recalcularTudo(); end;
                                    end;
                                    -- repinta os botoes sem funcao nomeada (template de item)
                                    local marcados = {
                                        {b = self.popQD_btnEscEnc, l = self.popQD_lblEscEnc, v = "Encantamentos (magia/forja)"},
                                        {b = self.popQD_btnEscTra, l = self.popQD_lblEscTra, v = "Transmutação (magia)"},
                                        {b = self.popQD_btnEscEvo, l = self.popQD_lblEscEvo, v = "Evocação (magia)"},
                                        {b = self.popQD_btnEscInv, l = self.popQD_lblEscInv, v = "Invocação"},
                                        {b = self.popQD_btnEscCla, l = self.popQD_lblEscCla, v = "Clarividência (magia/oráculos)"},
                                    };
                                    local escolhida = "Clarividência (magia/oráculos)";
                                    for _, m in ipairs(marcados) do
                                        if m.b ~= nil then
                                            if m.v == escolhida then
                                                m.b:setStrokeColor("#C9A24B"); m.b:setStrokeSize(2);
                                                if m.l ~= nil then m.l:setFontColor("#C9A24B"); end;
                                            else
                                                m.b:setStrokeColor("#22323A"); m.b:setStrokeSize(1);
                                                if m.l ~= nil then m.l:setFontColor("#8C9AA0"); end;
                                            end;
                                        end;
                                    end;
                                end;
                            ]]></event>
                            <label name="popQD_lblEscCla" align="client" text="Clarividência" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="9" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>
                        </rectangle>
                    </layout>
                    <label name="popQD_lblEscolaAtual" align="top" height="16" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="11" hitTest="false"/>
                    <rectangle align="top" height="1" color="#22323A" margins="{top=8,bottom=10}" hitTest="false"/>
                </layout>

                <rectangle align="bottom" height="36" color="#0D1317" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=10}" cursor="handPoint" hint="Fechar esta janela">
                    <event name="onClick"><![CDATA[
                        if self.popQDDetalhe ~= nil then self.popQDDetalhe:close(); end;
                    ]]></event>
                    <label align="client" text="FECHAR" fontFamily="Marcellus SC" fontColor="#8C9AA0" fontSize="11" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                </rectangle>

                <scrollBox align="client">
                    <rectangle align="top" height="210" color="#0B1014" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{bottom=10}" hitTest="false">
                        <layout align="client" margins="{left=12,right=12,top=8,bottom=8}">
