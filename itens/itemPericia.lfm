<?xml version="1.0" encoding="UTF-8"?>
<!--
  Item de recordList das listas de pericias (uma por atributo).

  Todo codigo e INLINE nos <event>: funcao nomeada no <script> de um template
  de item vira global e a ultima linha criada sobrescreve as anteriores.

  Campos do item:
    atributo         atributo dono da pericia
    nome             nome da pericia
    descricao        gravada no proprio no, para aparecer por binding
    aprovadoMestre   entrou fora do limite (aprovacao do mestre)
    origemConcessao  quando preenchido, veio de graca por raca/poder/qualidade
    ajusteManual     bonus temporario digitado pelo jogador (feitico, item...)

  ARMADILHA: horzTextAlign/vertTextAlign nao aceitam "left"/"right" - so
  "center", "leading" e "trailing".
-->
<form name="frmItemPericia" height="76" theme="dark">

    <event name="onNodeReady"><![CDATA[
        if sheet ~= nil then
            local origem = tostring(sheet.origemConcessao or "");
            if self.lblOrigemPer ~= nil then
                if origem ~= "" then
                    self.lblOrigemPer:setText("◆ GRÁTIS por " .. string.upper(origem));
                else
                    self.lblOrigemPer:setText("");
                end;
            end;

            if sheet.aprovadoMestre and origem == "" then
                if self.rectItemPericia ~= nil then self.rectItemPericia:setStrokeColor("#8B2332"); end;
                if self.barraItemPericia ~= nil then self.barraItemPericia:setColor("#8B2332"); end;
                if self.lblNomePericia ~= nil then self.lblNomePericia:setFontColor("#D4838F"); end;
            elseif origem ~= "" then
                if self.rectItemPericia ~= nil then self.rectItemPericia:setStrokeColor("#C9A24B"); end;
                if self.barraItemPericia ~= nil then self.barraItemPericia:setColor("#C9A24B"); end;
            end;

            -- Total de rolagem. A conta vive no ficha.lfm (calculoDaPericia)
            -- para nao duplicar regra em cada template.
            if calculoDaPericia ~= nil then
                local total, atr, prof, extras, manual, textoExtras =
                    calculoDaPericia(tostring(sheet.atributo or ""), tostring(sheet.nome or ""), sheet.ajusteManual);
                if self.lblTotalPericia ~= nil then
                    local sinal = "+";
                    if total < 0 then sinal = ""; end;
                    self.lblTotalPericia:setText(sinal .. tostring(total));
                end;
                -- Vantagem nao e numero: marca na propria linha.
                if self.lblVantagemPer ~= nil then
                    local temVant = false;
                    if periciaComVantagem ~= nil then
                        temVant = periciaComVantagem(tostring(sheet.nome or ""));
                    end;
                    if temVant then
                        self.lblVantagemPer:setText("VANTAGEM");
                        if self.rectItemPericia ~= nil then self.rectItemPericia:setStrokeColor("#8A63C9"); end;
                    else
                        self.lblVantagemPer:setText("");
                    end;
                end;
                if self.lblContaPericia ~= nil then
                    local partes = {};
                    table.insert(partes, "atributo " .. tostring(atr));
                    table.insert(partes, "prof +" .. tostring(prof));
                    if extras ~= 0 then
                        local t = "extras +" .. tostring(extras);
                        if textoExtras ~= nil and textoExtras ~= "" then
                            t = t .. " (" .. textoExtras .. ")";
                        end;
                        table.insert(partes, t);
                    end;
                    if manual ~= 0 then
                        local s = "+";
                        if manual < 0 then s = ""; end;
                        table.insert(partes, "manual " .. s .. tostring(manual));
                    end;
                    self.lblContaPericia:setText(table.concat(partes, "  ·  "));
                end;
            end;
        end;
    ]]></event>

    <rectangle name="rectItemPericia" align="client" color="#101217" strokeColor="#22323A" strokeSize="1" xradius="4" yradius="4" margins="{top=2,bottom=2}">
        <rectangle name="barraItemPericia" align="left" width="3" color="#22323A" hitTest="false"/>

        <!-- COLUNA DIREITA: container unico com filhos align="left", para a
             ordem ser a de declaracao. Os tres blocos tem a MESMA estrutura -
             rotulo de 12px em cima e caixa embaixo, com as mesmas margens -
             para as caixas ficarem alinhadas na horizontal. O "x" tem rotulo
             vazio so para nascer na mesma linha dos outros. -->
        <layout align="right" width="190" margins="{right=6,top=12,bottom=12}">
            <layout align="left" width="70">
                <label align="top" height="12" text="TOTAL" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="7" horzTextAlign="center" hitTest="false"/>
                <rectangle align="client" color="#0A0C10" strokeColor="#C9A24B" strokeSize="1" xradius="3" yradius="3" hitTest="false">
                    <label name="lblTotalPericia" align="client" text="+0" fontFamily="Cinzel" fontColor="#C9A24B" fontSize="16" fontStyle="bold" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                </rectangle>
            </layout>

            <layout align="left" width="70" margins="{left=8}">
                <label align="top" height="12" text="MANUAL" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="7" horzTextAlign="center" hitTest="false"/>
                <rectangle align="client" color="#0A0C10" strokeColor="#22323A" strokeSize="1" xradius="3" yradius="3">
                    <edit name="edAjustePericia" align="client" field="ajusteManual" type="number" text="0" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="14" horzTextAlign="center" transparent="true" hint="Bônus temporário: feitiço, item, situação. Some ou subtraia aqui — o resto a ficha calcula.">
                        <event name="onChange"><![CDATA[
                            if sheet ~= nil and calculoDaPericia ~= nil then
                                local total = calculoDaPericia(tostring(sheet.atributo or ""), tostring(sheet.nome or ""), sheet.ajusteManual);
                                if self.lblTotalPericia ~= nil then
                                    local sinal = "+";
                                    if total < 0 then sinal = ""; end;
                                    self.lblTotalPericia:setText(sinal .. tostring(total));
                                end;
                            end;
                        ]]></event>
                    </edit>
                </rectangle>
            </layout>

            <layout align="left" width="26" margins="{left=8}">
                <label align="top" height="12" text="" fontFamily="Marcellus SC" fontColor="#5F7078" fontSize="7" horzTextAlign="center" hitTest="false"/>
                <rectangle align="client" color="#170D10" strokeColor="#8B2332" strokeSize="1" xradius="3" yradius="3" cursor="handPoint" hint="Remover esta perícia da ficha">
                    <event name="onClick"><![CDATA[
                        -- remover pericia e criacao: bloqueado com a ficha
                        -- finalizada, exceto para o mestre
                        local podeMexer = true;
                        if podeEditarCriacao ~= nil then podeMexer = podeEditarCriacao(); end;
                        if sheet ~= nil and podeMexer then
                            NDB.deleteNode(sheet);
                            if atualizarContadoresPericias ~= nil then atualizarContadoresPericias(); end;
                            if atualizarPainelAtributosPericias ~= nil then atualizarPainelAtributosPericias(); end;
                        end;
                    ]]></event>
                    <label align="client" text="x" fontFamily="EB Garamond" fontColor="#9E3B4A" fontSize="13" horzTextAlign="center" vertTextAlign="center" hitTest="false"/>
                </rectangle>
            </layout>
        </layout>

        <label name="lblVantagemPer" align="right" width="72" text="" fontFamily="Marcellus SC" fontColor="#8A63C9" fontSize="8" horzTextAlign="center" vertTextAlign="center" wordWrap="false" hitTest="false"/>

        <layout align="client" margins="{left=10,right=4,top=4,bottom=4}">
            <label name="lblNomePericia" align="top" height="19" field="nome" text="(perícia sem nome)" fontFamily="Cinzel" fontColor="#E6E9E4" fontSize="13" fontStyle="bold" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            <label name="lblContaPericia" align="top" height="13" text="" fontFamily="EB Garamond" fontColor="#7FA8B8" fontSize="10" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            <label name="lblOrigemPer" align="top" height="11" text="" fontFamily="Marcellus SC" fontColor="#C9A24B" fontSize="8" vertTextAlign="center" wordWrap="false" hitTest="false"/>
            <label name="lblDescPericia" align="client" field="descricao" text="" fontFamily="EB Garamond" fontColor="#8C9AA0" fontSize="10" wordWrap="true" hitTest="false"/>
        </layout>
    </rectangle>
</form>
